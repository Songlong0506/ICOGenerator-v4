{
  // Luật xuất ICOGenerator-v4 sang repo team. Giải thích từng mục: docs/team-export.md.
  "exclude": [
    "docs/**",
    "tests/**",
    ".claude/**",
    "CLAUDE.md",
    "tools/**",
    "README.md",
    "docker-compose.otel.yml"
  ],
  "stripCommentExtensions": [ ".cs", ".cshtml", ".js", ".css", ".csproj" ],
  "stripCommentExclude": [],
  "keepCommentsContaining": [ "<auto-generated" ],
  "jsonTransforms": {
    "appsettings.json": {
      "removeKeysStartingWith": "_",
      "set": {
        "Llm:Proxy:UseDefaultCredentials": true
      }
    }
  },
  "overlayDirectory": "overlay",
  "preserveInTarget": []
}
