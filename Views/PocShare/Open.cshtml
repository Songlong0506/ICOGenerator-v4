@model ICOGenerator.Application.Projects.PocReviewPage
@{
    ViewData["Title"] = $"Bản demo — {Model.ProjectName}";
    var token = (string)ViewBag.ShareToken;
    Layout = "_GuestLayout";
}

@* Trang xem dành cho NGƯỜI ĐƯỢC GỬI LINK (không có tài khoản): bản demo + kịch bản nghiệm thu + ghim góp
   ý. Cố ý KHÔNG có gì khác của dự án — không tài liệu, không hội thoại, không kết quả tự kiểm nội bộ,
   không nút điều khiển quy trình. Người xem chỉ cần bấm thử bản demo và chỉ đúng chỗ chưa ổn. *@

<div class="page-head">
    <div>
        <h1>@Model.ProjectName — bản demo</h1>
        <p class="muted">
            Đây là bản demo để xem trước hướng đi (dữ liệu là dữ liệu mẫu, chưa phải hệ thống thật).
            Bấm <b>Add Note</b> dưới bản demo để góp ý cho một màn hình, hoặc bật chế độ ghim (biểu tượng <i class="bi bi-pin-angle" aria-hidden="true"></i> ở góc trên phải bản demo) rồi bấm vào chỗ chưa đúng.
        </p>
    </div>
</div>

@{ var hasGuide = Model.Scenarios.Scenarios.Any(); }

@* Cùng bố cục với POC Review: cột trái là bản demo + góp ý nói về CHÍNH bản demo đó (một mục góp ý và
   một pin vẽ trên demo là cùng một thứ nhìn từ hai phía, nên để ngay dưới khung chứ không bắt mắt người
   xem nhảy sang cột kia); cột phải chỉ còn hướng dẫn sử dụng. Không có kịch bản nào thì bỏ hẳn cột phải
   (.no-side) — một cột trống 360px chỉ bóp khung demo. *@
<div class="poc-review-layout@(hasGuide ? "" : " no-side")"
     id="pocShareRoot"
     data-comments-url="@Url.Action("Comments", "PocShare", new { token })"
     data-add-url="@Url.Action("AddComment", "PocShare", new { token })">

    <div class="poc-main-col">
        <section class="card poc-frame-panel">
            @* Cùng hàng icon nổi góc trên phải khung demo như POC Review (.poc-frame-actions): công tắc ghim
               đứng bên trái "mở tab riêng". Hai trang một kiểu để người đội dự án gửi link và người khách
               nhận link nhìn thấy cùng một chỗ bấm. Không có nút toàn màn hình — trang khách không nạp
               poc-review.js, và "mở tab riêng" đã cho khách bản demo trọn màn hình. *@
            <div class="poc-frame-actions">
                <button type="button"
                        class="poc-frame-btn"
                        id="pinModeBtn"
                        aria-pressed="false"
                        title="Bật chế độ ghim — bấm vào chỗ chưa đúng trong bản demo để góp ý"
                        aria-label="Bật chế độ ghim">
                    <i class="bi bi-pin-angle" aria-hidden="true"></i>
                </button>
                <a class="poc-frame-btn"
                   href="@Url.Action("Demo", "PocShare", new { token })"
                   target="_blank" rel="noopener"
                   title="Mở bản demo ở tab mới (không có chế độ ghim)"
                   aria-label="Mở bản demo ở tab mới">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                </a>
            </div>

            @* Cùng rào chắn sandbox như đường có đăng nhập: HTML này do LLM sinh, phải chạy ở origin mờ. *@
            <iframe id="pocFrame"
                    title="Bản demo"
                    src="@Url.Action("Demo", "PocShare", new { token, review = true })"
                    sandbox="allow-scripts allow-forms allow-modals"></iframe>
        </section>

        @* CÙNG bảng ghi chú với POC Review (partial _PocNotesTable + poc-notes.js): người gửi link và
           người nhận link nhìn chung một bảng. Khác đúng hai chỗ: không có cột Action (khách không rút được
           gì), và popup Add Note hỏi thêm tên người góp ý. Không có ghi chú Brief — tài liệu nội bộ. *@
        <section class="card poc-notes-panel">
            @await Html.PartialAsync("_PocNotesTable", (Model.Screens, true, Model.PocAcceptedAtUtc.HasValue))
        </section>
    </div>

    @if (hasGuide)
    {
        <aside class="card poc-comments-panel">
            @* Cùng partial với POC Review: bấm chữ một bước → bản demo mở đúng màn hình và tô sáng phần tử
               của bước đó (cùng mã neo UatAnchor). *@
            @await Html.PartialAsync("_PocGuide", Model.Scenarios.Scenarios)
        </aside>
    }
</div>

@section Scripts {
    @* dropdown.js: _GuestLayout không nạp nó, nhưng bộ lọc + dropdown Screen của bảng phải trông y như
       ở POC Review. *@
    <script src="~/js/dropdown.js" asp-append-version="true"></script>
    <script src="~/js/poc-notes.js" asp-append-version="true"></script>
    <script src="~/js/poc-share.js" asp-append-version="true"></script>
}
