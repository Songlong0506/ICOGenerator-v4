@using ICOGenerator.Application.Settings
@using ICOGenerator.Services.Budget
@model AppSettingsVm

@section Styles {
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <h1>Settings</h1>
    </div>
</div>

@await Html.PartialAsync("_CommandBar", new CommandBarModel
{
    Primary = new CommandBarButton
    {
        Label = "Save Settings",
        Icon = "bi-check-lg",
        OnClick = "document.getElementById('settingsForm').requestSubmit()"
    }
})

<form id="settingsForm" class="settings-form" asp-action="Update" method="post">
    @Html.AntiForgeryToken()

    <div class="card settings-card">
        <h2>Database</h2>
        <label>Connection String *</label>
        <textarea name="ConnectionString" rows="3" required>@Model.ConnectionString</textarea>
    </div>

    <div class="card settings-card">
        <h2>Agent Workspace</h2>
        <label>Workspace Root Path *</label>
        <input name="WorkspaceRootPath" value="@Model.WorkspaceRootPath" required placeholder="C:\Study App\ICOGeneratorWorkspaces" />
    </div>

    <div class="card settings-card">
        <h2>Tool Policy</h2>

        <label>Allowed Commands</label>
        <textarea name="AllowedCommands" rows="8">@Model.AllowedCommands</textarea>

        <label>Allowed File Extensions</label>
        <textarea name="AllowedFileExtensions" rows="8">@Model.AllowedFileExtensions</textarea>
    </div>

    <div class="card settings-card">
        <h2>Git / Pull Request</h2>

        <label>Remote Name</label>
        <input name="PullRequestRemoteName" value="@Model.PullRequestRemoteName" placeholder="origin" />
    </div>

    <div class="card settings-card">
        <h2>LLM Budget</h2>
        <p class="hint">
            Trần chi phí USD, kiểm tra trước mỗi lời gọi model (cả agent lẫn chat BA). Chạm trần thì lời gọi bị chặn
            cho tới khi tăng trần hoặc sang kỳ mới. Chi phí tính giống trang Usage, nên chỉ chính xác với model đã khai
            báo đơn giá. Đặt <strong>0</strong> = không giới hạn. Có hiệu lực ngay, không cần khởi động lại.
        </p>

        <label class="settings-check">
            <input type="checkbox" name="BudgetEnabled" value="true" @(Model.BudgetEnabled ? "checked" : "") />
            Bật chốt chặn ngân sách
        </label>
        <input type="hidden" name="BudgetEnabled" value="false" />

        <label>Kỳ tính</label>
        <select name="BudgetPeriod">
            <option value="@BudgetPeriod.Monthly" selected="@(Model.BudgetPeriod == BudgetPeriod.Monthly)">Monthly — reset ngày 1 mỗi tháng (UTC)</option>
            <option value="@BudgetPeriod.Daily" selected="@(Model.BudgetPeriod == BudgetPeriod.Daily)">Daily — reset 00:00 mỗi ngày (UTC)</option>
            <option value="@BudgetPeriod.Total" selected="@(Model.BudgetPeriod == BudgetPeriod.Total)">Total — cộng dồn từ trước tới nay, không reset</option>
        </select>

        <label>Trần toàn hệ thống (USD)</label>
        <input name="BudgetSystemUsdLimit" type="number" min="0" step="0.01" inputmode="decimal"
               value="@Model.BudgetSystemUsdLimit" placeholder="0" />

        <label>Trần mỗi project (USD)</label>
        <input name="BudgetPerProjectUsdLimit" type="number" min="0" step="0.01" inputmode="decimal"
               value="@Model.BudgetPerProjectUsdLimit" placeholder="0" />
    </div>

    <div class="card settings-card">
        <h2>Hosting</h2>

        <label>Allowed Hosts</label>
        <input name="AllowedHosts" value="@Model.AllowedHosts" placeholder="*" />
    </div>

</form>
