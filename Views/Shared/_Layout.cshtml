@using ICOGenerator.Configuration
@inject AuthenticationSettings AuthSettings
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ICO Generator</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/command-bar.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        string NavActive(params string[] controllers) =>
            controllers.Any(c => string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

        string PageTitle = currentController switch
        {
            "Projects" => "Projects",
            "Agents" => "Agents",
            "Usage" => "Usage",
            "Quality" => "Delivery Quality",
            "Evals" => "Prompt Evals",
            "Prompts" => "Agents",
            "Models" => "AI Models",
            "Settings" => "Settings",
            "Feedback" => "Feedback",
            "Requirements" => "Requirements",
            "AgentDashboard" => "Agent Dashboard",
            "Roles" => "Roles & Permissions",
            "UserRoles" => "User Roles",
            "Audit" => "Audit Log",
            _ => "Home"
        };
        @* Người dùng có thể giữ nhiều vai trò ⇒ hiện tất cả, không chỉ vai trò đầu tiên. *@
        var currentRole = string.Join(" · ", User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value));
    }
    <div class="app-shell" id="appShell">

        <div class="supergraphic"></div>

        <div class="app-body">

            <aside class="sidebar">
                <div class="sidebar-head">
                    <span class="app-name">ICO Generator</span>
                    @* Icon menu trong sidebar dùng font bootstrap-icons (.nav-ico), riêng nút này giữ SVG
                       nội tuyến: nó CHỈ có biểu tượng, không nhãn chữ, nên CDN không tới được là mất luôn
                       lối thu gọn/mở sidebar — cùng lý do nút bút chì ở Views/Projects/Index.cshtml. *@
                    <button class="sb-toggle" id="sbToggle" title="Toggle menu" aria-label="Toggle menu" type="button">
                        <svg class="ico ico-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg>
                        <svg class="ico ico-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
                    </button>
                </div>

                @{
                    // Menu chỉ hiện màn hình mà role hiện tại được phép xem (quyền *View tương ứng).
                    var canProjects = await Permissions.HasPermissionAsync(User, AppPermission.ProjectsView);
                    var canAgents = await Permissions.HasPermissionAsync(User, AppPermission.AgentsView);
                    var canUsage = await Permissions.HasPermissionAsync(User, AppPermission.UsageView);
                    var canQuality = await Permissions.HasPermissionAsync(User, AppPermission.QualityView);
                    var canEvals = await Permissions.HasPermissionAsync(User, AppPermission.EvalView);
                    var canModels = await Permissions.HasPermissionAsync(User, AppPermission.ModelsView);
                    var canSettings = await Permissions.HasPermissionAsync(User, AppPermission.SettingsView);
                    var canFeedback = await Permissions.HasPermissionAsync(User, AppPermission.FeedbackView);
                    var canRoles = await Permissions.HasPermissionAsync(User, AppPermission.AdministrationManageRoles);
                    var canUserRoles = await Permissions.HasPermissionAsync(User, AppPermission.UserRolesView);
                    var canAudit = await Permissions.HasPermissionAsync(User, AppPermission.AuditView);
                }
                @{
                    // Đếm số màn con được phép trong mỗi nhóm để: (1) ẩn cả nhóm khi không có con nào,
                    // (2) tự "phẳng" nhóm khi chỉ còn đúng 1 con (không bắt user bấm mở thêm 1 lớp).
                    var insightsCount = (canUsage ? 1 : 0) + (canQuality ? 1 : 0) + (canEvals ? 1 : 0);
                    var insightsActive = NavActive("Usage", "Quality", "Evals") == "active";

                    var adminCount = (canSettings ? 1 : 0) + (canModels ? 1 : 0) + (canRoles ? 1 : 0)
                        + (canUserRoles ? 1 : 0) + (canAudit ? 1 : 0);
                    var adminActive = NavActive("Settings", "Models", "Roles", "UserRoles", "Audit") == "active";
                }
                <nav class="sidebar-nav">
                    @if (canProjects)
                    {
                        <a class="nav-item @NavActive("Projects", "Requirements", "AgentDashboard")" asp-controller="Projects" asp-action="Index" title="Projects">
                            <i class="bi bi-grid nav-ico" aria-hidden="true"></i>
                            <span class="nav-label">Projects</span>
                        </a>
                    }
                    @if (canAgents)
                    {
                        <a class="nav-item @NavActive("Agents", "Prompts")" asp-controller="Agents" asp-action="Index" title="Agents">
                            <i class="bi bi-person nav-ico" aria-hidden="true"></i>
                            <span class="nav-label">Agents</span>
                        </a>
                    }

                    @* Nhóm Insights: đo lường & giám sát (Usage, Quality, Evals). *@
                    @if (insightsCount > 0)
                    {
                        <div class="nav-group @(insightsActive ? "open" : "") @(insightsCount == 1 ? "nav-group--single" : "")" data-group="insights">
                            <button type="button" class="nav-item nav-group-head" title="Insights" aria-expanded="@(insightsActive ? "true" : "false")">
                                <i class="bi bi-bar-chart nav-ico" aria-hidden="true"></i>
                                <span class="nav-label">Insights</span>
                                <i class="bi bi-chevron-right nav-caret" aria-hidden="true"></i>
                            </button>
                            <div class="nav-group-body">
                                @if (canUsage)
                                {
                                    <a class="nav-item nav-sub @NavActive("Usage")" asp-controller="Usage" asp-action="Index" title="Usage">
                                        <i class="bi bi-graph-up nav-ico" aria-hidden="true"></i>
                                        <span class="nav-label">Usage</span>
                                    </a>
                                }
                                @if (canQuality)
                                {
                                    <a class="nav-item nav-sub @NavActive("Quality")" asp-controller="Quality" asp-action="Index" title="Delivery Quality">
                                        <i class="bi bi-activity nav-ico" aria-hidden="true"></i>
                                        <span class="nav-label">Quality</span>
                                    </a>
                                }
                                @if (canEvals)
                                {
                                    <a class="nav-item nav-sub @NavActive("Evals")" asp-controller="Evals" asp-action="Index" title="Prompt Evals">
                                        <i class="bi bi-check2-square nav-ico" aria-hidden="true"></i>
                                        <span class="nav-label">Evals</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    @if (canFeedback)
                    {
                        <a class="nav-item @NavActive("Feedback")" asp-controller="Feedback" asp-action="Index" title="Feedback">
                            <i class="bi bi-chat-dots nav-ico" aria-hidden="true"></i>
                            <span class="nav-label">Feedback</span>
                        </a>
                    }

                    @* Nhóm Administration: quản trị & cấu hình hệ thống (Settings, Models, Roles, User Roles, Audit Log). *@
                    @if (adminCount > 0)
                    {
                        <div class="nav-group @(adminActive ? "open" : "") @(adminCount == 1 ? "nav-group--single" : "")" data-group="administration">
                            <button type="button" class="nav-item nav-group-head" title="Administration" aria-expanded="@(adminActive ? "true" : "false")">
                                <i class="bi bi-shield-check nav-ico" aria-hidden="true"></i>
                                <span class="nav-label">Administration</span>
                                <i class="bi bi-chevron-right nav-caret" aria-hidden="true"></i>
                            </button>
                            <div class="nav-group-body">
                                @if (canSettings)
                                {
                                    <a class="nav-item nav-sub @NavActive("Settings")" asp-controller="Settings" asp-action="Index" title="Settings">
                                        <i class="bi bi-gear nav-ico" aria-hidden="true"></i>
                                        <span class="nav-label">Settings</span>
                                    </a>
                                }
                                @if (canModels)
                                {
                                    <a class="nav-item nav-sub @NavActive("Models")" asp-controller="Models" asp-action="Index" title="Models">
                                        <i class="bi bi-box nav-ico" aria-hidden="true"></i>
                                        <span class="nav-label">Models</span>
                                    </a>
                                }
                                @if (canRoles)
                                {
                                    <a class="nav-item nav-sub @NavActive("Roles")" asp-controller="Roles" asp-action="Index" title="Roles & Permissions">
                                        <i class="bi bi-person-check nav-ico" aria-hidden="true"></i>
                                        <span class="nav-label">Roles</span>
                                    </a>
                                }
                                @if (canUserRoles)
                                {
                                    <a class="nav-item nav-sub @NavActive("UserRoles")" asp-controller="UserRoles" asp-action="Index" title="User Roles">
                                        <i class="bi bi-person-plus nav-ico" aria-hidden="true"></i>
                                        <span class="nav-label">User Roles</span>
                                    </a>
                                }
                                @if (canAudit)
                                {
                                    <a class="nav-item nav-sub @NavActive("Audit")" asp-controller="Audit" asp-action="Index" title="Audit Log">
                                        <i class="bi bi-file-earmark-text nav-ico" aria-hidden="true"></i>
                                        <span class="nav-label">Audit Log</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </nav>

                <div class="sidebar-foot">
                    <div class="nav-item" id="navUser" title="User">
                        <i class="bi bi-person-circle nav-ico" aria-hidden="true"></i>
                        <span class="nav-label">@(User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "Account")</span>
                    </div>
                    <div class="nav-item" id="navImprint" title="Imprint">
                        <i class="bi bi-info-circle nav-ico" aria-hidden="true"></i>
                        <span class="nav-label">Imprint</span>
                    </div>
                </div>
            </aside>

            <div class="main-col">

                <header class="topbar">
                    <div class="breadcrumb">
                        @if (IsSectionDefined("Breadcrumb"))
                        {
                            @RenderSection("Breadcrumb", required: false)
                        }
                        else
                        {
                            <text>Home <span class="sep">&rsaquo;</span> @PageTitle</text>
                        }
                    </div>
                    <div class="topbar-spacer"></div>
                    <div class="notif" id="notifRoot">
                        <button class="notif-bell" id="notifBell" type="button" title="Thông báo" aria-label="Thông báo" aria-haspopup="true" aria-expanded="false">
                            <i class="bi bi-bell"></i>
                            <span class="notif-badge" id="notifBadge" hidden>0</span>
                        </button>
                        <div class="notif-panel" id="notifPanel" hidden>
                            <div class="notif-panel-head">
                                <span>Thông báo</span>
                                <button type="button" class="notif-markall" id="notifMarkAll">Đánh dấu đã đọc</button>
                            </div>
                            <div class="notif-list" id="notifList">
                                <div class="notif-empty">Đang tải…</div>
                            </div>
                            <div class="notif-foot-row">
                                <a class="notif-foot" asp-controller="Notifications" asp-action="Index">Xem tất cả</a>
                                <a class="notif-foot" asp-controller="Notifications" asp-action="Preferences" title="Tùy chọn thông báo"><i class="bi bi-gear"></i></a>
                            </div>
                        </div>
                    </div>
                    <div class="bosch-logo">BOSCH</div>
                </header>

                <main class="page">@RenderBody()</main>
            </div>
        </div>
    </div>

    <div class="modal-overlay shell-modal" id="userModal">
        <div class="shell-modal-card">
            <div class="shell-modal-head">
                <h3>Account</h3>
                <button class="shell-modal-close" data-close="userModal" aria-label="Close" type="button"><svg class="ico" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
            </div>
            <div class="shell-modal-body">
                <div class="shell-field">
                    <label>Default Language</label>
                    <select class="shell-select"><option>English</option><option>Tiếng Việt</option><option>Deutsch</option></select>
                </div>
                <p>Đang đăng nhập: <strong>@(User.Identity?.Name ?? "—")</strong>@(string.IsNullOrEmpty(currentRole) ? "" : $" · {currentRole}")</p>
                @* Local: tự đăng nhập bằng Admin nên Logout vô nghĩa (sẽ đăng nhập lại ngay) → chỉ hiện ở chế độ SSO. *@
                @if (AuthSettings.Provider == AuthProvider.IdentityServer)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn primary" type="submit">Logout</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="modal-overlay shell-modal" id="imprintModal">
        <div class="shell-modal-card lg">
            <div class="imprint-bar"></div>
            <div class="shell-modal-head">
                <div class="imprint-logo">BOSCH<small>Invented for life</small></div>
                <div style="flex:1"></div>
                <button class="shell-modal-close" data-close="imprintModal" aria-label="Close" type="button"><svg class="ico" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
            </div>
            <div class="shell-modal-body">
                <dl class="imprint-grid">
                    <dt>Purpose</dt>
                    <dd>AI-assisted generation of project requirements, design and delivery artifacts.</dd>
                    <dt>Security class of the IT System (cf. CD 02900)</dt>
                    <dd>C_SC1</dd>
                    <dt>Requirements towards the IT Owner of the consuming IT System</dt>
                    <dd>Login by SSO or Group account</dd>
                    <dt>Name</dt>
                    <dd>ICO Generator</dd>
                    <dt>Version</dt>
                    <dd>4.0</dd>
                    <dt>Designed and developed by</dt>
                    <dd>HcP/ICO</dd>
                </dl>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_Flash")

    @Html.AntiForgeryToken()
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dropdown.js" asp-append-version="true"></script>
    <script src="~/js/command-bar.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
