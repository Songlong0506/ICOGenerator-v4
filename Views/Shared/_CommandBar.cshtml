@using ICOGenerator.Application.Shared
@model CommandBarModel
@{
    // Command bar dùng chung (mẫu Bosch) — thanh lệnh cấp trang DUY NHẤT của app.
    //
    // Bố cục cố định, mọi màn hình như nhau:
    //   [ bộ lọc · tìm kiếm ] ⟵ co giãn ⟶ [ nút phụ ] [ NÚT CHÍNH ]
    //           .cbar-left                       .cbar-right
    //   [ chip lọc đang áp dụng ]                            .cbar-chips (chỉ khi có lọc)
    //
    // Vùng trái = thu hẹp dữ liệu đang xem. Vùng phải = hành động, nút chính luôn sát mép phải.
    // Nhờ hai vùng này, thứ tự nút không còn phụ thuộc thứ tự khai báo trong từng view — đó là
    // nguyên nhân cũ khiến mỗi màn hình một kiểu.
    //
    // KHÔNG có nút "Lọc" trên thanh: bộ lọc áp dụng ngay khi người dùng chốt lựa chọn (dropdown đơn
    // tự submit form GET; combo chọn nhiều submit khi đóng panel bằng nút "Áp dụng" nằm trong panel).
    // Nút commit rời trên thanh tạo ra trạng thái "đã chọn nhưng chưa áp dụng" — dropdown hiện một
    // đằng, bảng dữ liệu hiện một nẻo. Chi tiết ở CommandBarModel.
    //
    // Tìm kiếm/sắp xếp chạy client-side qua command-bar.js trên Model.TargetSelector.

    // SVG nội tuyến để ô tìm kiếm vẫn có kính lúp kể cả khi font icon (CDN) không tải được.
    var searchSvg = "<svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"7\" cy=\"7\" r=\"4.5\"/><line x1=\"10.5\" y1=\"10.5\" x2=\"14.5\" y2=\"14.5\"/></svg>";

    // Nội dung trong nút: icon (nếu có) + nhãn + badge (nếu có). Nhãn luôn bọc <span> để CSS thu
    // gọn còn mỗi icon trên màn hẹp mà không cần biết nút thuộc loại nào.
    void RenderButtonInner(CommandBarButton b)
    {
        <text>
        @if (b.Icon != null)
        {
            <i class="bi @b.Icon" aria-hidden="true"></i>
        }
        <span class="cbar-label">@b.Label</span>
        @if (b.Badge != null)
        {
            <span class="cbar-badge" title="@b.BadgeTitle">@b.Badge</span>
        }
        </text>
    }

    // Một nút của thanh. `cls` quyết định kiểu dáng theo VỊ TRÍ (cbar-btn = phụ, cbar-primary =
    // chính), không theo ý riêng của từng màn hình.
    void RenderButton(CommandBarButton b, string cls)
    {
        <text>
        @if (b.Href != null)
        {
            <a class="@cls" id="@b.Id" href="@b.Href" title="@(b.Title ?? b.Label)" aria-label="@b.Label">
                @{ RenderButtonInner(b); }
            </a>
        }
        else
        {
            <button type="button" class="@cls" id="@b.Id" title="@(b.Title ?? b.Label)"
                    disabled="@b.Disabled" onclick="@b.OnClick" aria-label="@b.Label"
                    aria-haspopup="@(b.OpensDialog ? "dialog" : null)"
                    aria-expanded="@(b.OpensDialog ? "false" : null)">
                @{ RenderButtonInner(b); }
            </button>
        }
        </text>
    }

    void RenderZones()
    {
        <text>
        <div class="cbar-left">
            @if (Model.Filters != null)
            {
                @Model.Filters(null!)
            }

            @if (Model.HasSearch)
            {
                <label class="cbar-search">
                    <span class="cbar-search-icon" aria-hidden="true">@Html.Raw(searchSvg)</span>
                    <input type="search" data-cbar-search placeholder="@Model.SearchPlaceholder" autocomplete="off" aria-label="@Model.SearchPlaceholder" />
                </label>
            }

            @* Bộ lọc server-side giấu trong panel (nếu màn hình dùng kiểu này) — nút chỉ bật/tắt
               panel, không phải nút áp dụng: panel tự submit như mọi bộ lọc khác. *@
            @if (Model.FilterPanelId != null)
            {
                <button type="button" class="cbar-btn @(Model.FilterPanelOpen ? "open" : "")" data-cbar-filter-toggle="#@Model.FilterPanelId" aria-expanded="@(Model.FilterPanelOpen ? "true" : "false")">
                    <i class="bi bi-funnel" aria-hidden="true"></i>
                    <span class="cbar-label">Lọc</span>
                    @if (Model.FilterActive)
                    {
                        <span class="cbar-dot" aria-hidden="true"></span>
                    }
                </button>
            }
        </div>

        <div class="cbar-right">
            @foreach (var action in Model.Actions)
            {
                RenderButton(action, "cbar-btn cbar-btn-outline");
            }
            @if (Model.Primary != null)
            {
                RenderButton(Model.Primary, "cbar-primary");
            }
        </div>

        @* Hàng chip: bộ lọc ĐANG áp dụng, mỗi chip gỡ được riêng một giá trị. Đây là thứ duy nhất
           trên thanh nói cho người dùng biết họ đang xem tập dữ liệu nào — lựa chọn nằm trong panel
           đã đóng thì nhìn dropdown không đủ. Chip là thẻ <a> nên nằm trong <form> vẫn không submit. *@
        @if (Model.HasFilterChips)
        {
            <div class="cbar-chips">
                <span class="cbar-chips-label">Đang lọc:</span>
                @foreach (var chip in Model.FilterChips)
                {
                    <span class="cbar-chip">
                        <span class="cbar-chip-caption">@chip.Caption:</span>
                        <span class="cbar-chip-value">@chip.Value</span>
                        <a class="cbar-chip-remove" href="@chip.RemoveUrl" aria-label="Bỏ lọc @chip.Caption: @chip.Value" title="Bỏ lọc @chip.Value">
                            <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="4" x2="12" y2="12"/><line x1="12" y1="4" x2="4" y2="12"/></svg>
                        </a>
                    </span>
                }
                @if (Model.ShowClearAll)
                {
                    <a class="cbar-chips-clear" href="@Model.ClearFilterUrl">Xóa tất cả</a>
                }
            </div>
        }
        </text>
    }
}

@if (Model.IsForm)
{
    <form method="get" action="@Model.FormUrl" class="command-bar" data-cbar data-cbar-target="@Model.TargetSelector">
        @{ RenderZones(); }
    </form>
}
else
{
    <div class="command-bar" data-cbar data-cbar-target="@Model.TargetSelector">
        @{ RenderZones(); }
    </div>
}
