    <title>An error occurred - Ideapp</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main style="max-width:640px;margin:80px auto;padding:0 24px;font-family:system-ui,-apple-system,sans-serif;color:#1f2937;">
