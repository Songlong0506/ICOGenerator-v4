@using ICOGenerator.Application.Roles
@model RolePermissionMatrixVm?
@{
    ViewData["Title"] = "User Roles";
    // Vào được trang khi có UserRolesView HOẶC AdministrationManageRoles (xem UserRolesController).
    // Bảng role IS4 + popup người dùng chỉ hiện khi có UserRolesView (gán/thu hồi thêm UserRolesManage);
    // nút Permissions chỉ hiện khi controller nạp ma trận.
    var canView = await Permissions.HasPermissionAsync(User, AppPermission.UserRolesView);
    var canManage = canView && await Permissions.HasPermissionAsync(User, AppPermission.UserRolesManage);
    var matrix = Model;
}

@section Styles {
    <link rel="stylesheet" href="~/css/user-roles.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <h1>User Roles</h1>
    </div>
</div>

@* Command bar chuẩn: ô tìm kiếm lọc bảng role phía client (command-bar.js), nút chính "Permissions"
   mở popup ma trận Roles & Permissions (trước kia là màn hình riêng /Roles). *@
@{
    var userRolesBar = new CommandBarModel
    {
        TargetSelector = canView ? "#urRolesTable" : null,
        Primary = matrix != null
            ? new CommandBarButton
            {
                Label = "Permissions", Icon = "bi-file-earmark-person", Id = "urPermissionsOpen",
                OnClick = "openModal('permissionsModal')", OpensDialog = true,
                Title = "Cấu hình Roles & Permissions"
            }
            : null
    };
}
@await Html.PartialAsync("_CommandBar", userRolesBar)

@if (!canView)
{
    <div class="alert info">Bạn không có quyền xem người dùng theo role trên IdentityServer — chỉ cấu hình được <b>Permissions</b>.</div>
}
else
{
@* Bảng role lấy từ IS4 (RolesByAPIName) do user-roles.js nạp khi vào trang. Bấm vào một hàng (hoặc
   icon ở cột Action) ⇒ popup người dùng của role đó (IdentityServerUser), nơi gán / thu hồi. *@
<div class="card table-card">
    <table id="urRolesTable" class="data-table ur-roles-table">
        <thead>
            <tr>
                <th>Role name</th>
                <th class="ur-action-col">Action</th>
            </tr>
        </thead>
        <tbody id="urRoleRows">
            <tr data-cbar-skip><td colspan="2" class="ur-empty">Đang tải danh sách role…</td></tr>
        </tbody>
    </table>
</div>

<div id="roleUsersModal" class="modal-backdrop hidden" data-can-manage="@canManage.ToString().ToLowerInvariant()">
    <div class="modal ur-users-modal" role="dialog" aria-modal="true" aria-labelledby="urUsersTitle">
        <button type="button" class="x" onclick="closeModal('roleUsersModal')" aria-label="Đóng">×</button>

        <h2 id="urUsersTitle">Users</h2>
        <p class="modal-sub">Role <b id="urUsersRoleName"></b> · <span id="urUsersCount">0</span> người dùng</p>

        @if (canManage)
        {
            <div class="ur-assign-row">
                <div class="ur-autocomplete">
                    <label for="urUserSearch">Thêm người dùng</label>
                    <input id="urUserSearch" type="text" autocomplete="off"
                           placeholder="Gõ tên hoặc NTID để tìm..." aria-expanded="false" />
                    <input type="hidden" id="urSelectedUser" />
                    <div id="urSuggest" class="ur-suggest hidden" role="listbox"></div>
                </div>
                <button type="button" class="btn primary" id="urAssignBtn">
                    <i class="bi bi-person-plus" aria-hidden="true"></i> Assign
                </button>
            </div>
        }

        <div class="ur-users-body">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Người dùng</th>
                        <th>Email</th>
                        <th>Phòng ban</th>
                        @if (canManage)
                        {
                            <th class="ur-action-col">Action</th>
                        }
                    </tr>
                </thead>
                <tbody id="urUserRows"></tbody>
            </table>
        </div>
    </div>
</div>
}

@if (matrix != null)
{
    @await Html.PartialAsync("_PermissionsModal", matrix)
}

@section Scripts {
    <script src="~/js/user-roles.js" asp-append-version="true"></script>
}
