@using ICOGenerator.Application.Notifications
@model NotificationPreferencesVm

<div class="page-head">
    <div>
        <h1>Notification preferences</h1>
        <p>Choose how you want to be notified about workflow events (gates awaiting approval, completed, failed).</p>
    </div>
    <a class="btn" asp-controller="Notifications" asp-action="Index">← Back to notifications</a>
</div>

<form asp-controller="Notifications" asp-action="Preferences" method="post" class="pref-form">
    <div class="card pref-card">
        <h2 class="pref-h">Channels</h2>

        <label class="choice pref-choice">
            <input type="checkbox" asp-for="NotifyInApp" />
            <span>
                <b>In-app bell</b>
                <small>Shown on the bell icon in the top bar and in the notifications inbox.</small>
            </span>
        </label>

        <label class="choice pref-choice">
            <input type="checkbox" asp-for="NotifyByEmail" />
            <span>
                <b>Personal email</b>
                <small>Sent to your email address below.</small>
            </span>
        </label>

        <div class="pref-email">
            <label asp-for="Email">Email address</label>
            <input asp-for="Email" type="email" placeholder="ban@bosch.com" autocomplete="email" />
            @if (!Model.EmailChannelConfigured)
            {
                <small class="pref-hint">The system email channel is not enabled — this option takes effect once an admin configures SMTP.</small>
            }
        </div>
    </div>

    <div class="card pref-card">
        <h2 class="pref-h">Event types</h2>
        <p class="pref-sub">Applies to both the bell and your personal email.</p>

        <label class="choice pref-choice">
            <input type="checkbox" asp-for="NotifyOnGate" />
            <span><b>Gate awaiting approval</b><small>A step has finished and is waiting for approval to continue.</small></span>
        </label>
        <label class="choice pref-choice">
            <input type="checkbox" asp-for="NotifyOnCompleted" />
            <span><b>Workflow completed</b><small>The delivery pipeline has finished.</small></span>
        </label>
        <label class="choice pref-choice">
            <input type="checkbox" asp-for="NotifyOnFailed" />
            <span><b>Workflow failed</b><small>The pipeline stopped with an error and needs attention.</small></span>
        </label>
    </div>

    <button type="submit" class="btn primary">Save preferences</button>
</form>
