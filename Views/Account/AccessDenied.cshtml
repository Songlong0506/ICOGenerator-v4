@{
    ViewData["Title"] = "Access denied";
}
<div class="page-head">
    <h1>Access denied</h1>
</div>
<div class="card" style="max-width:560px;padding:24px;">
    <p>Your account (<strong>@(User.Identity?.Name ?? "—")</strong>) does not have permission to view this screen or perform this action.</p>
    <p style="color:#64748b;">If you need access, ask an administrator to grant it on the <em>Roles &amp; Permissions</em> screen.</p>
    <a class="btn primary" asp-controller="Projects" asp-action="Index">Back to Projects</a>
</div>
