@model ICOGenerator.Application.Projects.ProjectListPage

@section Styles {
    <link rel="stylesheet" href="~/css/projects.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <h1>Projects</h1>
    </div>
</div>
@{
    var selectedOrgUnits = Model.SelectedOrgUnitCodesOrEmpty;
    var hasFilter = selectedOrgUnits.Count > 0;

    // Link phân trang phải giữ nguyên bộ lọc. Org Unit giờ chọn nhiều (mảng) nên asp-route-* không dựng
    // được — tự ghép query string với đủ các tham số orgUnit lặp lại.
    string BuildUrl(int targetPage, int targetPageSize)
    {
        var qs = new List<string>
        {
            $"page={targetPage}",
            $"pageSize={targetPageSize}"
        };
        foreach (var code in selectedOrgUnits)
            qs.Add($"orgUnit={Uri.EscapeDataString(code)}");
        return $"{Url.Action("Index")}?{string.Join("&", qs)}";
    }

    string PageUrl(int targetPage) => BuildUrl(targetPage, Model.PageSize);
}
@* Command bar chuẩn (Shared/_CommandBar): bộ lọc Org Unit + "Lọc"/"Xóa lọc" ở vùng trái,
   "New Project" là hành động chính ở vùng phải. Form GET nên bộ lọc nằm trong URL —
   chia sẻ được và giữ nguyên khi phân trang. *@
@{
    var projectsBar = new CommandBarModel
    {
        FormUrl = Url.Action("Index"),
        ShowApplyFilter = true,
        ClearFilterUrl = hasFilter ? Url.Action("Index") : null,
        Filters = @<div class="cbar-field">
            @* Combo chọn NHIỀU đơn vị: mỗi lựa chọn là một checkbox name="orgUnit" nằm sẵn trong form GET,
               nên khi bấm "Lọc" toàn bộ mã đã tick được gửi lên (mảng). Không tự submit theo từng tick để
               người dùng chọn xong nhiều đơn vị rồi mới lọc. UI (nút, panel, tìm kiếm, chọn tất cả) do JS lái.
               Nhãn "Org Unit" hiển thị bên trong nút bấm để đồng bộ với các dropdown khác trong app. *@
            <div class="ms-combo ms-combo--has-caption" data-ms-combo>
                <button type="button" class="ms-combo-trigger" data-ms-trigger aria-haspopup="listbox" aria-expanded="false">
                    <span class="ms-combo-trigger-main">
                        <span class="ms-combo-caption">Org Unit</span>
                        <span class="ms-combo-text" data-ms-label data-ms-placeholder="Tất cả đơn vị"></span>
                    </span>
                    <span class="ms-combo-caret" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l4 4 4-4"/></svg></span>
                </button>
                <div class="ms-combo-panel hidden" data-ms-panel>
                    <div class="ms-combo-search">
                        <div class="ms-combo-search-box">
                            <input type="text" placeholder="Tìm đơn vị…" autocomplete="off" data-ms-search />
                            <button type="button" class="ms-combo-search-clear hidden" data-ms-clear aria-label="Xóa tìm kiếm"><svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="4" x2="12" y2="12"/><line x1="12" y1="4" x2="4" y2="12"/></svg></button>
                            <span class="ms-combo-search-icon" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="4.5"/><line x1="10.5" y1="10.5" x2="14.5" y2="14.5"/></svg></span>
                        </div>
                    </div>
                    <label class="ms-combo-checkbox ms-combo-all ms-combo-all-row" title="Chọn tất cả">
                        <input type="checkbox" data-ms-all />
                        <span class="ms-combo-box" aria-hidden="true"></span>
                        <span class="ms-combo-all-text" data-ms-all-text>Chọn tất cả</span>
                    </label>
                    <ul class="ms-combo-list" role="listbox" aria-multiselectable="true" data-ms-list>
                        @foreach (var o in Model.OrgUnitOptions)
                        {
                            var isSelected = selectedOrgUnits.Contains(o.Code, StringComparer.OrdinalIgnoreCase);
                            <li class="ms-combo-option @(isSelected ? "selected" : "")" role="option" aria-selected="@(isSelected ? "true" : "false")" data-search="@o.Name.ToLowerInvariant()">
                                <label class="ms-combo-checkbox">
                                    <input type="checkbox" name="orgUnit" value="@o.Code" @(isSelected ? "checked" : "") data-ms-option />
                                    <span class="ms-combo-box" aria-hidden="true"></span>
                                    <span class="ms-combo-option-text">@o.Name</span>
                                </label>
                            </li>
                        }
                    </ul>
                    <div class="ms-combo-empty hidden" data-ms-empty>Không tìm thấy đơn vị</div>
                </div>
            </div>
        </div>,
        Primary = new CommandBarButton { Label = "Add", Icon = "bi-plus-lg", OnClick = "openModal('newProject')" }
    };
}
@await Html.PartialAsync("_CommandBar", projectsBar)
@{
    // Quyền sửa dự án tra MỘT LẦN cho cả trang (dùng ở từng dòng và ở modal bên dưới) thay vì mỗi dòng
    // một lượt gọi. Cấp quyền ở màn hình Roles & Permissions; ngoài ra ProjectsController.Update còn qua
    // IProjectAccessGuard nên User thường chỉ sửa được project của chính mình.
    var canEditProject = await Permissions.HasPermissionAsync(User, AppPermission.ProjectsEdit);
}
<div class="card table-card">
    <table>
        <thead><tr><th>Project Name</th><th>Description</th><th>Created By</th><th>Org Unit</th><th>Created At</th><th>Actions</th></tr></thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="6" style="text-align:center; color:var(--muted); padding:24px;">
                        @(hasFilter ? "Không có dự án nào khớp với bộ lọc." : "Chưa có dự án nào.")
                    </td>
                </tr>
            }
            @foreach (var item in Model.Items)
            {
                var p = item.Project;
                <tr>
                    <td>
                        <div class="project-name-cell">
                            <b>@p.Name</b>
                        </div>
                    </td>
                    @* Mô tả có thể dài (tới 2000 ký tự) — kẹp còn 2 dòng để chiều cao các dòng bảng đều
                       nhau, xem đầy đủ qua tooltip hoặc modal Chỉnh sửa. *@
                    <td><span class="project-desc" title="@p.Description">@p.Description</span></td>
                    <td>@(string.IsNullOrWhiteSpace(item.CreatedByDisplayName) ? "—" : item.CreatedByDisplayName)</td>
                    @* Tên đơn vị tra từ OrgUnits; mã không còn trong dữ liệu HR thì hiển thị mã thô. *@
                    <td>@(item.OrgUnitName ?? (string.IsNullOrWhiteSpace(p.OrgUnitCode) ? "—" : p.OrgUnitCode))</td>
                    <td>@p.CreatedAt.ToString("MMM dd, yyyy")</td>
                    <td>
                        @* Phân quyền hiển thị từng nút theo ma trận Roles & Permissions (assign được ở màn hình
                           Roles), không hardcode vai trò:
                           - Requirements: quyền ProjectsOpenRequirements.
                           - Agent Dashboard: quyền ProjectsOpenAgentDashboard.
                           - Mockup: quyền ProjectsOpenMockup (và vẫn cần dự án có mockup như trước). *@
                        @{
                            var canOpenRequirements = await Permissions.HasPermissionAsync(User, AppPermission.ProjectsOpenRequirements);
                            var canOpenAgentDashboard = await Permissions.HasPermissionAsync(User, AppPermission.ProjectsOpenAgentDashboard);
                            var canOpenMockup = await Permissions.HasPermissionAsync(User, AppPermission.ProjectsOpenMockup);
                        }
                        <div class="actions">
                            @if (canOpenRequirements)
                            {
                                <a class="btn outline"
                                   asp-controller="Requirements"
                                   asp-action="Index"
                                   asp-route-projectId="@p.Id">
                                    Requirements
                                </a>
                            }

                            @if (canOpenAgentDashboard)
                            {
                                <a class="btn"
                                   asp-controller="AgentDashboard"
                                   asp-action="Index"
                                   asp-route-projectId="@p.Id">
                                    Agent Dashboard
                                </a>
                            }

                            @if (canOpenMockup && item.HasMockup)
                            {
                                <a class="btn outline"
                                   asp-controller="Projects"
                                   asp-action="PocReview"
                                   asp-route-projectId="@p.Id"
                                   title="Xem POC và ghim ghi chú trực tiếp lên phần tử cần sửa">
                                    Mockup
                                </a>
                            }

                            @* Sửa thông tin dự án: nút biểu tượng (không phải nút chữ) và tách khỏi nhóm
                               nút điều hướng bằng một vạch mờ — các nút chữ là "đi tới màn hình khác",
                               còn đây là thao tác trên chính dòng này, giống trang AI Models. Dữ liệu dòng
                               đi qua data-* (Razor tự HTML-encode) rồi JS đọc từ dataset — an toàn hơn
                               việc nhồi giá trị vào tham số onclick. *@
                            @if (canEditProject)
                            {
                            <span class="actions-tools">
                                <span class="actions-sep" aria-hidden="true"></span>
                                <button type="button"
                                        class="icon-btn"
                                        title="Chỉnh sửa dự án"
                                        aria-label="Chỉnh sửa dự án @p.Name"
                                        data-edit-project
                                        data-project-id="@p.Id"
                                        data-project-name="@p.Name"
                                        data-project-description="@p.Description"
                                        data-project-orgunit="@p.OrgUnitCode"
                                        data-project-running="@(item.HasRunningWorkflow ? "true" : "false")">
                                    @* SVG nội tuyến (không dùng font bootstrap-icons từ CDN): đây là nút
                                       CHỈ có biểu tượng, nên CDN không tới được là nút biến thành ô trống
                                       không ai thấy — cùng lý do dropdown.js vẽ caret/search bằng SVG. *@
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                </button>
                            </span>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pager", new ICOGenerator.Application.Shared.PagerModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        PageUrl = PageUrl,
        PageSizeUrl = size => BuildUrl(1, size)
    })
</div>
<div id="newProject" class="modal-backdrop hidden">
    <form class="modal" asp-action="Create" method="post">
        <button type="button" class="x" onclick="closeModal('newProject')">×</button><h2>New Project</h2>
        <label>Name *</label><input name="Name" placeholder="e.g E-commerce Web App" required />
        <label>Description</label><input name="Description" placeholder="Short description" />
        @if (Model.OrgUnitOptions.Count > 0)
        {
            @* Đơn vị yêu cầu (tùy chọn): giúp BA hiểu bối cảnh phòng ban ngay từ đầu, tài liệu ghi đúng
               đơn vị chủ quản và trang Usage thống kê được theo phòng ban. Dùng <select> gốc để
               dropdown.js tự nâng cấp thành combo chuẩn (.ms-combo--single) — đồng bộ với mọi dropdown
               khác trong app, kèm ô tìm kiếm khi danh sách dài. *@
            <label>Org Unit</label>
            <select name="OrgUnitCode">
                <option value="">— Chưa chọn —</option>
                @foreach (var o in Model.OrgUnitOptions)
                {
                    <option value="@o.Code">@o.Name</option>
                }
            </select>
        }
        <div class="modal-actions"><button type="button" class="btn" onclick="closeModal('newProject')">Cancel</button><button class="btn primary">Create Project</button></div>
    </form>
</div>

@* Modal "Chỉnh sửa dự án" — MỘT modal dùng chung cho mọi dòng (JS đổ dữ liệu dòng được bấm vào), thay vì
   render một modal cho mỗi project. Sửa ngay tại danh sách nên người dùng không mất ngữ cảnh (không rời
   trang, không mất bộ lọc), và các field xếp đúng thứ tự như modal New Project để cảm giác "cùng một form".
   Chỉ render khi có quyền sửa. *@
@if (canEditProject)
{
    <div id="editProject" class="modal-backdrop hidden">
        <form class="modal" asp-action="Update" method="post"
              role="dialog" aria-modal="true" aria-labelledby="edit-project-title" data-edit-project-form>
            <button type="button" class="x" onclick="closeModal('editProject')" aria-label="Đóng">×</button>
            <h2 id="edit-project-title">Chỉnh sửa dự án</h2>
            <p class="modal-sub" data-edit-subtitle></p>

            <input type="hidden" name="ProjectId" data-edit-id />
            @* Giữ nguyên trang + bộ lọc đang xem để sau khi lưu người dùng quay lại đúng chỗ cũ. *@
            <input type="hidden" name="page" value="@Model.Page" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            @foreach (var code in selectedOrgUnits)
            {
                <input type="hidden" name="orgUnit" value="@code" />
            }

            <label for="edit-project-name">Name *</label>
            <input id="edit-project-name" name="Name" maxlength="200" required autocomplete="off" data-edit-name />

            @* Hai ghi chú dưới đây chỉ hiện khi ĐÚNG hoàn cảnh, để modal ở trạng thái thường không bị
               nhiễu chữ: cảnh báo đổi tên (khi tên vừa bị sửa) và lý do không cho đổi tên (khi workflow
               đang chạy — lúc đó ô Name ở chế độ chỉ đọc). *@
            @* role="status" để trình đọc màn hình đọc cảnh báo NGAY khi nó xuất hiện (nó bật lên trong lúc
               người dùng đang gõ ở ô Name, không phải lúc mở modal). *@
            <p class="modal-note warning hidden" role="status" data-edit-rename-note>
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                Tên dự án cũng là tên thư mục làm việc của agent: khi lưu, thư mục sẽ được đổi tên theo —
                tài liệu và POC đã sinh vẫn giữ nguyên.
            </p>
            <p class="modal-note info hidden" data-edit-locked-note>
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                Dự án đang chạy workflow nên chưa đổi được tên (agent đang ghi vào thư mục làm việc hiện
                tại). Mô tả và đơn vị yêu cầu vẫn sửa được.
            </p>

            <label for="edit-project-description">Description</label>
            <textarea id="edit-project-description" name="Description" rows="3" maxlength="2000"
                      placeholder="Short description" data-edit-description></textarea>

            @if (Model.OrgUnitOptions.Count > 0)
            {
                <label for="edit-project-orgunit">Org Unit</label>
                <select id="edit-project-orgunit" name="OrgUnitCode" data-edit-orgunit>
                    <option value="">— Chưa chọn —</option>
                    @foreach (var o in Model.OrgUnitOptions)
                    {
                        <option value="@o.Code">@o.Name</option>
                    }
                </select>
            }

            @* Nút Lưu chỉ bật khi CÓ thay đổi: bấm lưu một form y nguyên chỉ tạo thêm một dòng audit log
               vô nghĩa, và trạng thái nút cho người dùng biết ngay là mình đã sửa gì chưa. *@
            <div class="modal-actions">
                <button type="button" class="btn" onclick="closeModal('editProject')">Cancel</button>
                <button class="btn primary" data-edit-save disabled>Lưu thay đổi</button>
            </div>
        </form>
    </div>
}

@section Scripts {
    <script src="~/js/projects.js" asp-append-version="true"></script>
}
