@model ICOGenerator.Application.Projects.PocReviewPage
@using ICOGenerator.Application.Projects
@functions {
    // Nhãn thuần trình bày cho bảng lịch sử. Để ở view vì chúng chỉ là chữ hiển thị — query trả về
    // enum/khoá, không trả chuỗi tiếng Việt (chuỗi trong dữ liệu là thứ sau này không đổi được).
    private static string KindLabel(PocNoteHistoryKind kind) => kind switch
    {
        PocNoteHistoryKind.BriefNote => "Ghi chú Brief",
        PocNoteHistoryKind.Revision => "Vòng Dev sửa",
        _ => "Ghi chú POC"
    };

    private static string KindClass(PocNoteHistoryKind kind) => kind switch
    {
        PocNoteHistoryKind.BriefNote => "routed",
        PocNoteHistoryKind.Revision => "done",
        _ => "open"
    };

    // Đường xử lý của dòng: đã gửi đi đâu, hoặc còn chờ. Dòng đã thu hồi trong bảng này chỉ có thể là dòng
    // TỪNG được gửi đi rồi mở lại ("vẫn chưa đạt") — ghi chú chưa gửi mà thu hồi thì bị xoá thật, không để
    // lại dòng nào. Nhãn cũ "không gửi" nói ngược hẳn chuyện đó; còn đọc `Route` thì ra "chưa gửi" vì mở
    // lại đã xoá đường cũ.
    private static string RouteLabel(PocNoteHistoryRow row)
    {
        if (row.Withdrawn) return "đã gửi → thu hồi";
        if (row.Status == "Deferred") return "→ Dev chỉnh demo (chờ bản demo mới)";
        return row.Route switch
        {
            "FixPoc" => "→ Dev chỉnh demo",
            "Requirement" => "→ BA sửa tài liệu",
            _ => "chưa gửi"
        };
    }
}
@{
    ViewData["Title"] = "POC Review";
    var canManage = ViewBag.CanManageComments is bool cm && cm;
    // Quyền cho HAI nút đóng vòng ở cuối panel ghi chú (chỉnh bản demo / gửi về Requirement) — cả hai
    // endpoint đều đòi RequirementsManage, nên UI phải soi đúng quyền đó chứ không phải DeliveryAdvance.
    var canManageRequirements = ViewBag.CanManageRequirements is bool cmr && cmr;
    // "Thử model khác" — thí nghiệm của Admin (quyền PocModelExperiment), xem PocVariantsController.
    var canExperimentModels = ViewBag.CanExperimentModels is bool cem && cem;
}

@* Trang review POC: nhúng POC (sandbox, origin opaque — xem ProjectsController.Mockup) trong iframe ở
   chế độ review (annotator được tiêm lúc phục vụ), kèm panel ghi chú bên phải. Người xem bật "chế độ
   ghim", click phần tử trong POC để ghi chú; các ghi chú Open được người duyệt gom vào "Yêu cầu chỉnh
   sửa" ở cổng POC trên Agent Dashboard. Trang cha (đây) giữ toàn bộ thao tác ghi/xóa — iframe chỉ nói
   chuyện qua postMessage nên rào chắn sandbox giữ nguyên. *@

@* Không có badge chặng dự án ở đây. Nó trả lời một câu hỏi mà trang này đã trả lời kỹ hơn ngay tại
   chỗ người dùng vấp phải: khối "✓ Đã nghiệm thu" trong thẻ ghi chú nói rõ ai chốt, lúc nào và điều gì
   đang khoá — còn badge chỉ nói tên chặng. Hai chỗ nói cùng một trạng thái thì chỗ mờ hơn là nhiễu. *@
<div class="page-head">
    <div>
        <h1>POC Review</h1>
    </div>
</div>

@* CHI TIẾT KỸ THUẬT: trang này phục vụ người dùng nghiệp vụ đi nghiệm thu bản demo, nên cột phải chỉ
   được chứa thứ họ đối chiếu được bằng mắt với POC. Kết quả vòng tự kiểm (tỉ lệ PASS, headless runtime,
   visual QA) và cách BA diễn đạt lại yêu cầu cho máy (business rule + nhãn có/chưa kịch bản kiểm) là
   ngôn ngữ của đội delivery: với người dùng chúng vừa chiếm chỗ vừa gây hoang mang ("3/5 PASS" thì họ
   phải làm gì?). Gom vào một hộp thoại hai tab, mở từ command bar, chỉ hiện với DeliveryAdvance —
   ĐÚNG quyền đang gate quyền xóa ghi chú của người khác, tức phía delivery/dev, khác hẳn
   RequirementsManage vốn thuộc về chính người dùng nghiệp vụ.
   Cái Ở LẠI cột phải là HƯỚNG DẪN SỬ DỤNG: các việc người dùng làm được trên bản demo, đi từng bước —
   đúng buổi BA ngồi cạnh và demo cho người dùng. Đó là thứ biến buổi review từ "mò lỗi tự do" thành
   "làm theo rồi xem có đúng ý mình không". Cũng vì thế nó không vào modal được — modal che kín iframe
   nên không soi song song với bản demo. *@
@{
    var cov = Model.Coverage;
    var hasSpecDetails = cov.Screens.Any() || cov.Rules.Any();
    // Nút chỉ có nghĩa khi thật sự có gì để xem: POC dựng trước các tính năng này không có dữ liệu nào.
    var showTechButton = canManage && (Model.Verification is not null || hasSpecDetails);

    // ---- Nhóm hướng dẫn theo MÀN HÌNH ----
    // Người dùng học một ứng dụng theo chỗ họ đứng ("ở màn hình này tôi làm được gì"), nên hướng dẫn gom
    // theo UatScenario.Screen, giữ thứ tự xuất hiện đầu tiên — prompt đã xếp kịch bản theo trình tự một
    // buổi demo, nên thứ tự nhóm cũng là thứ tự demo. Kịch bản không ghi màn hình rơi vào nhóm không tên.
    //
    // CHỈ SỐ GỐC i đi theo kịch bản tới nhóm của nó: data-key của checkbox là "@i-@j" và mã neo chỉ chỗ là
    // UatAnchor.Token(i, j) — cả hai phải khớp với chỉ số trong uat-scenarios.json (localStorage đã lưu
    // tick theo khoá đó, và agent dựng POC đã gắn data-uat theo đúng mã đó).
    var scenarios = Model.Scenarios.Scenarios;
    var guideGroups = Enumerable.Range(0, scenarios.Count)
        .GroupBy(i => (scenarios[i].Screen ?? "").Trim(), StringComparer.OrdinalIgnoreCase)
        .Select(g => (Screen: g.Key, Indexes: g.ToList()))
        .ToList();
    // Một nhóm duy nhất thì tiêu đề nhóm chỉ nhắc lại điều hiển nhiên — bỏ đi cho gọn.
    var showGroupHeads = guideGroups.Count > 1;

    // Một thẻ hướng dẫn (tiến độ + các bước tick được + "Làm theo" + nút báo lỗi). Dựng bằng templated
    // delegate cho gọn vòng lặp nhóm. `item.Index` LUÔN là chỉ số gốc trong Model.Scenarios.Scenarios.
    //
    // GẬP ĐƯỢC (<details>): một POC thật có 8 kịch bản × 5-7 bước, mở hết là hơn năm mươi dòng trong một
    // cột hẹp — người xem phải cuộn qua cả những việc đã làm xong mới tới việc đang làm dở. Đóng lại thì
    // mỗi thẻ còn ĐÚNG MỘT DÒNG mang đủ thứ để quyết định có mở hay không: tên việc, tiến độ "3/7 bước",
    // và số ghi chú đã ghim trong đó (ghi chú nằm trong thân thẻ nên thẻ đóng là giấu chúng đi — cái badge
    // là thứ duy nhất báo còn gì bên trong).
    // data-index = chỉ số gốc: JS dùng nó làm khóa nhớ trạng thái đóng/mở trong localStorage.
    Func<(ICOGenerator.Contracts.Requirements.UatScenario Scenario, int Index), object> scenarioCard =
    @<details class="uat-scenario" data-index="@item.Index" data-screen="@item.Scenario.Screen" data-title="@item.Scenario.Title">
        <summary class="uat-title" title="@item.Scenario.Title">
            <span class="uat-title-text">@item.Scenario.Title</span>
            @* Hai tín hiệu JS đổ vào, đều chỉ có nghĩa khi thẻ ĐANG ĐÓNG (lúc mở thì nội dung tự nói):
               tiến độ tick của riêng việc này, và số ghi chú đang nằm trong thân thẻ. *@
            <span class="uat-scenario-meta">
                <span class="uat-note-count" hidden></span>
                <span class="uat-step-count"></span>
            </span>
        </summary>
        <ol class="uat-steps">
            @for (var j = 0; j < item.Scenario.Steps.Count; j++)
            {
                <li>
                    <label>
                        <input type="checkbox" class="uat-step" data-key="@(item.Index)-@(j)" />
                        @* data-anchor = MÃ NEO của bước (xem UatAnchor): thứ duy nhất đi xuống iframe khi
                           người dùng bấm vào bước. Câu chữ của bước ở lại đây — annotator tra
                           [data-uat~="..."] do agent gắn sẵn chứ không đoán phần tử từ tiếng Việt nữa. *@
                        <span class="uat-step-text"
                              data-anchor="@ICOGenerator.Contracts.Requirements.UatAnchor.Token(item.Index, j)"
                              title="Bấm để bản demo chỉ chỗ thao tác này">@item.Scenario.Steps[j]</span>
                    </label>
                </li>
            }
        </ol>
        <div class="uat-actions">
            @* "Làm theo": đi lần lượt từng bước theo NHỊP NGƯỜI XEM — mỗi cú bấm chỉ chỗ đúng một bước, bấm
               tiếp là đánh dấu bước đó đã làm và sang bước sau. Xem poc-review.js. *@
            <button type="button" class="btn primary small uat-guide">▶ Làm theo</button>
            <button type="button" class="btn outline small uat-fail">✗ Chỗ này chưa đúng</button>
        </div>
        @* Hai CHỖ TRỐNG của riêng việc này. Ô nhập ghi chú (#pocCommentForm — chỉ có MỘT trên trang, dùng
           chung với đường ghim trên POC) được JS chuyển vào .uat-scenario-form khi bấm báo lỗi, và các ghi
           chú đã ghim cho việc này render vào .uat-scenario-notes — để người xem không phải cuộn đi cuộn
           về mới biết mình vừa ghi gì cho việc nào. Cả hai div rỗng thì `:empty` ẩn đi. *@
        <div class="uat-scenario-form"></div>
        <div class="uat-scenario-notes"></div>
    </details>;
}

@* Command bar chuẩn: chỗ đứng của các hành động CẤP TRANG. "Chia sẻ bản demo" nằm ở đây thay vì
   trong cột ghi chú bên phải — mời người khác vào xem là việc của người chủ trì buổi review, không phải
   một mục để đọc lướt khi đang soát ghi chú, và trước đây nó bị chôn giữa các panel gập nên gần như
   không ai thấy. Bấm nút mở hộp thoại; mỗi nút soi quyền riêng của nó.

   "Bật chế độ ghim" ở đây vì nó đổi CHẾ ĐỘ TƯƠNG TÁC của cả trang với bản demo — đúng định nghĩa vùng
   phải của command bar, và là một công tắc có trạng thái nên nó cần một chỗ đứng cố định, luôn đọc được.
   Vẫn không dựng lại thanh nút riêng trong thẻ iframe: hai hàng nút cách nhau vài chục pixel, khác kiểu
   dáng, người dùng phải quét cả hai mới biết hành động mình cần nằm ở đâu.

   "Mở tab riêng" và "toàn màn hình" thì KHÔNG ở đây — chúng là hai icon nổi ở góc trên phải của chính
   khung demo (xem .poc-frame-actions bên dưới). Khác với công tắc ghim, chúng không mang trạng thái nào
   của cả trang và chỉ có nghĩa với đúng một đối tượng: bản demo. Đặt chúng chạm vào thứ chúng phóng/mở
   là bỏ được hai dòng chữ trên thanh lệnh mà không mất đường đi nào, và trả chỗ đó cho các hành động
   thật sự cấp trang.

   Thanh LUÔN hiện: nút ghim không soi quyền nào (ai mở được trang thì ghim được), nên không còn thế
   "không có nút nào để hiện" như khi thanh chỉ chứa các nút có quyền riêng. *@
@{
    var pocActions = new List<CommandBarButton>
    {
        // Toggle: JS (poc-review.js) đảo aria-pressed + class "open" và đổi chữ trong .cbar-label.
        new CommandBarButton
        {
            Label = "Bật chế độ ghim",
            Icon = "bi-pin-angle",
            Id = "pinModeBtn",
            Toggle = true,
            Title = "Bật rồi bấm vào chỗ chưa đúng trong bản demo để ghim ghi chú"
        }
    };

    if (showTechButton)
    {
        var openIssueCount = Model.Verification is { } headVerif && headVerif.OpenIssues.Any()
            ? headVerif.OpenIssues.Count.ToString()
            : null;
        pocActions.Add(new CommandBarButton
        {
            Label = "Chi tiết kỹ thuật",
            Icon = "bi-wrench-adjustable",
            Id = "pocTechOpen",
            OpensDialog = true,
            Title = "Kết quả tự kiểm của hệ thống và đối chiếu spec — dành cho đội delivery",
            Badge = openIssueCount,
            BadgeTitle = "Số điểm máy báo chưa đạt"
        });
    }

    // THỬ MODEL KHÁC: nút phụ mở hộp thoại so sánh. Không phải nút chính — đây là thí nghiệm của người
    // chọn model, không phải bước của buổi review; và nó không đổi gì trên trang (bản demo, ghi chú, cổng
    // duyệt giữ nguyên), nên đứng cạnh "Chi tiết kỹ thuật" — cùng loại "nội dung cho đội kỹ thuật".
    if (canExperimentModels)
    {
        pocActions.Add(new CommandBarButton
        {
            Label = "Thử model khác",
            Icon = "bi-cpu",
            Id = "pocVariantsOpen",
            OpensDialog = true,
            Title = "Dựng lại bản demo bằng một model khác cho agent Developer và so sánh kết quả — không đụng bản đang review"
        });
    }
}

@{
    // ---- NGHIỆM THU: công tắc HAI CHIỀU, và nó đứng ở NÚT CHÍNH của command bar ----
    // Trước đây nút "Approve POC" nằm lọt trong panel ghi chú ở cột trái, cùng chỗ với các đường "còn sai
    // chỗ này". Nó là hành động CẤP TRANG và là điểm dừng của cả buổi review, nên chỗ của nó là vùng phải
    // của command bar — đúng luật đã áp cho "Bật chế độ ghim". "Share" lùi về nhóm nút phụ:
    // mời người khác vào xem là việc mở đầu buổi review, không phải kết luận của nó.
    //
    // Hai nút KHÔNG bao giờ cùng xuất hiện: đã nghiệm thu ⇒ chỉ có "Withdraw Approve", chưa ⇒ chỉ có
    // "Approve POC". Trạng thái này quyết định luôn việc trang có khoá hay không (xem PocAcceptanceGate),
    // nên sau mỗi cú bấm JS tải lại trang thay vì tự đảo nhãn — cả trang phải nói cùng một trạng thái.
    var pocAccepted = Model.PocAcceptedAtUtc.HasValue;
    CommandBarButton? pocPrimary = null;

    if (canManageRequirements && pocAccepted)
    {
        pocPrimary = new CommandBarButton
        {
            Label = "Withdraw Approve",
            Icon = "bi-unlock",
            Id = "pocWithdrawApproveBtn",
            Title = "Rút nghiệm thu để chat với BA và ghi chú trên POC trở lại"
        };
    }
    else if (canManageRequirements && Model.HasMockup)
    {
        pocPrimary = new CommandBarButton
        {
            Label = "Approve POC",
            Icon = "bi-check2-circle",
            Id = "pocAcceptBtn",
            Title = "Xác nhận bản demo đã đạt — khoá chat ở màn hình Requirement và ghi chú trên trang này"
        };
    }

    if (canManageRequirements)
    {
        var shareButton = new CommandBarButton { Label = "Share", Icon = "bi-share", Id = "pocShareOpen" };
        if (pocPrimary == null)
        {
            pocPrimary = shareButton;
        }
        else
        {
            pocActions.Add(shareButton);
        }
    }
}

@await Html.PartialAsync("_CommandBar", new CommandBarModel
{
    Actions = pocActions,
    Primary = pocPrimary
})

<div class="poc-review-layout@(pocAccepted ? " is-locked" : "")"
     id="pocReviewRoot"
     data-project-id="@Model.ProjectId"
     data-locked="@(pocAccepted ? "true" : "false")"
     data-accept-url="@Url.Action("AcceptPoc", "Projects")"
     data-withdraw-accept-url="@Url.Action("WithdrawPocAcceptance", "Projects")"
     data-comments-url="@Url.Action("PocComments", "Projects", new { projectId = Model.ProjectId })"
     data-add-url="@Url.Action("AddPocComment", "Projects")"
     data-withdraw-url="@Url.Action("WithdrawPocComment", "Projects")"
     data-reopen-url="@Url.Action("ReopenPocComment", "Projects")"
     data-triage-url="@Url.Action("TriagePocFeedback", "Projects")"
     data-dispatch-url="@Url.Action("DispatchPocFeedback", "Projects")"
     data-brief-version="@Model.BriefVersion"
     data-gate-open="@(Model.PocGateOpen ? "true" : "false")"
     data-revisions-used="@Model.PocRevisionsUsed"
     data-revision-limit="@Model.PocRevisionLimit">

    @* CỘT TRÁI = BẢN DEMO + NHỮNG GÌ NÓI VỀ CHÍNH BẢN DEMO. Ghi chú trên POC nằm ở đây, ngay dưới
       khung demo, chứ không còn ở đáy cột phải. Hai lý do:
       (a) Ghi chú là các PIN VẼ TRÊN BẢN DEMO — pin số 3 trong khung và mục số 3 trong danh sách là
           cùng một thứ nhìn từ hai phía. Để danh sách ở cột kia là bắt mắt người dùng nhảy qua lại
           giữa hai cột cho một phép đối chiếu lẽ ra chỉ cần liếc xuống.
       (b) Trước đây nó nằm SAU toàn bộ danh sách kịch bản, nên POC càng nhiều kịch bản thì ghi chú
           (và hai nút đóng vòng "Bản demo đã đạt" / "Gửi ghi chú cho đội xử lý") càng bị đẩy sâu —
           đúng những thao tác kết thúc buổi review lại là thứ khó với tới nhất. Nay hai cột dài
           tự cuộn độc lập: kịch bản bên phải, ghi chú bên trái, không cái nào đẩy cái nào. *@
    <div class="poc-main-col">
        @* Thẻ này KHÔNG có padding (xem #pocReviewRoot .poc-frame-panel): khung demo là nội dung duy nhất
           bên trong, mà bản thân POC đã có supergraphic + topbar + sidebar riêng của nó, nên viền trắng
           20px quanh iframe chỉ là một cái khung thứ hai lồng ngoài cái khung đã có — vừa thừa, vừa ăn
           mất chiều cao của thứ duy nhất trên trang này đáng được chỗ. *@
        <section class="card poc-frame-panel">
            @* Hai icon nổi ở góc trên PHẢI của khung, không còn là nút chữ trên command bar. Cả hai chỉ
               tác động lên đúng bản demo đang nằm dưới chúng, nên chỗ đúng là chạm vào bản demo: người
               dùng không phải đối chiếu một nhãn chữ ở tận thanh lệnh với thứ nó sẽ mở. Góc PHẢI vì góc
               trên trái của bản demo là header sidebar của chính nó (tên ứng dụng + nút gập X) — đặt hai
               icon bấm được của trang cha ngay cạnh một nút bấm được của demo là mời bấm nhầm; mép phải
               chỉ có chữ BOSCH tĩnh.
               "Mở tab riêng" là <a target="_blank"> chứ không phải nút JS: giữ nguyên chuột giữa /
               Ctrl+click, và không phụ thuộc poc-review.js. "Toàn màn hình" thì buộc phải là nút JS
               (Fullscreen API), và nó phóng CẢ THẺ .poc-frame-panel chứ không phóng riêng iframe — phóng
               iframe thì mọi thứ trang cha vẽ ĐÈ lên demo (pin ghi chú, khung tô sáng khi chỉ chỗ) nằm
               lại phía sau lớp toàn màn hình, tức là mất đúng thứ người ta đang review. *@
            <div class="poc-frame-actions">
                <a class="poc-frame-btn"
                   href="@Url.Action("Mockup", "Projects", new { projectId = Model.ProjectId })"
                   target="_blank" rel="noopener"
                   title="Mở bản demo ở tab mới (không có chế độ ghim)"
                   aria-label="Mở bản demo ở tab mới">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                </a>
                <button type="button"
                        class="poc-frame-btn"
                        id="pocFullscreenBtn"
                        aria-pressed="false"
                        title="Xem bản demo toàn màn hình (Esc để thoát)"
                        aria-label="Xem bản demo toàn màn hình">
                    <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
                </button>
            </div>

            @* sandbox trên thẻ iframe LẶP LẠI đúng CSP sandbox mà endpoint Mockup tự đặt (defense-in-depth,
               không nới thêm gì); review=True để server tiêm annotator vào tài liệu (bool binder KHÔNG
               nhận "1" — phải là true/false). *@
            <iframe id="pocFrame"
                    title="POC demo"
                    src="@Url.Action("Mockup", "Projects", new { projectId = Model.ProjectId, review = true })"
                    sandbox="allow-scripts allow-forms allow-modals"></iframe>
        </section>

        <section class="card poc-notes-panel">
            <h3>Ghi chú trên POC <span class="poc-count" id="pocCommentCount"></span></h3>
            @* MỘT đường đóng vòng thay cho hai nút cũ ("nhờ Dev chỉnh bản demo" / "gửi về Requirement").
               Vì sao gộp: hai đường đó bắt người xem demo — dân nghiệp vụ — tự phân loại ghi chú của mình,
               trong khi chính hệ thống làm được phép phân loại ấy (poc-feedback-triage.v1.md). Tệ hơn, CẢ HAI
               nút cũ đều nuốt trọn mọi ghi chú Open nên một buổi review lẫn hai loại (chuyện thường) không có
               nút nào đúng: bấm nút Dev thì tài liệu giữ nguyên chỗ hiểu sai, bấm nút Requirement thì các ghi
               chú thẩm mỹ bị đánh dấu RoutedToRequirement dù BA đã loại chúng khỏi tin nhắn — mất trắng.
               Nay: máy đề xuất nhóm cho từng ghi chú → người dùng soát/đổi trong hộp xác nhận → mỗi đường chỉ
               nhận đúng tập con của nó. Quyền vẫn là RequirementsManage như hai endpoint cũ. *@
            @* Nút bấm ĐÃ LÊN command bar (xem khối dựng pocPrimary phía trên). Ở lại đây là tấm biển trạng
               thái: ai chốt, lúc nào, và điều gì đang bị khoá — người mở trang giữa buổi review cần đọc
               được lý do ô nhập của họ không gõ được, ngay tại chỗ họ định gõ. *@
            @if (pocAccepted)
            {
                <div class="poc-accepted">
                    ✓ <b>Đã nghiệm thu</b>@(string.IsNullOrWhiteSpace(Model.PocAcceptedBy) ? "" : $" bởi {Model.PocAcceptedBy}")
                    · @Model.PocAcceptedAtUtc!.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    <div class="muted poc-panel-hint">
                        Nội dung đang khoá: không ghim/thu hồi ghi chú và không chat với BA ở màn hình Requirement.
                        @if (canManageRequirements)
                        {
                            <text>Bấm <b>Withdraw Approve</b> trên thanh lệnh để mở khoá.</text>
                        }
                    </div>
                </div>
            }

            @if (canManageRequirements && !pocAccepted)
            {
                @* hidden ngay từ server: poc-review.js mở khối này ra sau khi nạp xong danh sách và
                   thấy có ghi chú chờ gửi. Render sẵn rồi mới ẩn đi sẽ nháy một nút "gửi" trong khoảng
                   thời gian fetch — đúng lúc người dùng chưa biết mình có ghi chú nào hay không. *@
                <div class="poc-route-req" hidden>
                    <button type="button" id="pocSendFeedbackBtn" class="btn primary small full">
                        📤 Gửi ghi chú cho đội xử lý
                    </button>
                </div>

                @* Hộp xác nhận: bảng phân loại của máy, mỗi ghi chú một dòng và đổi nhóm được. Dựng rỗng ở đây,
                   JS đổ nội dung sau khi gọi TriagePocFeedback. *@
                <div class="modal-backdrop hidden" id="pocDispatchModal">
                    <div class="modal poc-dispatch-modal">
                        <button type="button" class="x" id="pocDispatchClose" aria-label="Đóng">&times;</button>
                        <h3>Gửi ghi chú đi xử lý</h3>
                        <p class="muted poc-dispatch-note" id="pocDispatchNote"></p>
                        <div id="pocDispatchGroups"></div>
                        <div class="poc-dispatch-msg" id="pocDispatchMsg"></div>
                        <div class="modal-actions">
                            <button type="button" class="btn outline small" id="pocDispatchCancel">Hủy</button>
                            <button type="button" class="btn primary small" id="pocDispatchConfirm">Gửi</button>
                        </div>
                    </div>
                </div>
            }

            <form id="pocCommentForm" class="poc-comment-form" hidden>
                @Html.AntiForgeryToken()
                <div class="poc-target-label" id="pocTargetLabel"></div>
                <textarea id="pocCommentText" rows="3" maxlength="4000"
                          placeholder="Phần tử này cần sửa gì? Ví dụ: đổi nhãn thành 'Lưu', thêm cột Trạng thái…"></textarea>
                <div class="poc-form-actions">
                    <button type="submit" class="btn primary small">Ghim ghi chú</button>
                    <button type="button" class="btn outline small" id="pocCommentCancel">Hủy</button>
                </div>
            </form>

            <div id="pocCommentList" class="poc-comment-list">
                <p class="muted">Đang tải ghi chú…</p>
            </div>

            @* LỊCH SỬ — thay cho panel "Nhật ký vòng sửa" cũ. Panel cũ chỉ có bàn giao của agent, nên nửa
               còn lại của câu chuyện (ai chê gì ở bản nào, điểm đó đi đường nào) không truy lại được sau
               khi Brief lên version mới. Bảng này gom cả ba nguồn về một dòng thời gian, gom theo phiên bản
               Product Brief, và KHÔNG có hành động nào. Bảng chỉ ghi những gì ĐÃ XẢY RA: ghi chú chưa gửi
               đi mà bị thu hồi thì không vào đây (xoá thật), ghi chú đã đi một vòng rồi bị thu hồi thì ở
               lại với nhãn "đã thu hồi" (xem WithdrawPocCommentUseCase). *@
            @if (Model.History.Any())
            {
                <div class="poc-history">
                    <h3>Lịch sử ghi chú <span class="poc-count">(@Model.History.Sum(v => v.Rows.Count) mục / @Model.History.Count bản)</span></h3>
                    <p class="muted poc-panel-hint">
                        Mọi ghi chú ĐÃ GỬI ĐI của mọi phiên bản Product Brief — kể cả ghi chú trên bản mô tả và các
                        dòng bị thu hồi sau khi đã đi một vòng. Ghi chú thu hồi trước khi gửi không lưu vào đây.
                    </p>

                    @foreach (var (version, versionIndex) in Model.History.Select((v, i) => (v, i)))
                    {
                        <details class="poc-history-version" open="@(versionIndex == 0)">
                            <summary>
                                <b>@(string.IsNullOrEmpty(version.BriefVersion) ? "Không rõ phiên bản" : $"Product Brief {version.BriefVersion}")</b>
                                <span class="poc-count">(@version.Rows.Count)</span>
                            </summary>
                            <div class="poc-history-scroll">
                                <table class="poc-history-table">
                                    <thead>
                                        <tr>
                                            <th>Loại</th>
                                            <th>Nội dung</th>
                                            <th>Người tạo</th>
                                            <th>Thời điểm</th>
                                            <th>Đã xử lý</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in version.Rows)
                                        {
                                            <tr class="@(row.Withdrawn ? "is-withdrawn" : "")">
                                                <td>
                                                    <span class="poc-badge @KindClass(row.Kind)">@KindLabel(row.Kind)</span>
                                                    <div class="poc-history-route">@RouteLabel(row)</div>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(row.Anchor))
                                                    {
                                                        <div class="poc-history-anchor">@row.Anchor</div>
                                                    }
                                                    <div class="poc-history-note">@row.Note</div>
                                                    @if (row.Withdrawn)
                                                    {
                                                        <div class="poc-history-withdrawn">
                                                            đã thu hồi@(string.IsNullOrWhiteSpace(row.WithdrawnBy) ? "" : $" bởi {row.WithdrawnBy}")
                                                        </div>
                                                    }
                                                </td>
                                                <td>@(row.CreatedBy ?? "agent Developer")</td>
                                                <td>@row.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>
                                                    @if (string.IsNullOrWhiteSpace(row.RepairLog))
                                                    {
                                                        <span class="muted">—</span>
                                                    }
                                                    else
                                                    {
                                                        <details class="poc-history-log">
                                                            <summary>@(row.RepairedAt.HasValue ? row.RepairedAt.Value.ToLocalTime().ToString("dd/MM HH:mm") : "xem bàn giao")</summary>
                                                            <pre>@row.RepairLog</pre>
                                                        </details>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </div>
            }
        </section>
    </div>

    <aside class="card poc-comments-panel">
        @* HƯỚNG DẪN SỬ DỤNG — nửa dành cho người dùng của trang review. Ngoài đời, sau khi có bản demo thì BA
           ngồi cạnh người dùng và dẫn họ đi: "việc này thì bấm đây, rồi đây, sẽ thấy thế này". Panel này là
           buổi dẫn đó, viết sẵn: mỗi thẻ là MỘT VIỆC người dùng làm được (một kịch bản của
           uat-scenarios.json), gom theo màn hình, xếp theo trình tự demo. Bấm vào một bước thì bản demo chỉ
           đúng chỗ thao tác (mã neo UatAnchor); "▶ Làm theo" đi lần lượt từng bước; chỗ nào không như mô
           tả thì báo lỗi ngay trong thẻ.
           Không còn khung "câu nghiệm thu": POC là một file HTML không backend, nên những câu kiểu "gửi
           email cho quản lý" không thể đúng trên nó — nghiệm thu thật thuộc về giai đoạn sau khi POC được
           duyệt (tài liệu kỹ thuật). *@
        @if (scenarios.Any())
        {
            <details class="uat-panel poc-guide-panel" open>
                @* Tiêu đề đếm VIỆC (thẻ), không đếm bước: người xem đi theo từng việc (mở → làm hết → đóng),
                   nên "3/8" đọc thẳng ra "còn 5 việc nữa". Tiến độ theo bước nằm trên dòng gập của từng thẻ. *@
                <summary>
                    <text>📘 Hướng dẫn sử dụng</text>
                    <span class="poc-count" id="uatProgress" data-total="@scenarios.Count"></span>
                </summary>
                <p class="muted poc-panel-hint">
                    Mỗi mục là một việc anh/chị làm được trên bản demo. Bấm <b>▶ Làm theo</b> để bản demo chỉ từng
                    chỗ cần thao tác (hoặc bấm thẳng vào một bước); làm xong bước nào thì tick bước đó. Chỗ nào
                    không như mô tả thì bấm <b>Chỗ này chưa đúng</b>.
                </p>

                @* #uatList bọc toàn bộ phần có thẻ hướng dẫn: mọi handler trong poc-review.js đều delegate từ
                   phần tử này và tìm ngược bằng closest(".uat-scenario"), nên lồng trong nhóm không ảnh hưởng gì. *@
                <div id="uatList">
                    @foreach (var group in guideGroups)
                    {
                        <div class="poc-guide-group">
                            @if (showGroupHeads)
                            {
                                <div class="poc-guide-screen">
                                    @(group.Screen.Length > 0 ? $"Màn hình {group.Screen}" : "Việc khác")
                                    <span class="poc-count">(@group.Indexes.Count)</span>
                                </div>
                            }
                            @foreach (var i in group.Indexes)
                            {
                                @scenarioCard((scenarios[i], i))
                            }
                        </div>
                    }
                </div>
            </details>
        }

        @* Panel "Máy đã tự kiểm" từng nằm ở đây — nay ở hộp thoại "Chi tiết kỹ thuật" trên command bar. *@

        @* CÁC VÒNG ĐÃ DỰNG: mỗi vòng "Yêu cầu chỉnh sửa" ghi đè thẳng lên poc-demo.html, nên bản chụp ở
           đây là đường DUY NHẤT để người nghiệm thu mở lại bản họ đã xem và tự đối chiếu — thay vì phải
           tin vào bản bàn giao bằng chữ của agent. Ẩn khi chưa có bản chụp nào (POC dựng trước tính năng
           này) hoặc mới đúng một vòng. *@
        @if (Model.Versions.Snapshots.Count > 1)
        {
            var snapshots = Model.Versions.Snapshots;
            var latest = snapshots[^1];
            var diff = Model.Versions.DiffWithPrevious;
            <details class="uat-panel poc-versions-panel" open>
                <summary>🕘 Các vòng đã dựng <span class="poc-count">(@snapshots.Count)</span></summary>
                <p class="muted poc-panel-hint">Bản đang xem là vòng @latest.Version. Mở lại vòng trước để so bằng mắt những gì đã đổi.</p>

                @if (diff.HasChanges)
                {
                    <div class="poc-cov-group">
                        <div class="poc-cov-head">Khác biệt màn hình so với vòng @Model.Versions.PreviousVersion:</div>
                        <ul class="poc-cov-worked">
                            @foreach (var screen in diff.AddedScreens)
                            {
                                <li class="poc-verif-ok">+ thêm màn hình «@screen»</li>
                            }
                            @foreach (var screen in diff.RemovedScreens)
                            {
                                <li class="poc-verif-bad">− bỏ màn hình «@screen» — kiểm tra xem đây có phải chủ ý không</li>
                            }
                        </ul>
                    </div>
                }
                else if (Model.Versions.PreviousVersion is not null)
                {
                    <p class="muted">Vòng này không thêm/bỏ màn hình nào so với vòng @Model.Versions.PreviousVersion — thay đổi nằm bên trong các màn hình đã có.</p>
                }

                <ul class="poc-cov-worked poc-version-list">
                    @foreach (var snapshot in snapshots.Reverse())
                    {
                        <li>
                            <a asp-action="Mockup"
                               asp-route-projectId="@Model.ProjectId"
                               asp-route-version="@snapshot.Version"
                               target="_blank"
                               rel="noopener">Vòng @snapshot.Version ↗</a>
                            <span class="muted"> — @snapshot.CapturedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            @if (snapshot.Version == latest.Version)
                            {
                                <span class="poc-verif-ok"> (bản đang xem)</span>
                            }
                        </li>
                    }
                </ul>
            </details>
        }

        @* Cột phải nay CHỈ còn hướng dẫn sử dụng + các vòng đã dựng. Khối "Ghi chú trên POC" cùng hai nút
           đóng vòng đã sang cột trái, ngay dưới khung demo — lý do ở comment đầu cột trái. *@

    </aside>
</div>

@* CHI TIẾT KỸ THUẬT (chỉ DeliveryAdvance): hai tab gom trọn phần nội dung mà người dùng nghiệp vụ
   không đọc được — kết quả vòng tự kiểm cuối, và cách BA diễn đạt lại yêu cầu cho máy. Đặt ngoài
   layout hai cột vì backdrop là phần tử toàn màn hình. *@
@if (showTechButton)
{
    <div class="modal-backdrop hidden" id="pocTechModal">
        <div class="modal poc-tech-modal" role="dialog" aria-modal="true" aria-labelledby="pocTechTitle">
            <button type="button" class="x" id="pocTechClose" aria-label="Đóng">&times;</button>
            <h2 id="pocTechTitle"><i class="bi bi-wrench-adjustable" aria-hidden="true"></i> Chi tiết kỹ thuật</h2>

            <div class="poc-tech-tabs" role="tablist" aria-label="Chi tiết kỹ thuật">
                @* Tab mặc định là tab có tín hiệu HÀNH ĐỘNG: nếu chưa có dữ liệu tự kiểm (POC cũ) thì
                   rơi về tab đối chiếu spec, để hộp thoại không bao giờ mở ra một panel rỗng. *@
                <button type="button" class="poc-tech-tab@(Model.Verification is not null ? " active" : "")"
                        role="tab" id="pocTechTabVerif" aria-controls="pocTechPanelVerif"
                        aria-selected="@(Model.Verification is not null ? "true" : "false")"
                        data-panel="pocTechPanelVerif" @(Model.Verification is null ? "disabled" : "")>
                    🧪 Máy đã tự kiểm
                    @if (Model.Verification is { } tabVerif && tabVerif.OpenIssues.Any())
                    {
                        <span class="poc-tech-badge">@tabVerif.OpenIssues.Count</span>
                    }
                </button>
                <button type="button" class="poc-tech-tab@(Model.Verification is null ? " active" : "")"
                        role="tab" id="pocTechTabSpec" aria-controls="pocTechPanelSpec"
                        aria-selected="@(Model.Verification is null ? "true" : "false")"
                        data-panel="pocTechPanelSpec" @(hasSpecDetails ? "" : "disabled")>
                    🎯 Đối chiếu spec
                </button>
            </div>

            @* ---- Tab 1: kết quả vòng tự kiểm cuối (audit tĩnh + headless browser + visual QA): máy ĐÃ xác nhận gì (đỡ kiểm lại bằng tay) và còn issue nào agent chưa
               xử lý được sau các vòng sửa (chỗ cần soi kỹ nhất). ---- *@
            <div class="poc-tech-panel@(Model.Verification is null ? " hidden" : "")"
                 id="pocTechPanelVerif" role="tabpanel" aria-labelledby="pocTechTabVerif" tabindex="0">
                @if (Model.Verification is { } verif)
                {
                    var selfPass = verif.SelfTestResults.Count(r => r.StartsWith("PASS", StringComparison.Ordinal));
                    var scenarioPass = verif.ScenarioResults.Count(r => r.StartsWith("PASS", StringComparison.Ordinal));
                    <p class="muted poc-panel-hint">
                        Kết quả vòng kiểm tự động cuối cùng trước khi bàn giao POC (@verif.CheckedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")) —
                        những mục ✓ máy đã xác nhận chạy đúng; những mục ✗ là chỗ nên soi kỹ khi review.
                        @if (verif.OpenIssues.Any())
                        {
                            <b class="poc-verif-bad">Còn @verif.OpenIssues.Count điểm chưa đạt.</b>
                        }
                        else
                        {
                            <b class="poc-verif-ok">Vòng kiểm cuối sạch.</b>
                        }
                    </p>

                    <ul class="poc-verif-lines">
                        @if (verif.RuntimeRan)
                        {
                            @if (verif.SelfTestResults.Any())
                            {
                                <li class="@(selfPass == verif.SelfTestResults.Count ? "poc-verif-ok" : "poc-verif-bad")">
                                    Quy tắc nghiệp vụ tự kiểm: @selfPass/@verif.SelfTestResults.Count PASS
                                </li>
                            }
                            @if (verif.ScenarioResults.Any())
                            {
                                <li class="@(scenarioPass == verif.ScenarioResults.Count ? "poc-verif-ok" : "poc-verif-bad")">
                                    Kịch bản end-to-end: @scenarioPass/@verif.ScenarioResults.Count PASS
                                </li>
                            }
                            @if (verif.SpecScreens > 0)
                            {
                                <li class="@(verif.CoveredScreens >= verif.SpecScreens ? "poc-verif-ok" : "poc-verif-bad")">
                                    Độ phủ màn hình theo spec: @verif.CoveredScreens/@verif.SpecScreens
                                </li>
                            }
                            @* Kịch bản nghiệm thu: sinh TRƯỚC khi POC được dựng, nên đây là thước đo độc lập
                               với các assertion do chính agent dựng POC viết. Hai dòng: có mục tương ứng đang
                               PASS không, và lượt lái THẬT bằng click có thao tác được không. *@
                            @if (verif.UatTotal > 0)
                            {
                                <li class="@(verif.UatCovered >= verif.UatTotal ? "poc-verif-ok" : "poc-verif-bad")">
                                    Kịch bản trong hướng dẫn sử dụng (cột phải) POC tự chạy đúng: @verif.UatCovered/@verif.UatTotal
                                </li>
                            }
                            @if (verif.UatDriveResults.Any())
                            {
                                var drivePass = verif.UatDriveResults.Count(x => x.StartsWith("PASS", StringComparison.Ordinal));
                                <li class="@(drivePass == verif.UatDriveResults.Count ? "poc-verif-ok" : "poc-verif-bad")">
                                    Máy bấm thử theo kịch bản (click thật trên POC): @drivePass/@verif.UatDriveResults.Count kịch bản thao tác được
                                </li>
                            }
                            @if (verif.CrossScreenIssues.Any())
                            {
                                <li class="poc-verif-bad">
                                    Dữ liệu mẫu lệch nhau giữa các màn hình: @verif.CrossScreenIssues.Count chỗ
                                </li>
                            }
                            @if (verif.VisualRan)
                            {
                                <li class="@(verif.VisualWarnings.Any() ? "" : "poc-verif-ok")">
                                    UI/UX agent đã soát ảnh từng màn hình@(verif.VisualWarnings.Any() ? $" — {verif.VisualWarnings.Count} cảnh báo nhỏ" : "")
                                </li>
                            }
                        }
                        else
                        {
                            <li class="muted">Tầng chạy thử trong trình duyệt không hoạt động ở môi trường này (@verif.RuntimeSkipReason) — chỉ có kiểm tra tĩnh.</li>
                        }
                    </ul>

                    @* ĐÃ SỬA ĐƯỢC so với vòng kiểm trước. Từ vòng review thứ hai trở đi, câu hỏi đầu tiên của
                       người review luôn là "lần sửa vừa rồi đụng vào những gì?" — không có danh sách này họ
                       phải rà lại cả bản demo từ đầu, dù hệ thống đã có sẵn dữ liệu để trả lời. *@
                    @if (Model.VerificationFixes.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head poc-verif-ok">✓ Đã sửa được so với vòng kiểm trước (@Model.VerificationFixes.Count):</div>
                            <ul class="poc-verif-lines">
                                @foreach (var fix in Model.VerificationFixes.Take(8))
                                {
                                    <li class="poc-verif-ok">@fix</li>
                                }
                            </ul>
                        </div>
                    }

                    @* HỒI QUY giữa các vòng sửa: thứ từng chạy đúng mà vòng sửa sau làm gãy. Tách riêng khỏi
                       "điểm chưa đạt" vì đây là tín hiệu KHÁC hẳn — không phải "chưa làm xong" mà là "đã lùi". *@
                    @if (verif.Regressions.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head poc-verif-bad">⚠ Đã chạy đúng ở vòng trước nhưng vòng này hỏng lại (@verif.Regressions.Count):</div>
                            <ul class="poc-verif-issues">
                                @foreach (var regression in verif.Regressions.Take(6))
                                {
                                    <li>@regression</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (verif.OpenIssues.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head poc-verif-bad">Điểm máy báo CHƯA ĐẠT mà agent chưa xử lý xong — ưu tiên xem khi review:</div>
                            <ul class="poc-verif-issues">
                                @foreach (var issue in verif.OpenIssues.Take(8))
                                {
                                    <li>@issue</li>
                                }
                                @if (verif.OpenIssues.Count > 8)
                                {
                                    <li class="muted">… và @(verif.OpenIssues.Count - 8) điểm khác.</li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>

            @* ---- Tab 2: đối chiếu spec — màn hình + business rule chắt từ AI Design Spec đã duyệt, kèm
               kịch bản UAT nào kiểm quy tắc nào. Đây là cách BA diễn đạt lại yêu cầu cho máy, nên nó nói
               chuyện với đội delivery chứ không với người nghiệm thu. ---- *@
            <div class="poc-tech-panel@(Model.Verification is not null ? " hidden" : "")"
                 id="pocTechPanelSpec" role="tabpanel" aria-labelledby="pocTechTabSpec" tabindex="0">
                @if (hasSpecDetails)
                {
                    <p class="muted poc-panel-hint">Chắt từ AI Design Spec (đã duyệt) — POC đáng lẽ phải phủ những gì, và mỗi quy tắc có kịch bản UAT nào kiểm.</p>

                    @if (cov.Screens.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head">Màn hình theo yêu cầu <span class="poc-count">(@cov.Screens.Count)</span></div>
                            <div class="poc-cov-chips">
                                @foreach (var screen in cov.Screens)
                                {
                                    <span class="poc-cov-chip">@screen</span>
                                }
                            </div>
                        </div>
                    }

                    @if (cov.Rules.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head">Quy tắc nghiệp vụ <span class="poc-count">(@cov.Rules.Count)</span></div>
                            <ul class="poc-cov-rules">
                                @foreach (var rule in cov.Rules)
                                {
                                    <li>
                                        <span class="poc-cov-rule-text">@rule.Rule</span>
                                        @if (rule.ScenarioTitles.Any())
                                        {
                                            <span class="poc-cov-rule-tested" title="Kịch bản UAT kiểm quy tắc này">✓ có kịch bản kiểm: @string.Join("; ", rule.ScenarioTitles)</span>
                                        }
                                        else
                                        {
                                            <span class="poc-cov-rule-untested" title="Chưa có kịch bản UAT nào tham chiếu quy tắc này">⚠ chưa có kịch bản kiểm</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                }
            </div>

            <div class="modal-actions">
                <button type="button" class="btn" id="pocTechDone">Đóng</button>
            </div>
        </div>
    </div>
}

@* XÁC NHẬN NGHIỆM THU — hộp thoại của app, không phải confirm() của trình duyệt. Hai cú bấm này là
   hai cú bấm đắt nhất trang: một cái đóng băng cả chat BA lẫn ghi chú POC, cái kia rút lại lời đã nói
   với đội delivery. Hộp mặc định của trình duyệt dán tên miền "localhost:7115 says" lên trên, bỏ hết
   xuống dòng của câu giải thích và không bày được nhãn hành động thật, nên người dùng đọc "OK/Cancel"
   mà không biết mình đang OK cái gì. Một hộp dùng .modal của app trả lại đủ ba thứ: tiêu đề là câu hỏi,
   một dòng cảnh báo nói hậu quả, và nút chính mang đúng nhãn của thao tác.

   Chữ trong hộp để TIẾNG ANH cho khớp nhãn nút trên command bar ("Approve POC" / "Withdraw Approve") —
   đọc "Rút lại nghiệm thu?" rồi phải tự suy ra là nút "Withdraw Approve" là một bước dịch thừa ngay tại
   khoảnh khắc cần chắc tay nhất. Nội dung do JS bơm vào (xem bindAcceptanceButton) vì hai thao tác dùng
   chung một hộp. *@
@if (canManageRequirements)
{
    <div class="modal-backdrop hidden" id="pocConfirmModal">
        <div class="modal poc-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="pocConfirmTitle">
            <button type="button" class="x" id="pocConfirmClose" aria-label="Close">&times;</button>
            <h2 id="pocConfirmTitle"></h2>
            <p class="modal-note warning" id="pocConfirmNote">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <span id="pocConfirmNoteText"></span>
            </p>
            @* Lỗi từ server hiện NGAY TRONG hộp: bắn alert() ra ngoài sau khi đã đóng hộp là quay lại
               đúng thứ vừa thay. *@
            <div class="poc-confirm-msg hidden" id="pocConfirmMsg" role="alert"></div>
            <div class="modal-actions">
                <button type="button" class="btn outline small" id="pocConfirmCancel">Cancel</button>
                <button type="button" class="btn primary small" id="pocConfirmOk"></button>
            </div>
        </div>
    </div>
}

@* CHIA SẺ bản demo cho người không có tài khoản: nghiệm thu thật luôn có nhiều người, mà trang này bị
   chặn theo quyền truy cập project. Link luôn có hạn dùng và thu hồi được; người xem chỉ mở được đúng
   bản demo + ghim góp ý, không thấy gì khác của dự án. Hộp thoại mở từ nút trên command bar; đặt ngoài
   layout hai cột vì backdrop là phần tử toàn màn hình, không thuộc cột ghi chú. *@
@if (canManageRequirements)
{
    <div class="modal-backdrop hidden" id="pocShareModal">
        <div class="modal poc-share-modal" id="pocSharePanel"
             role="dialog" aria-modal="true" aria-labelledby="pocShareTitle"
             data-list-url="@Url.Action("PocShareLinks", "Projects", new { projectId = Model.ProjectId })"
             data-create-url="@Url.Action("CreatePocShareLink", "Projects")"
             data-revoke-url="@Url.Action("RevokePocShareLink", "Projects")"
             data-associate-url="@Url.Action("SearchAssociates", "Projects", new { projectId = Model.ProjectId })">
            <button type="button" class="x" id="pocShareClose" aria-label="Đóng">&times;</button>
            <h2 id="pocShareTitle"><i class="bi bi-link-45deg" aria-hidden="true"></i> Share</h2>

            @* Ô "Gửi cho ai" là autocomplete lấy từ danh bạ nhân sự: nhãn link chỉ có ích khi cùng một
               người luôn được ghi cùng một cách. Vẫn cho gõ tự do (khách ngoài công ty không có trong
               danh bạ), gợi ý chỉ để chọn cho nhanh và cho đúng. *@
            <div class="poc-share-form">
                <div class="poc-share-field poc-share-who">
                    <label for="pocShareLabel">Send to</label>
                    <input type="text" id="pocShareLabel" maxlength="200" autocomplete="off"
                           role="combobox" aria-autocomplete="list" aria-expanded="false"
                           aria-controls="pocShareSuggest" placeholder="Gõ tên, email hoặc NTID…" />
                    <div class="poc-share-suggest hidden" id="pocShareSuggest" role="listbox"
                         aria-label="Gợi ý người nhận"></div>
                </div>
                <div class="poc-share-field poc-share-days">
                    <label for="pocShareDays">Expiry date</label>
                    <select id="pocShareDays">
                        <option value="7">7 ngày</option>
                        <option value="14" selected>14 ngày</option>
                        <option value="30">30 ngày</option>
                    </select>
                </div>
                <button type="button" class="btn primary" id="pocShareCreate">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Tạo link
                </button>
            </div>
            <div class="poc-share-pick hidden" id="pocSharePick"></div>
            <div class="poc-share-msg" id="pocShareMsg" role="status"></div>

            <h3 class="poc-share-list-head">Link đã tạo</h3>
            <div class="poc-share-list" id="pocShareList"></div>
            <div class="modal-actions">
                <button type="button" class="btn" id="pocShareDone">Đóng</button>
            </div>
        </div>
    </div>
}

@* THỬ MODEL KHÁC: bảng so sánh bản chính với các biến thể dựng lại bằng model khác. Mỗi CỘT là một bản
   demo, mỗi HÀNG là một tiêu chí máy đo được (cùng thước tự kiểm với bản chính) — đọc ngang một hàng là so
   các model trên đúng một tiêu chí, ô tốt nhất được tô. Nội dung do poc-variants.js nạp và vẽ (poll khi có
   lượt đang chạy); markup ở đây chỉ là khung. *@
@if (canExperimentModels)
{
    <div class="modal-backdrop hidden" id="pocVariantsModal">
        <div class="modal poc-variants-modal" role="dialog" aria-modal="true" aria-labelledby="pocVariantsTitle"
             data-list-url="@Url.Action("List", "PocVariants", new { projectId = Model.ProjectId })"
             data-start-url="@Url.Action("Start", "PocVariants")"
             data-delete-url="@Url.Action("Delete", "PocVariants")"
             data-demo-url="@Url.Action("Demo", "PocVariants", new { projectId = Model.ProjectId })"
             data-baseline-url="@Url.Action("Mockup", "Projects", new { projectId = Model.ProjectId })"
             data-project-id="@Model.ProjectId">
            <button type="button" class="x" id="pocVariantsClose" aria-label="Đóng">&times;</button>
            <h2 id="pocVariantsTitle"><i class="bi bi-cpu" aria-hidden="true"></i> Thử model khác cho Developer</h2>
            <p class="muted poc-variants-hint">
                Dựng lại bản demo <b>từ đầu</b> bằng model được chọn — cùng AI Design Spec, cùng kịch bản nghiệm thu,
                cùng tầng tự kiểm với bản đang review. Biến thể chạy trong thư mục riêng: bản demo, ghi chú, các
                vòng đã dựng và cổng duyệt <b>không đổi</b>, model của agent Developer cũng giữ nguyên. Mỗi lượt
                tiêu token thật và tính vào chi phí của dự án.
            </p>

            <div class="poc-variants-form">
                @Html.AntiForgeryToken()
                <div class="poc-share-field">
                    <label for="pocVariantsModel">Model</label>
                    <select id="pocVariantsModel"></select>
                </div>
                <button type="button" class="btn primary" id="pocVariantsStart">
                    <i class="bi bi-play-fill" aria-hidden="true"></i> Dựng biến thể
                </button>
            </div>
            <div class="poc-variants-msg" id="pocVariantsMsg" role="status"></div>

            <div class="poc-variants-table-wrap" id="pocVariantsTable"></div>
            <div class="modal-actions">
                <button type="button" class="btn" id="pocVariantsDone">Đóng</button>
            </div>
        </div>
    </div>
}

@section Breadcrumb {
    Projects <span class="sep">&rsaquo;</span> @Model.ProjectName <span class="sep">&rsaquo;</span> <b>POC Review</b>
}

@section Styles {
    <link rel="stylesheet" href="~/css/poc-review.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.POC_REVIEW_CAN_MANAGE = @(canManage ? "true" : "false");
    </script>
    <script src="~/js/poc-review.js" asp-append-version="true"></script>
    @if (canExperimentModels)
    {
        <script src="~/js/poc-variants.js" asp-append-version="true"></script>
    }
}

