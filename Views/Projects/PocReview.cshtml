@model ICOGenerator.Application.Projects.PocReviewPage
@{
    ViewData["Title"] = "POC Review";
    var canManage = ViewBag.CanManageComments is bool cm && cm;
    // Quyền cho HAI nút đóng vòng ở cuối panel ghi chú (chỉnh bản demo / gửi về Requirement) — cả hai
    // endpoint đều đòi RequirementsManage, nên UI phải soi đúng quyền đó chứ không phải DeliveryAdvance.
    var canManageRequirements = ViewBag.CanManageRequirements is bool cmr && cmr;
}

@* Trang review POC: nhúng POC (sandbox, origin opaque — xem ProjectsController.Mockup) trong iframe ở
   chế độ review (annotator được tiêm lúc phục vụ), kèm panel ghi chú bên phải. Người xem bật "chế độ
   ghim", click phần tử trong POC để ghi chú; các ghi chú Open được người duyệt gom vào "Yêu cầu chỉnh
   sửa" ở cổng POC trên Agent Dashboard. Trang cha (đây) giữ toàn bộ thao tác ghi/xóa — iframe chỉ nói
   chuyện qua postMessage nên rào chắn sandbox giữ nguyên. *@

<div class="page-head">
    <div>
        <h1>POC Review</h1>
    </div>
</div>

@* CHI TIẾT KỸ THUẬT: trang này phục vụ người dùng nghiệp vụ đi nghiệm thu bản demo, nên cột phải chỉ
   được chứa thứ họ đối chiếu được bằng mắt với POC. Kết quả vòng tự kiểm (tỉ lệ PASS, headless runtime,
   visual QA) và cách BA diễn đạt lại yêu cầu cho máy (business rule + nhãn có/chưa kịch bản kiểm) là
   ngôn ngữ của đội delivery: với người dùng chúng vừa chiếm chỗ vừa gây hoang mang ("3/5 PASS" thì họ
   phải làm gì?). Gom vào một hộp thoại hai tab, mở từ command bar, chỉ hiện với DeliveryAdvance —
   ĐÚNG quyền đang gate quyền xóa ghi chú của người khác, tức phía delivery/dev, khác hẳn
   RequirementsManage vốn thuộc về chính người dùng nghiệp vụ.
   Cái Ở LẠI cột phải là câu nghiệm thu + kịch bản kiểm + ví dụ tính thử: chữ của chính người dùng, và là
   thứ duy nhất biến buổi review từ "mò lỗi tự do" thành "đối chiếu với điều tôi đã yêu cầu". Cũng vì thế
   nó không vào modal được — modal che kín iframe nên không soi song song với bản demo. *@
@{
    var cov = Model.Coverage;
    var hasUserCoverage = cov.AcceptanceCriteria.Any() || cov.WorkedExamples.Any();
    var hasSpecDetails = cov.Screens.Any() || cov.Rules.Any();
    var untestedAc = cov.AcceptanceCriteria.Where(a => !a.ScenarioTitles.Any()).ToList();
    // Nút chỉ có nghĩa khi thật sự có gì để xem: POC dựng trước các tính năng này không có dữ liệu nào.
    var showTechButton = canManage && (Model.Verification is not null || hasSpecDetails);

    // ---- Ghép câu nghiệm thu ↔ kịch bản kiểm cho panel gộp (xem comment ở panel bên dưới) ----
    var scenarios = Model.Scenarios.Scenarios;
    var acList = cov.AcceptanceCriteria;

    // Chủ sở hữu của mỗi kịch bản = AC ĐẦU TIÊN (theo thứ tự trong spec) mà nó trỏ tới. Một kịch bản
    // chứng minh nhiều AC chỉ được dựng ĐẦY ĐỦ một lần, dưới AC chủ; các AC còn lại chỉ nhắc bằng một
    // dòng trỏ về. Lý do rất cụ thể: hai khối .uat-scenario sinh đôi sẽ mang CÙNG data-key, nên tick ở
    // bản này không sang bản kia cho tới lúc tải lại trang — người review tưởng mình chưa tick.
    // null ⇒ kịch bản không trỏ về AC nào (hoặc spec không parse ra AC nào) → xuống nhóm cuối.
    var ownerAcOf = new string?[scenarios.Count];
    for (var i = 0; i < scenarios.Count; i++)
    {
        var acRefs = scenarios[i].AcRefs;
        ownerAcOf[i] = acList
            .FirstOrDefault(ac => acRefs.Any(r => string.Equals(r, ac.Ref, StringComparison.OrdinalIgnoreCase)))
            ?.Ref;
    }

    // CHỈ SỐ GỐC i phải đi theo kịch bản tới chỗ mới: data-key của checkbox là "@i-@j" và đó là khóa
    // localStorage đã lưu tick của các buổi review trước. Đánh số lại theo thứ tự hiển thị mới sẽ làm
    // lệch toàn bộ tick cũ, nên mọi nhóm bên dưới đều mang theo cặp (kịch bản, chỉ số gốc).
    var scenariosByIndex = Enumerable.Range(0, scenarios.Count).ToList();
    var orphanScenarios = scenariosByIndex.Where(i => ownerAcOf[i] is null).ToList();
    var totalSteps = scenarios.Sum(s => s.Steps.Count);
    var showReviewPanel = hasUserCoverage || scenarios.Any();

    // Một thẻ kịch bản (tiêu đề + mã BR/AC + các bước tick được + nút báo lỗi). Dựng
    // bằng templated delegate vì cùng một thẻ xuất hiện ở hai chỗ: lồng dưới AC nó chứng minh, và ở
    // nhóm kịch bản chưa gắn AC. `item.Index` LUÔN là chỉ số gốc trong Model.Scenarios.Scenarios.
    Func<(ICOGenerator.Contracts.Requirements.UatScenario Scenario, int Index), object> scenarioCard =
    @<div class="uat-scenario" data-screen="@item.Scenario.Screen" data-title="@item.Scenario.Title">
        <div class="uat-title">
            @item.Scenario.Title
            @if (item.Scenario.RuleRefs.Any())
            {
                <span class="uat-rules" title="Business rule kịch bản này kiểm chứng">@string.Join(", ", item.Scenario.RuleRefs)</span>
            }
            @* Mã AC chỉ còn cần khi thẻ KHÔNG nằm dưới AC của nó (spec không parse ra AC nào, hoặc kịch
               bản trỏ về một mã đã biến mất khỏi spec): lúc đó đây là manh mối duy nhất về điều nó
               chứng minh. Nằm dưới đúng AC rồi thì in lại mã ấy chỉ là nhiễu. *@
            @if (ownerAcOf[item.Index] is null && item.Scenario.AcRefs.Any())
            {
                <span class="uat-rules" title="Câu nghiệm thu bạn đã duyệt mà kịch bản này chứng minh">@string.Join(", ", item.Scenario.AcRefs)</span>
            }
        </div>
        <ol class="uat-steps">
            @for (var j = 0; j < item.Scenario.Steps.Count; j++)
            {
                <li>
                    <label>
                        <input type="checkbox" class="uat-step" data-key="@(item.Index)-@(j)" />
                        <span class="uat-step-text" data-step="@item.Scenario.Steps[j]" title="Bấm để POC chỉ chỗ thao tác này">@item.Scenario.Steps[j]</span>
                    </label>
                </li>
            }
        </ol>
        <button type="button" class="btn outline small uat-fail">✗ Báo lỗi kịch bản này</button>
        @* Hai CHỖ TRỐNG của riêng kịch bản này. Ô nhập ghi chú (#pocCommentForm — chỉ có MỘT trên trang,
           dùng chung với đường ghim trên POC) được JS chuyển vào .uat-scenario-form khi bấm "Báo lỗi", và
           các ghi chú đã ghim cho kịch bản này render vào .uat-scenario-notes. Vì sao không để cả hai ở
           cuối cột như trước: người review đang đối chiếu TỪNG kịch bản, mà ô nhập và ghi chú lại rơi
           xuống dưới danh sách chung — họ phải cuộn đi rồi cuộn về để biết mình vừa ghi gì cho kịch bản
           nào. Cả hai div rỗng thì `:empty` ẩn đi nên thẻ kịch bản không dày thêm khi chưa có ghi chú. *@
        <div class="uat-scenario-form"></div>
        <div class="uat-scenario-notes"></div>
    </div>;
}

@* Command bar chuẩn: chỗ đứng của các hành động CẤP TRANG. "Chia sẻ bản demo" nằm ở đây thay vì
   trong cột ghi chú bên phải — mời người khác vào xem là việc của người chủ trì buổi review, không phải
   một mục để đọc lướt khi đang soát ghi chú, và trước đây nó bị chôn giữa các panel gập nên gần như
   không ai thấy. Bấm nút mở hộp thoại; mỗi nút soi quyền riêng của nó nên thanh hiện khi có ít nhất một. *@
@if (canManageRequirements || showTechButton)
{
    var pocActions = new List<CommandBarButton>();
    if (showTechButton)
    {
        var openIssueCount = Model.Verification is { } headVerif && headVerif.OpenIssues.Any()
            ? headVerif.OpenIssues.Count.ToString()
            : null;
        pocActions.Add(new CommandBarButton
        {
            Label = "Chi tiết kỹ thuật",
            Icon = "bi-wrench-adjustable",
            Id = "pocTechOpen",
            OpensDialog = true,
            Title = "Kết quả tự kiểm của hệ thống và đối chiếu spec — dành cho đội delivery",
            Badge = openIssueCount,
            BadgeTitle = "Số điểm máy báo chưa đạt"
        });
    }

    @await Html.PartialAsync("_CommandBar", new CommandBarModel
    {
        Actions = pocActions,
        Primary = canManageRequirements
            ? new CommandBarButton { Label = "Chia sẻ bản demo", Icon = "bi-share", Id = "pocShareOpen" }
            : null
    })
}

<div class="poc-review-layout"
     id="pocReviewRoot"
     data-project-id="@Model.ProjectId"
     data-comments-url="@Url.Action("PocComments", "Projects", new { projectId = Model.ProjectId })"
     data-add-url="@Url.Action("AddPocComment", "Projects")"
     data-delete-url="@Url.Action("DeletePocComment", "Projects")"
     data-reopen-url="@Url.Action("ReopenPocComment", "Projects")"
     data-triage-url="@Url.Action("TriagePocFeedback", "Projects")"
     data-dispatch-url="@Url.Action("DispatchPocFeedback", "Projects")"
     data-gate-open="@(Model.PocGateOpen ? "true" : "false")"
     data-revisions-used="@Model.PocRevisionsUsed"
     data-revision-limit="@Model.PocRevisionLimit">

    <section class="card poc-frame-panel">
        <div class="poc-toolbar">
            <button type="button" id="pinModeBtn" class="btn outline">📌 Bật chế độ ghim</button>
            <a class="btn outline small poc-open-tab"
               asp-action="Mockup"
               asp-route-projectId="@Model.ProjectId"
               target="_blank">Mở tab riêng ↗</a>
        </div>

        @* sandbox trên thẻ iframe LẶP LẠI đúng CSP sandbox mà endpoint Mockup tự đặt (defense-in-depth,
           không nới thêm gì); review=True để server tiêm annotator vào tài liệu (bool binder KHÔNG
           nhận "1" — phải là true/false). *@
        <iframe id="pocFrame"
                title="POC demo"
                src="@Url.Action("Mockup", "Projects", new { projectId = Model.ProjectId, review = true })"
                sandbox="allow-scripts allow-forms allow-modals"></iframe>
    </section>

    <aside class="card poc-comments-panel">
        @* Truy vết yêu cầu↔POC (U2), NỬA DÀNH CHO NGƯỜI DÙNG — MỘT panel duy nhất cho cả điều đã yêu cầu
           lẫn cách kiểm nó. Trước đây đây là hai panel cạnh nhau ("Điều anh/chị đã yêu cầu" và "Kịch bản
           kiểm thử"), nhưng chúng là HAI HƯỚNG CHIẾU CỦA CÙNG MỘT PHÉP JOIN: panel trên đi AC→kịch bản
           qua PocAcceptanceCoverage.ScenarioTitles, panel dưới đi kịch bản→AC qua UatScenario.AcRefs
           (xem GetPocReviewQuery). Tách ra thì phép join đó bị đẩy sang mắt người review: đọc "AC-3" ở
           trên rồi cuộn xuống dò chip AC-3 giữa các thẻ kịch bản — việc máy đã làm sẵn nhưng không bày ra.
           Nay lấy AC làm xương sống (chữ của chính người dùng) và lồng kịch bản dưới AC nó chứng minh:
           mỗi câu nghiệm thu hoặc có đường kiểm ngay bên dưới, hoặc mang nhãn ⚠ "phải tự thử" — quét một
           lượt là thấy cả cam kết lẫn độ phủ. Ví dụ tính thử (số cụ thể họ đã chốt) ở lại cuối panel.
           Fail-open cho POC/spec cũ: không parse ra AC nào thì mọi kịch bản rơi xuống nhóm cuối và panel
           thoái hóa về đúng danh sách kịch bản phẳng như trước. *@
        @if (showReviewPanel)
        {
            <details class="uat-panel poc-coverage-panel" open>
                <summary>
                    📋 Điều anh/chị đã yêu cầu
                    @if (totalSteps > 0)
                    {
                        @* Bộ đếm tiến độ thay cho số kịch bản: gộp xong thì danh sách hết dạng "checklist
                           phẳng để cày tuần tự", nên phải trả lại tín hiệu "còn bao nhiêu việc". JS đổ số
                           sau khi khôi phục tick từ localStorage. *@
                        <span class="poc-count" id="uatProgress" data-total="@totalSteps"></span>
                    }
                </summary>

                @* #uatList bọc toàn bộ phần có thẻ kịch bản: mọi handler trong poc-review.js đều delegate
                   từ phần tử này và tìm ngược bằng closest(".uat-scenario"), nên lồng sâu thêm một cấp
                   vào trong AC không ảnh hưởng gì. *@
                <div id="uatList">
                    @if (acList.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head">Câu nghiệm thu bạn đã duyệt <span class="poc-count">(@acList.Count)</span></div>
                            <ul class="poc-cov-rules poc-ac-list">
                                @foreach (var ac in acList)
                                {
                                    var ownScenarios = scenariosByIndex
                                        .Where(i => string.Equals(ownerAcOf[i], ac.Ref, StringComparison.OrdinalIgnoreCase))
                                        .ToList();
                                    // Kịch bản chứng minh AC này nhưng đã được dựng đầy đủ ở một AC TRƯỚC
                                    // đó (nó trỏ về nhiều AC). Chỉ nhắc một dòng, kèm mã AC chủ để người
                                    // review biết cuộn lên đâu — không dựng lại thẻ, xem lý do ở ownerAcOf.
                                    var xrefScenarios = scenariosByIndex
                                        .Where(i => !string.Equals(ownerAcOf[i], ac.Ref, StringComparison.OrdinalIgnoreCase)
                                                    && scenarios[i].AcRefs.Any(r => string.Equals(r, ac.Ref, StringComparison.OrdinalIgnoreCase)))
                                        .ToList();
                                    <li class="poc-ac-item">
                                        <span class="poc-cov-rule-text">
                                            <b>@ac.Ref</b>@(string.IsNullOrWhiteSpace(ac.Feature) ? "" : $" ({ac.Feature})"): @ac.Text
                                        </span>
                                        @* Chỉ giữ vế CẢNH BÁO, bỏ vế "✓ có kịch bản kiểm: <danh sách title>": vế ✓ là
                                           sổ sách QA (đã có tab kỹ thuật lo), còn vế ⚠ là một CHỈ DẪN cho chính người
                                           đang ngồi review — không ai kiểm hộ điểm này, anh/chị phải tự bấm thử.
                                           Gộp xong nhãn này còn đắt hơn: nó là một CHỖ TRỐNG ngay dưới câu nghiệm
                                           thu, đúng nơi đáng lẽ phải có kịch bản. *@
                                        @if (!ac.ScenarioTitles.Any())
                                        {
                                            <span class="poc-cov-rule-untested" title="Chưa có kịch bản UAT nào chứng minh câu này — hãy tự thử trên bản demo">⚠ chưa có kịch bản kiểm — anh/chị nên tự thử điểm này</span>
                                        }
                                        @foreach (var i in ownScenarios)
                                        {
                                            @scenarioCard((scenarios[i], i))
                                        }
                                        @foreach (var i in xrefScenarios)
                                        {
                                            <div class="poc-ac-xref" title="Kịch bản này chứng minh nhiều câu nghiệm thu — các bước của nó nằm ở câu nghiệm thu phía trên">
                                                ↳ còn được kiểm bởi kịch bản «@scenarios[i].Title» (các bước ở @ownerAcOf[i])
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (orphanScenarios.Any())
                    {
                        <div class="poc-cov-group">
                            @if (acList.Any())
                            {
                                <div class="poc-cov-head">Kịch bản chưa gắn câu nghiệm thu nào <span class="poc-count">(@orphanScenarios.Count)</span></div>
                                <p class="muted poc-panel-hint">Các kịch bản này không trỏ về câu nghiệm thu nào ở trên — vẫn nên đi thử một lượt.</p>
                            }
                            else
                            {
                                @* Không parse được AC nào (POC/spec bản cũ): panel thoái hóa về đúng danh
                                   sách kịch bản phẳng của phiên bản trước, không để lại vùng trống. *@
                                <div class="poc-cov-head">🧭 Kịch bản kiểm thử <span class="poc-count">(@orphanScenarios.Count)</span></div>
                                <p class="muted poc-panel-hint">Đi theo từng kịch bản, tick các bước đã đạt; bấm vào một bước để POC <b>chỉ chỗ</b> cần thao tác; bước nào sai thì bấm "Báo lỗi".</p>
                            }
                            @foreach (var i in orphanScenarios)
                            {
                                @scenarioCard((scenarios[i], i))
                            }
                        </div>
                    }
                </div>

                @if (cov.WorkedExamples.Any())
                {
                    <div class="poc-cov-group">
                        <div class="poc-cov-head">Ví dụ tính thử đã chốt <span class="poc-count">(@cov.WorkedExamples.Count)</span></div>
                        <ul class="poc-cov-worked">
                            @foreach (var we in cov.WorkedExamples)
                            {
                                <li>@we</li>
                            }
                        </ul>
                    </div>
                }
            </details>
        }

        @* Panel "Máy đã tự kiểm" từng nằm ở đây — nay ở hộp thoại "Chi tiết kỹ thuật" trên command bar. *@

        @* CÁC VÒNG ĐÃ DỰNG: mỗi vòng "Yêu cầu chỉnh sửa" ghi đè thẳng lên poc-demo.html, nên bản chụp ở
           đây là đường DUY NHẤT để người nghiệm thu mở lại bản họ đã xem và tự đối chiếu — thay vì phải
           tin vào bản bàn giao bằng chữ của agent. Ẩn khi chưa có bản chụp nào (POC dựng trước tính năng
           này) hoặc mới đúng một vòng. *@
        @if (Model.Versions.Snapshots.Count > 1)
        {
            var snapshots = Model.Versions.Snapshots;
            var latest = snapshots[^1];
            var diff = Model.Versions.DiffWithPrevious;
            <details class="uat-panel poc-versions-panel" open>
                <summary>🕘 Các vòng đã dựng <span class="poc-count">(@snapshots.Count)</span></summary>
                <p class="muted poc-panel-hint">Bản đang xem là vòng @latest.Version. Mở lại vòng trước để so bằng mắt những gì đã đổi.</p>

                @if (diff.HasChanges)
                {
                    <div class="poc-cov-group">
                        <div class="poc-cov-head">Khác biệt màn hình so với vòng @Model.Versions.PreviousVersion:</div>
                        <ul class="poc-cov-worked">
                            @foreach (var screen in diff.AddedScreens)
                            {
                                <li class="poc-verif-ok">+ thêm màn hình «@screen»</li>
                            }
                            @foreach (var screen in diff.RemovedScreens)
                            {
                                <li class="poc-verif-bad">− bỏ màn hình «@screen» — kiểm tra xem đây có phải chủ ý không</li>
                            }
                        </ul>
                    </div>
                }
                else if (Model.Versions.PreviousVersion is not null)
                {
                    <p class="muted">Vòng này không thêm/bỏ màn hình nào so với vòng @Model.Versions.PreviousVersion — thay đổi nằm bên trong các màn hình đã có.</p>
                }

                <ul class="poc-cov-worked poc-version-list">
                    @foreach (var snapshot in snapshots.Reverse())
                    {
                        <li>
                            <a asp-action="Mockup"
                               asp-route-projectId="@Model.ProjectId"
                               asp-route-version="@snapshot.Version"
                               target="_blank"
                               rel="noopener">Vòng @snapshot.Version ↗</a>
                            <span class="muted"> — @snapshot.CapturedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            @if (snapshot.Version == latest.Version)
                            {
                                <span class="poc-verif-ok"> (bản đang xem)</span>
                            }
                        </li>
                    }
                </ul>
            </details>
        }

        @* Checklist UAT (kịch bản đi-từng-bước sinh từ AI Design Spec) từng là một panel riêng ở đây —
           nay lồng dưới chính câu nghiệm thu mà mỗi kịch bản chứng minh, trong panel "Điều anh/chị đã
           yêu cầu" phía trên. *@

        <h3>Ghi chú trên POC <span class="poc-count" id="pocCommentCount"></span></h3>
        @* MỘT đường đóng vòng thay cho hai nút cũ ("nhờ Dev chỉnh bản demo" / "gửi về Requirement").
           Vì sao gộp: hai đường đó bắt người xem demo — dân nghiệp vụ — tự phân loại ghi chú của mình,
           trong khi chính hệ thống làm được phép phân loại ấy (poc-feedback-triage.v1.md). Tệ hơn, CẢ HAI
           nút cũ đều nuốt trọn mọi ghi chú Open nên một buổi review lẫn hai loại (chuyện thường) không có
           nút nào đúng: bấm nút Dev thì tài liệu giữ nguyên chỗ hiểu sai, bấm nút Requirement thì các ghi
           chú thẩm mỹ bị đánh dấu RoutedToRequirement dù BA đã loại chúng khỏi tin nhắn — mất trắng.
           Nay: máy đề xuất nhóm cho từng ghi chú → người dùng soát/đổi trong hộp xác nhận → mỗi đường chỉ
           nhận đúng tập con của nó. Quyền vẫn là RequirementsManage như hai endpoint cũ. *@
        @* NGHIỆM THU: điểm dừng của hành trình phía người yêu cầu. Ba đường bên dưới đều là "còn sai chỗ
           này"; thiếu đường "được rồi" thì đội delivery phải đi hỏi miệng và chặng cuối stepper trên trang
           Requirements không bao giờ đóng. Bấm KHÔNG đẩy pipeline — chỉ ghi nhận + báo người có quyền duyệt. *@
        @if (Model.PocAcceptedAtUtc.HasValue)
        {
            <div class="poc-accepted">
                ✓ <b>Đã nghiệm thu</b>@(string.IsNullOrWhiteSpace(Model.PocAcceptedBy) ? "" : $" bởi {Model.PocAcceptedBy}")
                · @Model.PocAcceptedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                <div class="muted poc-panel-hint">Đội delivery đã được báo. Anh/chị vẫn ghim thêm ghi chú được nếu phát hiện điểm cần sửa.</div>
            </div>
        }
        else if (canManageRequirements && Model.HasMockup)
        {
            <div class="poc-accept">
                <button type="button" id="pocAcceptBtn" class="btn approve small full"
                        data-accept-url="@Url.Action("AcceptPoc", "Projects")">
                    ✓ Bản demo đã đạt
                </button>
            </div>
        }

        @if (canManageRequirements)
        {
            <div class="poc-route-req">
                <button type="button" id="pocSendFeedbackBtn" class="btn primary small full">
                    📤 Gửi ghi chú cho đội xử lý
                </button>
                <p class="muted poc-panel-hint" id="pocSendFeedbackHint">
                    @if (Model.PocGateOpen)
                    {
                        <text>
                            Bấm để xem hệ thống xếp từng ghi chú vào đường nào — anh/chị đổi được trước khi gửi.
                            Đã dùng <b>@Model.PocRevisionsUsed/@Model.PocRevisionLimit</b> vòng chỉnh bản demo.
                        </text>
                    }
                    else
                    {
                        @* Cổng POC đóng ⇒ đường chỉnh bản demo không chạy được. Nói thẳng ở đây: trước đây
                           nút đó chỉ lặng lẽ biến mất, và người dùng đẩy luôn ghi chú thẩm mỹ vào pipeline
                           tài liệu — đúng cái panel này muốn tránh. *@
                        <text>
                            Quy trình đã đi qua bước bản demo nên vòng chỉnh sửa demo không còn mở — lượt này
                            chỉ gửi được các điểm <b>hiểu sai yêu cầu</b> về BA để sửa tài liệu.
                        </text>
                    }
                </p>
            </div>

            @* Hộp xác nhận: bảng phân loại của máy, mỗi ghi chú một dòng và đổi nhóm được. Dựng rỗng ở đây,
               JS đổ nội dung sau khi gọi TriagePocFeedback. *@
            <div class="modal-backdrop hidden" id="pocDispatchModal">
                <div class="modal poc-dispatch-modal">
                    <button type="button" class="x" id="pocDispatchClose" aria-label="Đóng">&times;</button>
                    <h3>Gửi ghi chú đi xử lý</h3>
                    <p class="muted poc-dispatch-note" id="pocDispatchNote"></p>
                    <div id="pocDispatchGroups"></div>
                    <div class="poc-dispatch-msg" id="pocDispatchMsg"></div>
                    <div class="modal-actions">
                        <button type="button" class="btn outline small" id="pocDispatchCancel">Hủy</button>
                        <button type="button" class="btn primary small" id="pocDispatchConfirm">Gửi</button>
                    </div>
                </div>
            </div>
        }

        <form id="pocCommentForm" class="poc-comment-form" hidden>
            @Html.AntiForgeryToken()
            <div class="poc-target-label" id="pocTargetLabel"></div>
            <textarea id="pocCommentText" rows="3" maxlength="4000"
                      placeholder="Phần tử này cần sửa gì? Ví dụ: đổi nhãn thành 'Lưu', thêm cột Trạng thái…"></textarea>
            <div class="poc-form-actions">
                <button type="submit" class="btn primary small">Ghim ghi chú</button>
                <button type="button" class="btn outline small" id="pocCommentCancel">Hủy</button>
            </div>
        </form>

        <div id="pocCommentList" class="poc-comment-list">
            <p class="muted">Đang tải ghi chú…</p>
        </div>

        @* Changelog các vòng "Yêu cầu chỉnh sửa" đã chạy: bàn giao cuối của agent nêu đã đổi gì ứng với
           từng ghi chú — người review thấy ngay POC mới khác gì thay vì phải tự so hai bản. *@
        @if (Model.Revisions.Any())
        {
            <div class="poc-changelog">
                <h3>Nhật ký vòng sửa <span class="poc-count">(@Model.Revisions.Count)</span></h3>
                @foreach (var revision in Model.Revisions)
                {
                    <details class="poc-changelog-item">
                        <summary>@revision.Title@(revision.FinishedAt.HasValue ? $" · {revision.FinishedAt.Value.ToLocalTime():dd/MM HH:mm}" : "")</summary>
                        <pre>@revision.Output</pre>
                    </details>
                }
            </div>
        }
    </aside>
</div>

@* CHI TIẾT KỸ THUẬT (chỉ DeliveryAdvance): hai tab gom trọn phần nội dung mà người dùng nghiệp vụ
   không đọc được — kết quả vòng tự kiểm cuối, và cách BA diễn đạt lại yêu cầu cho máy. Đặt ngoài
   layout hai cột vì backdrop là phần tử toàn màn hình. *@
@if (showTechButton)
{
    <div class="modal-backdrop hidden" id="pocTechModal">
        <div class="modal poc-tech-modal" role="dialog" aria-modal="true" aria-labelledby="pocTechTitle">
            <button type="button" class="x" id="pocTechClose" aria-label="Đóng">&times;</button>
            <h2 id="pocTechTitle"><i class="bi bi-wrench-adjustable" aria-hidden="true"></i> Chi tiết kỹ thuật</h2>

            <div class="poc-tech-tabs" role="tablist" aria-label="Chi tiết kỹ thuật">
                @* Tab mặc định là tab có tín hiệu HÀNH ĐỘNG: nếu chưa có dữ liệu tự kiểm (POC cũ) thì
                   rơi về tab đối chiếu spec, để hộp thoại không bao giờ mở ra một panel rỗng. *@
                <button type="button" class="poc-tech-tab@(Model.Verification is not null ? " active" : "")"
                        role="tab" id="pocTechTabVerif" aria-controls="pocTechPanelVerif"
                        aria-selected="@(Model.Verification is not null ? "true" : "false")"
                        data-panel="pocTechPanelVerif" @(Model.Verification is null ? "disabled" : "")>
                    🧪 Máy đã tự kiểm
                    @if (Model.Verification is { } tabVerif && tabVerif.OpenIssues.Any())
                    {
                        <span class="poc-tech-badge">@tabVerif.OpenIssues.Count</span>
                    }
                </button>
                <button type="button" class="poc-tech-tab@(Model.Verification is null ? " active" : "")"
                        role="tab" id="pocTechTabSpec" aria-controls="pocTechPanelSpec"
                        aria-selected="@(Model.Verification is null ? "true" : "false")"
                        data-panel="pocTechPanelSpec" @(hasSpecDetails ? "" : "disabled")>
                    🎯 Đối chiếu spec
                </button>
            </div>

            @* ---- Tab 1: kết quả vòng tự kiểm cuối (audit tĩnh + headless browser + oracle ví dụ đã
               chốt + visual QA): máy ĐÃ xác nhận gì (đỡ kiểm lại bằng tay) và còn issue nào agent chưa
               xử lý được sau các vòng sửa (chỗ cần soi kỹ nhất). ---- *@
            <div class="poc-tech-panel@(Model.Verification is null ? " hidden" : "")"
                 id="pocTechPanelVerif" role="tabpanel" aria-labelledby="pocTechTabVerif" tabindex="0">
                @if (Model.Verification is { } verif)
                {
                    var selfPass = verif.SelfTestResults.Count(r => r.StartsWith("PASS", StringComparison.Ordinal));
                    var scenarioPass = verif.ScenarioResults.Count(r => r.StartsWith("PASS", StringComparison.Ordinal));
                    var weOk = Math.Max(0, verif.WorkedExamplesTotal - verif.WorkedExampleIssues.Count);
                    <p class="muted poc-panel-hint">
                        Kết quả vòng kiểm tự động cuối cùng trước khi bàn giao POC (@verif.CheckedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")) —
                        những mục ✓ máy đã xác nhận chạy đúng; những mục ✗ là chỗ nên soi kỹ khi review.
                        @if (verif.OpenIssues.Any())
                        {
                            <b class="poc-verif-bad">Còn @verif.OpenIssues.Count điểm chưa đạt.</b>
                        }
                        else
                        {
                            <b class="poc-verif-ok">Vòng kiểm cuối sạch.</b>
                        }
                    </p>

                    <ul class="poc-verif-lines">
                        @if (verif.RuntimeRan)
                        {
                            @if (verif.SelfTestResults.Any())
                            {
                                <li class="@(selfPass == verif.SelfTestResults.Count ? "poc-verif-ok" : "poc-verif-bad")">
                                    Quy tắc nghiệp vụ tự kiểm: @selfPass/@verif.SelfTestResults.Count PASS
                                </li>
                            }
                            @if (verif.ScenarioResults.Any())
                            {
                                <li class="@(scenarioPass == verif.ScenarioResults.Count ? "poc-verif-ok" : "poc-verif-bad")">
                                    Kịch bản end-to-end: @scenarioPass/@verif.ScenarioResults.Count PASS
                                </li>
                            }
                            @if (verif.WorkedExamplesTotal > 0)
                            {
                                <li class="@(verif.WorkedExampleIssues.Any() ? "poc-verif-bad" : "poc-verif-ok")">
                                    Ví dụ đã chốt với người dùng: POC tính đúng @weOk/@verif.WorkedExamplesTotal
                                </li>
                            }
                            @if (verif.SpecScreens > 0)
                            {
                                <li class="@(verif.CoveredScreens >= verif.SpecScreens ? "poc-verif-ok" : "poc-verif-bad")">
                                    Độ phủ màn hình theo spec: @verif.CoveredScreens/@verif.SpecScreens
                                </li>
                            }
                            @* Kịch bản nghiệm thu: sinh TRƯỚC khi POC được dựng, nên đây là thước đo độc lập
                               với các assertion do chính agent dựng POC viết. Hai dòng: có mục tương ứng đang
                               PASS không, và lượt lái THẬT bằng click có thao tác được không. *@
                            @if (verif.UatTotal > 0)
                            {
                                <li class="@(verif.UatCovered >= verif.UatTotal ? "poc-verif-ok" : "poc-verif-bad")">
                                    Kịch bản nghiệm thu (checklist ở cột phải) POC tự chạy đúng: @verif.UatCovered/@verif.UatTotal
                                </li>
                            }
                            @if (verif.UatDriveResults.Any())
                            {
                                var drivePass = verif.UatDriveResults.Count(x => x.StartsWith("PASS", StringComparison.Ordinal));
                                <li class="@(drivePass == verif.UatDriveResults.Count ? "poc-verif-ok" : "poc-verif-bad")">
                                    Máy bấm thử theo kịch bản (click thật trên POC): @drivePass/@verif.UatDriveResults.Count kịch bản thao tác được
                                </li>
                            }
                            @if (verif.CrossScreenIssues.Any())
                            {
                                <li class="poc-verif-bad">
                                    Dữ liệu mẫu lệch nhau giữa các màn hình: @verif.CrossScreenIssues.Count chỗ
                                </li>
                            }
                            @if (verif.VisualRan)
                            {
                                <li class="@(verif.VisualWarnings.Any() ? "" : "poc-verif-ok")">
                                    UI/UX agent đã soát ảnh từng màn hình@(verif.VisualWarnings.Any() ? $" — {verif.VisualWarnings.Count} cảnh báo nhỏ" : "")
                                </li>
                            }
                        }
                        else
                        {
                            <li class="muted">Tầng chạy thử trong trình duyệt không hoạt động ở môi trường này (@verif.RuntimeSkipReason) — chỉ có kiểm tra tĩnh.</li>
                        }
                    </ul>

                    @* ĐÃ SỬA ĐƯỢC so với vòng kiểm trước. Từ vòng review thứ hai trở đi, câu hỏi đầu tiên của
                       người review luôn là "lần sửa vừa rồi đụng vào những gì?" — không có danh sách này họ
                       phải rà lại cả bản demo từ đầu, dù hệ thống đã có sẵn dữ liệu để trả lời. *@
                    @if (Model.VerificationFixes.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head poc-verif-ok">✓ Đã sửa được so với vòng kiểm trước (@Model.VerificationFixes.Count):</div>
                            <ul class="poc-verif-lines">
                                @foreach (var fix in Model.VerificationFixes.Take(8))
                                {
                                    <li class="poc-verif-ok">@fix</li>
                                }
                            </ul>
                        </div>
                    }

                    @* HỒI QUY giữa các vòng sửa: thứ từng chạy đúng mà vòng sửa sau làm gãy. Tách riêng khỏi
                       "điểm chưa đạt" vì đây là tín hiệu KHÁC hẳn — không phải "chưa làm xong" mà là "đã lùi". *@
                    @if (verif.Regressions.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head poc-verif-bad">⚠ Đã chạy đúng ở vòng trước nhưng vòng này hỏng lại (@verif.Regressions.Count):</div>
                            <ul class="poc-verif-issues">
                                @foreach (var regression in verif.Regressions.Take(6))
                                {
                                    <li>@regression</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (verif.OpenIssues.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head poc-verif-bad">Điểm máy báo CHƯA ĐẠT mà agent chưa xử lý xong — ưu tiên xem khi review:</div>
                            <ul class="poc-verif-issues">
                                @foreach (var issue in verif.OpenIssues.Take(8))
                                {
                                    <li>@issue</li>
                                }
                                @if (verif.OpenIssues.Count > 8)
                                {
                                    <li class="muted">… và @(verif.OpenIssues.Count - 8) điểm khác.</li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>

            @* ---- Tab 2: đối chiếu spec — màn hình + business rule chắt từ AI Design Spec đã duyệt, kèm
               kịch bản UAT nào kiểm quy tắc nào. Đây là cách BA diễn đạt lại yêu cầu cho máy, nên nó nói
               chuyện với đội delivery chứ không với người nghiệm thu. ---- *@
            <div class="poc-tech-panel@(Model.Verification is not null ? " hidden" : "")"
                 id="pocTechPanelSpec" role="tabpanel" aria-labelledby="pocTechTabSpec" tabindex="0">
                @if (hasSpecDetails)
                {
                    <p class="muted poc-panel-hint">Chắt từ AI Design Spec (đã duyệt) — POC đáng lẽ phải phủ những gì, và mỗi quy tắc có kịch bản UAT nào kiểm.</p>

                    @if (cov.Screens.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head">Màn hình theo yêu cầu <span class="poc-count">(@cov.Screens.Count)</span></div>
                            <div class="poc-cov-chips">
                                @foreach (var screen in cov.Screens)
                                {
                                    <span class="poc-cov-chip">@screen</span>
                                }
                            </div>
                        </div>
                    }

                    @if (cov.Rules.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head">Quy tắc nghiệp vụ <span class="poc-count">(@cov.Rules.Count)</span></div>
                            <ul class="poc-cov-rules">
                                @foreach (var rule in cov.Rules)
                                {
                                    <li>
                                        <span class="poc-cov-rule-text">@rule.Rule</span>
                                        @if (rule.ScenarioTitles.Any())
                                        {
                                            <span class="poc-cov-rule-tested" title="Kịch bản UAT kiểm quy tắc này">✓ có kịch bản kiểm: @string.Join("; ", rule.ScenarioTitles)</span>
                                        }
                                        else
                                        {
                                            <span class="poc-cov-rule-untested" title="Chưa có kịch bản UAT nào tham chiếu quy tắc này">⚠ chưa có kịch bản kiểm</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @* Nhắc lại các câu nghiệm thu CHƯA có kịch bản kiểm: ở cột phải người dùng chỉ thấy cảnh
                       báo rời từng dòng, còn đội delivery cần biết tổng cộng còn bao nhiêu điểm hở. *@
                    @if (untestedAc.Any())
                    {
                        <div class="poc-cov-group">
                            <div class="poc-cov-head poc-verif-bad">Câu nghiệm thu chưa có kịch bản UAT nào chứng minh (@untestedAc.Count):</div>
                            <ul class="poc-cov-rules">
                                @foreach (var ac in untestedAc)
                                {
                                    <li><span class="poc-cov-rule-text"><b>@ac.Ref</b>: @ac.Text</span></li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>

            <div class="modal-actions">
                <button type="button" class="btn" id="pocTechDone">Đóng</button>
            </div>
        </div>
    </div>
}

@* CHIA SẺ bản demo cho người không có tài khoản: nghiệm thu thật luôn có nhiều người, mà trang này bị
   chặn theo quyền truy cập project. Link luôn có hạn dùng và thu hồi được; người xem chỉ mở được đúng
   bản demo + ghim góp ý, không thấy gì khác của dự án. Hộp thoại mở từ nút trên command bar; đặt ngoài
   layout hai cột vì backdrop là phần tử toàn màn hình, không thuộc cột ghi chú. *@
@if (canManageRequirements)
{
    <div class="modal-backdrop hidden" id="pocShareModal">
        <div class="modal poc-share-modal" id="pocSharePanel"
             role="dialog" aria-modal="true" aria-labelledby="pocShareTitle"
             data-list-url="@Url.Action("PocShareLinks", "Projects", new { projectId = Model.ProjectId })"
             data-create-url="@Url.Action("CreatePocShareLink", "Projects")"
             data-revoke-url="@Url.Action("RevokePocShareLink", "Projects")"
             data-associate-url="@Url.Action("SearchAssociates", "Projects", new { projectId = Model.ProjectId })">
            <button type="button" class="x" id="pocShareClose" aria-label="Đóng">&times;</button>
            <h2 id="pocShareTitle"><i class="bi bi-link-45deg" aria-hidden="true"></i> Chia sẻ bản demo</h2>

            @* Ô "Gửi cho ai" là autocomplete lấy từ danh bạ nhân sự: nhãn link chỉ có ích khi cùng một
               người luôn được ghi cùng một cách. Vẫn cho gõ tự do (khách ngoài công ty không có trong
               danh bạ), gợi ý chỉ để chọn cho nhanh và cho đúng. *@
            <div class="poc-share-form">
                <div class="poc-share-field poc-share-who">
                    <label for="pocShareLabel">Gửi cho ai</label>
                    <input type="text" id="pocShareLabel" maxlength="200" autocomplete="off"
                           role="combobox" aria-autocomplete="list" aria-expanded="false"
                           aria-controls="pocShareSuggest" placeholder="Gõ tên, email hoặc NTID…" />
                    <div class="poc-share-suggest hidden" id="pocShareSuggest" role="listbox"
                         aria-label="Gợi ý người nhận"></div>
                </div>
                <div class="poc-share-field poc-share-days">
                    <label for="pocShareDays">Hạn dùng</label>
                    <select id="pocShareDays">
                        <option value="7">7 ngày</option>
                        <option value="14" selected>14 ngày</option>
                        <option value="30">30 ngày</option>
                    </select>
                </div>
                <button type="button" class="btn primary" id="pocShareCreate">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Tạo link
                </button>
            </div>
            <div class="poc-share-pick hidden" id="pocSharePick"></div>
            <div class="poc-share-msg" id="pocShareMsg" role="status"></div>

            <h3 class="poc-share-list-head">Link đã tạo</h3>
            <div class="poc-share-list" id="pocShareList"></div>
            <div class="modal-actions">
                <button type="button" class="btn" id="pocShareDone">Đóng</button>
            </div>
        </div>
    </div>
}

@section Breadcrumb {
    Projects <span class="sep">&rsaquo;</span> @Model.ProjectName <span class="sep">&rsaquo;</span> <b>POC Review</b>
}

@section Styles {
    <link rel="stylesheet" href="~/css/poc-review.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.POC_REVIEW_CAN_MANAGE = @(canManage ? "true" : "false");
    </script>
    <script src="~/js/poc-review.js" asp-append-version="true"></script>
}
