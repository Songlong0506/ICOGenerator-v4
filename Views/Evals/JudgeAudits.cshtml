@using System.Globalization
@using ICOGenerator.Application.Evals
@model JudgeAuditPageVm

@{
    ViewData["Title"] = "Judge Audit";
    var canManage = await Permissions.HasPermissionAsync(User, AppPermission.EvalManage);
    var hasActive = Model.Runs.Any(r => r.Status is EvalRunStatus.Queued or EvalRunStatus.Running);

    static string StatusBadge(EvalRunStatus status) => status switch
    {
        EvalRunStatus.Completed => "green",
        EvalRunStatus.Failed => "red",
        EvalRunStatus.Running => "blue",
        EvalRunStatus.Cancelled => "orange",
        _ => "gray"
    };

    static string Utc(DateTime? d) => d is { } v ? v.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC" : "–";

    static string Money(decimal v) =>
        v <= 0 ? "$0.00"
        : v < 0.01m ? "$" + v.ToString("0.####", CultureInfo.InvariantCulture)
        : "$" + v.ToString("N2", CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet" href="~/css/evals.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <h1>Judge Audit</h1>
        <p class="muted">
            Measures how accurately the judge model (<code>BATurnJudge</code>, <code>BACoverageQuestionJudge</code>) rules,
            on the very calls recorded in AI Call Logs. <a asp-action="Index">← Prompt Evals</a>
        </p>
    </div>
</div>

<div class="card table-card eval-card">
    <div class="eval-card-head">
        <h3>Logged judge calls</h3>
        <span class="muted">successful calls only</span>
    </div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr><th>Judge</th><th>Ruling model</th><th>Calls</th><th>From</th><th>To</th></tr>
            </thead>
            <tbody>
                @if (!Model.Availability.Any())
                {
                    <tr><td colspan="5" class="eval-empty">No judge calls in AI Call Logs yet.</td></tr>
                }
                @foreach (var a in Model.Availability)
                {
                    <tr>
                        <td><code>@a.Purpose</code></td>
                        <td>@a.ModelId</td>
                        <td>@a.Count.ToString("N0", CultureInfo.InvariantCulture)</td>
                        <td>@Utc(a.First)</td>
                        <td>@Utc(a.Last)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (canManage)
{
    <div class="card eval-card">
        <div class="eval-card-head">
            <h3>Create an audit</h3>
            <span class="muted">consumes real tokens — cost is recorded on the run, not charged to any project</span>
        </div>
        <form asp-action="StartJudgeAudit" method="post">
            @Html.AntiForgeryToken()
            <div class="form-grid three">
                <div>
                    <label for="jaPurpose">Judge *</label>
                    <select id="jaPurpose" name="purpose" required>
                        @foreach (var p in Model.Purposes)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="jaSource">Only calls ruled by this model</label>
                    <select id="jaSource" name="sourceModelId">
                        <option value="">— All models —</option>
                        @foreach (var m in Model.Availability.Select(a => a.ModelId).Distinct())
                        {
                            <option value="@m">@m</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="jaSample">Sample size * (max @StartJudgeAuditUseCase.MaxSampleSize)</label>
                    <input id="jaSample" name="sampleSize" type="number" min="1" max="@StartJudgeAuditUseCase.MaxSampleSize" value="200" required />
                </div>
                <div>
                    <label for="jaFrom">From date (UTC)</label>
                    <input id="jaFrom" name="from" type="date" />
                </div>
                <div>
                    <label for="jaTo">Through date (UTC)</label>
                    <input id="jaTo" name="to" type="date" />
                </div>
                <div>
                    <label for="jaNote">Note</label>
                    <input id="jaNote" name="note" maxlength="500" placeholder="e.g. try Haiku before enabling" />
                </div>
                <div>
                    <label for="jaCandidate">Replay model (candidate)</label>
                    <select id="jaCandidate" name="candidateModelId">
                        <option value="">— No replay: score the stored verdicts —</option>
                        @foreach (var m in Model.Models)
                        {
                            <option value="@m.Id">@m.Label</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="jaArbiter">Arbiter model *</label>
                    <select id="jaArbiter" name="arbiterModelId" required>
                        @foreach (var m in Model.Models)
                        {
                            <option value="@m.Id">@m.Label</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="checkbox-label">
                        <input type="checkbox" name="arbitrateAll" value="true" />
                        Ask the arbiter even when both verdicts agree
                    </label>
                    <span class="muted">More expensive, but counts errors both models make. No-replay mode always asks the arbiter on every call.</span>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn primary"><i class="bi bi-play-fill" aria-hidden="true"></i> Run audit</button>
            </div>
        </form>
    </div>
}

<div class="card table-card eval-card">
    <div class="eval-card-head">
        <h3>Audits</h3>
        <span class="muted">@Model.Runs.Count most recent</span>
    </div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Created</th><th>Judge</th><th>Mode</th><th>Arbiter</th>
                    <th>Progress</th><th>Disagreements</th><th>Cost</th><th>Status</th><th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Runs.Any())
                {
                    <tr><td colspan="9" class="eval-empty">No audits yet.</td></tr>
                }
                @foreach (var r in Model.Runs)
                {
                    <tr>
                        <td>
                            @Utc(r.CreatedAt)
                            @if (!string.IsNullOrEmpty(r.Note))
                            {
                                <div class="eval-cell-sub">@r.Note</div>
                            }
                        </td>
                        <td>
                            <code>@r.Purpose</code>
                            <div class="eval-cell-sub">source: @(r.SourceModelId ?? "all models")</div>
                        </td>
                        <td>
                            @if (r.IsReplay)
                            {
                                <span>Replay with <b>@r.CandidateModelName</b></span>
                                @if (r.ArbitrateAll)
                                {
                                    <div class="eval-cell-sub">arbiter asked on every call</div>
                                }
                            }
                            else
                            {
                                <span>Score stored verdicts</span>
                            }
                        </td>
                        <td>@r.ArbiterModelName</td>
                        <td>@r.CompletedCount/@(r.CaseCount == 0 ? r.SampleSize : r.CaseCount)</td>
                        <td>@r.DisagreementCount</td>
                        <td>@Money(r.TotalCost)</td>
                        <td>
                            <span class="badge @StatusBadge(r.Status)">@r.Status</span>
                            @if (!string.IsNullOrEmpty(r.Error))
                            {
                                <div class="eval-cell-sub">@r.Error</div>
                            }
                        </td>
                        <td class="actions">
                            <a class="btn outline small" asp-action="JudgeAudit" asp-route-id="@r.Id">Xem</a>
                            @if (canManage && r.Status is EvalRunStatus.Queued or EvalRunStatus.Running)
                            {
                                <form asp-action="CancelJudgeAudit" method="post" class="inline-form"
                                      onsubmit="return confirm('Cancel this audit? Calls already scored are kept.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button class="btn outline small" type="submit">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (hasActive)
{
    @* Run chạy nền vài phút tới vài chục phút: làm mới thô mỗi 10 giây là đủ, không cần endpoint poll riêng. *@
    <script>setTimeout(function () { location.reload(); }, 10000);</script>
}
