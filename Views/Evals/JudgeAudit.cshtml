@using System.Globalization
@using ICOGenerator.Application.Evals
@using ICOGenerator.Services.Evals
@model JudgeAuditDetailVm

@{
    ViewData["Title"] = "Judge Audit Result";
    var run = Model.Run;
    var active = run.Status is EvalRunStatus.Queued or EvalRunStatus.Running;

    // Phán THỪA / phán SÓT của từng trường nghĩa là gì ở chốt chặn thật — thứ quyết định một con số là chấp
    // nhận được hay không. Thừa ở repeats/emptyChips/drop là XOÁ OAN; sót chỉ là để lọt về hành vi khi chưa có phanh.
    var meaning = new Dictionary<string, (string Extra, string Missed)>
    {
        ["repeats"] = ("wrongly blocks a new question", "lets a repeated question through"),
        ["emptyChips"] = ("wrongly deletes a meaningful chip", "misses an empty chip"),
        ["yesNoChips"] = ("wrongly changes a chip set that is not yes/no", "lets a yes/no chip pair close the whole group"),
        ["userMentionsExistingSource"] = ("asks for a file when the user did not mention one in use", "misses a file request turn"),
        ["asksForFile"] = ("mistakes a turn for a file request", "does not recognize a file request"),
        ["drop"] = ("wrongly drops a still-open pending question", "keeps a dead question"),
    };

    static string Pct(double? v) => v is { } x ? (x * 100).ToString("0.0", CultureInfo.InvariantCulture) + "%" : "–";
    static string Utc(DateTime? d) => d is { } v ? v.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC" : "–";
    static string Money(decimal v) =>
        v <= 0 ? "$0.00"
        : v < 0.01m ? "$" + v.ToString("0.####", CultureInfo.InvariantCulture)
        : "$" + v.ToString("N2", CultureInfo.InvariantCulture);

    string Claims(IReadOnlyList<JudgeClaim>? claims, bool unreadable) =>
        unreadable ? "(unreadable ⇒ empty)"
        : claims == null ? "–"
        : claims.Count == 0 ? "(no ruling)"
        : string.Join("\n", claims.Select(c => c.ToString()));
}

@section Styles {
    <link rel="stylesheet" href="~/css/evals.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <h1>Judge Audit Result</h1>
        <p class="muted">
            <code>@run.Purpose</code> ·
            @(run.IsReplay ? $"replayed with {run.CandidateModelName}" : "scored stored verdicts") ·
            arbiter <b>@run.ArbiterModelName</b> ·
            source @(run.SourceModelId ?? "all models") · @Utc(run.From) → @Utc(run.To)
            <br />
            <span class="badge">@run.Status</span> @run.CompletedCount/@run.CaseCount calls · cost @Money(run.TotalCost)
            @if (!string.IsNullOrEmpty(run.Note)) { <span> · @run.Note</span> }
            · <a asp-action="JudgeAudits">← list</a>
        </p>
        @if (!string.IsNullOrEmpty(run.Error))
        {
            <p class="muted">@run.Error</p>
        }
    </div>
</div>

<div class="card eval-card">
    <p>
        <b>@Model.ScoredCases</b> calls scored · <b>@Model.ErrorCases</b> errored calls (not scored) ·
        arbiter asked <b>@Model.ArbiterCalls</b> time(s).
    </p>
    @if (run.IsReplay && !run.ArbitrateAll)
    {
        <p class="muted">
            Calls where both verdicts agree are treated as correct without asking the arbiter. Errors BOTH models make
            are therefore not counted — the figures below are a lower bound of the error rate. Re-run with "ask the arbiter even when
            both agree" for a full measurement.
        </p>
    }
    <p class="muted">
        <b>Extra</b> is a claim the model made that the reference answer does not have; <b>missed</b> is the opposite.
        Read the <b>rate of calls with extras</b> first: that is how many calls the guard did (or would) wrongly remove something the user needs to see.
        The reference answer comes from a model — review a few dozen disagreements below before fully trusting it.
    </p>
</div>

@foreach (var subject in Model.Subjects)
{
    var s = subject.Score;
    <div class="card table-card eval-card">
        <div class="eval-card-head">
            <h3>@(subject.IsCandidate ? "Replay" : "Ruled in production") · @s.Label</h3>
            <span class="muted">
                @s.Cases calls · exact match <b>@Pct(s.ExactRate)</b> ·
                with extras <b>@Pct(s.ExtraRate)</b> (@s.CasesWithExtra calls) ·
                unreadable @s.Unreadable
            </span>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Field</th><th>Correct</th><th>Extra</th><th>Missed</th>
                        <th title="Of the claims the model made, the share that is correct — low = often removes things wrongly">Precision</th>
                        <th title="Of the claims that should have been made, the share caught — low = often lets things through">Recall</th>
                        <th>Extra means</th><th>Missed means</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in s.Fields)
                    {
                        var m = meaning.GetValueOrDefault(f.Field);
                        <tr>
                            <td><code>@f.Field</code></td>
                            <td>@f.Correct</td>
                            <td>@f.Extra <span class="eval-cell-sub">(@f.CasesWithExtra calls)</span></td>
                            <td>@f.Missed</td>
                            <td>@Pct(f.Precision)</td>
                            <td>@Pct(f.Recall)</td>
                            <td class="muted">@m.Extra</td>
                            <td class="muted">@m.Missed</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card table-card eval-card">
    <div class="eval-card-head">
        <h3>Calls disagreeing with the reference or errored</h3>
        <span class="muted">
            @Model.TotalFlaggedCases calls@(Model.TotalFlaggedCases > Model.Cases.Count ? $" — showing the first {Model.Cases.Count}" : "")
        </span>
    </div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Call</th><th>Ruled (A)</th>
                    @if (run.IsReplay) { <th>Replay (B)</th> }
                    <th>Reference answer</th><th>Arbiter explanation</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Cases.Any())
                {
                    <tr><td colspan="@(run.IsReplay ? 5 : 4)" class="eval-empty">No disagreeing calls.</td></tr>
                }
                @foreach (var c in Model.Cases)
                {
                    <tr>
                        <td>
                            @Utc(c.SourceCreatedAt)
                            <div class="eval-cell-sub">@c.SourceModelId</div>
                            <div class="eval-cell-sub"><code>@c.SourceLogId</code></div>
                            @if (c.JudgeInput != null)
                            {
                                <details>
                                    <summary>Judge input</summary>
                                    <pre style="white-space:pre-wrap;max-width:520px">@c.JudgeInput</pre>
                                </details>
                            }
                            else
                            {
                                <div class="eval-cell-sub">original log no longer exists</div>
                            }
                        </td>
                        <td><pre style="white-space:pre-wrap">@Claims(c.Baseline, c.BaselineUnreadable)</pre></td>
                        @if (run.IsReplay)
                        {
                            <td><pre style="white-space:pre-wrap">@Claims(c.Candidate, c.CandidateUnreadable)</pre></td>
                        }
                        <td>
                            @if (c.Error != null)
                            {
                                <span class="badge red">error</span>
                                <div class="eval-cell-sub">@c.Error</div>
                            }
                            else
                            {
                                <pre style="white-space:pre-wrap">@Claims(c.Gold, false)</pre>
                            }
                        </td>
                        <td>@(c.ArbiterNotes ?? (c.ArbiterUsed ? "–" : "(arbiter not asked)"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (active)
{
    <script>setTimeout(function () { location.reload(); }, 10000);</script>
}
