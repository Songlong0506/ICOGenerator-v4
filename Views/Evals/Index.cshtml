@using System.Globalization
@using System.Text.Encodings.Web
@using ICOGenerator.Application.Evals
@model EvalPageVm

@{
    ViewData["Title"] = "Prompt Evals";
    var canManage = await Permissions.HasPermissionAsync(User, AppPermission.EvalManage);

    // Map scenario cho form sửa (JS đổ dữ liệu vào modal) — cùng mẫu DOCS của Agent Dashboard.
    var scenarioMap = Model.Scenarios.ToDictionary(
        s => s.Id.ToString(),
        s => (object)new { name = s.Name, promptKey = s.PromptKey, userInput = s.UserInput, criteria = s.Criteria, isActive = s.IsActive, kind = s.Kind.ToString() });
    var scenariosJson = System.Text.Json.JsonSerializer.Serialize(scenarioMap);

    // Ước lượng chi phí theo lựa chọn bộ lọc prompt của modal chạy ("" = tất cả scenario đang bật).
    var costMap = Model.CostEstimates.ToDictionary(
        c => c.PromptKey ?? "",
        c => (object)new { scenarioCount = c.ScenarioCount, cost = c.EstimatedCost, hasHistory = c.HasHistory });
    var costJson = System.Text.Json.JsonSerializer.Serialize(costMap);

    // Số cột bảng scenario đổi theo quyền — dòng "chưa có gì" phải trải đúng bấy nhiêu cột.
    var scenarioColumnCount = canManage ? 6 : 5;

    static string StatusBadge(EvalRunStatus status) => status switch
    {
        EvalRunStatus.Completed => "green",
        EvalRunStatus.Failed => "red",
        EvalRunStatus.Running => "blue",
        EvalRunStatus.Cancelled => "orange",
        _ => "gray"
    };

    static string ScoreClass(double? score) => score switch
    {
        null => "",
        >= 4.5 => "score-great",
        >= 3.5 => "score-good",
        >= 2.5 => "score-mid",
        _ => "score-bad"
    };

    // Thời lượng run đọc cho người: "42s" / "3m 07s" / "1h 12m".
    static string Duration(TimeSpan? d) =>
        d is not { } t ? "–"
        : t.TotalMinutes < 1 ? $"{t.TotalSeconds:0}s"
        : t.TotalHours < 1 ? $"{t.Minutes}m {t.Seconds:00}s"
        : $"{(int)t.TotalHours}h {t.Minutes:00}m";

    // Chi phí eval hay nhỏ dưới 1 cent (đơn giá $/1M token) — hiện thêm chữ số để không làm tròn về $0.00.
    // Cùng quy tắc với trang Usage để hai nơi đọc ra tiền giống nhau.
    static string Money(decimal v) =>
        v <= 0 ? "$0.00"
        : v < 0.01m ? "$" + v.ToString("0.####", CultureInfo.InvariantCulture)
        : "$" + v.ToString("N2", CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet" href="~/css/evals.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <h1>Prompt Evals</h1>
    </div>
</div>

@if (TempData["RunStarted"] != null)
{
    <div class="server-toast" data-toast-type="info" hidden>Đã xếp hàng run eval — worker sẽ chạy nền, tiến độ cập nhật ngay trong bảng dưới.</div>
}

@await Html.PartialAsync("_CommandBar", new CommandBarModel
{
    SearchPlaceholder = "Tìm scenario…",
    TargetSelector = "#evalScenarios",
    Actions = canManage
        ? new[] { new CommandBarButton { Label = "New", Icon = "bi-plus-lg", OnClick = "openCreateScenario()" } }
        : Array.Empty<CommandBarButton>(),
    Primary = canManage
        ? new CommandBarButton
        {
            Label = "Run eval",
            Icon = "bi-play-fill",
            OnClick = "openRunModal()",
            Disabled = !Model.Scenarios.Any(s => s.IsActive),
            Title = "Chạy toàn bộ scenario đang bật (tốn token thật)"
        }
        : null
})

<div class="card table-card eval-card">
    <div class="eval-card-head">
        <h3>Scenarios (golden set)</h3>
        <span class="muted">@Model.Scenarios.Count(s => s.IsActive) đang bật / @Model.Scenarios.Count tổng</span>
    </div>
    <div class="table-wrap">
        <table id="evalScenarios" class="data-table" data-paginate data-page-size="10">
            <thead>
                <tr>
                    <th>Tên</th>
                    <th>Prompt template</th>
                    <th title="Điểm judge của lần chấm gần nhất trên mọi run">Điểm gần nhất</th>
                    <th>Trạng thái</th>
                    <th>Tạo lúc</th>
                    @if (canManage)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Scenarios.Any())
                {
                    <tr data-cbar-skip><td colspan="@scenarioColumnCount" class="eval-empty">Chưa có scenario nào. Thêm scenario đầu tiên để bắt đầu đo chất lượng prompt.</td></tr>
                }
                @foreach (var s in Model.Scenarios)
                {
                    <tr>
                        <td><b>@s.Name</b></td>
                        <td>
                            <code class="eval-prompt-key">@s.PromptKey</code>
                            @if (s.Kind == ICOGenerator.Domain.Enums.EvalScenarioKind.Interview)
                            {
                                <span class="badge" title="Phỏng vấn mô phỏng nhiều lượt: AI đóng vai người dùng theo hồ sơ, BA phải tự đào thông tin">phỏng vấn</span>
                            }
                        </td>
                        <td>
                            @if (s.LastScore is int last)
                            {
                                <span class="eval-score @ScoreClass(last)">@last/5</span>
                                <span class="eval-cell-sub eval-time" data-utc="@s.LastRunAt!.Value.ToString("o")"></span>
                            }
                            else if (s.LastRunAt != null)
                            {
                                <span class="badge red" title="Lần chạy gần nhất không chấm được (lời gọi lỗi hoặc judge trả sai định dạng)">lỗi</span>
                            }
                            else
                            {
                                <span class="muted">chưa chạy</span>
                            }
                        </td>
                        <td><span class="badge @(s.IsActive ? "green" : "gray")">@(s.IsActive ? "Active" : "Off")</span></td>
                        <td><span class="eval-time" data-utc="@s.CreatedAt.ToString("o")"></span></td>
                        @if (canManage)
                        {
                            <td class="actions">
                                <button class="icon-btn" type="button" aria-label="Sửa scenario" title="Sửa scenario"
                                        onclick="openEditScenario('@s.Id')">
                                    <i class="bi bi-pencil-fill" aria-hidden="true"></i>
                                </button>
                                <form asp-action="DeleteScenario" method="post" class="inline-form"
                                      onsubmit="return confirm('Xoá scenario này? Kết quả các run cũ vẫn được giữ.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button class="icon-btn danger" type="submit" aria-label="Xoá scenario" title="Xoá scenario">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card table-card eval-card">
    <div class="eval-card-head">
        <h3>Runs</h3>

        @* Lọc PHÍA SERVER (khác ô tìm kiếm của command bar — ô đó lọc client trên bảng scenario). *@
        <form asp-action="Index" method="get" class="eval-run-filter">
            <select name="runPromptKey" onchange="this.form.submit()" aria-label="Lọc theo prompt template">
                <option value="">Mọi prompt</option>
                @foreach (var key in Model.RunPromptKeys)
                {
                    <option value="@key" selected="@(Model.RunPromptKeyFilter == key)">@key</option>
                }
            </select>
            <select name="runStatus" onchange="this.form.submit()" aria-label="Lọc theo trạng thái">
                <option value="">Mọi trạng thái</option>
                @foreach (var status in Enum.GetValues<EvalRunStatus>())
                {
                    <option value="@status" selected="@(Model.RunStatusFilter == status)">@status</option>
                }
            </select>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            @if (Model.HasRunFilter)
            {
                <a class="btn outline small" asp-action="Index">Xoá lọc</a>
            }
            <button class="btn outline small" type="button" id="compareBtn" disabled onclick="openCompare()"
                    title="Chọn đúng 2 run (checkbox) để so sánh điểm theo từng scenario">
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i> So sánh 2 run
            </button>
        </form>
    </div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="eval-cmp-col" title="Chọn 2 run để so sánh"></th>
                    <th>Thời điểm</th>
                    <th>Ghi chú</th>
                    <th>Model</th>
                    <th>Judge</th>
                    <th>Prompt</th>
                    <th title="Số scenario đã chạy xong / tổng; kèm số scenario hỏng nếu có">Tiến độ</th>
                    <th>Điểm TB</th>
                    <th title="Tổng chi phí USD (target + judge) theo đơn giá model lúc chạy">Chi phí</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Runs.Any())
                {
                    <tr><td colspan="11" class="eval-empty">@(Model.HasRunFilter ? "Không có run nào khớp bộ lọc." : "Chưa có run nào.")</td></tr>
                }
                @foreach (var r in Model.Runs)
                {
                    var isLive = r.Status is EvalRunStatus.Queued or EvalRunStatus.Running;
                    <tr data-run-id="@r.Id" data-live="@(isLive ? "true" : "false")" data-created="@r.CreatedAt.ToString("o")">
                        <td class="eval-cmp-col"><input type="checkbox" class="cmp-check" value="@r.Id" onchange="onCompareCheckChanged()" /></td>
                        <td>
                            <span class="eval-time" data-utc="@r.CreatedAt.ToString("o")"></span>
                            @if (!string.IsNullOrWhiteSpace(r.CreatedByUsername))
                            {
                                <span class="eval-cell-sub">bởi @r.CreatedByUsername</span>
                            }
                        </td>
                        <td class="eval-note" title="@r.Note">@(string.IsNullOrWhiteSpace(r.Note) ? "–" : r.Note)</td>
                        <td>@r.TargetModelName</td>
                        <td>@r.JudgeModelName</td>
                        <td>@if (string.IsNullOrWhiteSpace(r.PromptKey)) {<span class="muted">tất cả</span>} else {<code class="eval-prompt-key">@r.PromptKey</code>}</td>
                        <td class="run-progress-cell">
                            <span class="run-progress">@r.CompletedCount/@r.ScenarioCount</span>
                            @if (r.FailedCount > 0)
                            {
                                <span class="eval-failed" title="@r.FailedCount scenario chạy hỏng — điểm TB chỉ tính trên các scenario chấm được">@r.FailedCount lỗi</span>
                            }
                        </td>
                        <td class="run-score"><span class="eval-score @ScoreClass(r.AverageScore)">@(r.AverageScore?.ToString("0.00") ?? "–")</span></td>
                        <td class="run-cost">@Money(r.TotalCost)</td>
                        <td class="run-status">
                            <span class="badge @StatusBadge(r.Status)" title="@r.Error">@r.Status</span>
                            @if (r.Duration != null)
                            {
                                <span class="eval-cell-sub">@Duration(r.Duration)</span>
                            }
                        </td>
                        <td class="actions">
                            <button class="btn outline small" type="button" onclick="openRunDetail('@r.Id')">Chi tiết</button>
                            @if (canManage && isLive)
                            {
                                <form asp-action="CancelRun" method="post" class="inline-form"
                                      onsubmit="return confirm('Huỷ run này? Các scenario đã chạy xong vẫn được giữ lại.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="runPromptKey" value="@Model.RunPromptKeyFilter" />
                                    <input type="hidden" name="runStatus" value="@Model.RunStatusFilter" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <button class="icon-btn danger" type="submit" aria-label="Huỷ run" title="Huỷ run (dừng sau scenario đang chạy dở)">
                                        <i class="bi bi-stop-circle" aria-hidden="true"></i>
                                    </button>
                                </form>
                            }
                            else if (canManage)
                            {
                                <form asp-action="DeleteRun" method="post" class="inline-form"
                                      onsubmit="return confirm('Xoá run này cùng toàn bộ kết quả của nó?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="runPromptKey" value="@Model.RunPromptKeyFilter" />
                                    <input type="hidden" name="runStatus" value="@Model.RunStatusFilter" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <button class="icon-btn danger" type="submit" aria-label="Xoá run" title="Xoá run và mọi kết quả của nó">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new ICOGenerator.Application.Shared.PagerModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        PageUrl = p => Url.Action("Index", new { runPromptKey = Model.RunPromptKeyFilter, runStatus = Model.RunStatusFilter, page = p, pageSize = Model.PageSize })!,
        PageSizeUrl = s => Url.Action("Index", new { runPromptKey = Model.RunPromptKeyFilter, runStatus = Model.RunStatusFilter, page = 1, pageSize = s })!
    })
</div>

@if (canManage)
{
    <!-- Modal thêm/sửa scenario: MỘT form dùng chung — JS đổi action (CreateScenario/UpdateScenario) và đổ dữ liệu. -->
    <div id="scenarioModal" class="modal-backdrop hidden">
        <form class="modal eval-modal" method="post" id="scenarioForm">
            @Html.AntiForgeryToken()
            <button type="button" class="x" onclick="closeModal('scenarioModal')">×</button>

            <h2 id="scenarioModalTitle">Thêm Scenario</h2>

            <input type="hidden" name="id" id="scenario-id" />

            <label>Tên *</label>
            <input name="name" id="scenario-name" required placeholder="BA hỏi lại khi thiếu thông tin" />

            @* Kiểu tình huống: một lượt (như trước) hay PHỎNG VẤN MÔ PHỎNG nhiều lượt. Bộ một-lượt chấm
               được một câu trả lời đẹp, nhưng chất lượng yêu cầu lại do CẢ cuộc phỏng vấn quyết định —
               nó có tới đích không và tốn bao nhiêu lượt của người dùng. *@
            <label>Kiểu tình huống *</label>
            <select name="kind" id="scenario-kind">
                <option value="Prompt">Một lượt — chấm câu trả lời cho một đầu vào</option>
                <option value="Interview">Phỏng vấn mô phỏng — AI đóng vai người dùng, chạy trọn cuộc hỏi–đáp</option>
            </select>

            <label>Prompt template *</label>
            <select name="promptKey" id="scenario-prompt-key" required>
                @foreach (var key in Model.PromptKeys)
                {
                    <option value="@key">@key</option>
                }
            </select>

            <label id="scenario-user-input-label">Đầu vào mô phỏng (user gửi gì) *</label>
            <textarea name="userInput" id="scenario-user-input" rows="5" required
                      placeholder="Tôi muốn làm app quản lý kho cho phòng MFG..."></textarea>
            <div class="muted" id="scenario-persona-hint" style="display:none; font-size:11.5px; margin-top:-4px;">
                Với phỏng vấn mô phỏng, đây là <b>hồ sơ vai diễn</b>: bài toán, vai trò, quy trình, con số mà
                "người dùng" giả lập biết — và chỉ tiết lộ khi BA hỏi đúng chỗ.
            </div>

            <label>Tiêu chí chấm (judge đối chiếu từng dòng) *</label>
            <textarea name="criteria" id="scenario-criteria" rows="5" required
                      placeholder="- Phải hỏi lại về X thay vì tự giả định&#10;- Trả lời bằng tiếng Việt&#10;- ..."></textarea>
            <div class="muted eval-form-hint">
                Mỗi dòng là <b>một</b> tiêu chí — judge chấm đạt/trượt từng dòng và hiện thành checklist trong
                chi tiết run, nên dòng càng gọn và kiểm được thì kết quả càng dễ đọc.
            </div>

            <label class="checkbox-line" id="scenario-active-line" style="display:none;">
                <input name="isActive" id="scenario-is-active" type="checkbox" value="true" checked />
                Đang bật (được chạy trong run mới)
            </label>

            <div class="modal-actions">
                <button type="button" class="btn" onclick="closeModal('scenarioModal')">Cancel</button>
                <button class="btn primary" id="scenarioSubmitBtn">Thêm Scenario</button>
            </div>
        </form>
    </div>

    <!-- Modal chạy run -->
    <div id="runModal" class="modal-backdrop hidden">
        <form class="modal eval-modal" asp-action="StartRun" method="post">
            @Html.AntiForgeryToken()
            <button type="button" class="x" onclick="closeModal('runModal')">×</button>

            <h2>Chạy Eval</h2>

            <label>Model mục tiêu *</label>
            <select name="targetModelId" required>
                @foreach (var m in Model.Models)
                {
                    <option value="@m.Id">@m.ModelId</option>
                }
            </select>

            <label>Model judge *</label>
            <select name="judgeModelId" required>
                @foreach (var m in Model.Models)
                {
                    <option value="@m.Id">@m.ModelId</option>
                }
            </select>

            <label>Chỉ chạy scenario của prompt</label>
            <select name="promptKey" id="run-prompt-key">
                <option value="">— tất cả scenario đang bật —</option>
                @foreach (var key in Model.Scenarios.Where(s => s.IsActive).Select(s => s.PromptKey).Distinct().OrderBy(x => x))
                {
                    <option value="@key">@key</option>
                }
            </select>

            @* Ước lượng từ chi phí THẬT của các run gần đây — nút chạy đốt tiền thật, người bấm xứng đáng
               biết con số trước khi bấm chứ không chỉ một lời cảnh báo chung chung. *@
            <div class="eval-cost-estimate" id="run-cost-estimate"></div>

            <label>Ghi chú</label>
            <input name="note" maxlength="500" placeholder="vd: sau khi sửa requirement-chat v3" />

            <div class="modal-actions">
                <button type="button" class="btn" onclick="closeModal('runModal')">Cancel</button>
                <button class="btn primary">▶ Chạy</button>
            </div>
        </form>
    </div>
}

<!-- Modal chi tiết run (nội dung fetch từ /Evals/RunDetail) -->
<div id="runDetailModal" class="modal-backdrop hidden">
    <div class="modal eval-wide-modal">
        <button type="button" class="x" onclick="closeModal('runDetailModal')">×</button>
        <h2 id="runDetailTitle">Chi tiết run</h2>
        <div id="runDetailBody" class="eval-detail-body"><p class="muted">Đang tải…</p></div>
        <div class="modal-actions">
            <button type="button" class="btn" onclick="closeModal('runDetailModal')">Close</button>
        </div>
    </div>
</div>

<!-- Modal so sánh 2 run (nội dung fetch từ /Evals/Compare) -->
<div id="compareModal" class="modal-backdrop hidden">
    <div class="modal eval-wide-modal">
        <button type="button" class="x" onclick="closeModal('compareModal')">×</button>
        <h2>So sánh 2 run</h2>
        <div id="compareBody" class="eval-detail-body"><p class="muted">Đang tải…</p></div>
        <div class="modal-actions">
            <button type="button" class="btn" onclick="closeModal('compareModal')">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.EVALS = {
            scenarios: @Html.Raw(scenariosJson),
            costEstimates: @Html.Raw(costJson),
            createUrl: '@Url.Action("CreateScenario")',
            updateUrl: '@Url.Action("UpdateScenario")'
        };
    </script>
    <script src="~/js/evals.js" asp-append-version="true"></script>
}
