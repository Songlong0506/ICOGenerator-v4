@model Project
@{
    ViewData["Title"] = "Requirements";
    // Trang Requirements chỉ hiển thị tài liệu DỄ HIỂU cho user thường: Product Brief. Bản kỹ thuật
    // (AI Design Spec) và tài liệu kỹ thuật nặng (BRD/SRS/FSD/UserStories) sống ở Agent Dashboard.
    var productBriefs = Model.Documents
        .Where(x => x.FileName == "ProductBrief.docx")
        .ToList();

    var versions = productBriefs
        .GroupBy(x => x.VersionName)
        .OrderByDescending(g => g.Key == "draft" ? int.MaxValue :
            int.TryParse(g.Key.Replace("V", ""), out var n) ? n : 0)
        .ToList();
    var selectedVersion = ViewBag.SelectedVersion?.ToString() ?? "draft";
    var conversations = Model.Conversations
        .OrderBy(x => x.CreatedAt)
        .ToList();
    // Lượt user MỚI NHẤT — nút "✎ sửa" chỉ gắn ở đây (server cũng chỉ sửa được lượt user cuối cùng).
    var lastUserTurnId = conversations.LastOrDefault(x => x.Role == "user")?.Id;
    var workflowRuns = Model.WorkflowRuns
        .OrderBy(x => x.CreatedAt)
        .ToList();
    var workflowStarted = TempData["WorkflowStarted"] != null;
    var autoScrollWorkflowRunId = workflowStarted
        ? workflowRuns.OrderByDescending(x => x.CreatedAt).Select(x => (Guid?)x.Id).FirstOrDefault()
        : null;
    var timelineItems = conversations
        .Select(x => new { Kind = "conversation", CreatedAt = x.CreatedAt, Conversation = (AgentConversation?)x, WorkflowRun = (WorkflowRun?)null })
        .Concat(workflowRuns.Select(x => new { Kind = "workflow", CreatedAt = x.CreatedAt, Conversation = (AgentConversation?)null, WorkflowRun = (WorkflowRun?)x }))
        .OrderBy(x => x.CreatedAt)
        .ToList();

    // Gộp tiến độ thành MỘT timeline thống nhất: các workflow run LIỀN KỀ trên timeline (không có
    // tin nhắn hội thoại xen giữa) thuộc cùng một hành trình — ví dụ "Requirement Design Spec V1"
    // rồi "Delivery Workflow V1" mà worker sinh ngay sau khi spec xong — nên gom vào MỘT panel:
    // một header, một badge, một banner, một feed sự kiện liên tục. Run "lead" (mới nhất trong nhóm)
    // quyết định trạng thái tổng thể; mỗi run vẫn có stream riêng, JS dồn event vào cùng một feed.
    var renderGroups = new List<(string Kind, AgentConversation? Conversation, List<WorkflowRun> Runs)>();
    foreach (var item in timelineItems)
    {
        if (item.Kind == "workflow" && item.WorkflowRun != null)
        {
            if (renderGroups.Count > 0 && renderGroups[^1].Kind == "workflow")
                renderGroups[^1].Runs.Add(item.WorkflowRun);
            else
                renderGroups.Add(("workflow", null, new List<WorkflowRun> { item.WorkflowRun }));
        }
        else if (item.Conversation != null)
        {
            renderGroups.Add(("conversation", item.Conversation, new List<WorkflowRun>()));
        }
    }

    // F5 GIỮA lúc BA đang trả lời: lượt user đã lưu nhưng lượt assistant còn đang sinh nền (ChatStream
    // chạy với CancellationToken.None nên câu trả lời vẫn được lưu, chỉ chưa kịp). Khi lượt hội thoại
    // MỚI NHẤT là của user, câu trả lời còn "đang chờ" — JS hiện lại khung "BA đang soạn…" và chờ câu
    // trả lời được lưu (poll ChatReplyStatus) rồi tải lại, thay vì để bong bóng trả lời biến mất.
    var chatReplyPending = conversations.LastOrDefault()?.Role == "user";

    // Gợi ý chỉ hiển thị cho lượt HỎI mới nhất của BA (item cuối timeline). Các lượt cũ coi như đã trả lời.
    var lastItem = timelineItems.LastOrDefault();
    var lastBaSuggestions = (lastItem != null && lastItem.Kind == "conversation"
            && lastItem.Conversation != null && lastItem.Conversation.Role == "assistant")
        ? ParseSuggestions(lastItem.Conversation.Suggestions)
        : new List<string>();

    // Lượt chào đầu tiên (workspace trống) KHÔNG gợi ý: để người dùng tự mô tả ý tưởng dự án.
    // Chỉ khi đã có hội thoại thì mới hiển thị gợi ý cho lượt hỏi mới nhất của BA.
    var displaySuggestions = lastBaSuggestions;

    // THẺ HỎI GỘP của lượt BA mới nhất (2–4 câu hỏi độc lập đặt cùng lúc). Phải render lại từ cột đã lưu
    // chứ không chỉ dựng bằng JS ở frame done: F5 giữa chừng mà thẻ biến mất thì người dùng mất luôn các
    // câu chưa trả lời, và Message của lượt gộp chỉ là câu dẫn nên màn hình còn lại đúng một câu vô nghĩa.
    var lastBaQuestions = (lastItem != null && lastItem.Kind == "conversation"
            && lastItem.Conversation != null && lastItem.Conversation.Role == "assistant")
        ? ICOGenerator.Services.Requirements.ConversationTurnRenderer.ParseQuestions(lastItem.Conversation.Questions)
        : new List<ICOGenerator.Contracts.Requirements.BAChatQuestion>();

    // BẢNG CỘT của lượt BA vừa đọc một file bảng tính: mỗi cột một dòng, có ô tích "cột này ứng dụng dùng"
    // và ô ý nghĩa BA đã ĐIỀN SẴN để người dùng chỉ sửa chỗ lệch.
    //
    // Bảng còn TREO chừng nào FILE của nó chưa được chốt (ProjectSourceFile.ColumnMap == null), chứ không
    // phải chừng nào nó còn là lượt cuối: người dùng hoàn toàn có thể gõ một câu đính chính bản đọc lại
    // trước khi ngồi tích bảng, và mất bảng vì lý do đó là mất luôn đường chốt phạm vi cột của file — thứ
    // mà cả bước sinh tài liệu lẫn POC seed đều đọc. Chốt xong thì file biến mất khỏi danh sách dưới đây
    // nên bảng tự đóng, không cần cột trạng thái nào khác.
    //
    // Khác thẻ hỏi gộp, bảng này KHÔNG cần đường render bằng JS: lượt đọc file luôn tới sau một lần upload
    // (UploadSource redirect ⇒ tải lại trang), không đi qua khung chat streaming.
    var unconfirmedColumnFiles = Model.SourceFiles
        .Where(s => s.Kind == SourceFileKind.Spreadsheet && s.ColumnMap == null)
        .Select(s => (s.FileName ?? "").Trim())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var lastColumnMap = ICOGenerator.Services.Requirements.ConversationTurnRenderer
        .ParseColumnMap(conversations.LastOrDefault(c => c.Role == "assistant" && !string.IsNullOrWhiteSpace(c.ColumnMap))?.ColumnMap)
        .Where(c => unconfirmedColumnFiles.Contains((c.FileName ?? "").Trim()))
        .ToList();

    // BẢNG PHÂN QUYỀN của lượt BA chốt nhóm «Phân quyền theo nghiệp vụ»: mỗi dòng một chức năng của một
    // màn hình, mỗi cột một vai trò, ô là PHẠM VI DỮ LIỆU chứ không phải dấu tích (xem PermissionMatrixRow).
    //
    // Bảng treo theo DỰ ÁN (Project.PermissionMatrix == null) chứ không theo lượt, cùng lý do với bảng cột:
    // người dùng hoàn toàn có thể gõ một câu hỏi lại trước khi ngồi chọn, và mất bảng vì lý do đó là mất
    // luôn đường chốt phân quyền — thứ mà cả bản đồ bao phủ, cổng Write Requirement lẫn POC đều đọc.
    // Chốt xong thì cột trên project khác null nên bảng tự đóng, không cần cột trạng thái nào khác.
    var lastPermissionMatrix = Model.PermissionMatrix == null
        ? ICOGenerator.Services.Requirements.ConversationTurnRenderer
            .ParsePermissionMatrix(conversations.LastOrDefault(c => c.Role == "assistant" && !string.IsNullOrWhiteSpace(c.PermissionMatrix))?.PermissionMatrix)
        : new List<ICOGenerator.Contracts.Requirements.PermissionMatrixRow>();
    // Các vai trò = CỘT của bảng. PermissionMatrixBuilder đảm bảo mọi dòng có đủ mọi vai theo cùng thứ tự,
    // nên dòng đầu là đủ để dựng hàng tiêu đề.
    var permissionRoles = lastPermissionMatrix.FirstOrDefault()?.Grants.Select(g => g.Role).ToList()
        ?? new List<string>();

    // BA BẢNG CHỐT còn lại, dựng theo đúng khuôn của bảng phân quyền ngay trên: bảng treo theo DỰ ÁN (cột
    // tương ứng trên Project còn null) chứ không theo lượt, nên người dùng gõ thêm một câu hỏi lại rồi mới
    // ngồi rà cũng không mất bảng. Chốt xong thì cột khác null nên bảng tự đóng.
    var lastFlowMap = Model.FlowMap == null
        ? ICOGenerator.Services.Requirements.ConversationTurnRenderer
            .ParseFlowMap(conversations.LastOrDefault(c => c.Role == "assistant" && !string.IsNullOrWhiteSpace(c.FlowMap))?.FlowMap)
        : new List<ICOGenerator.Contracts.Requirements.FlowMapRow>();
    // BẢNG MÀN HÌNH là ngoại lệ của khuôn "treo theo DỰ ÁN" ngay trên, vì nó là cổng DUY NHẤT MỞ LẠI được
    // (ScreenScopeGate): ở lượt bày LẠI thì Project.ScreenScopeMap đã khác null từ lần chốt trước, nên hỏi
    // nó là kết luận "bảng đã trả lời xong" cho một bảng người dùng còn chưa kịp rà — bảng hiện ra rồi F5
    // một cái là mất, và các màn hình mới lại rơi vào bảng phân quyền ở dạng TRẮNG. Phép so đúng là bản ĐÃ
    // CHỐT với chính bảng server vừa bày; xem ScreenScopeMapBuilder.PendingRows.
    var lastScreenScope = ICOGenerator.Services.Requirements.ScreenScopeMapBuilder.PendingRows(
        Model.ScreenScopeMap,
        conversations.LastOrDefault(c => c.Role == "assistant" && !string.IsNullOrWhiteSpace(c.ScreenScopeMap))?.ScreenScopeMap);
    var lastEntityMap = Model.EntityMap == null
        ? ICOGenerator.Services.Requirements.ConversationTurnRenderer
            .ParseEntityMap(conversations.LastOrDefault(c => c.Role == "assistant" && !string.IsNullOrWhiteSpace(c.EntityMap))?.EntityMap)
        : new List<ICOGenerator.Contracts.Requirements.EntityMapRow>();
    var lastReportMap = Model.ReportMap == null
        ? ICOGenerator.Services.Requirements.ConversationTurnRenderer
            .ParseReportMap(conversations.LastOrDefault(c => c.Role == "assistant" && !string.IsNullOrWhiteSpace(c.ReportMap))?.ReportMap)
        : new List<ICOGenerator.Contracts.Requirements.ReportMapRow>();
    // Mục chọn của ô "lấy số từ": các đối tượng người dùng đã GIỮ ở bảng đối tượng. Ô là danh sách đóng vì
    // server xoá mọi giá trị không khớp đối tượng nào — để ô gõ tay là dựng một ô mà chữ vừa gõ biến mất
    // lúc lưu. Chở qua `data-entities` để JS dùng chung một bộ cho cả dòng người dùng tự thêm.
    var reportEntityOptions = ICOGenerator.Services.Requirements.EntityMapBuilder.EntityNames(Model.EntityMap);
    var reportEntityOptionsJson = System.Text.Json.JsonSerializer.Serialize(reportEntityOptions);
    var lastNotificationMap = Model.NotificationMap == null
        ? ICOGenerator.Services.Requirements.ConversationTurnRenderer
            .ParseNotificationMap(conversations.LastOrDefault(c => c.Role == "assistant" && !string.IsNullOrWhiteSpace(c.NotificationMap))?.NotificationMap)
        : new List<ICOGenerator.Contracts.Requirements.NotificationMapRow>();
    // DANH SÁCH NGƯỜI NHẬN của dự án — nguồn của cả bảng "Danh sách người nhận" lẫn hai ô To/CC: bộ người
    // dùng đã tự tay rà (cột NotificationRecipients) nếu có, còn không thì bản gieo từ bảng phân quyền đã
    // chốt. Chở qua `data-options` để JS dùng chung một bộ cho cả dòng người dùng tự thêm.
    var recipientOptions = ICOGenerator.Services.Requirements.NotificationMapBuilder.RecipientOptions(
        Model.NotificationRecipients,
        ICOGenerator.Services.Requirements.PermissionMatrixBuilder.Roles(Model.PermissionMatrix));
    var recipientOptionsJson = System.Text.Json.JsonSerializer.Serialize(recipientOptions);
    // Bước luồng chưa có màn hình nào phụ trách — phép kiểm TẤT ĐỊNH của mối nối luồng ⇄ màn hình, tính
    // lại ở đây thay vì chở qua SSE: sau F5 thì frame done đã đi mất, mà dòng nhắc thì phải còn.
    var uncoveredFlowSteps = lastScreenScope.Count > 0
        ? ICOGenerator.Services.Requirements.ScreenScopeMapBuilder.UncoveredActions(lastScreenScope, Model.FlowMap)
        : new List<string>();

    // GỘP CÂU DẪN VÀO THẺ HỎI: ở lượt gộp, Message chỉ là câu dẫn ngắn ("mình hỏi nhanh mấy điểm sau")
    // — render nó thành bong bóng riêng phía trên thẻ là hai khung liền nhau nói cùng một ý, vì bản thân
    // thẻ đã có dòng dẫn của nó. Nên lượt BA này KHÔNG có bong bóng riêng: câu dẫn xuống làm dòng đầu
    // của chính thẻ hỏi (xem #batchQuestions bên dưới + renderBatchQuestions trong requirements.js).
    // Chỉ áp cho lượt gộp MỚI NHẤT — các lượt gộp cũ trong lịch sử vẫn giữ bong bóng, và bong bóng đó
    // mang dấu vết chỉ-đọc các câu đã hỏi (.batchq-history bên dưới).
    var batchLeadTurn = lastBaQuestions.Count > 0 ? lastItem?.Conversation : null;
    var batchLead = (batchLeadTurn?.Message ?? "").Trim();

    // Cổng tạo tài liệu MỞ khi lượt BA mới nhất MỜI người dùng tạo tài liệu — tức lời nhắn có nhắc tới
    // "Write Requirement". Lời mời chỉ được LƯU sau khi cổng readiness tất định
    // (RequirementReadinessGate.Evaluate — mọi dòng áp dụng của bản đồ bao phủ đã [RÕ]) pass ngay trong
    // lượt chat, nên cổng mở ⇔ panel "Tiến độ khai thác" cũng đã đầy — cùng một nguồn dữ liệu, không thể
    // vênh nhau. Khi chưa mời — kể cả lúc workspace còn trống — KHÔNG có nút nào trên màn hình: BA vẫn
    // đang hỏi thêm, và một nút khóa sẵn chỉ mời người ta bấm vào thứ không bấm được.
    var lastBaTurn = conversations.LastOrDefault(c => c.Role == "assistant");
    var requirementReady = lastBaTurn?.Message?.Contains("Write Requirement", StringComparison.OrdinalIgnoreCase) ?? false;

    // Cờ mời ở trên chỉ trả lời "đã đủ vốn để soạn chưa". Hai câu hỏi còn lại — "có đang soạn không" và
    // "soạn rồi mà chưa có gì mới thì bấm lại để làm gì" — suy TẤT ĐỊNH từ các workflow run + hội thoại
    // đã nạp sẵn trên trang, không thêm cột trạng thái nào để khỏi sinh nguồn sự thật thứ hai.
    var draftRuns = workflowRuns
        .Where(r => r.Name == ICOGenerator.Services.Workflows.WorkflowOrchestrator.RequirementDraftRunName)
        .ToList();

    // ĐANG SOẠN ⇒ khoá nút. Thiếu nhánh này thì bấm xong → redirect → trang render lại với lời mời vẫn ở
    // cuối hội thoại → nút sáng lại, và mỗi lần bấm thêm là một run sinh lại đúng bản draft đó.
    var draftRunInFlight = draftRuns.Any(r => r.Status is WorkflowRunStatus.Queued or WorkflowRunStatus.Running);

    // ĐÃ SOẠN XONG VÀ CHƯA CÓ GÌ MỚI: bản draft đã tồn tại, vòng soạn gần nhất đã kết thúc, và người dùng
    // chưa nói thêm câu nào kể từ đó. Đây là lúc cổng phải ĐÓNG HẲN. Trước đây chỗ này bày lại cả bản tổng
    // kết (nay đã gỡ) kèm nút "🔄 Tạo lại tài liệu", và cả cụm đó là nhiễu ở đúng chỗ người dùng cần tập
    // trung nhất:
    //   - panel workflow ngay phía trên đã nói "Tài liệu đã sẵn sàng · Xem Product Brief" và BA cũng vừa
    //     mời xem lại rồi bấm Approve ⇒ bong bóng này là lần thứ ba nói cùng một điều, mà lại đẩy hành
    //     động thật (đọc Brief → Approve) xuống dưới hàng chục dòng;
    //   - soạn xong rồi thì thứ đáng rà là chính Product Brief — và đường đó đã có, chính xác hơn hẳn:
    //     ghim ghi chú ngay trên bản xem trước (ReviseBriefFromNotes) hoặc nhắn thẳng trong khung chat;
    //   - bấm lại khi chưa bổ sung gì tốn 2–3 lời gọi LLM để ra gần đúng bản cũ rồi GHI ĐÈ bản đang có, mà
    //     model chạy ở temperature > 0 nên bản mới có thể tệ hơn. Chính lời dẫn cũ của cổng cũng khuyên
    //     "nhắn thêm trong khung chat rồi tạo lại" — một cái nút mà dòng chữ trên nó bảo hãy làm việc khác.
    // Đường soạn lại KHÔNG mất: người dùng nhắn một câu là cổng mở lại ở "ready" (xem nhánh dưới).
    var lastFinishedDraftRunAt = draftRuns
        .Where(r => r.Status == WorkflowRunStatus.Completed && r.FinishedAt.HasValue)
        .Max(r => (DateTime?)r.FinishedAt!.Value);
    var lastUserTurnAt = conversations.LastOrDefault(x => x.Role == "user")?.CreatedAt;
    var draftExists = productBriefs.Any(d => d.VersionName == "draft");
    var draftSettled = draftExists
        && lastFinishedDraftRunAt.HasValue
        && (lastUserTurnAt == null || lastUserTurnAt <= lastFinishedDraftRunAt.Value);

    // ĐƯỜNG LÙI KHI BẢN BRIEF ĐÃ CŨ. Cờ mời ở trên đọc chữ trong lượt BA mới nhất, nên có một ca kẹt: bản
    // Brief đã tồn tại, người dùng nhắn một lời đính chính, BA đáp bằng một CÂU HỎI thay vì lời mời ⇒ cổng
    // đóng và không còn đường nào soạn lại bản Brief đang cũ dần so với hội thoại. Xét thêm cổng readiness
    // tất định (cùng hàm mà lượt chat và bước soạn tài liệu dùng — không có giám khảo thứ hai) và CHỈ khi
    // đã có draft: trước lần soạn đầu tiên, cổng vẫn đi theo đúng lời mời của BA như cũ.
    var coverageReady = ICOGenerator.Services.Requirements.RequirementReadinessGate
        .Evaluate(Model.RequirementCoverageMap).Ready;

    // CÒN BẢNG CHỜ CHỐT ⇒ cổng ĐÓNG, kể cả khi hai vế "ready" ở trên đều đúng. Đường lùi ngay trên
    // (draftExists && coverageReady) KHÔNG đọc lượt cuối, nên nếu không có nhánh này thì đúng ở lượt BA vừa
    // bày một bảng ra và vừa nói "rà lại rồi bấm Gửi bảng … giúp mình", nút tạo tài liệu vẫn sáng ngay bên
    // dưới cái bảng đó — hai việc chọi nhau, và người dùng bấm cái nút. Ca thật + cái giá ở
    // PendingConfirmTableGate. Panel của bảng dựng bằng đúng các danh sách ở đầu file này, còn cổng thì hỏi
    // lại cùng dữ liệu ấy qua một hàm tất định để bước soạn tài liệu (ProductBriefDraftService) và
    // requirements.js cùng đọc một luật.
    var pendingTable = ICOGenerator.Services.Requirements.PendingConfirmTableGate.Select(Model);

    // Tên bảng + nhãn nút gửi của TỪNG panel, lấy từ chính cổng chặn rồi render vào data-table-name /
    // data-send-label. requirements.js đọc hai thuộc tính này của panel đang HIỆN để soạn câu chặn ở frame
    // done — nhờ vậy nó không phải chép lại danh sách bảng, và đổi tên một bảng thì chỉ sửa một chỗ.
    var tblColumn = ICOGenerator.Services.Requirements.PendingConfirmTableGate.ColumnMap;
    var tblFlow = ICOGenerator.Services.Requirements.PendingConfirmTableGate.FlowMap;
    var tblEntity = ICOGenerator.Services.Requirements.PendingConfirmTableGate.EntityMap;
    var tblReport = ICOGenerator.Services.Requirements.PendingConfirmTableGate.ReportMap;
    var tblScreen = ICOGenerator.Services.Requirements.PendingConfirmTableGate.ScreenScope;
    var tblPermission = ICOGenerator.Services.Requirements.PendingConfirmTableGate.PermissionMatrix;
    var tblNotification = ICOGenerator.Services.Requirements.PendingConfirmTableGate.NotificationMap;

    // Năm trạng thái loại trừ nhau, xét theo đúng thứ tự ưu tiên: đang chạy > còn bảng chờ chốt > đã xong &
    // chưa có gì mới > sẵn sàng > còn phải khai thác thêm. Chỉ MỘT trạng thái có nút trên màn hình (cổng
    // #writeReqZone trong khung chat mở ở "ready"); bốn trạng thái kia không dựng nút nào:
    //   waiting — chưa đủ thông tin. KHÔNG dựng nút nào (một nút mờ-và-khóa chỉ mời bấm rồi từ chối);
    //             panel "Tiến độ khai thác" bên cạnh là chỗ nói điều còn thiếu.
    //   table   — còn một bảng chốt đang chờ gửi. Cổng đóng, và #tableGate nói ra bảng nào + nút nào —
    //             nhưng CHỈ khi cổng lẽ ra đã mở (tableGateSpeaks ngay dưới). Đứng TRƯỚC "done" vì một
    //             bảng chưa chốt là việc còn phải làm, kể cả khi bản Brief vừa xong.
    //   running — vòng soạn đang chạy. Tiến độ đã có panel .workflow-progress ngay trong khung chat, và
    //             requirement-workflow.js tải lại trang khi run xong.
    //   done    — vừa soạn xong, chưa có gì mới. Cổng đóng; người dùng nhắn thêm một câu là nó mở lại.
    var writeReqState = draftRunInFlight ? "running"
        : pendingTable != null ? "table"
        : draftSettled ? "done"
        : (requirementReady || (draftExists && coverageReady)) ? "ready"
        : "waiting";
    var writeReqOpen = writeReqState == "ready";

    // #tableGate CHỈ NÓI KHI CỔNG LẼ RA ĐÃ MỞ. Bong bóng đó tồn tại để trả lời đúng một câu hỏi: "cái nút
    // quen thuộc ở cuối khung chat đâu mất rồi?" — nên nó chỉ có nghĩa ở lượt mà nếu không vướng bảng thì
    // cổng ĐÃ mở. Trạng thái "table" lại nuốt cả ca lẽ ra là "waiting": lượt BA vừa bày bảng ra và vừa nói
    // "rà lại rồi bấm Gửi bảng … giúp mình" thì chưa có lời mời nào cả, cổng vốn đã đóng IM LẶNG, và một
    // bong bóng ngay dưới cái bảng đang có sẵn nút gửi + câu dẫn của chính nó là lần thứ hai nói cùng một
    // việc — tệ hơn: nó kéo khái niệm "nút tạo tài liệu" vào đầu người dùng đúng lúc họ đang rà từng dòng,
    // và giải thích vì sao thiếu một cái nút chưa ai hứa.
    //
    // Hai ca CẦN nói thì vẫn nói, vì cả hai đều là đường mở cổng mà KHÔNG đọc lượt cuối: fail-open (bảng
    // của lượt TRƯỚC còn treo, đã cuộn khỏi tầm mắt, lượt này model mời bấm nút) và đường lùi "draft đã có
    // + bản đồ đã đủ". Ở đó im lặng đúng là "hệ thống hỏng": người dùng vừa đọc một lời mời rồi nhìn xuống
    // không thấy gì, mà cũng không có gì để bấm để biết vì sao.
    //
    // Cổng CHẶN không đổi một li: trạng thái vẫn là "table", nút vẫn không được dựng, và
    // ProductBriefDraftService vẫn chặn trước mọi lời gọi LLM. Đây thuần là chuyện nói hay không nói.
    // requirements.js dựng lại đúng luật này ở frame done — data-gate-speaks là bản server render để F5
    // không đổi câu trả lời.
    var tableGateSpeaks = writeReqState == "table"
        && !draftSettled
        && (requirementReady || (draftExists && coverageReady));

    // Nhãn KHÔNG còn là "✓ Đúng hết — tạo tài liệu": cụm "đúng hết" là lời gật đầu cho một bản tổng kết
    // ngay phía trên nút, mà bản đó đã gỡ (xem chú thích ở cổng #writeReqZone). Giữ lại thì nút hỏi người
    // dùng xác nhận một thứ họ không được đưa ra để đọc.
    //
    // Nhãn là "Write Requirement" — nguyên văn cái tên mà MỌI chỗ khác đã gọi nó: prompt BA mời bấm nút
    // "Write Requirement" (requirement-chat.v4.md), cổng readiness dò đúng cụm đó trong lượt cuối (biến
    // requirementReady ngay trên), và tài liệu lẫn thông báo lỗi cũng gọi vậy. Dịch riêng cái nhãn thành
    // "Tạo bản mô tả sản phẩm" để lại đúng một khoảng vênh mà người dùng phải tự bắc cầu: BA bảo bấm một
    // nút không có trên màn hình. Giữ nguyên tiếng Anh ở ĐÂY rẻ hơn dịch cả prompt — tên nút là danh tính
    // của một bước quy trình, còn lời dẫn quanh nó vẫn tiếng Việt và đã nói đủ nút này làm gì.
    var writeReqLabel = "Write Requirement";
    var writeReqTitle = "BA đã thu thập đủ thông tin — tạo bản mô tả sản phẩm.";

    // Tài liệu nguồn (ảnh/PDF) người dùng upload cho project + cờ vision của model BA (để cảnh báo).
    var sourceFiles = Model.SourceFiles.OrderByDescending(x => x.CreatedAt).ToList();
    var baSupportsVision = ViewBag.BaSupportsVision is bool bv && bv;

    // Panel tiến độ khai thác (bản đồ bao phủ đã parse) — render lần đầu ở server, sau đó frame done của
    // ChatStream cập nhật live (markup phải khớp renderCoverage trong requirements.js).
    var coverage = ViewBag.Coverage as IReadOnlyList<ICOGenerator.Contracts.Requirements.CoverageMapItem>
        ?? new List<ICOGenerator.Contracts.Requirements.CoverageMapItem>();
    // Nhật ký "điều đã chốt" KHÔNG còn mặt UI nào: không panel sidebar, và cũng không còn bản tổng kết ở
    // cổng tạo tài liệu (xem chú thích ở #writeReqZone). Danh sách vẫn được chắt sau mỗi lượt nhưng chỉ đi
    // vào các đường tiêu thụ của máy, nên view không nhận nó nữa.
    // "Triển vọng phỏng vấn" (InterviewOutlookService) KHÔNG còn danh sách nào lên màn hình: cả ba
    // (OpenQuestions, PlannedScope, WorkedExamples) vẫn được chắt sau mỗi lượt nhưng đi thẳng vào các
    // đường tiêu thụ của máy — ngữ cảnh chat của BA, ngữ cảnh soát mâu thuẫn, và mục "## 13. Worked
    // Examples" của AI Design Spec.
    // Giả định BA tự đưa khi sinh AI Design Spec (mục ## 12. Assumptions) — hiển thị cho user rà lại.
    var specAssumptions = ViewBag.SpecAssumptions as IReadOnlyList<string> ?? new List<string>();
    var specVersion = ViewBag.SpecVersion as string;
    // CỔNG XÁC NHẬN GIẢ ĐỊNH: non-null ⇒ spec đã sinh xong nhưng POC CHƯA được dựng, đang chờ user rà
    // danh sách giả định. Panel giả định lúc này đổi từ "để tham khảo" sang "cổng có nút bấm" — đây là
    // chặn cuối cùng trước lượt dựng POC (lượt đắt nhất tuyến).
    var pendingAssumptions = !string.IsNullOrEmpty(Model.PendingAssumptionsVersion);
    // Tách danh sách giả định thành "mới" và "user đã duyệt ở vòng trước" (Project.ConfirmedAssumptions).
    // Mỗi lần user bác một điểm là spec được sinh LẠI, và spec mới lặp lại gần như nguyên văn các giả
    // định cũ — hỏi lại cả danh sách thì đúng nghĩa "tôi trả lời rồi mà BA cứ hỏi". Cổng chỉ đặt câu hỏi
    // ở phần MỚI; phần đã duyệt vẫn hiện nhưng gấp lại (đổi ý được, chỉ là không bị bắt trả lời lại).
    var confirmedAssumptionKeys = ICOGenerator.Services.Requirements.AssumptionMemory.KeySet(Model.ConfirmedAssumptions);
    var newAssumptions = specAssumptions
        .Where(a => !confirmedAssumptionKeys.Contains(ICOGenerator.Services.Requirements.AssumptionMemory.Key(a)))
        .ToList();
    var reviewedAssumptions = specAssumptions.Except(newAssumptions).ToList();

    // ĐÃ BỎ stepper hành trình 5 chặng ở đầu trang: quy trình thực tế không đi một chiều — user sửa tới
    // sửa lui (chat thêm → sinh lại brief → duyệt lại → dựng lại POC), nên một thanh tuyến tính vừa chiếm
    // chỗ vừa mô tả sai việc đang xảy ra. Trạng thái thật vẫn nằm đúng chỗ nó cần nằm: cổng xác nhận giả
    // định và tiến trình workflow hiện ngay trong khung chat, danh sách bản mô tả nằm ở panel tài liệu.
    // Tiến độ panel: mẫu số là TỔNG số nhóm (không rút theo [KHÔNG ÁP DỤNG]) và nhóm không áp dụng tính
    // là đã xong cho thanh — xem CoverageProgress. Công thức nằm trong parser để bản server render đây và
    // bản JS cập nhật live (renderCoverage) không lệch nhau.
    var coverageProgress = ICOGenerator.Services.Requirements.CoverageMapParser.Progress(coverage);

    // "Chào lại" cho phỏng vấn dài (F): khi quay lại một dự án đang dở (đã có tiến độ nhưng chưa xong,
    // và requirement chưa được mời chốt), nói rõ còn bao nhiêu nhóm thông tin cần làm rõ.

    // Cờ multi-select của lượt hỏi mới nhất (chip cho phép chọn nhiều rồi gửi một lần). Conversation
    // khác null đã ngầm định Kind == "conversation" (item workflow không có Conversation).
    var lastSuggestionsMulti = lastItem?.Conversation is { Role: "assistant", SuggestionsMultiSelect: true };

    static string CoverageIcon(string status) => status switch
    {
        "RÕ" => "✅",
        "MỘT PHẦN" => "🟡",
        "KHÔNG ÁP DỤNG" => "➖",
        _ => "⚪"
    };

    // Tooltip một dòng bản đồ = tóm tắt + câu của người dùng mà kết luận dựa vào. Trích dẫn TỪNG đứng
    // thành dòng riêng dưới nhãn, nhưng ở bề rộng sidebar nó luôn bị cắt giữa chừng (một dòng, ellipsis)
    // và hay lặp lại cùng một câu ở nhiều nhóm ⇒ chiếm gấp đôi chiều cao panel mà không soát được gì.
    // Gộp vào tooltip: panel trở lại danh sách nhãn + trạng thái, ai nghi một nhóm bị chấm oan vẫn tra
    // được căn cứ mà không cần mở lại nhóm. Markup phải khớp renderCoverage() trong requirements.js.
    static string CoverageTooltip(ICOGenerator.Contracts.Requirements.CoverageMapItem item) =>
        string.IsNullOrWhiteSpace(item.Evidence) ? item.Summary : $"{item.Summary}\nDựa vào: {item.Evidence}";

    static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    static List<string> ParseSuggestions(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return new List<string>();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }

    static List<ICOGenerator.Contracts.Requirements.ChatAttachment> ParseAttachments(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return new List<ICOGenerator.Contracts.Requirements.ChatAttachment>();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<ICOGenerator.Contracts.Requirements.ChatAttachment>>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                ?? new List<ICOGenerator.Contracts.Requirements.ChatAttachment>();
        }
        catch
        {
            return new List<ICOGenerator.Contracts.Requirements.ChatAttachment>();
        }
    }

}

<div class="page-head">
    <div>
        <h1>Requirements</h1>
    </div>
</div>

@if (TempData["SourceUploaded"] != null)
{
    <div class="server-toast" data-toast-type="success" hidden>Đã upload tài liệu nguồn. BA đang đọc và sẽ tóm tắt lại trong khung chat để anh/chị xác nhận.</div>
}
@if (TempData["SourceScanWarning"] != null)
{
    <div class="server-toast" data-toast-type="error" hidden>⚠️ @TempData["SourceScanWarning"]</div>
}

<div class="grid doc-grid">

    <aside class="card history-panel">

        @* Hai hành động luôn có mặt (không phụ thuộc trạng thái hội thoại) đứng trên cùng sidebar, để
           "Tiến độ khai thác" — thứ user cần nhìn nhất — không bị đẩy xuống dưới các panel dài.
           "Tài liệu nguồn" giờ chỉ là CỬA XEM LẠI: việc đính kèm file đã nằm trong khung chat (nút 📎),
           nên ở đây không còn form upload, chỉ mở popup liệt kê/xoá các file đã đính kèm. *@
        <div class="sidebar-actions">
            <form asp-action="NewChat"
                  method="post"
                  class="new-chat-form"
                  onsubmit="return confirm('Bắt đầu chat mới: hội thoại hiện tại sẽ được lưu trữ (BA không dùng nữa) và cuộc trò chuyện bắt đầu lại từ đầu. Tiếp tục?');">

                <input type="hidden"
                       name="projectId"
                       value="@Model.Id" />

                <button class="btn outline full" type="submit">
                    ＋ New Chat
                </button>
            </form>

            <button type="button"
                    class="btn outline full source-open-btn"
                    id="sourceOpenBtn"
                    title="Xem lại và xoá các tài liệu anh/chị đã đính kèm cho BA">
                📎 Tài liệu nguồn
                <span class="source-count-badge" id="sourceCountBadge" @(sourceFiles.Any() ? "" : "hidden")>@sourceFiles.Count</span>
            </button>

            @* Tải cả CHUỖI DẪN XUẤT (hội thoại → Product Brief → AI Design Spec → POC demo) thành một .zip
               để nhờ một công cụ AI khác (Claude Code, ChatGPT…) soi các mối nối giữa bốn tầng — lớp lỗi
               "điều người dùng nói bị rơi mất dần qua từng tầng" mà không cổng nào trong hệ thống bắt được.
               Mang theo phiên bản ĐANG CHỌN: gói xuất bản mô tả V1 cạnh bản demo dựng từ V3 chỉ sinh ra một
               danh sách sai lệch giả. Là thẻ <a> chứ không phải form: đây là thao tác CHỈ ĐỌC, và một link
               tải về không được phép làm mất nội dung đang gõ dở trong ô chat.

               Ẩn khi thiếu quyền RequirementsDownloadPackage (cấp ở màn hình Roles & Permissions, không
               hardcode vai trò) — cùng một quyền mà action chặn, nên nút này không bao giờ dẫn tới trang
               Access Denied. *@
            @if (await Permissions.HasPermissionAsync(User, AppPermission.RequirementsDownloadPackage))
            {
                <a class="btn outline full"
                   asp-action="DownloadReviewPackage"
                   asp-route-projectId="@Model.Id"
                   asp-route-version="@selectedVersion"
                   download
                   title="Tải một file .zip gồm đoạn chat (kèm bản đồ bao phủ, tài liệu nguồn, prompt của BA), Product Brief, AI Design Spec và bản demo POC — để nhờ AI khác soi xem thông tin có bị rơi mất qua từng tầng không">
                    ⬇️ Tải trọn gói cho AI
                </a>
            }
        </div>

        @* Tiến độ khai thác yêu cầu: cho user thấy cuộc phỏng vấn đã rõ bao nhiêu nhóm thông tin và còn
           thiếu gì — thay vì cảm giác "bị hỏi vô tận". Dự án mới CŨNG hiện panel, ở dạng khung 12 nhóm
           [CHƯA HỎI] (CoverageChecklist): đó chính là lúc "cuộc phỏng vấn này dài bao nhiêu" đáng nói
           nhất. Chỉ ẩn khi không dựng nổi cả khung (prompt coverage bị sửa hỏng) — fail-open như cũ. *@
        <div class="coverage-panel" id="coveragePanel" @(coverage.Count == 0 ? "hidden" : "")>
            <h3>Tiến độ khai thác</h3>
            <div class="coverage-progress">
                <div class="coverage-bar">
                    <span id="coverageBarFill" style="width:@(coverageProgress.Percent)%"></span>
                </div>
                <span class="coverage-progress-text" id="coverageProgressText">Đã rõ @coverageProgress.Clear/@coverageProgress.Total nhóm</span>
            </div>
            @* Nhóm bị loại khỏi phạm vi đứng RIÊNG một dòng, không nối vào dòng trên: nối vào thì chuỗi
               dài bóp thanh tiến độ (cùng hàng flex) còn một mẩu. Cũng là chú thích cho các dòng ➖ mờ
               bên dưới, và giải thích vì sao thanh đầy được trong khi chỉ 9/12 nhóm [RÕ]. *@
            <p class="coverage-na" id="coverageNa" @(coverageProgress.NotApplicable > 0 ? "" : "hidden")>
                ➖ <span id="coverageNaCount">@coverageProgress.NotApplicable</span> nhóm không áp dụng với dự án này
            </p>
            <ul class="coverage-list" id="coverageList">
                @foreach (var item in coverage)
                {
                    @* Dòng CHỈ ĐỌC. Nút "chưa đúng?" hiện khi hover từng nhóm đã bị gỡ: nhãn nhóm là từ
                       vựng nội bộ của BA ("Vòng đời & trạng thái", "Phân quyền theo nghiệp vụ") — người
                       dùng nghiệp vụ không đọc được chúng để biết mình đang phản đối cái gì, nên cái nút
                       ấy mời họ bấm vào một thứ họ không hiểu. Việc xác nhận "BA hiểu đúng chưa" thuộc về
                       khung chat, nơi BA đọc lại bằng lời của người dùng và hỏi lại (nhịp tóm tắt kiểm
                       chứng trong requirement-chat.v4.md); nói "chỗ này chưa đúng" ở đó thì lượt chắt lọc
                       hạ nhóm tương ứng xuống [MỘT PHẦN] và cổng tạo tài liệu tự đóng. *@
                    <li class="coverage-item @(item.Status == "KHÔNG ÁP DỤNG" ? "na" : "")"
                        title="@CoverageTooltip(item)">
                        <span class="cov-ico">@CoverageIcon(item.Status)</span>
                        @* IsCore (★) vẫn dùng để xếp thứ tự nhóm còn thiếu trong RequirementReadinessGate,
                           nhưng KHÔNG hiển thị: với user, "nhóm cốt lõi" là phân loại nội bộ của BA — mọi nhóm
                           áp dụng đều phải [RÕ] mới mở được Write Requirement, nên ★ chỉ gây nhiễu. *@
                        <span class="cov-label">@item.Label</span>
                    </li>
                }
            </ul>
        </div>

        @* KHÔNG còn panel "Điều đã chốt" ở đây — panel cuối cùng của sidebar bị gỡ, và vì đúng cái lý do
           đã gỡ ba panel trước nó. Nhật ký quyết định (DecisionLogService) VẪN được chắt sau mỗi lượt;
           chỉ có mặt UI biến mất, và người ĐỌC nó đổi từ user sang máy.
           Vì sao gỡ: panel này bắt người dùng vừa kể chuyện nghiệp vụ vừa audit một danh sách tới 40 dòng
           — hai chế độ tư duy chạy song song, đúng lúc họ cần tập trung nhất. Nó cũng đặt việc soát mâu
           thuẫn nhầm vai: người dùng không có nghĩa vụ nhớ mình đã nói gì ở lượt thứ ba, còn BA thì đọc
           được cả hội thoại. Và "bấm để sửa" cũng không phải công cụ sửa thật — nó chỉ soạn sẵn một câu
           vào ô chat, tức là vẫn quay về chat.
           Nhật ký nay đi vào ba đường tiêu thụ của máy, KHÔNG còn đường nào ra màn hình (bản tổng kết ở cổng
           tạo tài liệu đã gỡ theo — xem chú thích ở #writeReqZone):
             1. Ngữ cảnh chat của BA (BAChatService) — BA đối chiếu câu vừa nghe với điều đã chốt và hỏi
                lại NGAY khi thấy chọi nhau (prompt requirement-chat.v4 § "Soát mâu thuẫn với điều đã chốt").
             2. Ngữ cảnh soát mâu thuẫn trước lúc soạn tài liệu (RequirementConflictService) — lưới an toàn.
             3. Ngữ cảnh soạn Product Brief (ProductBriefDraftService) và bản xuất hội thoại
                (ChatExportBuilder). *@

        @* KHÔNG có panel "Sẽ xây gì" ở đây: PlannedScope vẫn được chắt sau mỗi lượt, nhưng nó là danh
           sách SUY ĐOÁN mà user không sửa được tại chỗ — vòng "bắt hiểu nhầm sớm" không đóng lại được nên
           panel chỉ còn là nhiễu.
           Dữ liệu vẫn giữ: nó đi vào ngữ cảnh soát mâu thuẫn (RequirementConflictService). *@

        @* KHÔNG có panel "Điểm cần làm rõ" ở đây: danh sách OpenQuestions vẫn được chắt sau mỗi lượt,
           nhưng nay đi thẳng vào ngữ cảnh chat của BA (BAChatService) thay vì thành một panel để user tự
           đọc. Người dùng chỉ cần trò chuyện — BA có thắc mắc gì thì hỏi ngay trong khung chat, và phần
           "còn mâu thuẫn" đã có panel ⚠ riêng ở trên với lựa chọn thật để chốt. *@

        @* KHÔNG có panel "Ví dụ đã xác nhận" ở đây: WorkedExamples vẫn được chắt sau mỗi lượt và vẫn là
           ORACLE mà POC bị chấm theo (spec đúc thành "## 13. Worked Examples", POC phải tính lại ra đúng
           kết quả), nhưng panel thì lặp lại đúng thứ BA vừa nói trong chat — các ví dụ định tính trùng
           gần nguyên văn BẢNG LUỒNG mà người dùng tự tay duyệt từng bước, còn ví dụ định lượng thì đến từ
           chính câu người dùng vừa chốt. Sidebar cuộn dài thêm một khối mà không thêm thông tin.
           Cái mất khi bỏ panel: đường SỬA TAY danh sách oracle (UpdateWorkedExamplesUseCase, đã gỡ theo).
           Đính chính nay đi qua chat như mọi điều khác — nói lại trong khung chat, lượt chắt lọc kế tiếp
           cập nhật danh sách. *@

        @* Giả định của bản thiết kế (AI Design Spec § 12): những điều BA tự quyết thay user.
           Ở SIDEBAR chỉ còn CHẾ ĐỘ THAM KHẢO (POC đã dựng): danh sách tra cứu nguội, bấm một giả định để
           nhắn BA sửa qua khung chat. Đây là panel DUY NHẤT còn sót lại kiểu "danh sách để user tự rà" —
           nó ở lại được vì chỉ xuất hiện SAU khi POC đã dựng, tức không còn cuộc phỏng vấn nào đang diễn
           ra để mà chia sự chú ý.
           CHẾ ĐỘ CỔNG (pendingAssumptions = true) đã CHUYỂN VÀO KHUNG CHAT: lúc đó quy trình đang ĐỨNG
           CHỜ người dùng, mà lời mời rà giả định lại do BA nói ở cuối chat ("đang chờ anh/chị rà N giả
           định"), trong khi nút bấm thì nằm lọt giữa một sidebar cuộn dài — người đọc phải tự đi tìm cổng.
           Đặt cổng làm khối CUỐI của khung chat thì nó rơi đúng chỗ mắt đang nhìn (chat tự cuộn xuống đáy
           khi tải trang) và có đủ bề ngang để hiện trọn danh sách thay vì ô cuộn cao 320px. *@
        @if (specAssumptions.Any() && !pendingAssumptions)
        {
            <div class="assumption-panel" id="assumptionPanel" data-pending="false">
                <h3>Giả định cần xác nhận @(string.IsNullOrEmpty(specVersion) ? "" : $"({specVersion})")</h3>
                <div class="history-sub decision-hint">
                    BA đã tự quyết các điểm sau khi dựng bản thiết kế. <b>Rà lại giúp mình:</b> nếu điểm nào
                    chưa đúng, bấm vào nó để sửa — mình sẽ cập nhật tài liệu và dựng lại bản demo cho khớp.
                    Không bấm gì nghĩa là anh/chị đồng ý với các giả định này.
                </div>
                <ul class="assumption-list">
                    @foreach (var assumption in specAssumptions)
                    {
                        <li>
                            <button type="button" class="assumption-item" data-assumption="@assumption" title="Bấm nếu giả định này chưa đúng để sửa">@assumption</button>
                        </li>
                    }
                </ul>
            </div>
        }

        <h3>Product Brief</h3>

        @if (versions.Any())
        {
            foreach (var version in versions)
            {
                <div class="history-item">

                    <div class="history-left">
                        <div class="history-icon">📄</div>

                        <div>
                            <div class="history-title">
                                @(version.Key == "draft" ? "Draft" : version.Key)
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="btn outline small"
                            onclick="openRequirementModal('@version.Key')">
                        View
                    </button>
                </div>
            }
        }
        else
        {
            <div class="empty-history">
                No requirement history yet.
            </div>
        }

    </aside>

    <section class="card chat-panel">

        <div id="chatMessages"
             class="chat-messages"
             data-reply-pending="@(chatReplyPending ? "true" : "false")">

            @if (!conversations.Any())
            {
                <b class="req-who">BA</b>
                <div class="req-msg ba">
                    <p>
                        Xin chào! Tôi là Business Analyst. Anh/chị cứ <b>kể thoải mái một mạch</b> mọi điều
                        đang hình dung về ứng dụng: bài toán cần giải quyết, ai sẽ dùng, quy trình hiện tại
                        đang làm thế nào và vướng ở đâu — càng chi tiết tôi càng đỡ phải hỏi lại.
                        Nếu có sẵn tài liệu, ảnh chụp màn hình Excel/biểu mẫu đang dùng, anh/chị bấm
                        <b>nút 📎 ngay dưới ô nhập</b> (hoặc dán/kéo-thả file vào khung chat) để tôi đọc luôn nhé.
                    </p>
                </div>
            }

            @{
                // Gộp các lượt BA LIỀN KỀ dưới MỘT nhãn "BA" (kiểu Teams/ChatGPT): mỗi lượt assistant vốn
                // tự in nhãn riêng, nên hai lượt BA nối nhau (vd lượt tóm tắt tài liệu do AcknowledgeSources
                // thêm ngay sau một câu hỏi BA) hiện "BA" hai lần chồng nhau. Chỉ in nhãn cho lượt BA ĐẦU
                // của một chuỗi; panel workflow và lượt user (đều KHÔNG phải bong bóng BA) cắt chuỗi lại.
                var prevWasBaBubble = false;
            }
            @foreach (var group in renderGroups)
            {
                if (group.Kind == "workflow")
                {
                    prevWasBaBubble = false;
                    var runs = group.Runs;
                    var leadRun = runs[runs.Count - 1];
                    var groupAutoScroll = runs.Any(r => r.Id == autoScrollWorkflowRunId) ? "true" : "false";
                    var runIds = string.Join(",", runs.Select(r => r.Id));
                    // Hành trình kết thúc bằng run delivery → nhãn "Delivery Progress"; ngược lại (chỉ có
                    // run requirement của BA) giữ "Requirement Progress" như trước.
                    var groupTitle = runs.Any(r => r.Name != null && r.Name.Contains("Delivery"))
                        ? "Delivery Progress"
                        : "Requirement Progress";

                    <div id="wf-panel-@leadRun.Id"
                         class="req-msg ba workflow-progress"
                         data-run-ids="@runIds"
                         data-lead-run-id="@leadRun.Id"
                         data-autoscroll="@groupAutoScroll">
                        <div class="workflow-progress-head">
                            <b>BA</b>
                            <span class="workflow-progress-title">@groupTitle</span>
                        </div>
                        <small class="muted wf-sub"></small>
                        <div class="workflow-progress-body wf-body">
                            <div class="wf-banner wf-run">⏳ Đang tải tiến độ delivery…</div>
                        </div>
                    </div>
                }
                else if (group.Conversation?.Role == "user")
                {
                    // Ảnh/file người dùng đính kèm ở lượt này (lưu JSON trong Attachments) — render ngay
                    // trong bubble như ChatGPT/Claude: ảnh thành thumbnail (bấm mở bản gốc), file khác
                    // thành chip tên file. Nguồn đã bị xóa ⇒ endpoint trả 404, onerror ẩn thumbnail hỏng.
                    prevWasBaBubble = false;
                    var attachments = ParseAttachments(group.Conversation.Attachments);
                    <div class="req-msg you">
                        @if (attachments.Any())
                        {
                            <div class="chat-attachments">
                                @foreach (var att in attachments)
                                {
                                    var src = Url.Action("SourceContent", new { id = att.Id });
                                    @if (att.IsImage)
                                    {
                                        <a href="@src" target="_blank" rel="noopener" class="chat-attachment-img" title="@att.Name">
                                            <img src="@src" alt="@att.Name" loading="lazy" onerror="this.closest('a').style.display='none'" />
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@src" target="_blank" rel="noopener" class="chat-attachment-file" title="@att.Name">📄 @att.Name</a>
                                    }
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(group.Conversation.Message))
                        {
                            <p>@group.Conversation.Message</p>
                        }
                        @* SỬA lượt vừa gửi — chỉ ở lượt user CUỐI CÙNG (sửa lượt giữa hội thoại thì mọi
                           lượt sau đó nói về nội dung đã biến mất). Không có nút này, một câu gõ nhầm chỉ
                           "sửa" được bằng cách nhắn thêm câu đính chính, trong khi bản đồ bao phủ và nhật
                           ký điều đã chốt đã kịp ghi nhận câu sai và chúng gộp lũy tiến. *@
                        @if (group.Conversation.Id == lastUserTurnId && !string.IsNullOrWhiteSpace(group.Conversation.Message))
                        {
                            <button type="button" class="chat-edit-btn"
                                    data-message="@group.Conversation.Message"
                                    title="Sửa lại câu vừa gửi — BA sẽ trả lời lại từ nội dung mới">✎ sửa</button>
                        }
                    </div>
                }
                else if (group.Conversation != null)
                {
                    // Lượt gộp mới nhất: bong bóng của nó CHÍNH LÀ thẻ hỏi ở cuối khung chat (câu dẫn đã
                    // xuống làm dòng đầu của thẻ), nên bỏ qua ở đây. prevWasBaBubble giữ nguyên: nhãn "BA"
                    // của lượt được in trước thẻ, theo đúng quy tắc gộp nhãn của chuỗi lượt BA liền kề.
                    if (batchLeadTurn != null && group.Conversation.Id == batchLeadTurn.Id)
                    {
                        continue;
                    }

                    // Lượt BA là THÔNG BÁO LỖI gọi AI (tiền tố ⚠️ dùng chung với transcript filter): tô đỏ
                    // như đường streaming, và nếu là lượt CUỐI của hội thoại thì kèm nút "Thử lại" — server
                    // xóa lượt lỗi rồi chạy lại, người dùng khỏi phải gõ lại câu vừa hỏi.
                    var isFailureTurn = (group.Conversation.Message ?? "").StartsWith(
                        ICOGenerator.Services.Requirements.ConversationTranscriptBuilder.LlmFailurePrefix, StringComparison.Ordinal);
                    var isLastTurn = group.Conversation.Id == conversations.LastOrDefault()?.Id;
                    @if (!prevWasBaBubble)
                    {
                        <b class="req-who">BA</b>
                    }
                    <div class="req-msg ba @(isFailureTurn ? "chat-error" : "")">
                        @* Giữ pre-wrap để tôn trọng xuống dòng trong câu trả lời của BA, nhưng đặt biểu thức
                           NGAY trong thẻ <p> (không xuống dòng/thụt lề) — nếu không, khoảng trắng thụt lề của
                           mã Razor bị pre-wrap giữ lại, đẩy dòng đầu tin nhắn thụt vào trông rất khó chịu. *@
                        <p style="white-space: pre-wrap;">@((group.Conversation.Message ?? "").Trim())</p>

                        @if (isFailureTurn && isLastTurn)
                        {
                            <button type="button" class="btn outline small chat-retry-btn" title="Chạy lại lượt trả lời vừa lỗi — không cần gõ lại câu hỏi">↻ Thử lại</button>
                        }

                        @{
                            // CÁC CÂU HỎI của một lượt hỏi GỘP CŨ, render CHỈ ĐỌC ngay trong bong bóng đã
                            // hỏi chúng. Message của lượt gộp chỉ là câu dẫn ("mình hỏi 4 điểm sau"), nên
                            // không có khối này thì lịch sử hội thoại nuốt mất chính các câu hỏi: người
                            // dùng cuộn lên không đối chiếu được mình đã được hỏi gì và đã trả lời gì —
                            // và khi BA lỡ hỏi lại, họ cũng không có bằng chứng nào để chỉ ra điều đó.
                            // Lượt đang giữ thẻ hỏi SỐNG không tới được đây: nó đã `continue` ở trên vì
                            // bong bóng của nó CHÍNH LÀ thẻ hỏi.
                            var pastQuestions = ICOGenerator.Services.Requirements.ConversationTurnRenderer
                                .ParseQuestions(group.Conversation.Questions);
                        }
                        @if (pastQuestions.Any())
                        {
                            <ul class="batchq-history">
                                @foreach (var q in pastQuestions)
                                {
                                    @* KHÔNG in nhãn nhóm của bản đồ bao phủ ở đây: nó là sổ sách nội bộ,
                                       xem chú thích ở thẻ hỏi bên dưới. q.Group vẫn được lưu và vẫn đi vào
                                       transcript cho các bước máy đọc. *@
                                    <li>
                                        <span class="batchq-history-question">@q.Question</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    prevWasBaBubble = true;
                }
            }

            @* CỔNG XÁC NHẬN GIẢ ĐỊNH — khối CUỐI của dòng hội thoại, ngay dưới lượt BA vừa báo "đã sinh
               bản thiết kế, đang chờ anh/chị rà N giả định". POC CHƯA dựng: quy trình thực sự đang đứng
               chờ ở đây, nên câu hỏi và nút trả lời phải nằm cùng một chỗ — trước đây cổng ở sidebar nên
               người dùng đọc xong lời mời trong chat rồi phải quét mắt sang cột trái tìm nút. Mỗi giả định
               có hai nút Đúng/Chưa đúng; "Chưa đúng" mở ô gõ ý đúng. Xác nhận xong mới dựng POC — bắt lỗi
               trước khi tốn trọn một lượt dựng (5–15 phút) thay vì sau. Markup/ID giữ nguyên như bản ở
               sidebar để initAssumptionGate (requirements.js) dùng lại y hệt. *@
            @if (specAssumptions.Any() && pendingAssumptions)
            {
                <div class="req-msg ba assumption-panel gate"
                     id="assumptionPanel"
                     data-pending="true"
                     data-confirm-url="@Url.Action("ConfirmAssumptions", "Requirements")"
                     data-revise-url="@Url.Action("ReviseAssumptions", "Requirements")">
                    <div class="assumption-gate-head">
                        <b>BA</b>
                        <span class="assumption-gate-title">
                            Giả định cần xác nhận @(string.IsNullOrEmpty(specVersion) ? "" : $"({specVersion})")
                        </span>
                        <span class="assumption-gate-count">@newAssumptions.Count điểm</span>
                    </div>
                    <div class="assumption-gate-hint">
                        <b>Bản demo chưa được dựng — đang chờ anh/chị ở bước này.</b>
                        @if (reviewedAssumptions.Any())
                        {
                            <text>
                                Các điểm anh/chị đã xác nhận trước đó mình giữ nguyên, không hỏi lại.
                                @if (newAssumptions.Any())
                                {
                                    <text>Chỉ còn <b>@newAssumptions.Count điểm mới</b> cần rà:</text>
                                }
                            </text>
                        }
                        else
                        {
                            <text>Bản mô tả không nói rõ mấy điểm dưới đây nên BA đã tự quyết. Rà nhanh giúp mình:</text>
                        }
                        điểm nào <b>chưa đúng</b> thì đánh dấu và ghi ý đúng, xong bấm nút bên dưới —
                        sửa ở đây chỉ mất vài giây, phát hiện sau khi xem demo thì phải dựng lại cả bản.
                    </div>
                    <ul class="assumption-list gate">
                        @foreach (var assumption in newAssumptions)
                        {
                            <li class="assumption-gate-item" data-assumption="@assumption">
                                <div class="assumption-gate-text">@assumption</div>
                                <div class="assumption-gate-actions">
                                    <button type="button" class="assumption-vote ok is-on" data-vote="ok">Đúng</button>
                                    <button type="button" class="assumption-vote bad" data-vote="bad">Chưa đúng</button>
                                </div>
                                <textarea class="assumption-fix" rows="2" hidden
                                          placeholder="Đúng ra là… (ghi ngắn gọn, có thể bỏ trống)"></textarea>
                            </li>
                        }
                    </ul>
                    @* Phần user đã bấm "Đúng" ở vòng trước: gấp lại thay vì bỏ hẳn — không hỏi lại nhưng
                       vẫn cho đổi ý (markup y hệt nên initAssumptionGate coi chúng như mọi mục khác). *@
                    @if (reviewedAssumptions.Any())
                    {
                        <details class="assumption-reviewed">
                            <summary>@reviewedAssumptions.Count điểm anh/chị đã xác nhận trước đó — bấm để xem/đổi ý</summary>
                            <ul class="assumption-list gate">
                                @foreach (var assumption in reviewedAssumptions)
                                {
                                    <li class="assumption-gate-item" data-assumption="@assumption">
                                        <div class="assumption-gate-text">@assumption</div>
                                        <div class="assumption-gate-actions">
                                            <button type="button" class="assumption-vote ok is-on" data-vote="ok">Đúng</button>
                                            <button type="button" class="assumption-vote bad" data-vote="bad">Chưa đúng</button>
                                        </div>
                                        <textarea class="assumption-fix" rows="2" hidden
                                                  placeholder="Đúng ra là… (ghi ngắn gọn, có thể bỏ trống)"></textarea>
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                    <div class="assumption-gate-bar">
                        <button type="button" class="btn primary" id="assumptionConfirmBtn">
                            ✓ Tất cả đúng — dựng bản demo
                        </button>
                        <button type="button" class="btn outline" id="assumptionReviseBtn" hidden>
                            ↻ Sửa các điểm đã đánh dấu rồi dựng lại bản thiết kế
                        </button>
                        <div class="assumption-gate-msg" id="assumptionGateMsg"></div>
                    </div>
                </div>
            }

            <div id="suggestionList"
                 class="suggestion-list"
                 role="listbox"
                 aria-label="Gợi ý trả lời"
                 data-multi="@(lastSuggestionsMulti ? "true" : "false")"
                 style="@(displaySuggestions.Any() ? "" : "display:none;")">
                @{
                    var suggestionIndex = 0;
                }
                @foreach (var suggestion in displaySuggestions)
                {
                    suggestionIndex++;
                    <button type="button"
                            class="suggestion-option"
                            role="option"
                            aria-selected="@(lastSuggestionsMulti ? "false" : null)"
                            data-suggestion="@suggestion">
                        <span class="suggestion-option-check" aria-hidden="true"></span>
                        <span class="suggestion-option-text">@suggestion</span>
                        <span class="suggestion-option-key">@suggestionIndex</span>
                    </button>
                }
            </div>

            @* THẺ HỎI GỘP — 2–4 câu hỏi độc lập BA đặt trong CÙNG một lượt. Đây là đường thay thế cho cổng
               "chốt nhanh" đã bỏ: cổng đó rút ngắn phỏng vấn bằng cách để BA tự soạn phương án cho mọi
               nhóm còn trống rồi ghi vào hội thoại NHƯ LỜI NGƯỜI DÙNG — lấp đầy bản đồ bao phủ mà không ai
               thật sự trả lời câu nào. Ở đây BA vẫn là người HỎI, người dùng vẫn là người TRẢ LỜI; thứ
               được rút ngắn chỉ là số vòng đi-về, không phải độ sâu khai thác.

               Render ở CẢ HAI đường (server ở đây khi tải trang, requirements.js ở frame done) vì reload
               phải giữ nguyên các câu chưa trả lời. Markup hai bên phải khớp nhau.

               Đặt SAU #suggestionList (không phải trước) vì quy tắc gộp "câu hỏi BA + chip gợi ý" dựa vào
               kề nhau (.req-msg.ba:has(+ .suggestion-list …)): chen một div vào giữa là hỏng, kể cả khi
               div đó đang ẩn. Đây cũng là lý do lượt gộp KHÔNG gộp bằng CSS như cặp "câu hỏi + chip" mà
               gộp bằng nội dung (câu dẫn dọn hẳn vào trong thẻ): thẻ không bao giờ kề bong bóng câu dẫn. *@
            @* Nhãn "BA" của lượt gộp đứng NGOÀI thẻ (như mọi bong bóng BA khác) vì thẻ giờ là bong bóng của
               lượt đó. Bỏ qua khi lượt BA liền trước đã in nhãn — cùng quy tắc gộp nhãn với vòng lặp trên. *@
            @if (lastBaQuestions.Count > 0 && !prevWasBaBubble)
            {
                <b class="req-who">BA</b>
            }
            <div class="req-msg ba batchq" id="batchQuestions" @(lastBaQuestions.Count > 0 ? "" : "hidden")>
                @if (lastBaQuestions.Count > 0)
                {
                    @* Câu dẫn = Message của chính lượt gộp (xem batchLead ở đầu file). Rỗng thì mới rơi về
                       câu tĩnh — không có dòng dẫn nào thì thẻ mở đầu bằng câu hỏi trần, mất mạch hội thoại. *@
                    <p class="batchq-lead">@(string.IsNullOrWhiteSpace(batchLead) ? "Anh/chị trả lời giúp mình mấy điểm sau nhé." : batchLead)</p>
                    <ul class="batchq-list">
                        @foreach (var q in lastBaQuestions)
                        {
                            @* Câu MỞ: không có gợi ý nào để bấm nên chỉ còn ô tự nhập. Suy cả từ Suggestions
                               rỗng, không chỉ từ cờ: lượt gộp cũ lưu trước khi có cờ này vẫn phải render ra
                               một dòng trả lời được. *@
                            var openQuestion = q.OpenEnded || q.Suggestions.Count == 0;
                            @* Nhãn nhóm (`q.Group`) KHÔNG lên màn hình. «Dữ liệu / danh mục chính»,
                               «Vòng đời & trạng thái» là từ vựng của bản đồ bao phủ, không phải cách người
                               dùng nghiệp vụ gọi công việc của họ — in nó lên đầu mỗi câu hỏi là bắt họ đọc
                               sổ sách của hệ thống trước khi đọc câu hỏi. Trường vẫn được LƯU và vẫn đi vào
                               transcript: nó là thứ nối câu hỏi về đúng dòng bản đồ (CoveragePendingGuard,
                               AskedQuestionHistory), chỉ là không nói ra với người dùng. Panel "Tiến độ
                               khai thác" bên cạnh vẫn liệt kê đủ 12 nhãn cho ai muốn xem. *@
                            <li class="batchq-item" data-question="@q.Question" data-multi="@(q.MultiSelect ? "true" : "false")" data-open="@(openQuestion ? "true" : "false")">
                                <div class="batchq-question">@q.Question</div>
                                @if (!openQuestion)
                                {
                                    <div class="batchq-choices">
                                        @foreach (var s in q.Suggestions)
                                        {
                                            <button type="button" class="batchq-choice" data-value="@s">@s</button>
                                        }
                                    </div>
                                    @* Ô "Ý khác" LUÔN MỞ, kể cả khi câu này có hàng gợi ý: giấu nó sau một
                                       nút là giấu mất lối thoát duy nhất của người có ý riêng. Nó chở phần
                                       người dùng TỰ NÓI — lựa chọn nằm trên chính chip, không chép vào đây —
                                       xem chú thích ở requirements.js, mục BATCH_ANSWER_LABEL. Nhãn nổi khoét
                                       trên viền là nhãn NHÌN nên `aria-hidden`; chỗ trình đọc màn hình lấy
                                       tên ô là `aria-label`. *@
                                    <div class="batchq-other-field">
                                        <textarea class="batchq-answer" rows="1" aria-label="Ý khác — câu trả lời anh/chị tự nhập" placeholder="Không gợi ý nào đúng, hoặc muốn nói thêm? Anh/chị gõ vào đây…"></textarea>
                                        <span class="batchq-other-cap" aria-hidden="true">Ý khác</span>
                                    </div>
                                }
                                else
                                {
                                    <textarea class="batchq-answer" rows="3" placeholder="Anh/chị kể giúp mình, càng chi tiết càng tốt…"></textarea>
                                }
                            </li>
                        }
                    </ul>
                    <div class="batchq-bar">
                        <button type="button" class="btn primary" id="batchQuestionsSendBtn" disabled>Chưa trả lời câu nào</button>
                        <div class="batchq-hint">Không cần trả lời hết — gửi phần anh/chị đã rõ, BA hỏi tiếp các câu còn lại.</div>
                    </div>
                }
            </div>

            @* BẢNG CỘT — file người dùng gửi gần như luôn là bản XUẤT của hệ thống họ đang dùng, nên nó chở
               theo cả cột nghiệp vụ lẫn cột hạ tầng của hệ cũ. Đây không phải chuyện gọn gàng: text bóc từ
               file đi tiếp vào "dữ liệu mẫu thật" của bước sinh tài liệu và POC seed màn hình bằng ĐÚNG các
               cột đó — không chốt thì người dùng mở demo ra thấy Revision Number nằm như một trường của app
               mới, và mất niềm tin vào cả bản demo.

               Vì sao là BẢNG chứ không phải hàng chip: chip chỉ nêu được tập con do BA tự chọn, các cột
               không lên chip bị coi là "của hệ cũ" mà người dùng không bao giờ nhìn thấy để phản đối. Bảng
               phơi ĐỦ cột của file nên quyết định loại bỏ trở thành thứ nhìn thấy và bấm lại được.

               Vì sao ô "Ý nghĩa" đã ĐIỀN SẴN: một bảng 18 dòng để trống là bắt người dùng nghiệp vụ giải
               nghĩa 18 cột — bị hỏi "Last Name nghĩa là gì" thì họ hiểu là BA chưa mở file. BA có tên cột,
               mọi giá trị phân biệt và số dòng nên đoán được gần hết; đoán sai thì họ sửa một dòng là xong.

               Vì sao bảng này là thứ ĐẦU TIÊN người dùng thấy sau khi upload, trước cả bản đọc lại: kể lại
               cả file khi chưa biết họ dùng cột nào là dựng việc tồn trên những cột sắp bị bỏ tích, và nếu
               họ gửi nhầm file thì cả bản đọc là công cốc — nhưng vẫn đủ hợp lý để được bấm "Đúng rồi".
               Bản đọc lại chuyển sang lượt chat ngay sau khi bảng được gửi (xem source-readback.v1.md).

               Đặt SAU #suggestionList và #batchQuestions vì quy tắc gộp "câu hỏi BA + chip gợi ý" dựa vào
               hai khối KỀ NHAU (.req-msg.ba:has(+ .suggestion-list …)) — chen vào giữa là hỏng, kể cả khi
               khối chen vào đang ẩn. *@
            <div class="req-msg ba colmap" id="columnMap"
                 data-confirm-url="@Url.Action("ConfirmColumnMap", "Requirements")"
                 data-table-name="@tblColumn.Name" data-send-label="@tblColumn.SendLabel"
                 @(lastColumnMap.Count > 0 ? "" : "hidden")>
                @if (lastColumnMap.Count > 0)
                {
                    <div class="colmap-howto">
                        Mình đã tích sẵn các cột mình nghĩ là dùng cho ứng dụng mới và ghi cách hiểu của mình vào
                        cột <b>Ý nghĩa</b> — anh/chị chỉ cần sửa những chỗ lệch. Cột <b>không tích</b> mình coi là
                        dữ liệu của hệ thống cũ và sẽ không đưa vào ứng dụng. Chốt xong bảng này mình mới kể lại
                        cách hiểu file để anh/chị soát, rồi hỏi tiếp những chỗ còn chưa rõ.
                    </div>
                    @foreach (var file in lastColumnMap.GroupBy(c => c.FileName))
                    {
                        <div class="colmap-file">@file.Key</div>
                        <table class="colmap-table">
                            <thead>
                                <tr>
                                    <th class="colmap-th-col">Cột trong file</th>
                                    <th class="colmap-th-use">Có dùng</th>
                                    <th>Ý nghĩa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var note in file)
                                {
                                    <tr class="colmap-row" data-file="@note.FileName" data-column="@note.Column">
                                        <td class="colmap-col">@note.Column</td>
                                        <td class="colmap-use">
                                            <input type="checkbox" class="colmap-check" aria-label="Dùng cột @note.Column" @(note.Used ? "checked" : "") />
                                        </td>
                                        <td>
                                            <input type="text" class="colmap-meaning" value="@note.Meaning"
                                                   placeholder="Cột này là gì trong công việc của anh/chị?" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="colmap-bar">
                        <button type="button" class="btn primary" id="columnMapSendBtn">Gửi bảng cột</button>
                        @* KHÔNG viết "lời giới thiệu PHÍA TRÊN": bảng treo theo FILE chứ không theo lượt, và
                           requirements.js dời nó xuống cuối dòng hội thoại sau mỗi lượt — gõ vài câu là
                           lượt đọc file đã nằm cách đó mấy lượt, lúc đó "phía trên" chỉ vào nhầm bong bóng. *@
                        <div class="colmap-hint">
                            Gửi nhầm file hay còn điều gì muốn nói thêm thì anh/chị cứ gõ vào khung chat nhé.
                        </div>
                        <div class="colmap-msg" id="columnMapMsg"></div>
                    </div>
                }
            </div>

            @* BA BẢNG CHỐT của buổi phỏng vấn, theo đúng thứ tự chúng được bày ra (InterviewTableGate):
               LUỒNG → MÀN HÌNH → ĐỐI TƯỢNG, rồi tới bảng phân quyền ngay dưới. Thứ tự DOM cố định vì
               requirements.js dời cả cụm xuống cuối dòng hội thoại sau mỗi lượt; không bao giờ có hai bảng
               cùng sống, nhưng thứ tự vẫn phải xác định.

               Cả ba treo theo DỰ ÁN (cột trên Project còn null) chứ không theo lượt, cùng lý do với bảng
               cột và bảng phân quyền: người dùng hoàn toàn có thể gõ một câu hỏi lại trước khi ngồi rà, và
               mất bảng vì lý do đó là mất luôn đường chốt. *@

            @* BẢNG LUỒNG — người dùng rà từng bước của từng luồng: sửa thẳng vào ô, hoặc bấm × để bỏ bước
               không có thật. Không cột "Đúng" và không dấu ✓ bằng chứng — xem docs/requirement-flow.md,
               mục "Vì sao bảng luồng và bảng màn hình không có dấu ✓ bằng chứng". *@
            <div class="req-msg ba permmap flowmap" id="flowMapPanel"
                 data-confirm-url="@Url.Action("ConfirmFlowMap", "Requirements")"
                 data-table-name="@tblFlow.Name" data-send-label="@tblFlow.SendLabel"
                 @(lastFlowMap.Count > 0 ? "" : "hidden")>
                @if (lastFlowMap.Count > 0)
                {
                    <div class="permmap-howto">
                        Đây là các luồng <b>mình ráp lại</b> từ những gì anh/chị đã kể — bước nào sai thì sửa thẳng vào ô,
                        bước nào không có thật thì bấm <b>×</b> ở cuối dòng để bỏ (bấm lại để lấy về). Sai thứ tự thì bấm
                        <b>↑ ↓</b>, thiếu bước thì bấm <b>+ thêm bước</b> ở cuối luồng, thiếu hẳn một luồng thì bấm
                        <b>+ thêm luồng</b> ở cuối bảng.
                    </div>
                    @foreach (var flow in lastFlowMap)
                    {
                        @* Tiêu đề và bảng gói chung trong .flowmap-block vì JS gom bảng đi theo từng BLOCK chứ không
                           theo từng <table>: một luồng người dùng tự thêm chở tên/loại/vai ở các ô gõ NGOÀI bảng, và
                           nút × của nó phải xóa được cả cụm. Server chỉ render lại được đề xuất của BA, nên ở đây
                           không có nhánh "luồng tự thêm" — xem renderFlowMap trong requirements.js. *@
                        <div class="flowmap-block">
                            <div class="permmap-screen">
                                @flow.Name <span class="flowmap-kind">@flow.Kind</span>
                                @if (!string.IsNullOrWhiteSpace(flow.Role))
                                {
                                    <span class="flowmap-role">· @flow.Role</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(flow.Trigger))
                                {
                                    <span class="flowmap-role">· khi @flow.Trigger</span>
                                }
                            </div>
                            <table class="permmap-table flowmap-table" data-flow="@flow.Name" data-kind="@flow.Kind"
                                   data-role="@flow.Role" data-trigger="@flow.Trigger">
                                <thead>
                                    <tr>
                                        <th class="flowmap-th-actor">Ai làm</th>
                                        <th class="flowmap-th-action">Làm gì</th>
                                        <th class="flowmap-th-outcome">Sau đó</th>
                                        <th class="flowmap-th-del"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var step in flow.Steps)
                                    {
                                        <tr class="flowmap-row @(step.Included ? "" : "flowmap-row-dropped")">
                                            <td><textarea rows="1" class="permmap-cellinput flowmap-actor" placeholder="ai làm bước này?">@step.Actor</textarea></td>
                                            <td><textarea rows="1" class="permmap-cellinput flowmap-action" placeholder="bước này làm gì?">@step.Action</textarea></td>
                                            <td><textarea rows="1" class="permmap-cellinput flowmap-outcome" placeholder="trạng thái sau bước (nếu có)">@step.Outcome</textarea></td>
                                            @* Cờ đi theo payload nằm ở input ẩn, không ở class của dòng: JS gom bảng đọc đúng
                                               một chỗ (tableChecked) cho cả năm bảng, và một dòng bị bỏ vẫn phải có mặt trong
                                               payload để tin nhắn gửi đi còn gọi tên được nó.

                                               ↑ ↓ đổi THỨ TỰ BƯỚC, thứ ở bảng này là dữ liệu chứ không phải cách bày (nó đi
                                               thẳng vào oracle chấm POC — xem FlowMapRow.Steps). Trạng thái khóa của hai nút
                                               ở dòng đầu/dòng cuối do refreshFlowMoves() gán lúc nạp trang. *@
                                            <td class="flowmap-delcell">
                                                <input type="hidden" class="flowmap-check" value="@(step.Included ? "1" : "0")" />
                                                <button type="button" class="flowmap-move" data-dir="up"
                                                        title="Đưa lên trên bước @step.Action" aria-label="Đưa lên trên bước @step.Action">↑</button>
                                                <button type="button" class="flowmap-move" data-dir="down"
                                                        title="Đưa xuống dưới bước @step.Action" aria-label="Đưa xuống dưới bước @step.Action">↓</button>
                                                <button type="button" class="flowmap-del" title="@(step.Included ? $"Bỏ bước {step.Action}" : $"Lấy lại bước {step.Action}")"
                                                        aria-label="@(step.Included ? $"Bỏ bước {step.Action}" : $"Lấy lại bước {step.Action}")">@(step.Included ? "×" : "↩")</button>
                                            </td>
                                        </tr>
                                    }
                                    <tr class="flowmap-addsteprow">
                                        <td colspan="4">
                                            <button type="button" class="flowmap-add flowmap-addstep"
                                                    title="Thêm bước cho luồng @flow.Name" aria-label="Thêm bước cho luồng @flow.Name">+ thêm bước</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                    <div class="flowmap-addflowrow">
                        <button type="button" class="flowmap-add flowmap-addflow"
                                title="Thêm một luồng mới vào bảng" aria-label="Thêm một luồng mới vào bảng">+ thêm luồng</button>
                    </div>
                    <div class="permmap-bar">
                        <button type="button" class="btn primary" id="flowMapSendBtn">Gửi bảng luồng</button>
                        <div class="permmap-hint">
                            Muốn mình tự dựng thêm một luồng hay một tình huống hỏng từ đầu, anh/chị cứ gõ vào khung chat — mình bổ sung rồi bày lại bảng.
                        </div>
                        <div class="permmap-msg" id="flowMapMsg"></div>
                    </div>
                }
            </div>

            @* BẢNG MÀN HÌNH — phạm vi màn hình của ứng dụng. Ô "phục vụ bước" của TỪNG CHỨC NĂNG là chỗ phép
               kiểm tất định chạy: bước luồng nào không chức năng nào nhận thì hiện thành dòng nhắc dưới bảng,
               vì hai danh sách đọc riêng đều "đạt" còn chỗ hỏng nằm ở mối nối. *@
            <div class="req-msg ba permmap screenmap" id="screenScopePanel"
                 data-confirm-url="@Url.Action("ConfirmScreenScope", "Requirements")"
                 data-table-name="@tblScreen.Name" data-send-label="@tblScreen.SendLabel"
                 @(lastScreenScope.Count > 0 ? "" : "hidden")>
                @if (lastScreenScope.Count > 0)
                {
                    <div class="permmap-howto">
                        Đây là các màn hình mình dự kiến dựng và các chức năng trên từng màn. Màn nào <b>không cần</b>
                        thì bỏ tích ở cột đầu; chức năng nào không cần thì bỏ tích ngay dòng của nó. Thiếu chức năng
                        nào thì bấm <b>+ thêm chức năng</b> ở cuối màn đó, thiếu cả một màn hình thì bấm
                        <b>+ thêm màn hình</b> ở cuối bảng.
                    </div>
                    <table class="permmap-table screenmap-table">
                        <thead>
                            <tr>
                                <th class="flowmap-th-use">Cần</th>
                                <th class="screenmap-th-name">Màn hình</th>
                                <th class="screenmap-th-fn">Chức năng <span class="screenmap-th-note">· cột phải: bước luồng chức năng đó phụ trách</span></th>
                                @* Cột nút xóa. Trống ở mọi dòng BA bày ra — chúng BỎ TÍCH chứ không xóa, xem
                                   screenFunctionRow ở requirements.js. *@
                                <th class="screenmap-th-del"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in lastScreenScope)
                            {
                                <tr class="screenmap-row" data-screen="@row.Screen" data-covers="@string.Join("|", row.Covers)">
                                    <td class="flowmap-use">
                                        @* Chỉ có ô tích. Bảng này KHÔNG có dấu ✓ bằng chứng — xem requirement-flow.md,
                                           mục "Vì sao bảng màn hình không có dấu ✓ bằng chứng". *@
                                        <input type="checkbox" class="screenmap-check" aria-label="Cần màn hình @row.Screen" @(row.Included ? "checked" : "") />
                                    </td>
                                    <td class="permmap-fn">
                                        <div class="screenmap-name">@row.Screen</div>
                                        <textarea rows="1" class="permmap-cellinput screenmap-purpose" placeholder="màn này để làm gì?">@row.Purpose</textarea>
                                        @if (row.Covers.Count > 0)
                                        {
                                            <div class="screenmap-covers">gộp vào màn này: @string.Join(", ", row.Covers)</div>
                                        }
                                    </td>
                                    <td class="screenmap-fncell">
                                        <table class="screenmap-fntable">
                                            <tbody>
                                                @foreach (var fn in row.Functions)
                                                {
                                                    <tr class="screenmap-fn-row">
                                                        <td class="flowmap-use">
                                                            <input type="checkbox" class="screenfn-check" aria-label="Cần chức năng @fn.Name" @(fn.Included ? "checked" : "") />
                                                        </td>
                                                        <td><textarea rows="1" class="permmap-cellinput screenfn-name" placeholder="chức năng">@fn.Name</textarea></td>
                                                        <td><textarea rows="1" class="permmap-cellinput screenfn-steps" placeholder="chức năng này phụ trách bước nào?">@string.Join("; ", fn.FlowSteps)</textarea></td>
                                                        <td class="screenmap-delcell"></td>
                                                    </tr>
                                                }
                                                @* Dòng cuối mỗi màn: nút thêm chức năng còn thiếu. Dòng thêm ra mà
                                                   không gõ gì thì server bỏ nó đi (tên rỗng = không phải một chức
                                                   năng). Chỉ dòng người dùng tự thêm mới có nút xóa. *@
                                                <tr class="screenmap-fn-add">
                                                    <td colspan="4">
                                                        <button type="button" class="screenmap-add screenmap-addfn" aria-label="Thêm chức năng cho @row.Screen">+ thêm chức năng</button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                    <td class="screenmap-delcell"></td>
                                </tr>
                            }
                            @* Dòng cuối bảng: nút thêm một màn hình BA chưa nghĩ tới. Dòng thêm ra có ô tên gõ được
                               và cờ `addedByUser` để đi qua chốt chặn "màn hình bịa" ở server — chốt chặn đó dựng
                               để chặn model, không phải để chặn người dùng. Xem ScreenScopeRow.AddedByUser. *@
                            <tr class="screenmap-addrow">
                                <td colspan="4"><button type="button" class="screenmap-add screenmap-addscreen">+ thêm màn hình</button></td>
                            </tr>
                        </tbody>
                    </table>
                    @* Dòng nhắc của phép kiểm tất định, và là CHỖ RƠI CUỐI CÙNG chứ không còn là lối ra
                       mặc định: bắt được bước mồ côi thì BA tự xếp nó vào chức năng phù hợp trước khi bảng
                       hiện ra (ScreenStepPlacementService), nên tới đây chỉ còn những bước mà chính BA
                       cũng không xếp nổi — bước làm ngoài phần mềm, hoặc một màn hình còn thiếu hẳn. Đó
                       đúng là ca duy nhất đáng hỏi người dùng, và nó vẫn KHÔNG chặn gửi: một câu hỏi,
                       không phải một lỗi để khóa nút. *@
                    <div class="screenmap-warn" id="screenScopeWarn" @(uncoveredFlowSteps.Count > 0 ? "" : "hidden")>
                        Mình chưa xếp được các bước này vào chức năng nào: <b>@string.Join("; ", uncoveredFlowSteps)</b>.
                        Có thể bước đó làm ngoài phần mềm, cũng có thể mình còn thiếu hẳn một màn hình — anh/chị nhắn cho mình biết là bên nào giúp nhé.
                    </div>
                    <div class="permmap-bar">
                        <button type="button" class="btn primary" id="screenScopeSendBtn">Gửi bảng màn hình</button>
                        <div class="permmap-hint">
                            Muốn mô tả kỹ hơn một màn hình còn thiếu, anh/chị cứ gõ vào khung chat — mình bổ sung rồi bày lại bảng.
                        </div>
                        <div class="permmap-msg" id="screenScopeMsg"></div>
                    </div>
                }
            </div>

            @* BẢNG ĐỐI TƯỢNG NGHIỆP VỤ — thông tin cần lưu + vòng đời trạng thái. Vòng đời ở đây là nguồn
               DÒNG của bảng thông báo bên dưới: mỗi trạng thái thành một sự kiện cần trả lời "ai được báo".
               Hai bảng tách nhau vì người nhận thật gần như luôn là một QUAN HỆ với bản ghi ("người gửi
               đơn", "sếp của người đó"), mà muốn bày ra danh sách quan hệ/vai trò đóng thì phải có bảng
               phân quyền đã chốt trước. *@
            <div class="req-msg ba permmap entitymap" id="entityMapPanel"
                 data-confirm-url="@Url.Action("ConfirmEntityMap", "Requirements")"
                 data-table-name="@tblEntity.Name" data-send-label="@tblEntity.SendLabel"
                 @(lastEntityMap.Count > 0 ? "" : "hidden")>
                @if (lastEntityMap.Count > 0)
                {
                    <div class="permmap-howto">
                        Đây là những thứ ứng dụng cần lưu hồ sơ riêng. Đối tượng nào <b>không cần</b> thì bỏ tích ở tiêu
                        đề; thông tin nào không cần lưu thì bỏ tích trong bảng. Thiếu thông tin hay thiếu một trạng thái
                        thì bấm <b>+ thêm</b> ở cuối bảng đó, thiếu cả một đối tượng thì bấm <b>+ thêm đối tượng</b> ở
                        cuối. Ai được báo ở mỗi trạng thái thì mình hỏi ở bảng cuối buổi.
                        <br />Tên đối tượng, tên thông tin và tên trạng thái mình để <b>tiếng Anh</b> vì chúng sẽ thành
                        nhãn cột, ô nhập và trạng thái trong ứng dụng; phần tiếng Việt là dòng mô tả ngay dưới mỗi tên —
                        chỗ nào mình hiểu sai thì anh/chị sửa giúp.
                        <br />Cột <b>Nhập thế nào</b> quyết định hình dạng ô trên màn hình; chọn <b>Chọn 1</b> hay
                        <b>Chọn nhiều</b> thì nói thêm giúp mình danh sách lấy ở đâu — <b>ứng dụng tự quản lý</b> nghĩa là
                        app sẽ có thêm một màn hình riêng để quản lý danh mục đó.
                    </div>
                    @* Bọc các khối trong một div riêng: nút "+ thêm đối tượng" chèn khối mới vào CUỐI div này,
                       nên nó phải là một hộp chứa chỉ có khối đối tượng — không có nó thì khối mới rơi xuống
                       sau cả thanh nút gửi. *@
                    <div class="entitymap-blocks">
                        @foreach (var entity in lastEntityMap)
                        {
                            <div class="entitymap-block" data-entity="@entity.Entity"
                                 data-parent="@entity.ParentEntity"
                                 data-min="@(entity.MinRows?.ToString() ?? "")"
                                 data-max="@(entity.MaxRows?.ToString() ?? "")">
                                <div class="permmap-screen entitymap-head">
                                    @if (entity.Locked)
                                    {
                                        <span class="permmap-locked" title="@entity.Evidence">✓</span>
                                        <input type="hidden" class="entitymap-check" value="1" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="entitymap-check" aria-label="Cần đối tượng @entity.Entity" @(entity.Included ? "checked" : "") />
                                    }
                                    @* Đối tượng BA bày ra: tên là chữ TĨNH. Chỉ đối tượng người dùng tự thêm
                                       mới có ô tên gõ được và nút xóa — xem entityMapBlock ở requirements.js. *@
                                    <span class="entitymap-name">@entity.Entity</span>
                                    <textarea rows="1" class="permmap-cellinput entitymap-desc" placeholder="đối tượng này là gì?">@entity.Description</textarea>
                                </div>
                                @* Ô quan hệ để RỖNG: danh sách đối tượng được phép làm cha phụ thuộc tên và
                                   quan hệ của MỌI khối khác (luật "tối đa một cấp"), nên nó chỉ dựng đúng được
                                   khi cả cụm đã có mặt — xem renderEntityRelation ở requirements.js. *@
                                <div class="entitymap-rel"></div>
                                @* Hai bảng con LUÔN hiện, kể cả khi rỗng: đó là chỗ đứng của hai nút thêm. Một
                                   bảng trạng thái rỗng không phải "mời xác nhận một vòng đời vô nghĩa" (thứ mà
                                   luật cắt vòng đời một trạng thái đang chặn) — nó là chỗ người dùng nói ra
                                   rằng đối tượng này CÓ vòng đời mà BA tưởng là danh mục. *@
                                <table class="permmap-table entitymap-table entitymap-fieldtable">
                                    <thead>
                                        <tr>
                                            <th class="flowmap-th-use">Lưu</th>
                                            @* "Là gì" là DÒNG PHỤ dưới tên chứ không chiếm một cột, cùng luật
                                               với việc-của-màn ở bảng màn hình: bảng này đã có hai cột mới, và
                                               cột người dùng phải điền mà bị đẩy ra ngoài vùng nhìn thấy thì
                                               coi như không tồn tại. *@
                                            <th class="entityfield-th-name">Thông tin</th>
                                            <th class="flowmap-th-use entityfield-th-req">Bắt buộc</th>
                                            <th class="entityfield-th-input">Nhập thế nào</th>
                                            <th class="entityfield-th-src">Danh sách lấy ở đâu</th>
                                            @* Cột nút xóa. Trống ở mọi dòng BA bày ra — chúng BỎ TÍCH chứ không
                                               xóa, vì dòng bị loại vẫn phải kể lại được trong tin nhắn gửi đi. *@
                                            <th class="screenmap-th-del"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var field in entity.Fields)
                                        {
                                            @* Hai ô cuối (kiểu nhập, nguồn danh sách) để RỖNG: chúng đổi hình theo
                                               nhau, và dựng chúng ở đây nữa là nuôi hai bản của cùng một luật ở hai
                                               ngôn ngữ. Razor chỉ chở dữ liệu xuống bằng data-attribute, còn
                                               hydrateEntityField ở requirements.js dựng cho CẢ HAI đường render —
                                               cùng khuôn với khối "Ý khác" của hàng chip. *@
                                            <tr class="entitymap-field"
                                                data-input="@field.Input"
                                                data-source="@field.Source"
                                                data-options="@System.Text.Json.JsonSerializer.Serialize(field.Options)"
                                                data-system="@field.SourceSystem"
                                                data-rule="@field.Rule">
                                                <td class="flowmap-use">
                                                    <input type="checkbox" class="entityfield-check" aria-label="Lưu @field.Name" @(field.Used ? "checked" : "") />
                                                </td>
                                                <td class="permmap-fn entityfield-namecell">
                                                    <textarea rows="1" class="permmap-cellinput entityfield-name" placeholder="thông tin cần lưu">@field.Name</textarea>
                                                    <textarea rows="1" class="permmap-cellinput entityfield-meaning" placeholder="thông tin này là gì?">@field.Meaning</textarea>
                                                </td>
                                                <td class="flowmap-use">
                                                    <input type="checkbox" class="entityfield-required" aria-label="Bắt buộc nhập @field.Name" @(field.Required ? "checked" : "") />
                                                </td>
                                                <td class="entityfield-inputcell"></td>
                                                <td class="entityfield-srccell"></td>
                                                <td class="entitymap-delcell"></td>
                                            </tr>
                                        }
                                        <tr class="entitymap-addfieldrow">
                                            <td colspan="6"><button type="button" class="entitymap-add entitymap-addfield" aria-label="Thêm thông tin cho @entity.Entity">+ thêm thông tin</button></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="permmap-table entitymap-table entitymap-statetable">
                                    <thead>
                                        <tr>
                                            <th class="screenmap-th-name">Trạng thái</th>
                                            <th class="screenmap-th-purpose">Khi nào chuyển vào</th>
                                            <th class="screenmap-th-del"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var state in entity.States)
                                        {
                                            @* Dòng trạng thái KHÔNG có ô tích, nên MỌI dòng đều xóa được — kể cả
                                               dòng BA đề xuất. "Có trạng thái này nhưng bỏ tích" không có nghĩa
                                               gì trong một vòng đời, và trước đây cách duy nhất để loại một
                                               trạng thái sai là xóa trắng ô tên (server bỏ dòng không tên) —
                                               tức đúng việc này, chỉ khác là không ai nhìn ra để làm. *@
                                            <tr class="entitymap-state">
                                                <td class="permmap-fn"><textarea rows="1" class="permmap-cellinput entitystate-name" placeholder="tên trạng thái">@state.State</textarea></td>
                                                <td><textarea rows="1" class="permmap-cellinput entitystate-entry" placeholder="điều kiện/hành động đưa vào trạng thái này">@state.EntryCondition</textarea></td>
                                                <td class="entitymap-delcell">
                                                    <button type="button" class="entitymap-del" title="Xóa trạng thái này" aria-label="Xóa trạng thái này">×</button>
                                                </td>
                                            </tr>
                                        }
                                        <tr class="entitymap-addstaterow">
                                            <td colspan="3"><button type="button" class="entitymap-add entitymap-addstate" aria-label="Thêm trạng thái cho @entity.Entity">+ thêm trạng thái</button></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    @* Nút thêm một đối tượng BA chưa nghĩ tới. Khối thêm ra có ô tên gõ được và cờ `addedByUser`
                       để đi qua luật "đối tượng rỗng ruột" ở server — luật đó dựng để chặn model, không phải để
                       chặn người dùng. Xem EntityMapRow.AddedByUser. *@
                    <div class="entitymap-addrow">
                        <button type="button" class="entitymap-add entitymap-addentity">+ thêm đối tượng</button>
                    </div>
                    <div class="permmap-bar">
                        <button type="button" class="btn primary" id="entityMapSendBtn">Gửi bảng đối tượng</button>
                        <div class="permmap-hint">
                            Muốn mô tả kỹ hơn một đối tượng còn thiếu, anh/chị cứ gõ vào khung chat — mình bổ sung rồi bày lại bảng.
                        </div>
                        <div class="permmap-msg" id="entityMapMsg"></div>
                    </div>
                }
            </div>

            @* BẢNG BÁO CÁO / THỐNG KÊ — bảng thứ tư, đứng giữa bảng đối tượng và bảng phân quyền.

               Vì sao là bảng chứ không phải ô kể tự do: câu trả lời của nhóm này luôn là một DANH SÁCH, mà
               một ô text gom cả danh sách vào một đoạn — mỗi báo cáo mất phần "lấy số từ đâu" và "gộp theo
               gì", rồi bước sinh spec phải đoán lại cả hai.

               Vì sao bảng KHÔNG bao giờ bày ra trống: cổng của nó (ReportMapGate) đòi nhóm «Báo cáo / thống
               kê» đã [RÕ] — hội thoại kể xong thì BA mới có gì để điền sẵn. Một bảng trống là bắt người
               dùng nghiệp vụ tự chẻ câu chuyện của họ thành bốn cột trước khi gõ được chữ nào, tức thu về
               ít hơn cả cái ô text nó thay thế.

               Vì sao KHÔNG có cột "ai xem": mỗi dòng còn tích là một MÀN HÌNH (ConfirmReportMapUseCase gieo
               vào PlannedScope), nên nó đi tiếp vào bảng màn hình rồi thành DÒNG của bảng phân quyền — nơi
               "ai xem" đã có cột riêng kèm phạm vi dữ liệu. Đó cũng là lý do bảng này đứng TRƯỚC bảng phân
               quyền. Bảng treo theo DỰ ÁN (Project.ReportMap còn null) như các bảng kia. *@
            <div class="req-msg ba permmap reportmap" id="reportMapPanel"
                 data-confirm-url="@Url.Action("ConfirmReportMap", "Requirements")"
                 data-table-name="@tblReport.Name" data-send-label="@tblReport.SendLabel"
                 data-entities='@Html.Raw(reportEntityOptionsJson)'
                 @(lastReportMap.Count > 0 ? "" : "hidden")>
                @if (lastReportMap.Count > 0)
                {
                    <div class="permmap-howto">
                        Đây là các báo cáo <b>mình gom lại</b> từ những gì anh/chị đã kể. Báo cáo nào không cần thì
                        <b>bỏ tích</b> cột đầu; ô nào mình hiểu chưa đúng thì sửa thẳng vào ô; thiếu báo cáo nào thì
                        bấm <b>+ thêm báo cáo</b> ở cuối bảng. Mỗi báo cáo còn giữ sẽ thành <b>một màn hình</b> của
                        ứng dụng, nên ai được xem báo cáo nào sẽ hỏi ở bảng phân quyền ngay sau đây.
                    </div>
                    <table class="permmap-table reportmap-table">
                        <thead>
                            <tr>
                                <th class="flowmap-th-use">Cần</th>
                                <th class="reportmap-th-name">Báo cáo / thống kê</th>
                                <th class="reportmap-th-question">Để trả lời câu hỏi gì</th>
                                <th class="reportmap-th-source">Lấy số từ</th>
                                <th class="reportmap-th-breakdown">Gộp / lọc theo</th>
                                @* Cột nút xóa: TRỐNG ở mọi dòng BA gieo ra — chúng bỏ tích chứ không xóa, vì
                                   báo cáo bị loại vẫn phải kể lại được trong tin nhắn gửi đi. *@
                                <th class="screenmap-th-del"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in lastReportMap)
                            {
                                <tr class="reportmap-row" data-added="@(row.AddedByUser ? "true" : "false")">
                                    <td class="flowmap-use">
                                        <input type="checkbox" class="reportmap-check" aria-label="Cần báo cáo @row.Report" @(row.Included ? "checked" : "") />
                                    </td>
                                    @* Khác ba bảng kia, tên ở đây SỬA ĐƯỢC kể cả ở dòng BA đề xuất: nó không
                                       phải khóa nối sang bảng nào (mục phạm vi được gieo từ chính giá trị vừa
                                       gửi lên), mà đặt lại tên một báo cáo lại là chỗ người dùng hay sửa nhất. *@
                                    <td><textarea rows="1" class="permmap-cellinput reportmap-name" aria-label="Tên báo cáo" placeholder="tên báo cáo…">@row.Report</textarea></td>
                                    <td><textarea rows="1" class="permmap-cellinput reportmap-question" aria-label="Báo cáo này trả lời câu hỏi gì" placeholder="để biết điều gì?">@row.Question</textarea></td>
                                    <td>
                                        <select class="reportmap-source" aria-label="Số liệu lấy từ đối tượng nào">
                                            <option value="" selected="@(string.IsNullOrWhiteSpace(row.Source))">— chưa rõ —</option>
                                            @foreach (var entity in reportEntityOptions)
                                            {
                                                <option value="@entity" selected="@(string.Equals(entity, row.Source, StringComparison.OrdinalIgnoreCase))">@entity</option>
                                            }
                                        </select>
                                    </td>
                                    <td><textarea rows="1" class="permmap-cellinput reportmap-breakdown" aria-label="Gộp hoặc lọc theo" placeholder="kỳ, đơn vị, trạng thái…">@row.Breakdown</textarea></td>
                                    <td class="entitymap-delcell">
                                        @if (row.AddedByUser)
                                        {
                                            <button type="button" class="entitymap-del reportmap-del" title="Xóa dòng này" aria-label="Xóa dòng này">×</button>
                                        }
                                    </td>
                                </tr>
                            }
                            <tr class="reportmap-addrow">
                                <td colspan="6"><button type="button" class="entitymap-add reportmap-add">+ thêm báo cáo</button></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="permmap-bar">
                        <button type="button" class="btn primary" id="reportMapSendBtn">Gửi bảng báo cáo</button>
                        <div class="permmap-hint">
                            Không cần báo cáo nào thì cứ bỏ tích hết rồi gửi — mình ghi lại là ứng dụng không có
                            phần báo cáo, không hỏi lại nữa.
                        </div>
                        <div class="permmap-msg" id="reportMapMsg"></div>
                    </div>
                }
            </div>

            @* BẢNG THÔNG BÁO / NHẮC NHỞ — bảng CUỐI CÙNG của buổi phỏng vấn, và là nhóm THỨ HAI (sau phân
               quyền) không được chốt bằng câu hỏi.

               Vì sao không hỏi bằng chip: chuẩn [RÕ] của nhóm đòi hai vế GHÉP ĐƯỢC với nhau — mỗi loại sự
               kiện biết ai là người nhận của RIÊNG nó — trong khi hình dạng tự nhiên của câu hỏi lại tách
               chúng làm hai câu rời ("vai trò nào cần nhận email?" + "sự kiện nào cần gửi?"). Ca thật: người
               dùng bấm bốn chip vai trò, dòng lên [RÕ], và tài liệu đóng băng thành "mọi thay đổi trạng thái
               gửi cho cả bốn nhóm" — tức mỗi lần một bản ghi đổi trạng thái là cả nhà máy nhận email.

               Vì sao ô là CHỌN NHIỀU chứ không phải ô gõ: người nhận thật gần như luôn là một QUAN HỆ với
               bản ghi ("người gửi đơn", "sếp của người đó"), và một người nhận gõ thẳng vào từng dòng thì
               mỗi dòng lại một cách viết — không tầng nào ghép chúng lại được. Chọn thì chọn từ DANH SÁCH
               NGƯỜI NHẬN ngay trên đầu panel: đó mới là chỗ người dùng thêm/sửa/xóa, và sửa một lần thì mọi
               ô To/CC đổi theo. Bảng treo theo DỰ ÁN (Project.NotificationMap còn null) như bốn bảng kia. *@
            <div class="req-msg ba permmap notifmap" id="notificationMapPanel"
                 data-confirm-url="@Url.Action("ConfirmNotificationMap", "Requirements")"
                 data-table-name="@tblNotification.Name" data-send-label="@tblNotification.SendLabel"
                 data-options='@Html.Raw(recipientOptionsJson)'
                 @(lastNotificationMap.Count > 0 ? "" : "hidden")>
                @if (lastNotificationMap.Count > 0)
                {
                    @* DANH SÁCH NGƯỜI NHẬN — bảng đứng TRƯỚC vì nó là nguồn của hai ô To/CC ở bảng dưới:
                       sửa một mục ở đây là mọi ô chọn đổi theo (requirements.js, syncRecipientOptions).
                       Markup phải khớp bản JS dựng ở renderRecipientList. *@
                    <div class="permmap-howto">
                        Đây là <b>danh sách người nhận</b> của dự án — mình gom từ những gì anh/chị đã kể. Hai ô
                        <b>Gửi cho (To)</b> và <b>Đồng gửi (CC)</b> ở bảng dưới chỉ chọn được trong danh sách này,
                        nên thiếu ai thì thêm ngay ở đây, sửa chữ hoặc xóa cũng được.
                    </div>
                    <table class="permmap-table notifrecip-table">
                        <thead>
                            <tr>
                                <th>Người nhận</th>
                                <th class="screenmap-th-del"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var recipient in recipientOptions)
                            {
                                <tr class="notifrecip-row">
                                    <td><textarea rows="1" class="permmap-cellinput notifrecip-name" aria-label="Tên người nhận">@recipient</textarea></td>
                                    <td class="entitymap-delcell">
                                        <button type="button" class="entitymap-del notifrecip-del" title="Xóa người nhận này" aria-label="Xóa người nhận này">×</button>
                                    </td>
                                </tr>
                            }
                            <tr class="notifrecip-addrow">
                                <td colspan="2"><button type="button" class="entitymap-add notifrecip-add">+ thêm người nhận</button></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="permmap-howto">
                        Đây là các sự kiện của ứng dụng. Sự kiện nào <b>không cần gửi email</b> thì bỏ tích cột đầu; sự
                        kiện còn tích thì <b>bắt buộc chọn người nhận (To)</b>, còn <b>đồng gửi (CC)</b> có thì chọn,
                        không có thì để trống. Thiếu một lời nhắc theo thời hạn thì bấm <b>+ thêm lời nhắc</b> ở cuối bảng.
                    </div>
                    <table class="permmap-table notifmap-table">
                        <thead>
                            <tr>
                                <th class="flowmap-th-use">Cần</th>
                                <th class="notifmap-th-event">Sự kiện</th>
                                <th class="notifmap-th-who">Gửi cho (To)</th>
                                <th class="notifmap-th-cc">Đồng gửi (CC)</th>
                                @* Cột nút xóa: TRỐNG ở mọi dòng BA gieo ra — chúng bỏ tích chứ không xóa, vì
                                   sự kiện bị tắt vẫn phải kể lại được trong tin nhắn gửi đi. *@
                                <th class="screenmap-th-del"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in lastNotificationMap)
                            {
                                <tr class="notifmap-row" data-entity="@row.Entity" data-event="@row.Event" data-trigger="@row.Trigger">
                                    <td class="flowmap-use">
                                        @if (row.Locked)
                                        {
                                            <span class="permmap-locked" title="@row.Evidence">✓</span>
                                            <input type="hidden" class="notifmap-check" value="1" />
                                        }
                                        else
                                        {
                                            <input type="checkbox" class="notifmap-check" aria-label="Cần báo khi @row.Event" @(row.Needed ? "checked" : "") />
                                        }
                                    </td>
                                    <td class="permmap-fn">
                                        @if (!string.IsNullOrWhiteSpace(row.Entity))
                                        {
                                            <span class="notifmap-entity">@row.Entity</span>
                                        }
                                        <span class="notifmap-name">@row.Event</span>
                                        @if (!string.IsNullOrWhiteSpace(row.Trigger))
                                        {
                                            <span class="notifmap-trigger">khi @row.Trigger</span>
                                        }
                                    </td>
                                    @* Hai ô chọn dùng markup .ms-combo dùng chung của app; phần điều khiển
                                       (mở/đóng, cập nhật nhãn) ở requirements.js — xem recipientPicker, bản
                                       này phải khớp đúng nó, lệch nhau thì người dùng rà một bảng rồi F5 và
                                       thấy một bảng khác. *@
                                    @foreach (var kind in new[] { "to", "cc" })
                                    {
                                        var chosen = kind == "to" ? row.To : row.Cc;
                                        <td>
                                            <div class="ms-combo notifmap-pick" data-kind="@kind">
                                                <button type="button" class="ms-combo-trigger" aria-label="@(kind == "to" ? "Người nhận chính" : "Người đồng gửi") của @row.Event">
                                                    <span class="ms-combo-trigger-main">
                                                        <span class="ms-combo-text @(chosen.Count == 0 ? "is-placeholder" : "")">
                                                            @(chosen.Count > 0 ? string.Join(", ", chosen) : (kind == "to" ? "Chọn người nhận" : "Không đồng gửi"))
                                                        </span>
                                                    </span>
                                                    <span class="ms-combo-caret">▾</span>
                                                </button>
                                                <div class="ms-combo-panel" hidden>
                                                    <ul class="ms-combo-list">
                                                        @foreach (var option in recipientOptions)
                                                        {
                                                            <li class="ms-combo-option @(chosen.Contains(option) ? "selected" : "")">
                                                                <label class="ms-combo-checkbox">
                                                                    <input type="checkbox" value="@option" @(chosen.Contains(option) ? "checked" : "") />
                                                                    <span class="ms-combo-box"></span>
                                                                    <span class="ms-combo-option-text">@option</span>
                                                                </label>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </td>
                                    }
                                    <td class="entitymap-delcell"></td>
                                </tr>
                            }
                            @* Nửa "NHẮC NHỞ" của nhóm không phải chuyển trạng thái nào ("trước hạn 3 ngày"),
                               nên không có nút này thì nó biến mất trong im lặng ngay tại bảng sinh ra để
                               chốt nó. Dòng thêm ra mang cờ addedByUser để đi qua chốt chặn "sự kiện bịa" ở
                               server — chốt chặn đó dựng để chặn model, không phải để chặn người dùng. *@
                            <tr class="notifmap-addrow">
                                <td colspan="5"><button type="button" class="entitymap-add notifmap-add">+ thêm lời nhắc</button></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="permmap-bar">
                        <button type="button" class="btn primary" id="notificationMapSendBtn">Gửi bảng thông báo</button>
                        <div class="permmap-hint">
                            Người nhận là một quan hệ với bản ghi ("Người tạo", "Quản lý trực tiếp của người tạo") hoặc một
                            người/nhóm anh/chị tự thêm ở bảng danh sách người nhận phía trên.
                        </div>
                        <div class="permmap-msg" id="notificationMapMsg"></div>
                    </div>
                }
            </div>

            @* BẢNG PHÂN QUYỀN — nhóm «Phân quyền theo nghiệp vụ» là một trong HAI nhóm không được chốt bằng câu
               hỏi. Hỏi "mỗi vai trò được xem và làm những gì?" là bắt người dùng nghiệp vụ tự dựng cả ma
               trận trong đầu, nên câu trả lời thật gần như luôn là "cứ vậy đã, có gì tôi bổ sung sau" — rồi
               BA tự soạn phương án và một chip "Đồng ý" đóng dấu [RÕ] cho cả nhóm, khóa luôn đường hỏi lại.

               Vì sao ô là DROPDOWN PHẠM VI chứ không phải checkbox: quyết định thật gần như luôn có mệnh đề
               phạm vi ("xem Plan DO MÌNH LẬP", "xem ticket CỦA NHÂN VIÊN THUỘC QUYỀN"). Một dấu tích chỉ ghi
               được "có xem" và bước soạn tài liệu phải tự đoán xem của ai — đúng chỗ trống cần lấp.

               Vì sao ô có bằng chứng thì KHÓA (dấu ✓ + tooltip trích dẫn) còn ô còn lại thì chọn được: nếu
               mọi ô đều điền sẵn và trông như đã chốt thì người dùng bấm gửi trong ba giây, và ta quay về
               đúng cái chip "Đồng ý phương án này" — chỉ khác là to hơn.

               Đặt SAU #columnMap và TRƯỚC #writeReqZone: hai bảng không bao giờ cùng sống (bảng cột thuộc
               lượt đọc file đầu buổi, bảng này thuộc lượt cuối buổi), nhưng thứ tự DOM vẫn phải cố định để
               requirements.js dời cả cụm xuống cuối dòng hội thoại sau mỗi lượt. *@
            <div class="req-msg ba permmap" id="permissionMatrix"
                 data-confirm-url="@Url.Action("ConfirmPermissionMatrix", "Requirements")"
                 data-table-name="@tblPermission.Name" data-send-label="@tblPermission.SendLabel"
                 @(lastPermissionMatrix.Count > 0 ? "" : "hidden")>
                @if (lastPermissionMatrix.Count > 0)
                {
                    @* BẢNG VAI TRÒ — nguồn của MỌI cột bên dưới, cùng khuôn với "Danh sách người nhận" của bảng
                       thông báo. Trước đó cột được chắt ngầm từ đề xuất của model, nên vai bị quên chỉ thêm lại
                       được bằng cách gõ vào khung chat cho BA bày lại cả bảng — một lượt LLM cho một việc tất
                       định. Markup khớp bản JS dựng ở frame done (renderPermissionRoles). *@
                    <div class="permmap-howto">
                        Đây là các <b>vai trò</b> mình gom được từ những gì anh/chị đã kể — cũng chính là các
                        <b>cột</b> của bảng dưới. Thiếu vai nào thì thêm ngay ở đây, sửa chữ hoặc xóa cũng được;
                        các bảng dưới đổi cột theo.
                    </div>
                    <table class="permmap-table permrole-table">
                        <thead>
                            <tr>
                                <th>Vai trò</th>
                                <th class="screenmap-th-del"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in permissionRoles)
                            {
                                <tr class="permrole-row">
                                    <td><textarea rows="1" class="permmap-cellinput permrole-name" aria-label="Tên vai trò">@role</textarea></td>
                                    <td class="entitymap-delcell">
                                        <button type="button" class="entitymap-del permrole-del" title="Xóa vai trò này" aria-label="Xóa vai trò này">×</button>
                                    </td>
                                </tr>
                            }
                            <tr class="permrole-addrow">
                                <td colspan="2"><button type="button" class="entitymap-add permrole-add">+ thêm vai trò</button></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="permmap-howto">
                        Ô <b>✓</b> là quyền anh/chị đã nói trong lúc trao đổi (rê chuột để xem lại câu gốc) — mình khóa
                        lại, không cần chọn nữa. Các ô còn lại là <b>phỏng đoán của mình</b>: anh/chị chọn phạm vi dữ
                        liệu cho đúng, và <b>để trống</b> nghĩa là vai đó không có quyền này.
                    </div>
                    @foreach (var screen in lastPermissionMatrix.GroupBy(r => r.Screen))
                    {
                        <div class="permmap-screen">@screen.Key</div>
                        <table class="permmap-table">
                            <thead>
                                <tr>
                                    <th class="permmap-th-fn">Chức năng</th>
                                    @foreach (var role in permissionRoles)
                                    {
                                        <th class="permmap-th-role">@role</th>
                                    }
                                    <th class="permmap-th-cond">Điều kiện thêm (nếu có)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in screen)
                                {
                                    <tr class="permmap-row" data-screen="@row.Screen" data-function="@row.Function">
                                        <td class="permmap-fn">@row.Function</td>
                                        @foreach (var grant in row.Grants)
                                        {
                                            <td class="permmap-cell" data-role="@grant.Role">
                                                @if (grant.Locked)
                                                {
                                                    @* Ô đã có bằng chứng: hiện ✓ cố định + input ẩn giữ phạm vi, đúng
                                                       lối của cột "Super Administrator" trong bảng phân quyền giấy —
                                                       nhìn là biết ngay ô nào đã chốt, ô nào còn phải quyết. *@
                                                    <span class="permmap-locked" title="@grant.Evidence">✓ @grant.Scope</span>
                                                    <input type="hidden" class="permmap-scope" value="@grant.Scope" />
                                                }
                                                else
                                                {
                                                    <select class="permmap-scope" aria-label="@grant.Role — @row.Function">
                                                        <option value="" selected="@(!ICOGenerator.Contracts.Requirements.PermissionScope.IsGranted(grant.Scope))">—</option>
                                                        @foreach (var scope in ICOGenerator.Contracts.Requirements.PermissionScope.Granted)
                                                        {
                                                            <option value="@scope" selected="@(grant.Scope == scope)">@scope</option>
                                                        }
                                                    </select>
                                                }
                                            </td>
                                        }
                                        <td>
                                            <input type="text" class="permmap-condition" value="@row.Condition"
                                                   placeholder="vd: chỉ sửa khi chưa submit" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="permmap-bar">
                        <button type="button" class="btn primary" id="permissionMatrixSendBtn">Gửi bảng phân quyền</button>
                        <div class="permmap-hint">
                            Thiếu màn hình nào thì anh/chị cứ gõ vào khung chat — mình bổ sung rồi bày lại bảng.
                        </div>
                        <div class="permmap-msg" id="permissionMatrixMsg"></div>
                    </div>
                }
            </div>

            @* CỔNG TẠO TÀI LIỆU (#writeReqZone) — khối cuối cùng của dòng hội thoại, và là chỗ DUY NHẤT
               trên màn hình có nút sinh Product Brief. Gồm hai nhịp của CÙNG một quyết định: nút tạo tài
               liệu → cổng soát mâu thuẫn (nếu có).

               Vì sao cả cụm nằm trong khung chat chứ không ở sidebar: quy trình đang ĐỨNG CHỜ người dùng,
               mà lời mời lại do BA nói ở cuối chat — câu hỏi và nút trả lời phải nằm cùng một chỗ mắt đang
               nhìn (chat tự cuộn đáy). Cùng lý do đã chuyển cổng xác nhận giả định vào đây.

               Là MỘT wrapper chứ không phải hai khối rời vì requirements.js phải dời cả cụm xuống cuối dòng
               hội thoại sau mỗi lượt (các bong bóng mới chèn vào trước #thinkingBox): dời lẻ từng khối thì
               panel mâu thuẫn có thể lạc lên giữa các lượt cũ. Wrapper cũng giữ cụm này KHÔNG kề trực tiếp
               các bong bóng BA, nên quy tắc gộp "câu hỏi BA + chip gợi ý" (.req-msg.ba:has(+ .suggestion-list
               …)) không bị chen vào giữa.

               KHÔNG còn "bản tổng kết trước khi tạo tài liệu" ở đây (danh sách nhật ký "điều đã chốt" kèm
               nút ✎ Sửa, chip bôi đen và nút "Gửi đính chính"). Nó bị gỡ vì đúng cái lý do đã gỡ panel
               "Điều đã chốt" ở sidebar, chỉ muộn hơn một nhịp: một danh sách ~40 dòng phẳng, không thứ tự
               ưu tiên, được bày ra đúng lúc người dùng chỉ còn muốn bấm nút — nên nó bị đọc lướt rồi bấm
               qua, và một cổng rà soát được bấm qua còn tệ hơn không có: nó tạo cảm giác ĐÃ rà. Người dùng
               cũng không có cách nào nhìn danh sách đó mà biết được cái gì THIẾU — thứ đắt nhất ở bước này
               — vì bản tổng kết chỉ kể lại những gì đã nói.

               Việc rà soát không mất, nó đã nằm ở những chỗ SỬA ĐƯỢC và đúng lúc hơn: nhịp BA chủ động đọc
               lại sau mỗi ~5–7 câu (requirement-chat.v4.md), sáu bảng chốt + bảng phân quyền mà người dùng
               sửa trực tiếp (bảng LUỒNG là chỗ rà từng bước quy trình), cổng soát mâu thuẫn ngay dưới nút
               này, và sau khi có tài liệu thì ghim ghi chú thẳng trên bản xem trước Product Brief
               (ReviseBriefFromNotesUseCase).

               data-state là hợp đồng với requirements.js: nó khởi tạo trạng thái cổng từ đúng bản server
               vừa render thay vì đoán qua việc khối đang ẩn hay hiện.
               Markup phải khớp syncWriteReqGate (requirements.js) để frame done render y hệt khi không reload. *@
            @* data-draft-exists: bản Brief đã có hay chưa. requirements.js cần nó để quyết định có được
               dùng cờ readiness của frame done hay không (đường lùi khi BA đáp bằng câu hỏi thay vì lời
               mời — xem BAChatTurnResult.CoverageReady). Chỉ đổi khi vòng soạn chạy xong, mà lúc đó
               requirement-workflow.js tải lại trang, nên một thuộc tính render sẵn là đủ. *@
            <div class="write-req-zone" id="writeReqZone" data-state="@writeReqState"
                 data-draft-exists="@(draftExists ? "true" : "false")"
                 data-gate-speaks="@(tableGateSpeaks ? "true" : "false")">
                @* CỔNG ĐANG CHỜ MỘT BẢNG (trạng thái "table"). Loại trừ với #summaryGate ngay dưới: hai khối
                   này là hai câu trả lời khác nhau cho cùng câu hỏi "bấm gì tiếp theo", nên không bao giờ
                   cùng hiện.

                   Vì sao phải NÓI RA thay vì chỉ đóng cổng: cụm này nằm ở cuối khung chat, và người dùng
                   vừa được MỜI bấm nút ở đây — nút biến mất trong im lặng đọc lên thành "hệ thống hỏng".
                   Nhưng cũng vì thế, khối này chỉ dựng khi cổng LẼ RA ĐÃ MỞ (tableGateSpeaks): ở lượt BA
                   vừa bày bảng ra và chưa mời gì cả, cổng vốn đã im lặng, và nói thêm một câu ngay dưới cái
                   bảng đang có sẵn nút gửi của nó chỉ là lặp lại — xem chú thích ở tableGateSpeaks.

                   Câu chữ do PendingConfirmTableGate soạn (một nguồn cho cả lượt BA ở đường bị chặn phía
                   server), và requirements.js dựng lại ĐÚNG câu này ở frame done — markup phải khớp, xem
                   tableGateHint. *@
                <div class="req-msg ba summary-gate summary-gate-blocked" id="tableGate"
                     @(tableGateSpeaks ? "" : "hidden")>
                    <div class="summary-gate-head">
                        <b>BA</b>
                        <span class="summary-gate-title">Còn một bảng chờ anh/chị chốt</span>
                    </div>
                    <div class="summary-gate-hint" id="tableGateHint">@(pendingTable?.GateHint)</div>
                </div>

                <div class="req-msg ba summary-gate" id="summaryGate" @(writeReqOpen ? "" : "hidden")>
                    <div class="summary-gate-head">
                        <b>BA</b>
                        <span class="summary-gate-title">Sẵn sàng tạo tài liệu</span>
                    </div>
                    @* Lời dẫn chỉ còn MỘT biến thể (trước đây có hai: có/không có bản tổng kết để rà). Nó chỉ
                       đường rà soát cho bước SAU — bản mô tả — chứ không mời rà một danh sách ở đây nữa, và
                       vì thế requirements.js không phải viết lại nó theo lượt. *@
                    <div class="summary-gate-hint">
                        Mình đã thu thập đủ thông tin để soạn bản mô tả sản phẩm. Bấm nút bên dưới để mình soạn —
                        rồi anh/chị <b>rà thẳng trên bản mô tả</b>: chỗ nào chưa đúng thì ghim ghi chú ngay tại đó,
                        hoặc nhắn lại cho mình trong khung chat.
                    </div>
                    <div class="summary-gate-bar">
                        @* NÚT THẬT — không còn nút trung gian "bấm hộ" một form ở sidebar. Chốt chặn trước
                           lúc soạn (cổng soát mâu thuẫn initConflictGate) là listener trên chính nút này,
                           nên mọi đường bấm đều đi qua nó — không có cửa sau nào submit thẳng form.
                           data-*-label/title là hợp đồng với requirements.js: cổng soát mâu thuẫn đọc
                           data-idle-label để khôi phục nhãn sau khi soát xong, còn data-ready-* là bản
                           gốc để syncWriteReqGate dựng lại nhãn sau mỗi lượt chat (nhãn có thể đang là
                           "Đang tạo tài liệu…"/"Đang soát…"). Nút chỉ còn MỘT nhãn vì cổng chỉ còn MỘT
                           trạng thái mở ("ready"); các trạng thái khác không dựng nút nào. Cờ "run đang
                           bay" KHÔNG lặp lại ở đây — nó đã nằm trong data-state của #writeReqZone, và hai
                           nguồn sự thật cho cùng một điều là đúng thứ sinh ra vênh trạng thái. *@
                        <form asp-action="WriteRequirement"
                              method="post"
                              class="write-req write-req-@writeReqState"
                              onsubmit="var b=this.querySelector('button'); b.disabled=true; b.textContent='Đang tạo tài liệu…';">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="projectId" value="@Model.Id" />
                            <button class="btn write-req-btn primary"
                                    type="submit"
                                    data-idle-label="@writeReqLabel"
                                    data-ready-label="@writeReqLabel"
                                    data-ready-title="@writeReqTitle"
                                    title="@writeReqTitle">
                                @writeReqLabel
                            </button>
                        </form>
                        @* KHÔNG còn nút "Gửi đính chính cho BA" ở đây: nó là cặp loại trừ với nút trên, dùng để
                           gửi ghi chú của bản tổng kết — mà bản tổng kết đã gỡ. Đính chính đi qua khung chat như
                           mọi điều khác (dòng ngay dưới đây chỉ đường). *@
                        <div class="summary-gate-foot">
                            Còn điều gì chưa nói tới, anh/chị cứ nhắn thêm trong khung chat như bình thường.
                        </div>
                    </div>
                </div>

                @* CỔNG SOÁT MÂU THUẪN: chạy khi bấm nút ở trên, TRƯỚC khi tài liệu được soạn. Panel tiến độ
                   chỉ trả lời "đã rõ hết chưa"; cổng này trả lời "những điều đã rõ có chọi nhau không" — và
                   một mâu thuẫn lọt qua đây sẽ đóng băng thành yêu cầu sai rồi kéo cả POC theo. Không có mâu
                   thuẫn ⇒ panel không bao giờ hiện, form submit như trước.
                   Đứng ngay dưới nút chứ không ở sidebar: nó là CÂU HỎI PHÁT SINH TỪ CÚ BẤM đó, hiện lên ở
                   nửa màn hình bên kia thì người dùng chỉ thấy nút mình vừa bấm không phản ứng gì. *@
                <div class="conflict-panel" id="conflictPanel" hidden
                     data-check-url="@Url.Action("CheckConflicts", "Requirements")"
                     data-resolve-url="@Url.Action("ResolveConflicts", "Requirements")">
                    <h3>⚠ Có điểm đang mâu thuẫn</h3>
                    <div class="history-sub">Mấy điểm dưới đây anh/chị đã nói theo hai cách khác nhau. Chọn giúp phương án đúng để tài liệu không ghi nhầm.</div>
                    <div class="conflict-body" id="conflictBody"></div>
                    <div class="conflict-msg" id="conflictMsg"></div>
                </div>
            </div>

            <div id="thinkingBox"
                 class="req-msg ba thinking"
                 style="display:none;">

                <div class="thinking-content">

                    <div class="spinner"></div>

                    <span id="thinkingText">
                        BA is analyzing requirements...
                    </span>

                </div>
            </div>

        </div>

        <div class="chat-composer">

            <div class="composer-actions">

                <!-- WRITE REQUIREMENT không có nút ở đây, và cũng không còn ở sidebar: nút thật nằm trong
                     cổng tạo tài liệu (#writeReqZone) ở cuối dòng hội thoại, ngay dưới lượt BA mời tạo tài
                     liệu. Một nút đứng thường trực cạnh ô nhập lại quay về đúng vấn đề cũ — nó phải bịa ra
                     trạng thái "khóa" cho phần lớn thời gian nó tồn tại. -->

                <!-- Cổng "Duyệt & tiếp tục" (và Retry/Reject) ĐÃ CHUYỂN sang Agent Dashboard: user thường
                     dừng ở bước POC, chỉ TeamDev/Admin (quyền DeliveryAdvance) mới đẩy tiếp các bước
                     Architecture/code/test. Trang này chỉ hiển thị tiến độ; banner bên dưới sẽ hướng
                     dẫn người có quyền sang dashboard. -->

            </div>

            <!-- Khay xem trước ảnh đã đính kèm (chưa gửi): đính kèm/dán/kéo-thả ảnh sẽ hiện thumbnail nhỏ
                 ở đây để user gõ thêm ghi chú vào ô nhập rồi mới bấm gửi. JS (requirements.js) dựng các
                 thumbnail và xử lý xóa từng ảnh; ẩn khi chưa có ảnh nào. -->
            <div id="attachPreview" class="attach-preview" hidden aria-label="Ảnh đính kèm chờ gửi"></div>

            <!-- Form này KHÔNG bao giờ postback: requirements.js chặn submit và gửi lượt chat qua
                 POST /Requirements/ChatStream (SSE) — đường ghi duy nhất của khung chat. Nó tồn tại để
                 requestSubmit() có chỗ bám (Enter, các nút gửi trên thẻ hỏi/gợi ý) và để giữ sẵn hai
                 giá trị streamChat cần đọc ra FormData: projectId và antiforgery token. asp-action trỏ
                 đúng ChatStream để không còn endpoint ghi thứ hai nào lệch khỏi luồng chính. -->
            <form id="chatForm"
                  asp-action="ChatStream"
                  method="post"
                  class="req-chatbox">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="projectId"
                       value="@Model.Id" />

              <textarea id="messageInput"
                          rows="1"
                          placeholder="Type your message..."
                          autocomplete="off"></textarea>

                <!-- Đính kèm tài liệu: mở hộp chọn file rồi upload qua đúng endpoint UploadSource (BA đọc &
                     tóm tắt). Dùng chung luồng với dán (Ctrl+V) / kéo-thả — chỉ thêm điểm bấm rõ ràng cho
                     người dùng không biết mẹo dán. Input không có name để không lẫn vào form chat.
                     accept phải phủ ĐỦ mọi định dạng ProjectSourceIngestor nhận (ảnh/PDF/bảng tính): đây là
                     lối đính kèm DUY NHẤT sau khi form upload ở sidebar bị bỏ. -->
                <input type="file"
                       id="attachImageInput"
                       accept="image/png,image/jpeg,image/webp,image/gif,application/pdf,.pdf,.docx,.docm,.xlsx,.xlsm,.csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"
                       multiple
                       hidden />
                <button class="btn outline attach-btn"
                        type="button"
                        id="attachImageBtn"
                        aria-label="Đính kèm tài liệu"
                        title="Đính kèm tài liệu để BA đọc: ảnh/chụp màn hình, PDF (kể cả bản scan), Word (.docx), Excel (.xlsx) hoặc CSV">
                    <i class="bi bi-paperclip" aria-hidden="true"></i>
                </button>

                <!-- Nói thay vì gõ (Web Speech API). JS ẩn nút khi trình duyệt không hỗ trợ;
                     đang ghi âm thì nút đổi trạng thái đỏ + text nhận dạng đổ dần vào ô nhập. -->
                <button class="btn outline voice-btn"
                        type="button"
                        id="voiceInputBtn"
                        hidden
                        aria-label="Nói thay vì gõ"
                        title="Nói thay vì gõ — bấm để bắt đầu/dừng ghi âm">
                    <i class="bi bi-mic" aria-hidden="true"></i>
                </button>

                <button class="btn primary"
                        type="submit"
                        aria-label="Send message">
                    ➤
                </button>
            </form>

        </div>

    </section>

</div>

@* Popup "Tài liệu nguồn": bảng liệt kê MỌI file người dùng đã đính kèm cho BA (qua nút 📎 / dán /
   kéo-thả trong khung chat) — xem lại, mở bản gốc, hoặc xoá. Không còn form upload ở đây: đính kèm đã
   là một phần của cuộc trò chuyện. Xoá chạy bằng fetch để bảng cập nhật tại chỗ (popup không đóng). *@
<div id="sourceModal" class="req-modal-overlay">
    <div class="requirement-modal source-modal">

        <div class="modal-header">
            <div>
                <h2>Tài liệu nguồn</h2>
                <div class="history-sub">Các file anh/chị đã đính kèm cho BA trong cuộc trò chuyện. Xoá file nghĩa là BA không dùng nội dung đó cho các lượt sau nữa.</div>
            </div>

            <button class="modal-close" type="button" aria-label="Close" id="sourceModalClose">×</button>
        </div>

        <div class="requirement-content">
            @Html.AntiForgeryToken()
            <input type="hidden" id="sourceModalProjectId" value="@Model.Id" />

            @if (!baSupportsVision)
            {
                <div class="source-vision-warn">
                    ⚠️ Model BA hiện không bật <b>vision</b> → ảnh sẽ không được đọc; chỉ phần chữ trích từ PDF/bảng tính được dùng.
                    Bật "Hỗ trợ ảnh (vision)" trong màn hình AI Models nếu cần.
                </div>
            }

            <table class="source-table" id="sourceTable" @(sourceFiles.Any() ? "" : "hidden")>
                <thead>
                    <tr>
                        <th class="source-col-name">Tên file</th>
                        <th>Loại</th>
                        <th class="source-col-num">Kích thước</th>
                        <th>Đính kèm lúc</th>
                        <th class="source-col-act"></th>
                    </tr>
                </thead>
                <tbody id="sourceTableBody">
                    @foreach (var src in sourceFiles)
                    {
                        <tr data-source-id="@src.Id">
                            <td class="source-col-name">
                                <a href="@Url.Action("SourceContent", new { id = src.Id })"
                                   target="_blank"
                                   rel="noopener"
                                   class="source-name"
                                   title="Mở bản gốc: @src.FileName">
                                    @(src.Kind switch {
                                        ICOGenerator.Domain.Enums.SourceFileKind.Image => "🖼️",
                                        ICOGenerator.Domain.Enums.SourceFileKind.Spreadsheet => "📊",
                                        _ => "📄" }) @src.FileName
                                </a>
                            </td>
                            <td>@(src.Kind switch {
                                ICOGenerator.Domain.Enums.SourceFileKind.Image => "Ảnh",
                                ICOGenerator.Domain.Enums.SourceFileKind.Spreadsheet => "Bảng tính",
                                _ => "PDF" })</td>
                            <td class="source-col-num">@FormatSize(src.SizeBytes)</td>
                            <td>@src.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="source-col-act">
                                <button type="button" class="source-del" data-source-id="@src.Id" title="Xoá tài liệu này">🗑</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="empty-history" id="sourceEmpty" @(sourceFiles.Any() ? "hidden" : "")>
                Chưa có tài liệu nguồn nào. Bấm nút 📎 dưới ô nhập trong khung chat để đính kèm ảnh, PDF (kể cả bản scan), Word hoặc file Excel/CSV cho BA đọc.
            </div>
        </div>

    </div>
</div>

<div id="requirementModal" class="req-modal-overlay">
    <div class="requirement-modal">

        <div class="modal-header">
            <div>
                <h2 id="modalTitle">Product Brief</h2>
            </div>

            <button class="modal-close" type="button" aria-label="Close" onclick="closeRequirementModal()">
                ×
            </button>
        </div>

        <div class="requirement-content">
            @foreach (var doc in productBriefs)
            {
                <div class="doc-preview"
                     id="doc-@doc.Id"
                     data-version="@doc.VersionName"
                     style="display:none;">

                    <div class="doc-actions">
                        <a class="btn outline"
                           asp-controller="Requirements"
                           asp-action="DownloadDocument"
                           asp-route-id="@doc.Id">
                            Download
                        </a>
                        <button type="button"
                                class="btn outline"
                                onclick="openDocHistory('@doc.Id')"
                                title="Xem các lần sinh/sửa trước và khác biệt giữa chúng">
                            <i class="bi bi-clock-history" aria-hidden="true"></i> Lịch sử
                        </button>
                    </div>

                    <h3>@doc.FileName</h3>

                    @* Bản DRAFT cho phép ghi chú trực tiếp: bôi đen một đoạn → "＋ Ghi chú" → gom lại gửi
                       BA sửa (ReviseBrief). Bản đã duyệt (V{n}) chỉ đọc, không gắn cờ này. *@
                    <div class="doc-render"
                         data-doc-id="@doc.Id"
                         data-loaded="false"
                         data-annotatable="@(doc.VersionName == "draft" ? "true" : "false")">
                        <p class="doc-loading">Loading…</p>
                    </div>
                </div>
            }
        </div>

        @* Khay ghi chú trên brief (chỉ bản draft): các ghi chú đã thêm + nút gửi cho BA sửa. Ẩn khi
           chưa có ghi chú nào. Antiforgery token dùng cho POST ReviseBrief qua fetch. *@
        <div class="brief-notes-tray" id="briefNotesTray" hidden>
            @Html.AntiForgeryToken()
            <div class="brief-notes-head">
                <b>Ghi chú của bạn</b> <span class="brief-notes-count" id="briefNotesCount">(0)</span>
                <span class="brief-notes-hint">Bôi đen một đoạn trong bản mô tả rồi bấm "＋ Ghi chú".</span>
            </div>
            <ul class="brief-notes-list" id="briefNotesList"></ul>
        </div>

        <div class="modal-footer">
            @if (selectedVersion == "draft")
            {
                <button type="button" class="btn outline" id="briefNotesSendBtn" hidden
                        title="Gom các ghi chú và nhờ BA sửa lại bản mô tả">
                    ✎ Gửi ghi chú cho BA sửa
                </button>
                <form asp-action="Approve" method="post">
                    <input type="hidden"
                           name="projectId"
                           value="@Model.Id" />

                    <button class="btn approve">
                        Approve this requirement
                    </button>
                </form>
            }
        </div>

    </div>
</div>

@section Breadcrumb {
    Projects <span class="sep">&rsaquo;</span> @Model.Name <span class="sep">&rsaquo;</span> <b>Requirements</b>
}

@section Styles {
    <link rel="stylesheet" href="~/css/requirements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/doc-history.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/requirements.js" asp-append-version="true"></script>
    <script src="~/js/doc-history.js" asp-append-version="true"></script>
    <script>
        window.REQUIREMENTS_PROJECT_ID = '@Model.Id';
        // Người có quyền DeliveryAdvance (TeamDev/Admin) được dẫn sang Agent Dashboard để duyệt/đẩy bước;
        // user thường chỉ thấy thông báo bàn giao "POC đã sẵn sàng".
        window.REQUIREMENTS_CAN_ADVANCE = @((await Permissions.HasPermissionAsync(User, AppPermission.DeliveryAdvance)) ? "true" : "false");
    </script>
    <script src="~/js/requirement-workflow.js" asp-append-version="true"></script>
}
