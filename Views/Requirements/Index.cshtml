@model Project
@{
    ViewData["Title"] = "Requirements";
    // Trang Requirements chỉ hiển thị tài liệu DỄ HIỂU cho user thường: Product Brief. Bản kỹ thuật
    // (AI Design Spec) và tài liệu kỹ thuật nặng (BRD/SRS/FSD/UserStories) sống ở Agent Dashboard.
    var productBriefs = Model.Documents
        .Where(x => x.FileName == "ProductBrief.docx")
        .ToList();

    var versions = productBriefs
        .GroupBy(x => x.VersionName)
        .OrderByDescending(g => g.Key == "draft" ? int.MaxValue :
            int.TryParse(g.Key.Replace("V", ""), out var n) ? n : 0)
        .ToList();
    var selectedVersion = ViewBag.SelectedVersion?.ToString() ?? "draft";
    var conversations = Model.Conversations
        .OrderBy(x => x.CreatedAt)
        .ToList();
    // Lượt user MỚI NHẤT — nút "✎ sửa" chỉ gắn ở đây (server cũng chỉ sửa được lượt user cuối cùng).
    var lastUserTurnId = conversations.LastOrDefault(x => x.Role == "user")?.Id;
    var workflowRuns = Model.WorkflowRuns
        .OrderBy(x => x.CreatedAt)
        .ToList();
    var workflowStarted = TempData["WorkflowStarted"] != null;
    var autoScrollWorkflowRunId = workflowStarted
        ? workflowRuns.OrderByDescending(x => x.CreatedAt).Select(x => (Guid?)x.Id).FirstOrDefault()
        : null;
    var timelineItems = conversations
        .Select(x => new { Kind = "conversation", CreatedAt = x.CreatedAt, Conversation = (AgentConversation?)x, WorkflowRun = (WorkflowRun?)null })
        .Concat(workflowRuns.Select(x => new { Kind = "workflow", CreatedAt = x.CreatedAt, Conversation = (AgentConversation?)null, WorkflowRun = (WorkflowRun?)x }))
        .OrderBy(x => x.CreatedAt)
        .ToList();

    // Gộp tiến độ thành MỘT timeline thống nhất: các workflow run LIỀN KỀ trên timeline (không có
    // tin nhắn hội thoại xen giữa) thuộc cùng một hành trình — ví dụ "Requirement Design Spec V1"
    // rồi "Delivery Workflow V1" mà worker sinh ngay sau khi spec xong — nên gom vào MỘT panel:
    // một header, một badge, một banner, một feed sự kiện liên tục. Run "lead" (mới nhất trong nhóm)
    // quyết định trạng thái tổng thể; mỗi run vẫn có stream riêng, JS dồn event vào cùng một feed.
    var renderGroups = new List<(string Kind, AgentConversation? Conversation, List<WorkflowRun> Runs)>();
    foreach (var item in timelineItems)
    {
        if (item.Kind == "workflow" && item.WorkflowRun != null)
        {
            if (renderGroups.Count > 0 && renderGroups[^1].Kind == "workflow")
                renderGroups[^1].Runs.Add(item.WorkflowRun);
            else
                renderGroups.Add(("workflow", null, new List<WorkflowRun> { item.WorkflowRun }));
        }
        else if (item.Conversation != null)
        {
            renderGroups.Add(("conversation", item.Conversation, new List<WorkflowRun>()));
        }
    }

    // F5 GIỮA lúc BA đang trả lời: lượt user đã lưu nhưng lượt assistant còn đang sinh nền (ChatStream
    // chạy với CancellationToken.None nên câu trả lời vẫn được lưu, chỉ chưa kịp). Khi lượt hội thoại
    // MỚI NHẤT là của user, câu trả lời còn "đang chờ" — JS hiện lại khung "BA đang soạn…" và chờ câu
    // trả lời được lưu (poll ChatReplyStatus) rồi tải lại, thay vì để bong bóng trả lời biến mất.
    var chatReplyPending = conversations.LastOrDefault()?.Role == "user";

    // Gợi ý chỉ hiển thị cho lượt HỎI mới nhất của BA (item cuối timeline). Các lượt cũ coi như đã trả lời.
    var lastItem = timelineItems.LastOrDefault();
    var lastBaSuggestions = (lastItem != null && lastItem.Kind == "conversation"
            && lastItem.Conversation != null && lastItem.Conversation.Role == "assistant")
        ? ParseSuggestions(lastItem.Conversation.Suggestions)
        : new List<string>();

    // Lượt chào đầu tiên (workspace trống) KHÔNG gợi ý: để người dùng tự mô tả ý tưởng dự án.
    // Chỉ khi đã có hội thoại thì mới hiển thị gợi ý cho lượt hỏi mới nhất của BA.
    var displaySuggestions = lastBaSuggestions;

    // THẺ HỎI GỘP của lượt BA mới nhất (2–4 câu hỏi độc lập đặt cùng lúc). Phải render lại từ cột đã lưu
    // chứ không chỉ dựng bằng JS ở frame done: F5 giữa chừng mà thẻ biến mất thì người dùng mất luôn các
    // câu chưa trả lời, và Message của lượt gộp chỉ là câu dẫn nên màn hình còn lại đúng một câu vô nghĩa.
    var lastBaQuestions = (lastItem != null && lastItem.Kind == "conversation"
            && lastItem.Conversation != null && lastItem.Conversation.Role == "assistant")
        ? ICOGenerator.Services.Requirements.ConversationTurnRenderer.ParseQuestions(lastItem.Conversation.Questions)
        : new List<ICOGenerator.Contracts.Requirements.BAChatQuestion>();

    // GỘP CÂU DẪN VÀO THẺ HỎI: ở lượt gộp, Message chỉ là câu dẫn ngắn ("mình hỏi nhanh mấy điểm sau")
    // — render nó thành bong bóng riêng phía trên thẻ là hai khung liền nhau nói cùng một ý, vì bản thân
    // thẻ đã có dòng dẫn của nó. Nên lượt BA này KHÔNG có bong bóng riêng: câu dẫn xuống làm dòng đầu
    // của chính thẻ hỏi (xem #batchQuestions bên dưới + renderBatchQuestions trong requirements.js).
    // Chỉ áp cho lượt gộp MỚI NHẤT — các lượt gộp cũ trong lịch sử vẫn giữ bong bóng, và bong bóng đó
    // mang dấu vết chỉ-đọc các câu đã hỏi (.batchq-history bên dưới).
    var batchLeadTurn = lastBaQuestions.Count > 0 ? lastItem?.Conversation : null;
    var batchLead = (batchLeadTurn?.Message ?? "").Trim();

    // Nút "Write Requirement" hiện "sẵn sàng" (nổi bật) khi lượt BA mới nhất MỜI người dùng bấm nút — tức
    // lời nhắn có nhắc tới "Write Requirement". Lời mời chỉ được LƯU sau khi cổng readiness tất định
    // (RequirementReadinessGate.Evaluate — mọi dòng áp dụng của bản đồ bao phủ đã [RÕ]) pass ngay trong
    // lượt chat, nên nút nổi ⇔ panel "Tiến độ khai thác" bên cạnh cũng đã đầy — cùng một nguồn dữ liệu,
    // không thể vênh nhau. Khi chưa mời — kể cả lúc workspace còn trống — nút ở trạng thái "mờ" và KHÓA:
    // BA vẫn đang hỏi thêm, hoàn tất các nhóm còn lại trong panel tiến độ thì nút tự mở.
    var lastBaTurn = conversations.LastOrDefault(c => c.Role == "assistant");
    var requirementReady = lastBaTurn?.Message?.Contains("Write Requirement", StringComparison.OrdinalIgnoreCase) ?? false;

    // Cờ mời ở trên chỉ trả lời "đã đủ vốn để soạn chưa". Hai câu hỏi còn lại — "có đang soạn không" và
    // "soạn rồi mà chưa có gì mới thì bấm lại để làm gì" — suy TẤT ĐỊNH từ các workflow run + hội thoại
    // đã nạp sẵn trên trang, không thêm cột trạng thái nào để khỏi sinh nguồn sự thật thứ hai.
    var draftRuns = workflowRuns
        .Where(r => r.Name == ICOGenerator.Services.Workflows.WorkflowOrchestrator.RequirementDraftRunName)
        .ToList();

    // ĐANG SOẠN ⇒ khoá nút. Thiếu nhánh này thì bấm xong → redirect → trang render lại với lời mời vẫn ở
    // cuối hội thoại → nút sáng lại, và mỗi lần bấm thêm là một run sinh lại đúng bản draft đó.
    var draftRunInFlight = draftRuns.Any(r => r.Status is WorkflowRunStatus.Queued or WorkflowRunStatus.Running);

    // ĐÃ SOẠN XONG VÀ CHƯA CÓ GÌ MỚI: bản draft đã tồn tại, vòng soạn gần nhất đã kết thúc, và người dùng
    // chưa nói thêm câu nào kể từ đó. Bấm lại lúc này tốn 2–3 lời gọi LLM để ra gần đúng bản cũ, lại GHI ĐÈ
    // bản đang có — và vì model chạy ở temperature > 0, bản mới có thể tệ hơn. Vẫn cho bấm (người dùng có
    // quyền muốn bản khác) nhưng đổi sang nút "Tạo lại tài liệu" kèm xác nhận, không còn là hành động một chạm.
    // Đây cũng là chỗ sửa một lời nói dối cũ của UI: sau khi soạn xong, lượt cuối là thông báo "đã tạo xong"
    // nên requirementReady hoá false và nút hiện tooltip "BA vẫn đang hỏi thêm thông tin" trong khi panel
    // "Tiến độ khai thác" đầy 100%.
    var lastFinishedDraftRunAt = draftRuns
        .Where(r => r.Status == WorkflowRunStatus.Completed && r.FinishedAt.HasValue)
        .Max(r => (DateTime?)r.FinishedAt!.Value);
    var lastUserTurnAt = conversations.LastOrDefault(x => x.Role == "user")?.CreatedAt;
    var draftExists = productBriefs.Any(d => d.VersionName == "draft");
    var requirementRegenerateOnly = draftExists
        && lastFinishedDraftRunAt.HasValue
        && (lastUserTurnAt == null || lastUserTurnAt <= lastFinishedDraftRunAt.Value);

    // Bốn trạng thái loại trừ nhau, xét theo đúng thứ tự ưu tiên: đang chạy > đã xong & chưa có gì mới >
    // sẵn sàng > còn phải khai thác thêm.
    var writeReqState = draftRunInFlight ? "running"
        : requirementRegenerateOnly ? "regenerate"
        : requirementReady ? "ready"
        : "waiting";
    var writeReqEnabled = writeReqState is "ready" or "regenerate";
    var writeReqLabel = writeReqState switch
    {
        "running" => "⏳ Đang tạo tài liệu…",
        "regenerate" => "🔄 Tạo lại tài liệu",
        _ => "📝 Write Requirement"
    };
    var writeReqTitle = writeReqState switch
    {
        "running" => "Tài liệu đang được soạn — theo dõi tiến độ trong khung chat. Nút mở lại khi soạn xong.",
        "regenerate" => "Tài liệu đã soạn xong và anh/chị chưa bổ sung gì thêm. Bấm để soạn lại và GHI ĐÈ bản hiện tại.",
        "ready" => "BA đã thu thập đủ thông tin — tạo bản mô tả sản phẩm.",
        _ => "BA vẫn đang hỏi thêm thông tin. Hoàn tất các nhóm còn lại trong 'Tiến độ khai thác' để mở khóa nút này."
    };

    // Tài liệu nguồn (ảnh/PDF) người dùng upload cho project + cờ vision của model BA (để cảnh báo).
    var sourceFiles = Model.SourceFiles.OrderByDescending(x => x.CreatedAt).ToList();
    var baSupportsVision = ViewBag.BaSupportsVision is bool bv && bv;

    // Panel tiến độ khai thác (bản đồ bao phủ đã parse) — render lần đầu ở server, sau đó frame done của
    // ChatStream cập nhật live (markup phải khớp renderCoverage trong requirements.js).
    var coverage = ViewBag.Coverage as IReadOnlyList<ICOGenerator.Contracts.Requirements.CoverageMapItem>
        ?? new List<ICOGenerator.Contracts.Requirements.CoverageMapItem>();
    // Nhật ký "điều đã chốt": KHÔNG còn panel sidebar. Danh sách này giờ chỉ dùng cho CỔNG TỔNG KẾT CUỐI
    // (#summaryGate) — bản rà soát một lần khi BA đã khai thác xong. Markup phải khớp renderSummaryGate.
    var decisions = ViewBag.Decisions as IReadOnlyList<string> ?? new List<string>();
    // "Triển vọng phỏng vấn" (InterviewOutlookService) KHÔNG còn danh sách nào lên màn hình: cả ba
    // (OpenQuestions, PlannedScope, WorkedExamples) vẫn được chắt sau mỗi lượt nhưng đi thẳng vào các
    // đường tiêu thụ của máy — ngữ cảnh chat của BA, ngữ cảnh soát mâu thuẫn, và mục "## 13. Worked
    // Examples" của AI Design Spec.
    // Giả định BA tự đưa khi sinh AI Design Spec (mục ## 12. Assumptions) — hiển thị cho user rà lại.
    var specAssumptions = ViewBag.SpecAssumptions as IReadOnlyList<string> ?? new List<string>();
    var specVersion = ViewBag.SpecVersion as string;
    // CỔNG XÁC NHẬN GIẢ ĐỊNH: non-null ⇒ spec đã sinh xong nhưng POC CHƯA được dựng, đang chờ user rà
    // danh sách giả định. Panel giả định lúc này đổi từ "để tham khảo" sang "cổng có nút bấm" — đây là
    // chặn cuối cùng trước lượt dựng POC (lượt đắt nhất tuyến).
    var pendingAssumptions = !string.IsNullOrEmpty(Model.PendingAssumptionsVersion);
    // Tách danh sách giả định thành "mới" và "user đã duyệt ở vòng trước" (Project.ConfirmedAssumptions).
    // Mỗi lần user bác một điểm là spec được sinh LẠI, và spec mới lặp lại gần như nguyên văn các giả
    // định cũ — hỏi lại cả danh sách thì đúng nghĩa "tôi trả lời rồi mà BA cứ hỏi". Cổng chỉ đặt câu hỏi
    // ở phần MỚI; phần đã duyệt vẫn hiện nhưng gấp lại (đổi ý được, chỉ là không bị bắt trả lời lại).
    var confirmedAssumptionKeys = ICOGenerator.Services.Requirements.AssumptionMemory.KeySet(Model.ConfirmedAssumptions);
    var newAssumptions = specAssumptions
        .Where(a => !confirmedAssumptionKeys.Contains(ICOGenerator.Services.Requirements.AssumptionMemory.Key(a)))
        .ToList();
    var reviewedAssumptions = specAssumptions.Except(newAssumptions).ToList();

    // ĐÃ BỎ stepper hành trình 5 chặng ở đầu trang: quy trình thực tế không đi một chiều — user sửa tới
    // sửa lui (chat thêm → sinh lại brief → duyệt lại → dựng lại POC), nên một thanh tuyến tính vừa chiếm
    // chỗ vừa mô tả sai việc đang xảy ra. Trạng thái thật vẫn nằm đúng chỗ nó cần nằm: cổng xác nhận giả
    // định và tiến trình workflow hiện ngay trong khung chat, danh sách bản mô tả nằm ở panel tài liệu.
    // Tiến độ panel: mẫu số là TỔNG số nhóm (không rút theo [KHÔNG ÁP DỤNG]) và nhóm không áp dụng tính
    // là đã xong cho thanh — xem CoverageProgress. Công thức nằm trong parser để bản server render đây và
    // bản JS cập nhật live (renderCoverage) không lệch nhau.
    var coverageProgress = ICOGenerator.Services.Requirements.CoverageMapParser.Progress(coverage);
    // KHUNG RỖNG: chưa nhóm nào được khai thác (dự án vừa tạo / vừa New Chat — GetRequirementWorkspaceQuery
    // trả khung 12 nhóm [CHƯA HỎI]). Panel lúc này chỉ là danh sách sắp được hỏi, nên cần một dòng nói rõ
    // nó sẽ tự đầy dần — nếu không, một bảng 12 dấu ⚪ trông như thứ người dùng phải tự đi điền.
    var coverageEmpty = coverage.Count > 0 && coverage.All(x => x.Status == "CHƯA HỎI");
    // "Chào lại" cho phỏng vấn dài (F): khi quay lại một dự án đang dở (đã có tiến độ nhưng chưa xong,
    // và requirement chưa được mời chốt), nói rõ còn bao nhiêu nhóm thông tin cần làm rõ.

    // Cờ multi-select của lượt hỏi mới nhất (chip cho phép chọn nhiều rồi gửi một lần). Conversation
    // khác null đã ngầm định Kind == "conversation" (item workflow không có Conversation).
    var lastSuggestionsMulti = lastItem?.Conversation is { Role: "assistant", SuggestionsMultiSelect: true };

    static string CoverageIcon(string status) => status switch
    {
        "RÕ" => "✅",
        "MỘT PHẦN" => "🟡",
        "KHÔNG ÁP DỤNG" => "➖",
        _ => "⚪"
    };

    static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    static List<string> ParseSuggestions(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return new List<string>();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }

    static List<ICOGenerator.Contracts.Requirements.ChatAttachment> ParseAttachments(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return new List<ICOGenerator.Contracts.Requirements.ChatAttachment>();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<ICOGenerator.Contracts.Requirements.ChatAttachment>>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                ?? new List<ICOGenerator.Contracts.Requirements.ChatAttachment>();
        }
        catch
        {
            return new List<ICOGenerator.Contracts.Requirements.ChatAttachment>();
        }
    }

    static List<ICOGenerator.Contracts.Requirements.FlowStep> ParseFlow(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return new List<ICOGenerator.Contracts.Requirements.FlowStep>();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<ICOGenerator.Contracts.Requirements.FlowStep>>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                ?? new List<ICOGenerator.Contracts.Requirements.FlowStep>();
        }
        catch
        {
            return new List<ICOGenerator.Contracts.Requirements.FlowStep>();
        }
    }
}

<div class="page-head">
    <div>
        <h1>Requirements</h1>
    </div>
</div>

@if (TempData["SourceUploaded"] != null)
{
    <div class="server-toast" data-toast-type="success" hidden>Đã upload tài liệu nguồn. BA đang đọc và sẽ tóm tắt lại trong khung chat để anh/chị xác nhận.</div>
}
@if (TempData["SourceScanWarning"] != null)
{
    <div class="server-toast" data-toast-type="error" hidden>⚠️ @TempData["SourceScanWarning"]</div>
}
@if (TempData["RequirementApproved"] != null)
{
    // Đặt kỳ vọng ngay sau Approve: nói rõ điều gì đang chạy nền và mất khoảng bao lâu (ETA đo từ
    // các lần dựng POC đã hoàn tất — EstimatePocEtaQuery; chưa có lịch sử thì bỏ phần con số).
    var etaMinutes = TempData["ApprovedPocEtaMinutes"] as int?;
    <div class="server-toast" data-toast-type="success" hidden>✅ Yêu cầu đã được duyệt. Hệ thống đang tự dựng <b>bản demo (POC)</b> để anh/chị xem trước — @(etaMinutes.HasValue ? $"thường mất khoảng {etaMinutes.Value} phút. " : "quá trình này chạy nền, có thể mất ít phút. ")Anh/chị có thể theo dõi tiến độ ngay trong khung chat bên dưới và sẽ nhận thông báo khi POC sẵn sàng.</div>
}

<div class="grid doc-grid">

    <aside class="card history-panel">

        @* Hai hành động luôn có mặt (không phụ thuộc trạng thái hội thoại) đứng trên cùng sidebar, để
           "Tiến độ khai thác" — thứ user cần nhìn nhất — không bị đẩy xuống dưới các panel dài.
           "Tài liệu nguồn" giờ chỉ là CỬA XEM LẠI: việc đính kèm file đã nằm trong khung chat (nút 📎),
           nên ở đây không còn form upload, chỉ mở popup liệt kê/xoá các file đã đính kèm. *@
        <div class="sidebar-actions">
            <form asp-action="NewChat"
                  method="post"
                  class="new-chat-form"
                  onsubmit="return confirm('Bắt đầu chat mới: hội thoại hiện tại sẽ được lưu trữ (BA không dùng nữa) và cuộc trò chuyện bắt đầu lại từ đầu. Tiếp tục?');">

                <input type="hidden"
                       name="projectId"
                       value="@Model.Id" />

                <button class="btn outline full" type="submit">
                    ＋ New Chat
                </button>
            </form>

            <button type="button"
                    class="btn outline full source-open-btn"
                    id="sourceOpenBtn"
                    title="Xem lại và xoá các tài liệu anh/chị đã đính kèm cho BA">
                📎 Tài liệu nguồn
                <span class="source-count-badge" id="sourceCountBadge" @(sourceFiles.Any() ? "" : "hidden")>@sourceFiles.Count</span>
            </button>
        </div>

        @* Tiến độ khai thác yêu cầu: cho user thấy cuộc phỏng vấn đã rõ bao nhiêu nhóm thông tin và còn
           thiếu gì — thay vì cảm giác "bị hỏi vô tận". Dự án mới CŨNG hiện panel, ở dạng khung 12 nhóm
           [CHƯA HỎI] (CoverageChecklist): đó chính là lúc "cuộc phỏng vấn này dài bao nhiêu" đáng nói
           nhất. Chỉ ẩn khi không dựng nổi cả khung (prompt coverage bị sửa hỏng) — fail-open như cũ. *@
        <div class="coverage-panel" id="coveragePanel" @(coverage.Count == 0 ? "hidden" : "")
             data-reopen-url="@Url.Action("ReopenCoverage", "Requirements")">
            <h3>Tiến độ khai thác</h3>
            <div class="coverage-progress">
                <div class="coverage-bar">
                    <span id="coverageBarFill" style="width:@(coverageProgress.Percent)%"></span>
                </div>
                <span class="coverage-progress-text" id="coverageProgressText">Đã rõ @coverageProgress.Clear/@coverageProgress.Total nhóm</span>
            </div>
            @* Nhóm bị loại khỏi phạm vi đứng RIÊNG một dòng, không nối vào dòng trên: nối vào thì chuỗi
               dài bóp thanh tiến độ (cùng hàng flex) còn một mẩu. Cũng là chú thích cho các dòng ➖ mờ
               bên dưới, và giải thích vì sao thanh đầy được trong khi chỉ 9/12 nhóm [RÕ]. *@
            <p class="coverage-na" id="coverageNa" @(coverageProgress.NotApplicable > 0 ? "" : "hidden")>
                ➖ <span id="coverageNaCount">@coverageProgress.NotApplicable</span> nhóm không áp dụng với dự án này
            </p>
            @* Khung rỗng lúc mới vào: nói rõ ai là người điền bảng này (BA, qua chính cuộc trò chuyện) và
               nó tự đầy dần. Ẩn ngay khi có nhóm đầu tiên khác [CHƯA HỎI] — requirements.js làm điều
               tương tự ở frame done. *@
            <p class="coverage-hint" id="coverageHint" @(coverageEmpty ? "" : "hidden")>
                Anh/chị cứ mô tả ý tưởng trong khung chat — BA sẽ hỏi dần và bảng này tự đầy theo. Nhóm nào
                không liên quan tới dự án sẽ được đánh dấu bỏ qua.
            </p>
            @* Bản đồ không gộp được lượt vừa rồi (đã thử lại): danh sách bên dưới là bản CŨ và BA cũng vừa
               dẫn lượt bằng bản cũ đó — nên nó có thể hỏi lại nhóm anh/chị vừa trả lời. Ẩn lúc tải trang
               (cờ chỉ có ý nghĩa cho lượt vừa chạy); requirements.js bật khi frame done báo coverageStale. *@
            <div class="coverage-stale" id="coverageStale" hidden>
                ⚠️ Chưa cập nhật được tiến độ cho lượt vừa rồi — danh sách bên dưới đang là bản cũ.
                Anh/chị cứ trả lời tiếp, lượt sau hệ thống gộp bù.
            </div>
            <ul class="coverage-list" id="coverageList">
                @foreach (var item in coverage)
                {
                    <li class="coverage-item @(item.Status == "KHÔNG ÁP DỤNG" ? "na" : "")"
                        data-label="@item.Label"
                        title="@item.Summary">
                        <span class="cov-ico">@CoverageIcon(item.Status)</span>
                        @* IsCore (★) vẫn dùng để xếp thứ tự nhóm còn thiếu trong RequirementReadinessGate,
                           nhưng KHÔNG hiển thị: với user, "nhóm cốt lõi" là phân loại nội bộ của BA — mọi nhóm
                           áp dụng đều phải [RÕ] mới mở được Write Requirement, nên ★ chỉ gây nhiễu. *@
                        <span class="cov-label">@item.Label</span>
                        @* BẰNG CHỨNG + đường đính chính: một nhóm bị chấm [RÕ] oan là điểm mù kín của hệ
                           thống (BA bị cấm hỏi lại nhóm đã [RÕ]), nên người dùng phải thấy được kết luận
                           dựa vào câu nào của mình VÀ có nút phản đối ngay tại đó. *@
                        @if (item.Status is "RÕ" or "MỘT PHẦN")
                        {
                            <button type="button" class="cov-wrong" title="Nhóm này BA hiểu chưa đúng — hỏi lại giúp tôi">chưa đúng?</button>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Evidence))
                        {
                            <div class="cov-evidence" title="Câu mà kết luận này dựa vào">@item.Evidence</div>
                        }
                    </li>
                }
            </ul>

            <!-- WRITE REQUIREMENT: sinh bản mô tả sản phẩm (Product Brief) DỄ HIỂU cho user.
                 Tài liệu kỹ thuật (BRD/SRS/FSD/UserStories) do team dev trigger ở Agent Dashboard.
                 Đặt ngay cuối panel "Tiến độ khai thác" như phần thưởng khi thanh tiến độ đầy. BỐN trạng
                 thái (writeReqState, suy tất định ở đầu file):
                   waiting    — BA còn câu hỏi (panel chưa đầy): mờ + KHÓA. Dùng chung cờ requirementReady
                                với panel tiến độ (cùng bản đồ bao phủ) nên nút mở khóa ⇔ panel đầy.
                   ready      — mọi nhóm áp dụng đã [RÕ]: nổi bật, bấm được.
                   running    — vòng soạn đang xếp hàng/đang chạy: KHÓA cho tới khi run xong (trang tự tải
                                lại lúc đó). Chặn kiểu spam bấm liên tục, mỗi lần một run sinh lại cùng bản.
                   regenerate — đã soạn xong và hội thoại chưa có gì mới: vẫn bấm được nhưng đổi nhãn thành
                                "Tạo lại tài liệu" + hỏi xác nhận ở JS, vì lượt này GHI ĐÈ bản đang có.
                 data-* dưới đây là hợp đồng với requirements.js: nó cần biết run có đang bay không (để
                 không mở khóa nút sau một lượt chat) và nhãn/tooltip gốc để khôi phục. -->
            <form asp-action="WriteRequirement"
                  method="post"
                  class="write-req write-req-@writeReqState"
                  data-run-in-flight="@(draftRunInFlight ? "true" : "false")"
                  onsubmit="var b=this.querySelector('button'); b.disabled=true; b.textContent='Đang tạo tài liệu…';">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <button class="btn write-req-btn @(writeReqState == "ready" ? "primary" : "outline")"
                        type="submit"
                        disabled="@(writeReqEnabled ? null : "disabled")"
                        data-idle-label="@writeReqLabel"
                        data-ready-label="📝 Write Requirement"
                        data-ready-title="BA đã thu thập đủ thông tin — tạo bản mô tả sản phẩm."
                        data-waiting-title="BA vẫn đang hỏi thêm thông tin. Hoàn tất các nhóm còn lại trong 'Tiến độ khai thác' để mở khóa nút này."
                        title="@writeReqTitle">
                    @writeReqLabel
                </button>
                @* Ghi chú hiện ngay dưới nút cho hai trạng thái mới: tooltip không thấy được trên cảm ứng
                   và rất dễ bỏ sót, mà đây đúng là hai lúc người dùng hay bấm đi bấm lại vì không hiểu nút
                   đang làm gì. Lớp riêng (không phải .write-req-hint) để requirements.js xoá thẳng khi có
                   lượt chat mới, khỏi lẫn với ghi chú của trạng thái "chưa đủ thông tin". *@
                @if (writeReqState == "running")
                {
                    <small class="write-req-hint write-req-state-hint">Đang soạn tài liệu — theo dõi tiến độ trong khung chat. Nút mở lại khi xong.</small>
                }
                else if (writeReqState == "regenerate")
                {
                    <small class="write-req-hint write-req-state-hint">Tài liệu đã tạo xong. Muốn sửa nội dung, nhắn thêm cho BA trong khung chat rồi tạo lại.</small>
                }
            </form>

            @* CỔNG SOÁT MÂU THUẪN: chạy khi bấm "Write Requirement", TRƯỚC khi tài liệu được soạn. Panel
               tiến độ chỉ trả lời "đã rõ hết chưa"; cổng này trả lời "những điều đã rõ có chọi nhau
               không" — và một mâu thuẫn lọt qua đây sẽ đóng băng thành yêu cầu sai rồi kéo cả POC theo.
               Không có mâu thuẫn ⇒ panel không bao giờ hiện, form submit như trước. *@
            <div class="conflict-panel" id="conflictPanel" hidden
                 data-check-url="@Url.Action("CheckConflicts", "Requirements")"
                 data-resolve-url="@Url.Action("ResolveConflicts", "Requirements")">
                <h3>⚠ Có điểm đang mâu thuẫn</h3>
                <div class="history-sub">Mấy điểm dưới đây anh/chị đã nói theo hai cách khác nhau. Chọn giúp phương án đúng để tài liệu không ghi nhầm.</div>
                <div class="conflict-body" id="conflictBody"></div>
                <div class="conflict-msg" id="conflictMsg"></div>
            </div>
        </div>

        @* KHÔNG còn panel "Điều đã chốt" ở đây — panel cuối cùng của sidebar bị gỡ, và vì đúng cái lý do
           đã gỡ ba panel trước nó. Nhật ký quyết định (DecisionLogService) VẪN được chắt sau mỗi lượt;
           chỉ có mặt UI biến mất, và người ĐỌC nó đổi từ user sang máy.
           Vì sao gỡ: panel này bắt người dùng vừa kể chuyện nghiệp vụ vừa audit một danh sách tới 40 dòng
           — hai chế độ tư duy chạy song song, đúng lúc họ cần tập trung nhất. Nó cũng đặt việc soát mâu
           thuẫn nhầm vai: người dùng không có nghĩa vụ nhớ mình đã nói gì ở lượt thứ ba, còn BA thì đọc
           được cả hội thoại. Và "bấm để sửa" cũng không phải công cụ sửa thật — nó chỉ soạn sẵn một câu
           vào ô chat, tức là vẫn quay về chat.
           Nhật ký nay đi vào HAI đường tiêu thụ của máy:
             1. Ngữ cảnh chat của BA (BAChatService) — BA đối chiếu câu vừa nghe với điều đã chốt và hỏi
                lại NGAY khi thấy chọi nhau (prompt requirement-chat.v4 § "Soát mâu thuẫn với điều đã chốt").
             2. Ngữ cảnh soát mâu thuẫn trước lúc soạn tài liệu (RequirementConflictService) — lưới an toàn.
           Người dùng gặp lại chính danh sách này đúng MỘT lần, ở cổng tổng kết cuối khung chat (#summaryGate),
           khi phỏng vấn đã xong và họ rảnh trí để rà. *@

        @* KHÔNG có panel "Sẽ xây gì" ở đây: PlannedScope vẫn được chắt sau mỗi lượt, nhưng nó là danh
           sách SUY ĐOÁN mà user không sửa được tại chỗ — vòng "bắt hiểu nhầm sớm" không đóng lại được nên
           panel chỉ còn là nhiễu.
           Dữ liệu vẫn giữ: nó đi vào ngữ cảnh soát mâu thuẫn (RequirementConflictService). *@

        @* KHÔNG có panel "Điểm cần làm rõ" ở đây: danh sách OpenQuestions vẫn được chắt sau mỗi lượt,
           nhưng nay đi thẳng vào ngữ cảnh chat của BA (BAChatService) thay vì thành một panel để user tự
           đọc. Người dùng chỉ cần trò chuyện — BA có thắc mắc gì thì hỏi ngay trong khung chat, và phần
           "còn mâu thuẫn" đã có panel ⚠ riêng ở trên với lựa chọn thật để chốt. *@

        @* KHÔNG có panel "Ví dụ đã xác nhận" ở đây: WorkedExamples vẫn được chắt sau mỗi lượt và vẫn là
           ORACLE mà POC bị chấm theo (spec đúc thành "## 13. Worked Examples", POC phải tính lại ra đúng
           kết quả), nhưng panel thì lặp lại đúng thứ BA vừa nói trong chat — các ví dụ định tính trùng
           gần nguyên văn sơ đồ luồng ở cuối lượt (renderFlowDiagram, có nút "chưa đúng?" cho TỪNG bước),
           còn ví dụ định lượng thì đến từ chính câu người dùng vừa chốt. Sidebar cuộn dài thêm một khối
           mà không thêm thông tin.
           Cái mất khi bỏ panel: đường SỬA TAY danh sách oracle (UpdateWorkedExamplesUseCase, đã gỡ theo).
           Đính chính nay đi qua chat như mọi điều khác — nói lại trong khung chat, lượt chắt lọc kế tiếp
           cập nhật danh sách. *@

        @* Giả định của bản thiết kế (AI Design Spec § 12): những điều BA tự quyết thay user.
           Ở SIDEBAR chỉ còn CHẾ ĐỘ THAM KHẢO (POC đã dựng): danh sách tra cứu nguội, bấm một giả định để
           nhắn BA sửa qua khung chat. Đây là panel DUY NHẤT còn sót lại kiểu "danh sách để user tự rà" —
           nó ở lại được vì chỉ xuất hiện SAU khi POC đã dựng, tức không còn cuộc phỏng vấn nào đang diễn
           ra để mà chia sự chú ý.
           CHẾ ĐỘ CỔNG (pendingAssumptions = true) đã CHUYỂN VÀO KHUNG CHAT: lúc đó quy trình đang ĐỨNG
           CHỜ người dùng, mà lời mời rà giả định lại do BA nói ở cuối chat ("đang chờ anh/chị rà N giả
           định"), trong khi nút bấm thì nằm lọt giữa một sidebar cuộn dài — người đọc phải tự đi tìm cổng.
           Đặt cổng làm khối CUỐI của khung chat thì nó rơi đúng chỗ mắt đang nhìn (chat tự cuộn xuống đáy
           khi tải trang) và có đủ bề ngang để hiện trọn danh sách thay vì ô cuộn cao 320px. *@
        @if (specAssumptions.Any() && !pendingAssumptions)
        {
            <div class="assumption-panel" id="assumptionPanel" data-pending="false">
                <h3>Giả định cần xác nhận @(string.IsNullOrEmpty(specVersion) ? "" : $"({specVersion})")</h3>
                <div class="history-sub decision-hint">
                    BA đã tự quyết các điểm sau khi dựng bản thiết kế. <b>Rà lại giúp mình:</b> nếu điểm nào
                    chưa đúng, bấm vào nó để sửa — mình sẽ cập nhật tài liệu và dựng lại bản demo cho khớp.
                    Không bấm gì nghĩa là anh/chị đồng ý với các giả định này.
                </div>
                <ul class="assumption-list">
                    @foreach (var assumption in specAssumptions)
                    {
                        <li>
                            <button type="button" class="assumption-item" data-assumption="@assumption" title="Bấm nếu giả định này chưa đúng để sửa">@assumption</button>
                        </li>
                    }
                </ul>
            </div>
        }

        <h3>Product Brief</h3>

        @if (versions.Any())
        {
            foreach (var version in versions)
            {
                <div class="history-item">

                    <div class="history-left">
                        <div class="history-icon">📄</div>

                        <div>
                            <div class="history-title">
                                @(version.Key == "draft" ? "Draft" : version.Key)
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="btn outline small"
                            onclick="openRequirementModal('@version.Key')">
                        View
                    </button>
                </div>
            }
        }
        else
        {
            <div class="empty-history">
                No requirement history yet.
            </div>
        }

    </aside>

    <section class="card chat-panel">

        <div id="chatMessages"
             class="chat-messages"
             data-reply-pending="@(chatReplyPending ? "true" : "false")">

            @if (!conversations.Any())
            {
                <b class="req-who">BA</b>
                <div class="req-msg ba">
                    <p>
                        Xin chào! Tôi là Business Analyst. Anh/chị cứ <b>kể thoải mái một mạch</b> mọi điều
                        đang hình dung về ứng dụng: bài toán cần giải quyết, ai sẽ dùng, quy trình hiện tại
                        đang làm thế nào và vướng ở đâu — càng chi tiết tôi càng đỡ phải hỏi lại.
                        Nếu có sẵn tài liệu, ảnh chụp màn hình Excel/biểu mẫu đang dùng, anh/chị bấm
                        <b>nút 📎 ngay dưới ô nhập</b> (hoặc dán/kéo-thả file vào khung chat) để tôi đọc luôn nhé.
                    </p>
                </div>
            }

            @{
                // Gộp các lượt BA LIỀN KỀ dưới MỘT nhãn "BA" (kiểu Teams/ChatGPT): mỗi lượt assistant vốn
                // tự in nhãn riêng, nên hai lượt BA nối nhau (vd lượt tóm tắt tài liệu do AcknowledgeSources
                // thêm ngay sau một câu hỏi BA) hiện "BA" hai lần chồng nhau. Chỉ in nhãn cho lượt BA ĐẦU
                // của một chuỗi; panel workflow và lượt user (đều KHÔNG phải bong bóng BA) cắt chuỗi lại.
                var prevWasBaBubble = false;
            }
            @foreach (var group in renderGroups)
            {
                if (group.Kind == "workflow")
                {
                    prevWasBaBubble = false;
                    var runs = group.Runs;
                    var leadRun = runs[runs.Count - 1];
                    var groupAutoScroll = runs.Any(r => r.Id == autoScrollWorkflowRunId) ? "true" : "false";
                    var runIds = string.Join(",", runs.Select(r => r.Id));
                    // Hành trình kết thúc bằng run delivery → nhãn "Delivery Progress"; ngược lại (chỉ có
                    // run requirement của BA) giữ "Requirement Progress" như trước.
                    var groupTitle = runs.Any(r => r.Name != null && r.Name.Contains("Delivery"))
                        ? "Delivery Progress"
                        : "Requirement Progress";

                    <div id="wf-panel-@leadRun.Id"
                         class="req-msg ba workflow-progress"
                         data-run-ids="@runIds"
                         data-lead-run-id="@leadRun.Id"
                         data-autoscroll="@groupAutoScroll">
                        <div class="workflow-progress-head">
                            <b>BA</b>
                            <span class="workflow-progress-title">@groupTitle</span>
                        </div>
                        <small class="muted wf-sub"></small>
                        <div class="workflow-progress-body wf-body">
                            <div class="wf-banner wf-run">⏳ Đang tải tiến độ delivery…</div>
                        </div>
                    </div>
                }
                else if (group.Conversation?.Role == "user")
                {
                    // Ảnh/file người dùng đính kèm ở lượt này (lưu JSON trong Attachments) — render ngay
                    // trong bubble như ChatGPT/Claude: ảnh thành thumbnail (bấm mở bản gốc), file khác
                    // thành chip tên file. Nguồn đã bị xóa ⇒ endpoint trả 404, onerror ẩn thumbnail hỏng.
                    prevWasBaBubble = false;
                    var attachments = ParseAttachments(group.Conversation.Attachments);
                    <div class="req-msg you">
                        @if (attachments.Any())
                        {
                            <div class="chat-attachments">
                                @foreach (var att in attachments)
                                {
                                    var src = Url.Action("SourceContent", new { id = att.Id });
                                    @if (att.IsImage)
                                    {
                                        <a href="@src" target="_blank" rel="noopener" class="chat-attachment-img" title="@att.Name">
                                            <img src="@src" alt="@att.Name" loading="lazy" onerror="this.closest('a').style.display='none'" />
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@src" target="_blank" rel="noopener" class="chat-attachment-file" title="@att.Name">📄 @att.Name</a>
                                    }
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(group.Conversation.Message))
                        {
                            <p>@group.Conversation.Message</p>
                        }
                        @* SỬA lượt vừa gửi — chỉ ở lượt user CUỐI CÙNG (sửa lượt giữa hội thoại thì mọi
                           lượt sau đó nói về nội dung đã biến mất). Không có nút này, một câu gõ nhầm chỉ
                           "sửa" được bằng cách nhắn thêm câu đính chính, trong khi bản đồ bao phủ và nhật
                           ký điều đã chốt đã kịp ghi nhận câu sai và chúng gộp lũy tiến. *@
                        @if (group.Conversation.Id == lastUserTurnId && !string.IsNullOrWhiteSpace(group.Conversation.Message))
                        {
                            <button type="button" class="chat-edit-btn"
                                    data-message="@group.Conversation.Message"
                                    title="Sửa lại câu vừa gửi — BA sẽ trả lời lại từ nội dung mới">✎ sửa</button>
                        }
                    </div>
                }
                else if (group.Conversation != null)
                {
                    // Lượt gộp mới nhất: bong bóng của nó CHÍNH LÀ thẻ hỏi ở cuối khung chat (câu dẫn đã
                    // xuống làm dòng đầu của thẻ), nên bỏ qua ở đây. prevWasBaBubble giữ nguyên: nhãn "BA"
                    // của lượt được in trước thẻ, theo đúng quy tắc gộp nhãn của chuỗi lượt BA liền kề.
                    if (batchLeadTurn != null && group.Conversation.Id == batchLeadTurn.Id)
                    {
                        continue;
                    }

                    // Lượt BA là THÔNG BÁO LỖI gọi AI (tiền tố ⚠️ dùng chung với transcript filter): tô đỏ
                    // như đường streaming, và nếu là lượt CUỐI của hội thoại thì kèm nút "Thử lại" — server
                    // xóa lượt lỗi rồi chạy lại, người dùng khỏi phải gõ lại câu vừa hỏi.
                    var isFailureTurn = (group.Conversation.Message ?? "").StartsWith(
                        ICOGenerator.Services.Requirements.ConversationTranscriptBuilder.LlmFailurePrefix, StringComparison.Ordinal);
                    var isLastTurn = group.Conversation.Id == conversations.LastOrDefault()?.Id;
                    @if (!prevWasBaBubble)
                    {
                        <b class="req-who">BA</b>
                    }
                    <div class="req-msg ba @(isFailureTurn ? "chat-error" : "")">
                        @* Giữ pre-wrap để tôn trọng xuống dòng trong câu trả lời của BA, nhưng đặt biểu thức
                           NGAY trong thẻ <p> (không xuống dòng/thụt lề) — nếu không, khoảng trắng thụt lề của
                           mã Razor bị pre-wrap giữ lại, đẩy dòng đầu tin nhắn thụt vào trông rất khó chịu. *@
                        <p style="white-space: pre-wrap;">@((group.Conversation.Message ?? "").Trim())</p>

                        @if (isFailureTurn && isLastTurn)
                        {
                            <button type="button" class="btn outline small chat-retry-btn" title="Chạy lại lượt trả lời vừa lỗi — không cần gõ lại câu hỏi">↻ Thử lại</button>
                        }

                        @{
                            // CÁC CÂU HỎI của một lượt hỏi GỘP CŨ, render CHỈ ĐỌC ngay trong bong bóng đã
                            // hỏi chúng. Message của lượt gộp chỉ là câu dẫn ("mình hỏi 4 điểm sau"), nên
                            // không có khối này thì lịch sử hội thoại nuốt mất chính các câu hỏi: người
                            // dùng cuộn lên không đối chiếu được mình đã được hỏi gì và đã trả lời gì —
                            // và khi BA lỡ hỏi lại, họ cũng không có bằng chứng nào để chỉ ra điều đó.
                            // Lượt đang giữ thẻ hỏi SỐNG không tới được đây: nó đã `continue` ở trên vì
                            // bong bóng của nó CHÍNH LÀ thẻ hỏi.
                            var pastQuestions = ICOGenerator.Services.Requirements.ConversationTurnRenderer
                                .ParseQuestions(group.Conversation.Questions);
                        }
                        @if (pastQuestions.Any())
                        {
                            <ul class="batchq-history">
                                @foreach (var q in pastQuestions)
                                {
                                    <li>
                                        @if (!string.IsNullOrWhiteSpace(q.Group))
                                        {
                                            <span class="batchq-history-group">@q.Group</span>
                                        }
                                        <span class="batchq-history-question">@q.Question</span>
                                    </li>
                                }
                            </ul>
                        }

                        @{
                            // Sơ đồ luồng chỉ đính ở lượt BA mời "Write Requirement" và chỉ hiện cho lượt BA
                            // MỚI NHẤT (như chip gợi ý) để không lặp lại các sơ đồ cũ trong lịch sử. Markup
                            // khớp renderFlowDiagram (requirements.js) để frame done render y hệt khi không reload.
                            var flow = group.Conversation.Id == lastBaTurn?.Id
                                ? ParseFlow(group.Conversation.FlowDiagram)
                                : new List<ICOGenerator.Contracts.Requirements.FlowStep>();
                        }
                        @if (flow.Any())
                        {
                            <div class="flow-diagram" aria-label="Sơ đồ luồng nghiệp vụ để xác nhận">
                                <div class="flow-diagram-title">Luồng nghiệp vụ chính — anh/chị xem giúp đã đúng chưa nhé:</div>
                                <ol class="flow-steps">
                                    @foreach (var step in flow)
                                    {
                                        <li class="flow-step">
                                            @if (!string.IsNullOrWhiteSpace(step.Actor))
                                            {
                                                <span class="flow-actor">@step.Actor</span>
                                            }
                                            <span class="flow-action">@step.Action</span>
                                            @if (!string.IsNullOrWhiteSpace(step.Outcome))
                                            {
                                                <span class="flow-outcome">@step.Outcome</span>
                                            }
                                            <button type="button" class="flow-step-fix" data-step="@step.Action" title="Bấm nếu bước này chưa đúng để đính chính ngay trong chat">chưa đúng?</button>
                                        </li>
                                    }
                                </ol>
                            </div>
                        }
                    </div>
                    prevWasBaBubble = true;
                }
            }

            @* CỔNG XÁC NHẬN GIẢ ĐỊNH — khối CUỐI của dòng hội thoại, ngay dưới lượt BA vừa báo "đã sinh
               bản thiết kế, đang chờ anh/chị rà N giả định". POC CHƯA dựng: quy trình thực sự đang đứng
               chờ ở đây, nên câu hỏi và nút trả lời phải nằm cùng một chỗ — trước đây cổng ở sidebar nên
               người dùng đọc xong lời mời trong chat rồi phải quét mắt sang cột trái tìm nút. Mỗi giả định
               có hai nút Đúng/Chưa đúng; "Chưa đúng" mở ô gõ ý đúng. Xác nhận xong mới dựng POC — bắt lỗi
               trước khi tốn trọn một lượt dựng (5–15 phút) thay vì sau. Markup/ID giữ nguyên như bản ở
               sidebar để initAssumptionGate (requirements.js) dùng lại y hệt. *@
            @if (specAssumptions.Any() && pendingAssumptions)
            {
                <div class="req-msg ba assumption-panel gate"
                     id="assumptionPanel"
                     data-pending="true"
                     data-confirm-url="@Url.Action("ConfirmAssumptions", "Requirements")"
                     data-revise-url="@Url.Action("ReviseAssumptions", "Requirements")">
                    <div class="assumption-gate-head">
                        <b>BA</b>
                        <span class="assumption-gate-title">
                            Giả định cần xác nhận @(string.IsNullOrEmpty(specVersion) ? "" : $"({specVersion})")
                        </span>
                        <span class="assumption-gate-count">@newAssumptions.Count điểm</span>
                    </div>
                    <div class="assumption-gate-hint">
                        <b>Bản demo chưa được dựng — đang chờ anh/chị ở bước này.</b>
                        @if (reviewedAssumptions.Any())
                        {
                            <text>
                                Các điểm anh/chị đã xác nhận trước đó mình giữ nguyên, không hỏi lại.
                                @if (newAssumptions.Any())
                                {
                                    <text>Chỉ còn <b>@newAssumptions.Count điểm mới</b> cần rà:</text>
                                }
                            </text>
                        }
                        else
                        {
                            <text>Bản mô tả không nói rõ mấy điểm dưới đây nên BA đã tự quyết. Rà nhanh giúp mình:</text>
                        }
                        điểm nào <b>chưa đúng</b> thì đánh dấu và ghi ý đúng, xong bấm nút bên dưới —
                        sửa ở đây chỉ mất vài giây, phát hiện sau khi xem demo thì phải dựng lại cả bản.
                    </div>
                    <ul class="assumption-list gate">
                        @foreach (var assumption in newAssumptions)
                        {
                            <li class="assumption-gate-item" data-assumption="@assumption">
                                <div class="assumption-gate-text">@assumption</div>
                                <div class="assumption-gate-actions">
                                    <button type="button" class="assumption-vote ok is-on" data-vote="ok">Đúng</button>
                                    <button type="button" class="assumption-vote bad" data-vote="bad">Chưa đúng</button>
                                </div>
                                <textarea class="assumption-fix" rows="2" hidden
                                          placeholder="Đúng ra là… (ghi ngắn gọn, có thể bỏ trống)"></textarea>
                            </li>
                        }
                    </ul>
                    @* Phần user đã bấm "Đúng" ở vòng trước: gấp lại thay vì bỏ hẳn — không hỏi lại nhưng
                       vẫn cho đổi ý (markup y hệt nên initAssumptionGate coi chúng như mọi mục khác). *@
                    @if (reviewedAssumptions.Any())
                    {
                        <details class="assumption-reviewed">
                            <summary>@reviewedAssumptions.Count điểm anh/chị đã xác nhận trước đó — bấm để xem/đổi ý</summary>
                            <ul class="assumption-list gate">
                                @foreach (var assumption in reviewedAssumptions)
                                {
                                    <li class="assumption-gate-item" data-assumption="@assumption">
                                        <div class="assumption-gate-text">@assumption</div>
                                        <div class="assumption-gate-actions">
                                            <button type="button" class="assumption-vote ok is-on" data-vote="ok">Đúng</button>
                                            <button type="button" class="assumption-vote bad" data-vote="bad">Chưa đúng</button>
                                        </div>
                                        <textarea class="assumption-fix" rows="2" hidden
                                                  placeholder="Đúng ra là… (ghi ngắn gọn, có thể bỏ trống)"></textarea>
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                    <div class="assumption-gate-bar">
                        <button type="button" class="btn primary" id="assumptionConfirmBtn">
                            ✓ Tất cả đúng — dựng bản demo
                        </button>
                        <button type="button" class="btn outline" id="assumptionReviseBtn" hidden>
                            ↻ Sửa các điểm đã đánh dấu rồi dựng lại bản thiết kế
                        </button>
                        <div class="assumption-gate-msg" id="assumptionGateMsg"></div>
                    </div>
                </div>
            }

            <div id="suggestionList"
                 class="suggestion-list"
                 role="listbox"
                 aria-label="Gợi ý trả lời"
                 data-multi="@(lastSuggestionsMulti ? "true" : "false")"
                 style="@(displaySuggestions.Any() ? "" : "display:none;")">
                @{
                    var suggestionIndex = 0;
                }
                @foreach (var suggestion in displaySuggestions)
                {
                    suggestionIndex++;
                    <button type="button"
                            class="suggestion-option"
                            role="option"
                            aria-selected="@(lastSuggestionsMulti ? "false" : null)"
                            data-suggestion="@suggestion">
                        <span class="suggestion-option-check" aria-hidden="true"></span>
                        <span class="suggestion-option-text">@suggestion</span>
                        <span class="suggestion-option-key">@suggestionIndex</span>
                    </button>
                }
            </div>

            @* THẺ HỎI GỘP — 2–4 câu hỏi độc lập BA đặt trong CÙNG một lượt. Đây là đường thay thế cho cổng
               "chốt nhanh" đã bỏ: cổng đó rút ngắn phỏng vấn bằng cách để BA tự soạn phương án cho mọi
               nhóm còn trống rồi ghi vào hội thoại NHƯ LỜI NGƯỜI DÙNG — lấp đầy bản đồ bao phủ mà không ai
               thật sự trả lời câu nào. Ở đây BA vẫn là người HỎI, người dùng vẫn là người TRẢ LỜI; thứ
               được rút ngắn chỉ là số vòng đi-về, không phải độ sâu khai thác.

               Render ở CẢ HAI đường (server ở đây khi tải trang, requirements.js ở frame done) vì reload
               phải giữ nguyên các câu chưa trả lời. Markup hai bên phải khớp nhau.

               Đặt SAU #suggestionList (không phải trước) vì quy tắc gộp "câu hỏi BA + chip gợi ý" dựa vào
               kề nhau (.req-msg.ba:has(+ .suggestion-list …)): chen một div vào giữa là hỏng, kể cả khi
               div đó đang ẩn. Đây cũng là lý do lượt gộp KHÔNG gộp bằng CSS như cặp "câu hỏi + chip" mà
               gộp bằng nội dung (câu dẫn dọn hẳn vào trong thẻ): thẻ không bao giờ kề bong bóng câu dẫn. *@
            @* Nhãn "BA" của lượt gộp đứng NGOÀI thẻ (như mọi bong bóng BA khác) vì thẻ giờ là bong bóng của
               lượt đó. Bỏ qua khi lượt BA liền trước đã in nhãn — cùng quy tắc gộp nhãn với vòng lặp trên. *@
            @if (lastBaQuestions.Count > 0 && !prevWasBaBubble)
            {
                <b class="req-who">BA</b>
            }
            <div class="req-msg ba batchq" id="batchQuestions" @(lastBaQuestions.Count > 0 ? "" : "hidden")>
                @if (lastBaQuestions.Count > 0)
                {
                    @* Câu dẫn = Message của chính lượt gộp (xem batchLead ở đầu file). Rỗng thì mới rơi về
                       câu tĩnh — không có dòng dẫn nào thì thẻ mở đầu bằng câu hỏi trần, mất mạch hội thoại. *@
                    <p class="batchq-lead">@(string.IsNullOrWhiteSpace(batchLead) ? "Anh/chị trả lời giúp mình mấy điểm sau nhé." : batchLead)</p>
                    <div class="batchq-howto">Bấm một gợi ý hoặc tự nhập; điểm nào chưa nghĩ tới thì để trống.</div>
                    <ul class="batchq-list">
                        @foreach (var q in lastBaQuestions)
                        {
                            @* Câu MỞ: không có gợi ý nào để bấm nên ô tự nhập mở SẴN (không có nút "Ý khác"
                               để bấm mở). Suy cả từ Suggestions rỗng, không chỉ từ cờ: lượt gộp cũ lưu
                               trước khi có cờ này vẫn phải render ra một dòng trả lời được. *@
                            var openQuestion = q.OpenEnded || q.Suggestions.Count == 0;
                            <li class="batchq-item" data-question="@q.Question" data-multi="@(q.MultiSelect ? "true" : "false")" data-open="@(openQuestion ? "true" : "false")">
                                @if (!string.IsNullOrWhiteSpace(q.Group))
                                {
                                    <div class="batchq-group">@q.Group</div>
                                }
                                <div class="batchq-question">@q.Question</div>
                                @if (!openQuestion)
                                {
                                    <div class="batchq-choices">
                                        @foreach (var s in q.Suggestions)
                                        {
                                            <button type="button" class="batchq-choice" data-value="@s">@s</button>
                                        }
                                        <button type="button" class="batchq-choice is-other" data-other="1">Ý khác — tôi tự nhập</button>
                                    </div>
                                    <textarea class="batchq-answer" rows="2" hidden placeholder="Câu trả lời của anh/chị…"></textarea>
                                }
                                else
                                {
                                    <textarea class="batchq-answer" rows="3" placeholder="Anh/chị kể giúp mình, càng chi tiết càng tốt…"></textarea>
                                }
                            </li>
                        }
                    </ul>
                    <div class="batchq-bar">
                        <button type="button" class="btn primary" id="batchQuestionsSendBtn" disabled>Chưa trả lời câu nào</button>
                        <div class="batchq-hint">Không cần trả lời hết — gửi phần anh/chị đã rõ, BA hỏi tiếp các câu còn lại.</div>
                    </div>
                }
            </div>

            @* CỔNG TỔNG KẾT CUỐI — khối cuối cùng của dòng hội thoại, mở đúng ở lượt BA mời bấm
               "Write Requirement". Đây là chỗ DUY NHẤT người dùng còn gặp lại nhật ký "điều đã chốt" sau
               khi panel sidebar bị gỡ: trong suốt cuộc phỏng vấn việc soát mâu thuẫn là của BA (nhật ký
               nằm trong ngữ cảnh chat của BA), người dùng chỉ đội mũ kiểm duyệt đúng một lần — ở đây, khi
               đã kể xong và còn rảnh trí để rà.

               Đặt ở khung chat vì cùng lý do đã chuyển cổng xác nhận giả định vào đây: quy trình đang ĐỨNG
               CHỜ người dùng, mà lời mời lại do BA nói ở cuối chat — câu hỏi và nút trả lời phải nằm cùng
               một chỗ. Đặt SAU #suggestionList và #batchQuestions vì quy tắc gộp "câu hỏi BA + chip gợi ý"
               dựa vào hai khối KỀ NHAU (.req-msg.ba:has(+ .suggestion-list …)); chen vào giữa là hỏng, kể
               cả khi khối chen vào đang ẩn.

               RANH GIỚI QUAN TRỌNG — cổng này KHÔNG phải cổng "chốt nhanh" đã bỏ đội lốt: mọi dòng ở đây
               đều là điều người dùng ĐÃ nói hoặc đã bấm đồng ý (decision-log.v1.md cấm suy diễn). BA không
               bao giờ được điền hộ một ý còn trống rồi ghi vào hội thoại như lời người dùng — chỗ trống
               vẫn phải hỏi tiếp trong chat, và cổng readiness vẫn là thứ quyết định khi nào cổng này mở.

               Markup phải khớp renderSummaryGate (requirements.js) để frame done render y hệt khi không reload. *@
            @{
                // Chỉ mở khi nút "Write Requirement" thật sự đang bấm được. Ở trạng thái "running" (đang
                // soạn) hay "regenerate" (soạn xong, chưa có gì mới), một bản tổng kết kèm nút "tạo tài
                // liệu" chỉ mời người dùng bấm lại đúng thứ vừa chạy.
                var showSummaryGate = writeReqState == "ready" && decisions.Count > 0;
            }
            <div class="req-msg ba summary-gate" id="summaryGate" @(showSummaryGate ? "" : "hidden")>
                <div class="summary-gate-head">
                    <b>BA</b>
                    <span class="summary-gate-title">Tổng kết trước khi tạo tài liệu</span>
                    <span class="summary-gate-count">@decisions.Count ý</span>
                </div>
                <div class="summary-gate-hint">
                    Đây là toàn bộ những gì mình đã hiểu được từ cuộc trao đổi. <b>Anh/chị rà nhanh giúp mình:</b>
                    ý nào chưa đúng thì bấm <b>✎ Sửa</b> ở ý đó — hoặc bôi đen đúng đoạn sai — rồi ghi lại ý đúng.
                    Sửa ở đây mất vài giây; để lọt tới lúc tài liệu và bản demo đã dựng thì phải làm lại cả tuyến.
                </div>
                <ul class="summary-gate-list">
                    @foreach (var decision in decisions)
                    {
                        <li class="summary-gate-item" data-decision="@decision">
                            <div class="summary-gate-text">@decision</div>
                            <button type="button" class="summary-gate-fix" title="Ý này chưa đúng — ghi chú lại cho BA">✎ Sửa</button>
                            <textarea class="summary-gate-note" rows="2" hidden
                                      placeholder="Đúng ra là… (ghi ngắn gọn)"></textarea>
                        </li>
                    }
                </ul>
                <div class="summary-gate-bar">
                    <button type="button" class="btn primary summary-gate-ok">✓ Đúng hết — tạo tài liệu</button>
                    @* Hai nút loại trừ nhau: đã ghi chú thì "tạo tài liệu" không còn nghĩa — soạn tài liệu
                       từ một bản tổng kết người dùng vừa nói là sai chính là điều cổng này sinh ra để chặn. *@
                    <button type="button" class="btn primary summary-gate-send" hidden>Gửi đính chính cho BA</button>
                    <div class="summary-gate-foot">
                        Còn điều gì chưa nói tới, anh/chị cứ nhắn thêm trong khung chat như bình thường.
                    </div>
                </div>
            </div>

            <div id="thinkingBox"
                 class="req-msg ba thinking"
                 style="display:none;">

                <div class="thinking-content">

                    <div class="spinner"></div>

                    <span id="thinkingText">
                        BA is analyzing requirements...
                    </span>

                </div>
            </div>

        </div>

        <div class="chat-composer">

            <div class="composer-actions">

                <!-- WRITE REQUIREMENT đã CHUYỂN lên cuối panel "Tiến độ khai thác" (cột trái): nút mở khóa
                     đúng khi thanh tiến độ đầy nên đặt ở đó tạo mạch "lấp đầy → nút sáng ngay đây", đồng
                     thời gọn khu vực soạn chat. -->

                <!-- Cổng "Duyệt & tiếp tục" (và Retry/Reject) ĐÃ CHUYỂN sang Agent Dashboard: user thường
                     dừng ở bước POC, chỉ TeamDev/Admin (quyền DeliveryAdvance) mới đẩy tiếp các bước
                     Architecture/code/test. Trang này chỉ hiển thị tiến độ; banner bên dưới sẽ hướng
                     dẫn người có quyền sang dashboard. -->

            </div>

            <!-- Khay xem trước ảnh đã đính kèm (chưa gửi): đính kèm/dán/kéo-thả ảnh sẽ hiện thumbnail nhỏ
                 ở đây để user gõ thêm ghi chú vào ô nhập rồi mới bấm gửi. JS (requirements.js) dựng các
                 thumbnail và xử lý xóa từng ảnh; ẩn khi chưa có ảnh nào. -->
            <div id="attachPreview" class="attach-preview" hidden aria-label="Ảnh đính kèm chờ gửi"></div>

            <form id="chatForm"
                  asp-action="Chat"
                  method="post"
                  class="req-chatbox">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="projectId"
                       value="@Model.Id" />

                <input type="hidden"
                       id="hiddenMessage"
                       name="message" />

              <textarea id="messageInput"
                          rows="1"
                          placeholder="Type your message..."
                          autocomplete="off"></textarea>

                <!-- Đính kèm tài liệu: mở hộp chọn file rồi upload qua đúng endpoint UploadSource (BA đọc &
                     tóm tắt). Dùng chung luồng với dán (Ctrl+V) / kéo-thả — chỉ thêm điểm bấm rõ ràng cho
                     người dùng không biết mẹo dán. Input không có name để không lẫn vào form chat.
                     accept phải phủ ĐỦ mọi định dạng ProjectSourceIngestor nhận (ảnh/PDF/bảng tính): đây là
                     lối đính kèm DUY NHẤT sau khi form upload ở sidebar bị bỏ. -->
                <input type="file"
                       id="attachImageInput"
                       accept="image/png,image/jpeg,image/webp,image/gif,application/pdf,.pdf,.docx,.docm,.xlsx,.xlsm,.csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"
                       multiple
                       hidden />
                <button class="btn outline attach-btn"
                        type="button"
                        id="attachImageBtn"
                        aria-label="Đính kèm tài liệu"
                        title="Đính kèm tài liệu để BA đọc: ảnh/chụp màn hình, PDF (kể cả bản scan), Word (.docx), Excel (.xlsx) hoặc CSV">
                    <i class="bi bi-paperclip" aria-hidden="true"></i>
                </button>

                <!-- Nói thay vì gõ (Web Speech API). JS ẩn nút khi trình duyệt không hỗ trợ;
                     đang ghi âm thì nút đổi trạng thái đỏ + text nhận dạng đổ dần vào ô nhập. -->
                <button class="btn outline voice-btn"
                        type="button"
                        id="voiceInputBtn"
                        hidden
                        aria-label="Nói thay vì gõ"
                        title="Nói thay vì gõ — bấm để bắt đầu/dừng ghi âm">
                    <i class="bi bi-mic" aria-hidden="true"></i>
                </button>

                <button class="btn primary"
                        type="submit"
                        aria-label="Send message">
                    ➤
                </button>
            </form>

        </div>

    </section>

</div>

@* Popup "Tài liệu nguồn": bảng liệt kê MỌI file người dùng đã đính kèm cho BA (qua nút 📎 / dán /
   kéo-thả trong khung chat) — xem lại, mở bản gốc, hoặc xoá. Không còn form upload ở đây: đính kèm đã
   là một phần của cuộc trò chuyện. Xoá chạy bằng fetch để bảng cập nhật tại chỗ (popup không đóng). *@
<div id="sourceModal" class="req-modal-overlay">
    <div class="requirement-modal source-modal">

        <div class="modal-header">
            <div>
                <h2>Tài liệu nguồn</h2>
                <div class="history-sub">Các file anh/chị đã đính kèm cho BA trong cuộc trò chuyện. Xoá file nghĩa là BA không dùng nội dung đó cho các lượt sau nữa.</div>
            </div>

            <button class="modal-close" type="button" aria-label="Close" id="sourceModalClose">×</button>
        </div>

        <div class="requirement-content">
            @Html.AntiForgeryToken()
            <input type="hidden" id="sourceModalProjectId" value="@Model.Id" />

            @if (!baSupportsVision)
            {
                <div class="source-vision-warn">
                    ⚠️ Model BA hiện không bật <b>vision</b> → ảnh sẽ không được đọc; chỉ phần chữ trích từ PDF/bảng tính được dùng.
                    Bật "Hỗ trợ ảnh (vision)" trong màn hình AI Models nếu cần.
                </div>
            }

            <table class="source-table" id="sourceTable" @(sourceFiles.Any() ? "" : "hidden")>
                <thead>
                    <tr>
                        <th class="source-col-name">Tên file</th>
                        <th>Loại</th>
                        <th class="source-col-num">Kích thước</th>
                        <th>Đính kèm lúc</th>
                        <th class="source-col-act"></th>
                    </tr>
                </thead>
                <tbody id="sourceTableBody">
                    @foreach (var src in sourceFiles)
                    {
                        <tr data-source-id="@src.Id">
                            <td class="source-col-name">
                                <a href="@Url.Action("SourceContent", new { id = src.Id })"
                                   target="_blank"
                                   rel="noopener"
                                   class="source-name"
                                   title="Mở bản gốc: @src.FileName">
                                    @(src.Kind switch {
                                        ICOGenerator.Domain.Enums.SourceFileKind.Image => "🖼️",
                                        ICOGenerator.Domain.Enums.SourceFileKind.Spreadsheet => "📊",
                                        _ => "📄" }) @src.FileName
                                </a>
                            </td>
                            <td>@(src.Kind switch {
                                ICOGenerator.Domain.Enums.SourceFileKind.Image => "Ảnh",
                                ICOGenerator.Domain.Enums.SourceFileKind.Spreadsheet => "Bảng tính",
                                _ => "PDF" })</td>
                            <td class="source-col-num">@FormatSize(src.SizeBytes)</td>
                            <td>@src.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="source-col-act">
                                <button type="button" class="source-del" data-source-id="@src.Id" title="Xoá tài liệu này">🗑</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="empty-history" id="sourceEmpty" @(sourceFiles.Any() ? "hidden" : "")>
                Chưa có tài liệu nguồn nào. Bấm nút 📎 dưới ô nhập trong khung chat để đính kèm ảnh, PDF (kể cả bản scan), Word hoặc file Excel/CSV cho BA đọc.
            </div>
        </div>

    </div>
</div>

<div id="requirementModal" class="req-modal-overlay">
    <div class="requirement-modal">

        <div class="modal-header">
            <div>
                <h2 id="modalTitle">Product Brief</h2>
            </div>

            <button class="modal-close" type="button" aria-label="Close" onclick="closeRequirementModal()">
                ×
            </button>
        </div>

        <div class="requirement-content">
            @foreach (var doc in productBriefs)
            {
                <div class="doc-preview"
                     id="doc-@doc.Id"
                     data-version="@doc.VersionName"
                     style="display:none;">

                    <div class="doc-actions">
                        <a class="btn outline"
                           asp-controller="Requirements"
                           asp-action="DownloadDocument"
                           asp-route-id="@doc.Id">
                            Download
                        </a>
                        <button type="button"
                                class="btn outline"
                                onclick="openDocHistory('@doc.Id')"
                                title="Xem các lần sinh/sửa trước và khác biệt giữa chúng">
                            <i class="bi bi-clock-history" aria-hidden="true"></i> Lịch sử
                        </button>
                    </div>

                    <h3>@doc.FileName</h3>

                    @* Bản DRAFT cho phép ghi chú trực tiếp: bôi đen một đoạn → "＋ Ghi chú" → gom lại gửi
                       BA sửa (ReviseBrief). Bản đã duyệt (V{n}) chỉ đọc, không gắn cờ này. *@
                    <div class="doc-render"
                         data-doc-id="@doc.Id"
                         data-loaded="false"
                         data-annotatable="@(doc.VersionName == "draft" ? "true" : "false")">
                        <p class="doc-loading">Loading…</p>
                    </div>
                </div>
            }
        </div>

        @* Khay ghi chú trên brief (chỉ bản draft): các ghi chú đã thêm + nút gửi cho BA sửa. Ẩn khi
           chưa có ghi chú nào. Antiforgery token dùng cho POST ReviseBrief qua fetch. *@
        <div class="brief-notes-tray" id="briefNotesTray" hidden>
            @Html.AntiForgeryToken()
            <div class="brief-notes-head">
                <b>Ghi chú của bạn</b> <span class="brief-notes-count" id="briefNotesCount">(0)</span>
                <span class="brief-notes-hint">Bôi đen một đoạn trong bản mô tả rồi bấm "＋ Ghi chú".</span>
            </div>
            <ul class="brief-notes-list" id="briefNotesList"></ul>
        </div>

        <div class="modal-footer">
            @if (selectedVersion == "draft")
            {
                <button type="button" class="btn outline" id="briefNotesSendBtn" hidden
                        title="Gom các ghi chú và nhờ BA sửa lại bản mô tả">
                    ✎ Gửi ghi chú cho BA sửa
                </button>
                <form asp-action="Approve" method="post">
                    <input type="hidden"
                           name="projectId"
                           value="@Model.Id" />

                    <button class="btn approve">
                        Approve this requirement
                    </button>
                </form>
            }
        </div>

    </div>
</div>

@section Breadcrumb {
    Projects <span class="sep">&rsaquo;</span> @Model.Name <span class="sep">&rsaquo;</span> <b>Requirements</b>
}

@section Styles {
    <link rel="stylesheet" href="~/css/requirements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/doc-history.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/requirements.js" asp-append-version="true"></script>
    <script src="~/js/doc-history.js" asp-append-version="true"></script>
    <script>
        window.REQUIREMENTS_PROJECT_ID = '@Model.Id';
        // Người có quyền DeliveryAdvance (TeamDev/Admin) được dẫn sang Agent Dashboard để duyệt/đẩy bước;
        // user thường chỉ thấy thông báo bàn giao "POC đã sẵn sàng".
        window.REQUIREMENTS_CAN_ADVANCE = @((await Permissions.HasPermissionAsync(User, AppPermission.DeliveryAdvance)) ? "true" : "false");
    </script>
    <script src="~/js/requirement-workflow.js" asp-append-version="true"></script>
}
