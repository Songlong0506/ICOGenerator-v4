@using ICOGenerator.Domain.Enums
@model IReadOnlyList<ICOGenerator.Application.Agents.LearnedChecklistBucket>
@{
    var role = ViewBag.Role is AgentRoleKey r ? r : AgentRoleKey.BusinessAnalyst;
    var isBa = role == AgentRoleKey.BusinessAnalyst;
    var roleTitle = role.GetTitle();
    var canManage = ViewBag.CanManage is bool cm && cm;
    // Có giá trị khi thân checklist được mở dạng popup trên màn Agents: form lưu xong quay về đúng vai
    // đó ở màn Agents và tự mở lại popup, thay vì nhảy sang trang Checklist riêng.
    var returnAgentId = ViewBag.ReturnAgentId as Guid?;
}

@* Thân checklist học được của MỘT vai — dùng chung cho trang Agents/Checklist và popup trên màn Agents
   (AgentsController.ChecklistModal). Nội dung vai này tự học được từ các dự án TRƯỚC. Nó được nạp vào
   prompt của vai ở MỌI dự án sau — BA vào mỗi lượt chat phỏng vấn, các vai kỹ thuật vào mỗi bước delivery
   họ chạy — tức là một bài học rút sai từ một dự án cá biệt sẽ âm thầm làm nhiễu mọi dự án sau đó. Đây là
   chỗ duy nhất nhìn thấy, hiểu VÌ SAO nó được rút ra, và tắt được nó.

   Tắt (bỏ tick) chứ không xóa: mục đã tắt được gửi cho vòng harvest sau như danh sách cấm, nên bài học
   sai không quay lại — điều mà thời checklist còn là một ô text tự do không làm được. *@

<p class="muted checklist-intro">
    @if (isBa)
    {
        <text>
            What the BA learned on its own from previous projects and asks about in later projects.
        </text>
    }
    else
    {
        <text>
            What @roleTitle learned on its own from <b>reviewer comments</b> on previous projects and
            applies in later projects.
        </text>
    }
    Each item comes with <b>why that lesson was learned</b> — read the reason and <b>untick</b> any item that is not
    right: @roleTitle stops applying it and <b>will not re-learn</b> it in later projects.
</p>

@if (!Model.Any())
{
    <div class="card">
        <p class="muted">
            @if (isBa)
            {
                <text>
                    The BA has not learned anything yet. Content appears here after a project finishes its interview or
                    after notes on the POC are sent to the Dev team to fix.
                </text>
            }
            else
            {
                <text>
                    @roleTitle has not learned anything yet. Content appears here after someone clicks
                    <b>"Request revision"</b> on a step run by @roleTitle, types a comment, and then <b>approves</b>
                    that step. Approving straight away without feedback leaves nothing to learn — that is the intended behavior.
                </text>
            }
        </p>
    </div>
}

@foreach (var bucket in Model)
{
    <div class="card checklist-bucket">
        <div class="checklist-bucket-head">
            <h2>
                @(bucket.DepartmentCode == null ? "Applies to all projects" : $"Department: {bucket.DepartmentLabel}")
                <span class="muted">· @bucket.ActiveCount/@bucket.Items.Count items active</span>
            </h2>
            @if (bucket.UpdatedAt.HasValue)
            {
                <span class="muted">updated @bucket.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            }
        </div>

        @* Truy nguồn ở mức bucket: dự án nào đã đóng góp bài học vào nhóm này (từng mục còn có nguồn riêng
           bên dưới). Khi thấy một mục lạ/sai, câu hỏi đầu tiên luôn là "cái này ở đâu ra". *@
        @if (bucket.Sources.Any())
        {
            <div class="checklist-sources">
                Learned from @bucket.Sources.Count project(s):
                @foreach (var source in bucket.Sources)
                {
                    <a asp-controller="Requirements" asp-action="Index" asp-route-projectId="@source.ProjectId"
                       class="checklist-source-chip">@source.Name</a>
                }
            </div>
        }

        <form asp-action="SaveChecklist" method="post" class="checklist-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="role" value="@role" />
            <input type="hidden" name="departmentCode" value="@bucket.DepartmentCode" />
            @if (returnAgentId.HasValue)
            {
                <input type="hidden" name="returnAgentId" value="@returnAgentId" />
            }

            @{ var index = 0; }
            @foreach (var item in bucket.Items)
            {
                var rows = Math.Clamp(item.Text.Length / 90 + 1, 1, 4);
                <div class="checklist-item @(item.IsActive ? "" : "is-off")">
                    <div class="checklist-item-row">
                        @if (canManage)
                        {
                            <input type="hidden" name="items[@index].Id" value="@item.Id" />
                            <input type="checkbox" name="items[@index].Enabled" value="true" checked="@item.IsActive"
                                   title="Untick so this role stops applying it (and does not re-learn it)" />
                            <input type="hidden" name="items[@index].Enabled" value="false" />
                            <textarea name="items[@index].Text" rows="@rows" spellcheck="false" class="checklist-item-text">@item.Text</textarea>
                            <button type="submit" name="deleteId" value="@item.Id" class="checklist-item-del"
                                    title="Delete this item permanently"
                                    onclick="return confirm('Delete this item PERMANENTLY? This role may learn the same lesson again from a later project. To block it for good, untick it instead of deleting.');">✕</button>
                        }
                        else
                        {
                            <span class="checklist-item-mark">@(item.IsActive ? "✓" : "✕")</span>
                            <span class="checklist-item-text-readonly">@item.Text</span>
                        }
                    </div>

                    <div class="checklist-item-why">
                        @if (!string.IsNullOrWhiteSpace(item.Rationale))
                        {
                            <div><span class="checklist-why-label">Why:</span> @item.Rationale</div>
                        }
                        else
                        {
                            <div class="muted">No reason was recorded for this lesson.</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.Evidence))
                        {
                            <div class="checklist-item-evidence">“@item.Evidence”</div>
                        }

                        <div class="checklist-item-meta">
                            <span class="checklist-tag">
                                @(item.SourceKind switch
                                {
                                    ChecklistItemSource.PocFeedback => "from notes on the POC",
                                    ChecklistItemSource.SpecAssumption => "from an assumption rejected before building the demo",
                                    ChecklistItemSource.BriefNote => "from notes on the brief",
                                    ChecklistItemSource.StageRevision => "from reviewer comments at an approval gate",
                                    _ => "from the interview conversation"
                                })
                            </span>
                            @if (item.SourceProjectId.HasValue && item.SourceProjectName != null)
                            {
                                <a asp-controller="Requirements" asp-action="Index" asp-route-projectId="@item.SourceProjectId"
                                   class="checklist-source-chip">@item.SourceProjectName</a>
                            }
                            @if (item.IsRecent)
                            {
                                <span class="checklist-tag is-new">newly learned</span>
                            }
                            @if (item.Status == ChecklistItemStatus.DisabledByUser)
                            {
                                <span class="checklist-tag is-off">disabled — not applied & not re-learned</span>
                            }
                            else if (item.Status == ChecklistItemStatus.DisabledByOverflow)
                            {
                                <span class="checklist-tag is-off">auto-disabled because the group already has @ICOGenerator.Services.Requirements.ChecklistNoteStore.MaxActiveItemsPerBucket items</span>
                            }
                        </div>
                    </div>
                </div>
                index++;
            }

            @if (canManage)
            {
                <div class="checklist-form-actions">
                    <button type="submit" class="btn primary">Save</button>
                    <button type="submit" name="bucketAction" value="disableAll" class="btn outline danger"
                            onclick="return confirm('Disable this group\'s entire checklist? This role will stop applying those items — re-enable any time.');">
                        Disable this entire group
                    </button>
                </div>
            }
        </form>
    </div>
}
