@model IReadOnlyList<ICOGenerator.Application.Agents.LearnedChecklistBucket>
@{
    var role = ViewBag.Role is ICOGenerator.Domain.Enums.AgentRoleKey r ? r : ICOGenerator.Domain.Enums.AgentRoleKey.BusinessAnalyst;
    var roleTitle = role.GetTitle();
    ViewData["Title"] = $"Checklist learned by {roleTitle}";
}

@* Trang riêng của checklist — đường dẫn trực tiếp (bookmark, link trong tài liệu) và đường lùi khi JS tắt.
   Trên màn Agents, nút "Checklist học được" mở cùng nội dung này dạng popup (_ChecklistBody). *@

<div class="page-head">
    <div>
        <h1>Checklist learned by @roleTitle</h1>
    </div>
    <a class="btn outline" asp-action="Index">← Back to Agents</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert error">@TempData["Error"]</div>
}

@await Html.PartialAsync("_ChecklistBody", Model)
