@using ICOGenerator.Application.Agents
@model IReadOnlyList<AgentPromptItem>

@* Danh sách template prompt của một role (hoặc bucket Shared/General). Mỗi dòng link sang Prompt Studio
   (Detail) để xem/sửa theo phiên bản. Thay cho ô Instruction cũ trên trang Agents. *@
<div class="table-wrap">
    <table class="data-table" data-paginate data-page-size="10">
        <thead>
            <tr>
                <th>Prompt</th>
                <th>Active source</th>
                <th>Versions</th>
                <th>Last modified</th>
                <th>By</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="muted">No prompts in this section yet.</td></tr>
            }
            @foreach (var p in Model)
            {
                <tr>
                    <td>
                        <a class="prompt-key-link" asp-controller="Prompts" asp-action="Detail" asp-route-key="@p.PromptKey">
                            <code class="prompt-key">@p.DisplayName</code>
                        </a>
                        @if (p.IsInstruction)
                        {
                            <span class="badge blue" title="The agent's core instructions (instruction.md)">Instruction</span>
                        }
                        @if (!p.FileExists)
                        {
                            <span class="badge orange" title="The .md file was removed from the repo — the template now lives only as a DB version">File deleted</span>
                        }
                    </td>
                    <td>
                        @if (p.ActiveVersionNumber is int active)
                        {
                            <span class="badge green" title="A DB version is overriding the file content">DB v@(active)</span>
                        }
                        else
                        {
                            <span class="badge gray" title="Using the file content from the repo">File</span>
                        }
                    </td>
                    <td>@(p.VersionCount == 0 ? "—" : p.VersionCount.ToString())</td>
                    <td>
                        @if (p.LastChangedAt is DateTime lastAt)
                        {
                            <span class="prompt-time" data-utc="@lastAt.ToString("o")"></span>
                        }
                        else
                        {
                            <span class="muted">Never modified</span>
                        }
                    </td>
                    <td>@(p.LastChangedBy ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
