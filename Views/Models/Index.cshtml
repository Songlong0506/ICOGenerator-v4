@using System.Globalization
@using System.Text.Encodings.Web
@using ICOGenerator.Application.Models
@using ICOGenerator.Domain.Enums
@model AiModelListPage

@functions {
    // Ba mức response_format, xếp từ "không gửi gì" đến "chặt nhất" — cùng thứ tự khai báo enum nên
    // dropdown luôn mở ra ở lựa chọn an toàn nhất.
    private static readonly StructuredOutputMode[] StructuredModes = Enum.GetValues<StructuredOutputMode>();

    // Badge ở bảng: chỉ None là "tắt", hai mức còn lại đều đang gửi response_format.
    private static string StructuredBadgeClass(StructuredOutputMode mode) =>
        mode == StructuredOutputMode.None ? "gray" : "green";

    private static string StructuredBadgeText(StructuredOutputMode mode) => mode switch
    {
        StructuredOutputMode.JsonObject => "JSON mode",
        StructuredOutputMode.JsonSchema => "JSON Schema",
        _ => "Không"
    };

    private static string StructuredBadgeTitle(StructuredOutputMode mode) => mode switch
    {
        StructuredOutputMode.JsonObject => "Gửi response_format: json_object — API bảo đảm JSON hợp lệ về cú pháp, vẫn stream được token",
        StructuredOutputMode.JsonSchema => "Gửi response_format: json_schema sinh từ kiểu kết quả — chỉ endpoint OpenAI thật nhận, không stream token",
        _ => "Không gửi response_format — kết quả JSON được parse từ văn xuôi"
    };

    // Prices are stored as decimal(18,6), so a raw ToString() renders "0.140000". Three decimals
    // ("$0.001") is enough resolution for $ / 1M tokens, and trailing zeros are dropped.
    private const string PriceFormat = "0.###";

    private static string Price(decimal v) =>
        v > 0 ? "$" + v.ToString(PriceFormat, CultureInfo.InvariantCulture) : "–";

    // Same rounding, without the "$"/"–" decoration, for prefilling the Edit modal's number inputs.
    private static string PriceValue(decimal v) =>
        v.ToString(PriceFormat, CultureInfo.InvariantCulture);

    // Masked preview of the API key for display only (e.g. "sk-66af2***********************f1a2").
    // Reveals only a short head/tail so the user can recognise which key is configured without ever
    // exposing the full secret. Keys too short to safely reveal head+tail are fully masked.
    private const int ApiKeyHead = 8;
    private const int ApiKeyTail = 4;

    private static string MaskApiKey(string? key)
    {
        if (string.IsNullOrEmpty(key))
            return string.Empty;

        if (key.Length <= ApiKeyHead + ApiKeyTail)
            return new string('*', Math.Max(key.Length, 4));

        return key[..ApiKeyHead] + new string('*', 12) + key[^ApiKeyTail..];
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/models.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <h1>AI Models</h1>
    </div>
</div>

@await Html.PartialAsync("_CommandBar", new CommandBarModel
{
    SearchPlaceholder = "Search models…",
    TargetSelector = "#modelsTable",
    Primary = new CommandBarButton { Label = "Add Model", Icon = "bi-plus-lg", OnClick = "openAddModel()" }
})

<div class="card table-card">
    <table id="modelsTable">
        <thead>
            <tr>
                <th>Model ID</th>
                <th>Context Window</th>
                <th>Input $/1M</th>
                <th>Output $/1M</th>
                <th>Vision</th>
                <th>Structured Output</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var m in Model.Items)
            {
                <tr>
                    <td><b>@m.ModelId</b></td>
                    <td>@m.ContextWindow.ToString("N0")</td>
                    <td>@Price(m.InputPricePerMillionTokens)</td>
                    <td>@Price(m.OutputPricePerMillionTokens)</td>
                    <td>
                        <span class="badge @(m.SupportsVision ? "green" : "gray")"
                              title="@(m.SupportsVision
                                         ? "Model nhận input ảnh — tài liệu ảnh/PDF scan được gửi thẳng cho model"
                                         : "Model text-only — chỉ nhận phần text bóc từ tài liệu")">
                            @(m.SupportsVision ? "Có" : "Không")
                        </span>
                    </td>
                    <td>
                        <span class="badge @StructuredBadgeClass(m.StructuredOutputMode)"
                              title="@StructuredBadgeTitle(m.StructuredOutputMode)">
                            @StructuredBadgeText(m.StructuredOutputMode)
                        </span>
                    </td>
                    <td>
                        <span class="badge @(m.IsActive ? "green" : "gray")">
                            @(m.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="actions">
                        <button class="icon-btn"
                                type="button"
                                aria-label="Edit model"
                                title="Edit model"
                                onclick="openEditModel(
                                        '@m.Id',
                                        '@JavaScriptEncoder.Default.Encode(m.ModelId)',
                                        '@JavaScriptEncoder.Default.Encode(m.Endpoint)',
                                        '@m.ContextWindow',
                                        '@PriceValue(m.InputPricePerMillionTokens)',
                                        '@PriceValue(m.OutputPricePerMillionTokens)',
                                        '@m.IsActive.ToString().ToLower()',
                                        '@m.SupportsVision.ToString().ToLower()',
                                        '@m.StructuredOutputMode',
                                        '@JavaScriptEncoder.Default.Encode(MaskApiKey(m.ApiKey))'
                                    )">
                            <i class="bi bi-pencil-fill" aria-hidden="true"></i>
                        </button>

                        <form asp-action="Delete" method="post" class="inline-form"
                              onsubmit="return confirm('Delete this model?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.Id" />
                            <button class="icon-btn danger" type="submit" aria-label="Delete model" title="Delete model">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pager", new ICOGenerator.Application.Shared.PagerModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        PageUrl = p => Url.Action("Index", new { page = p, pageSize = Model.PageSize })!,
        PageSizeUrl = s => Url.Action("Index", new { page = 1, pageSize = s })!
    })
</div>

<div id="addModel" class="modal-backdrop hidden">
    <form class="modal" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <button type="button" class="x" onclick="closeModal('addModel')">×</button>

        <h2>Add Model</h2>

        <label>Model ID *</label>
        <input name="ModelId" required placeholder="qwen3.6-27b@q3_k_s" />

        <label>Endpoint *</label>
        <input name="Endpoint" required value="http://127.0.0.1:1234/v1" />

        <label>ApiKey *</label>
        <input name="ApiKey" value="lm-studio" required />

        <label>Context Window</label>
        <input name="ContextWindow" type="number" value="128000" />

        <label>Input price ($ / 1M tokens)</label>
        <input name="InputPricePerMillionTokens" type="number" step="0.001" min="0" value="0" />

        <label>Output price ($ / 1M tokens)</label>
        <input name="OutputPricePerMillionTokens" type="number" step="0.001" min="0" value="0" />

        <label class="checkbox-line">
            <input name="IsActive" type="checkbox" value="true" checked />
            Active
        </label>

        <label class="checkbox-line">
            <input name="SupportsVision" type="checkbox" value="true" />
            Hỗ trợ ảnh (vision)
        </label>

        <label>Structured output (response_format)</label>
        <select name="StructuredOutputMode">
            @foreach (var mode in StructuredModes)
            {
                <option value="@mode">@mode.GetTitle()</option>
            }
        </select>

        <div id="add-test-result" class="test-result hidden" role="status" aria-live="polite"></div>

        <div class="modal-actions">
            <button type="button" class="btn test-conn-btn"
                    data-test-url="@Url.Action("TestConnection")"
                    data-result="add-test-result"
                    onclick="testModelConnection(this)">
                <i class="bi bi-plug" aria-hidden="true"></i> Test Connection
            </button>
            <span class="modal-actions-spacer"></span>
            <button type="button" class="btn" onclick="closeModal('addModel')">Cancel</button>
            <button class="btn primary">Add Model</button>
        </div>
    </form>
</div>

<div id="editModel" class="modal-backdrop hidden">
    <form class="modal" asp-action="Update" method="post">
        @Html.AntiForgeryToken()

        <button type="button" class="x" onclick="closeModal('editModel')">×</button>

        <h2>Edit Model</h2>

        <input type="hidden" id="edit-id" name="Id" />

        <label>Model ID *</label>
        <input id="edit-model-id" name="ModelId" required />

        <label>Endpoint *</label>
        <input id="edit-endpoint" name="Endpoint" required />

        <label>ApiKey</label>
        <input id="edit-api-key" name="ApiKey" placeholder="Để trống để giữ key hiện tại" autocomplete="off" />
        <small class="hint">Key hiện tại: <code id="edit-api-key-preview">—</code>. Để trống để giữ key hiện tại.</small>

        <label>Context Window</label>
        <input id="edit-context-window" name="ContextWindow" type="number" />

        <label>Input price ($ / 1M tokens)</label>
        <input id="edit-input-price" name="InputPricePerMillionTokens" type="number" step="0.001" min="0" />

        <label>Output price ($ / 1M tokens)</label>
        <input id="edit-output-price" name="OutputPricePerMillionTokens" type="number" step="0.001" min="0" />

        <label class="checkbox-line">
            <input id="edit-is-active" name="IsActive" type="checkbox" value="true" />
            Active
        </label>

        <label class="checkbox-line">
            <input id="edit-supports-vision" name="SupportsVision" type="checkbox" value="true" />
            Hỗ trợ ảnh (vision)
        </label>

        <label>Structured output (response_format)</label>
        <select id="edit-structured-output-mode" name="StructuredOutputMode">
            @foreach (var mode in StructuredModes)
            {
                <option value="@mode">@mode.GetTitle()</option>
            }
        </select>

        <div id="edit-test-result" class="test-result hidden" role="status" aria-live="polite"></div>

        <div class="modal-actions">
            <button type="button" class="btn test-conn-btn"
                    data-test-url="@Url.Action("TestConnection")"
                    data-result="edit-test-result"
                    onclick="testModelConnection(this)">
                <i class="bi bi-plug" aria-hidden="true"></i> Test Connection
            </button>
            <span class="modal-actions-spacer"></span>
            <button type="button" class="btn" onclick="closeModal('editModel')">Cancel</button>
            <button class="btn primary">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/models.js" asp-append-version="true"></script>
}
