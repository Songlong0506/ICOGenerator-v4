@model Project
@{
    var agents = ViewBag.Agents as List<Agent> ?? new();
    var phases = ViewBag.Phases as IReadOnlyList<string> ?? new List<string> { "01_Requirement", "02_Design", "03_Architecture", "04_Implementation", "05_Test" };
    // Token totals come from AgentModelCallLog (the single source of truth for AI token
    // usage), aggregated across all of the project's call logs in the query. Per-agent
    // values sum to the grand total because every call log is attributed to an agent.
    var agentStats = ViewBag.AgentStats as ICOGenerator.Application.Agents.AgentStatsResult
        ?? new ICOGenerator.Application.Agents.AgentStatsResult(0, Array.Empty<ICOGenerator.Application.Agents.AgentStatItem>());
    var totalTokens = agentStats.TotalTokens;
    var statsByAgent = agentStats.Agents.ToDictionary(x => x.AgentId);
    var workspaceDocuments = ViewBag.WorkspaceDocuments as IReadOnlyList<ICOGenerator.Domain.ProjectDocument> ?? Model.Documents.ToList();

    Func<string, string> phaseOf = folder => phases.FirstOrDefault(p => string.Equals(p, folder, StringComparison.OrdinalIgnoreCase)) ?? "Other";
    var docsByPhase = workspaceDocuments.GroupBy(d => phaseOf(d.Folder)).ToDictionary(g => g.Key, g => g.ToList());
    var orderedFolders = phases.ToList();
    if (docsByPhase.ContainsKey("Other")) { orderedFolders.Add("Other"); }

    static int VersionOrder(string versionName)
    {
        if (string.Equals(versionName, "draft", StringComparison.OrdinalIgnoreCase))
            return 0;

        if (versionName.Length > 1
            && versionName.StartsWith("V", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(versionName[1..], out var versionNumber))
            return versionNumber;

        return int.MaxValue;
    }

    // DB-tracked documents are previewed by their real row Id; workspace files that exist only
    // on disk (no DB row) carry a fresh random Id each request, so they must be previewed by
    // their relative path instead. Mark the disk-only ones here so the client picks the right URL.
    var dbDocIds = new HashSet<Guid>(Model.Documents.Select(d => d.Id));
    var docMap = workspaceDocuments.ToDictionary(
        d => d.Id.ToString(),
        d => (object)new
        {
            name = d.FileName,
            agentId = d.AgentId?.ToString() ?? "",
            path = dbDocIds.Contains(d.Id) ? "" : (d.FilePath ?? "")
        });
    var docsJson = System.Text.Json.JsonSerializer.Serialize(docMap);
    var firstDoc = workspaceDocuments.FirstOrDefault();

    // Developer-generated source lands under 04_Implementation/src; LoadWorkspaceDocuments maps those
    // disk files to Folder="04_Implementation", VersionName="src". Presence of any such file means the
    // packaged-source download is available.
    var hasImplementationSource = workspaceDocuments.Any(d =>
        string.Equals(d.Folder, "04_Implementation", StringComparison.OrdinalIgnoreCase)
        && string.Equals(d.VersionName, "src", StringComparison.OrdinalIgnoreCase));

    // Cổng duyệt/đẩy bước delivery chỉ hiện cho TeamDev/Admin (quyền DeliveryAdvance). User thường
    // dừng ở bước POC bên màn hình Requirements và không thấy cổng này.
    var canAdvance = await Permissions.HasPermissionAsync(User, AppPermission.DeliveryAdvance);

}

@section Styles {
    <link rel="stylesheet" href="~/css/agent-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/doc-history.css" asp-append-version="true" />
}


@section Breadcrumb {
    Projects <span class="sep">&rsaquo;</span> @Model.Name <span class="sep">&rsaquo;</span> <b>Agent Dashboard</b>
}

<div class="page-head">
    <div>
        <h1>Agent Dashboard</h1>
    </div>
</div>

@* "Cấu hình delivery" và "Total Tokens Used" nằm chung MỘT hàng (.dashboard-top-row): card cấu hình
   co giãn chiếm phần còn lại, card token giữ nguyên bề rộng theo nội dung và dính lề phải. Khi người
   dùng không có quyền DeliveryAdvance thì chỉ còn card token, vẫn nằm bên phải như cũ. *@
<div class="dashboard-top-row">
    @if (canAdvance)
    {
        @* Cấu hình delivery chỉ cần set một lần nên không hiển thị form thường trực; chỉ hiện summary
           gọn + nút mở popup (#delivery-config-modal) để giữ dashboard sạch sẽ. *@
        <div class="card delivery-config-summary">
            <div class="dg-head">
                <h3>Config delivery</h3>
                <button class="icon-btn" type="button"
                        title="Edit delivery configuration"
                        aria-label="Edit delivery configuration"
                        onclick="openDeliveryConfig()">
                    <i class="bi bi-pencil-fill" aria-hidden="true"></i>
                </button>
            </div>
            <div class="dc-summary">
                <span class="dc-summary-item">
                    <span class="muted">Generation Mode:</span>
                    <b>@(Model.IsUseBoschTemplate == false ? "Let TechLead Define" : "Use Bosch Template")</b>
                </span>
                <span class="dc-summary-item">
                    <span class="muted">Backend Git:</span>
                    <b>@(string.IsNullOrWhiteSpace(Model.BackendGitUrl) ? "—" : Model.BackendGitUrl)</b>
                </span>
                <span class="dc-summary-item">
                    <span class="muted">Frontend Git:</span>
                    <b>@(string.IsNullOrWhiteSpace(Model.FrontendGitUrl) ? "—" : Model.FrontendGitUrl)</b>
                </span>
                <span class="dc-summary-item">
                    <span class="muted">Target branch:</span>
                    <b>@(string.IsNullOrWhiteSpace(Model.GitBaseBranch) ? "main" : Model.GitBaseBranch)</b>
                </span>
                <span class="dc-summary-item">
                    <span class="muted">Git user:</span>
                    <b>@(string.IsNullOrWhiteSpace(Model.GitUsername) ? "—" : Model.GitUsername)</b>
                </span>
                @* Chỉ nói CÓ hay KHÔNG — token đã lưu không bao giờ được render ra trang. *@
                <span class="dc-summary-item">
                    <span class="muted">Git token:</span>
                    <b>@(string.IsNullOrWhiteSpace(Model.GitAccessToken) ? "—" : "saved")</b>
                </span>
            </div>
        </div>
    }

    <div class="card token">
        <span>Total Tokens Used</span>
        <b id="total-tokens">@totalTokens.ToString("N0")</b>
    </div>
</div>

@* Tài liệu kỹ thuật (BRD/SRS/FSD/UserStories) nay là BƯỚC 2 của Delivery Pipeline (sau POC): chạy tự
   động sau khi duyệt POC thay vì có nút trigger riêng — theo dõi trong timeline "Delivery Pipeline". *@

@if (canAdvance)
{
    <!-- CỔNG DELIVERY: duyệt/đẩy/chạy-lại các bước sau POC (Architecture → code → review → test → PR).
         Dải timeline hiện ở MỌI project, kể cả project mới tạo chưa có run nào (khi đó mọi bước ở trạng
         thái "chưa tới" và không có nút hành động); JS (agent-dashboard.js) bật đúng nút theo trạng thái
         run. Ẩn ở lần render đầu để khỏi chớp một card rỗng trước khi poll đầu tiên trả về. -->
    <div class="card delivery-gate" id="delivery-gate" style="display:none;">
        <div class="dg-head">
            <h3>Delivery Pipeline</h3>
            <span id="dg-status" class="muted"></span>
        </div>

        <!-- Timeline tiến trình: render từ data.pipeline (JS). Mỗi bước có CSS theo trạng thái
             done/running/next/failed/pending để nhìn là biết đang ở đâu trong quy trình. -->
        <ol id="dg-timeline" class="dg-timeline" aria-label="Delivery progress"></ol>

        <div id="dg-banner" class="dg-banner"></div>

        <div class="dg-actions">
            <form id="dg-approve-form" asp-controller="AgentDashboard" asp-action="ApproveStage" method="post"
                  class="dg-inline" style="display:none;"
                  onsubmit="var b=this.querySelector('button'); b.disabled=true; b.textContent='Processing…';">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <input type="hidden" name="runId" id="dg-approve-runid" value="" />
                <button class="btn approve" type="submit"
                        title="Approve the current step and run the next step of the delivery pipeline">
                    ✓ Approve &amp; continue
                </button>
            </form>

            <button class="btn outline" type="button" id="dg-revise-btn" style="display:none;"
                    onclick="openReviseModal()"
                    title="Send feedback so the agent revises the current step's result — does not cancel the workflow or re-run finished steps">
                ✎ Request revision
            </button>

            <form id="dg-reject-form" asp-controller="AgentDashboard" asp-action="RejectStage" method="post"
                  class="dg-inline" style="display:none;"
                  onsubmit="return confirm('Reject this step\'s result and cancel the workflow? You will need to Approve the requirement again to run a new version.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <input type="hidden" name="runId" id="dg-reject-runid" value="" />
                <button class="btn outline" type="submit"
                        title="Reject the current step's result and cancel the delivery workflow">
                    ✗ Reject
                </button>
            </form>

            <form id="dg-retry-form" asp-controller="AgentDashboard" asp-action="RetryWorkflow" method="post"
                  class="dg-inline" style="display:none;"
                  onsubmit="var s=event.submitter; setTimeout(function(){ this.querySelectorAll('button').forEach(function(b){ b.disabled=true; }); if(s) s.textContent='Restarting…'; }.bind(this), 0);">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <input type="hidden" name="runId" id="dg-retry-runid" value="" />
                <button class="btn" type="submit" id="dg-retry-btn" title="Re-run the failed step without Approving again from the start">
                    ↻ Retry this step
                </button>
                @* Chỉ hiện khi bước hỏng còn checkpoint (agent-dashboard.js): nút chính khi đó CHẠY TIẾP,
                   nút này bỏ phần đã làm để chạy lại cả bước. *@
                <button class="btn outline" type="submit" id="dg-restart-btn" name="restart" value="true" style="display:none;"
                        title="Discard the steps the agent did in the previous attempt and run this step from scratch"
                        onclick="return confirm('Discard the steps the agent did in the previous attempt and run this step from scratch? The tokens already spent on those steps will have to be paid again.');">
                    Run from scratch
                </button>
            </form>

            <span id="dg-revise-note" class="muted dg-revise-note" style="display:none;"></span>
        </div>
    </div>
}

<div class="agent-table-wrap">
    <table class="data-table agent-table">
        <thead>
            <tr>
                <th>Agent</th>
                <th class="share-col">Share</th>
                <th class="num-col tokens-col">Total Tokens</th>
                <th class="num-col">Calls</th>
                <th>Last Activity</th>
                <th class="actions-col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in agents)
            {
                var stat = statsByAgent.TryGetValue(a.Id, out var st) ? st : null;
                var agentTokens = stat?.TotalTokens ?? 0L;
                var agentCalls = stat?.Calls ?? 0;
                var sharePct = totalTokens > 0 ? (double)agentTokens / totalTokens * 100 : 0d;
                var shareWidth = sharePct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                var shareLabel = sharePct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                var hasActivity = stat?.LastActivityUtc != null;
                var lastAtIso = hasActivity ? stat!.LastActivityUtc!.Value.ToString("o") : null;
                <tr class="agent-row" data-agent-id="@a.Id" data-agent-name="@a.RoleKey.GetTitle()" onclick="filterByAgent('@a.Id', '@a.RoleKey.GetTitle()')">
                    <td>
                        <div class="agent-name-cell">
                            <span class="circle" style="background:@a.Color"></span>
                            <span class="agent-name-text">
                                <b>@a.RoleKey.GetTitle()</b>
                            </span>
                            <span class="running-indicator" title="Agent is running — click to view activity" onclick="event.stopPropagation(); openAgentActivity('@a.Id', '@a.RoleKey.GetTitle()')"><span class="pulse-dot"></span> Running</span>
                        </div>
                    </td>
                    <td class="share-col">
                        <div class="share-bar"><span class="share-fill" style="width:@(shareWidth)%"></span></div>
                        <small class="muted share-label">@shareLabel%</small>
                    </td>
                    @* Số thô nằm ở data-*; agent-dashboard.js (renderAgentTokenCells) dựng thanh + popover bằng
                       đúng component của cột Tokens trong popup AI Call Logs. Chữ trong ô là bản dự phòng. *@
                    <td class="num-col tokens-col agent-tokens"
                        data-prompt-tokens="@(stat?.PromptTokens ?? 0)" data-cached-prompt-tokens="@(stat?.CachedPromptTokens ?? 0)"
                        data-cache-write-prompt-tokens="@(stat?.CacheWritePromptTokens ?? 0)" data-completion-tokens="@(stat?.CompletionTokens ?? 0)"
                        data-total-tokens="@agentTokens">@agentTokens.ToString("N0")</td>
                    <td class="num-col agent-calls">@agentCalls.ToString("N0")</td>
                    <td class="agent-last-activity">
                        @if (hasActivity)
                        {
                            <span class="last-activity" data-utc="@lastAtIso"></span>
                        }
                        else
                        {
                            <span class="muted">—</span>
                        }
                    </td>
                    @* Cột Actions dùng dải nút biểu tượng chung của app (site.css) — cùng một kiểu
                       với Projects và Audit Log. Nhãn "View Logs" chuyển vào tooltip + aria-label.
                       stopPropagation vẫn cần: cả dòng là vùng bấm để lọc theo agent. *@
                    <td class="actions-col">
                        <div class="row-actions">
                            <button type="button"
                                    class="icon-btn icon-btn--accent"
                                    data-tip="View model call log"
                                    aria-label="View model call log of @a.RoleKey.GetTitle()"
                                    onclick="event.stopPropagation(); loadAgentLogs('@a.Id', '@a.RoleKey.GetTitle()')">
                                <i class="bi bi-journal-text" aria-hidden="true"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="grid manage-grid">
    <div class="card">
        <div class="ws-head">
            <h3>Workspace</h3>
            <small id="ws-filter-label" class="muted"></small>
            <button type="button" id="ws-clear" class="btn ws-clear hidden" onclick="clearAgentFilter()">Show all</button>
            @if (hasImplementationSource)
            {
                <a class="btn ws-download"
                   href="/Projects/DownloadSource?projectId=@Model.Id"
                   title="Download all source code (04_Implementation/src) as .zip">
                    ⬇ Download
                </a>
            }
        </div>
        <ul class="tree" id="ws-tree">
            @foreach (var folder in orderedFolders)
            {
                var docs = docsByPhase.TryGetValue(folder, out var list)
                    ? list.OrderBy(d => VersionOrder(d.VersionName)).ThenBy(d => d.VersionName).ThenBy(d => d.FileName).ToList()
                    : new List<ICOGenerator.Domain.ProjectDocument>();

                var rootDocs = docs.Where(d => string.IsNullOrWhiteSpace(d.VersionName)).OrderBy(d => d.FileName).ToList();
                var versionGroups = docs
                    .Where(d => !string.IsNullOrWhiteSpace(d.VersionName))
                    .GroupBy(d => d.VersionName)
                    .OrderBy(g => VersionOrder(g.Key))
                    .ThenBy(g => g.Key)
                    .ToList();

                <li class="folder phase-folder">
                    <button type="button" class="tree-row folder-toggle" aria-expanded="true" onclick="toggleFolder(this)">
                        <span class="folder-caret" aria-hidden="true">▾</span>
                        <span aria-hidden="true">📁</span>
                        <span>@folder</span>
                    </button>
                    <ul class="tree-children">
                        @if (rootDocs.Any() || versionGroups.Any())
                        {
                            foreach (var d in rootDocs)
                            {
                                <li class="file" data-doc-id="@d.Id" data-agent-id="@(d.AgentId?.ToString() ?? "")" onclick="showDoc('@d.Id')"><span class="file-icon" aria-hidden="true">📄</span><span class="file-name">@d.FileName</span></li>
                            }

                            foreach (var versionGroup in versionGroups)
                            {
                                <li class="folder version-folder">
                                    <button type="button" class="tree-row folder-toggle" aria-expanded="true" onclick="toggleFolder(this)">
                                        <span class="folder-caret" aria-hidden="true">▾</span>
                                        <span aria-hidden="true">📁</span>
                                        <span>@versionGroup.Key</span>
                                    </button>
                                    <ul class="tree-children">
                                        @foreach (var d in versionGroup.OrderBy(d => d.FileName))
                                        {
                                            <li class="file" data-doc-id="@d.Id" data-agent-id="@(d.AgentId?.ToString() ?? "")" onclick="showDoc('@d.Id')"><span class="file-icon" aria-hidden="true">📄</span><span class="file-name">@d.FileName</span></li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="empty">— empty —</li>
                        }
                    </ul>
                </li>
            }
        </ul>
    </div>

    <div class="card">
        <div class="doc-preview-head">
            <h3 id="doc-title">@(firstDoc?.FileName ?? "No document")</h3>
            <!-- Lịch sử revision chỉ có cho tài liệu DB-tracked (file chỉ-trên-đĩa không có lịch sử);
                 agent-dashboard.js bật/tắt nút này trong showDoc theo meta.path. -->
            <button type="button"
                    id="doc-history-btn"
                    class="btn outline small hidden"
                    onclick="openDocHistory(currentDbDocId)"
                    title="View previous generations/edits and the differences between them">
                <i class="bi bi-clock-history" aria-hidden="true"></i> History
            </button>
        </div>
        <div class="preview"><div id="doc-content" class="doc-render"><p class="doc-empty">No document yet</p></div></div>
    </div>
</div>

<div class="modal-backdrop" id="logs-modal">
    <div class="modal-card large-modal">
        <button class="modal-x" type="button" aria-label="Close" onclick="closeLogsModal()">×</button>

        <div class="logs-header">
            <div>
                <h3>AI Call Logs</h3>
                <p id="logs-subtitle">
                    Click an agent card to view model invocation history.
                </p>
            </div>
        </div>

        <div class="logs-filters" id="logs-filters">
            <div class="logs-filter">
                <label for="filter-from">Time from</label>
                <input type="datetime-local" id="filter-from" class="logs-filter-input">
            </div>
            <div class="logs-filter">
                <label for="filter-to">Time to</label>
                <input type="datetime-local" id="filter-to" class="logs-filter-input">
            </div>
            <div class="logs-filter">
                <label for="filter-purpose">Purpose</label>
                <select id="filter-purpose" class="logs-filter-input">
                    <option value="">All</option>
                </select>
            </div>
            <div class="logs-filter">
                <label for="filter-status">Status</label>
                <select id="filter-status" class="logs-filter-input">
                    <option value="">All</option>
                    <option value="success">Success</option>
                    <option value="error">Error</option>
                </select>
            </div>
            <div class="logs-filter logs-filter-actions">
                <button class="btn btn-primary" onclick="applyLogFilters()">Filter</button>
                <button class="btn" onclick="clearLogFilters()">Clear</button>
            </div>
        </div>

        <div style="overflow-x:auto;">
            <table class="data-table logs-table">
                <thead>
                    <tr>
                        @* Cột mũi tên mở/đóng chi tiết — nhãn để trống, ý nghĩa nằm ở aria-label của nút. *@
                        <th class="log-toggle-col"></th>
                        @* Bảng chạy table-layout:fixed nên bề rộng cột lấy từ chính hàng <th> này
                           (xem .log-col-* trong agent-dashboard.css) — cột Purpose để trống, nhận
                           phần rộng còn lại. *@
                        <th class="log-col-time">Time</th>
                        <th>Purpose</th>
                        <th class="log-col-model">Model</th>
                        <th class="log-col-tokens">Tokens</th>
                        <th class="log-col-duration">Duration</th>
                        <th class="log-col-status">Status</th>
                        @* Cột hành động của dòng — nút biểu tượng, nhãn nằm ở tooltip nên <th> để trống. *@
                        <th class="actions-col"></th>
                    </tr>
                </thead>

                <tbody id="logs-tbody"></tbody>
            </table>
        </div>

        <div class="logs-pager" id="logs-pager"></div>

    </div>
</div>

<div class="modal-backdrop" id="agent-activity-modal">
    <div class="modal-card">
        <button class="modal-x" type="button" aria-label="Close" onclick="closeAgentActivity()">×</button>
        <div class="logs-header">
            <div>
                <h3>Agent Activity</h3>
                <p id="activity-subtitle">Actions the agent is performing (real-time, for debugging).</p>
            </div>
        </div>

        <div id="activity-meta" class="activity-meta"></div>
        <div id="activity-feed" class="activity-feed">
            <p class="activity-empty">Loading activity…</p>
        </div>
    </div>
</div>

@if (canAdvance)
{
    <div class="modal-backdrop" id="delivery-config-modal">
        <div class="modal-card delivery-config-card">
            <button class="modal-x" type="button" aria-label="Close" onclick="closeDeliveryConfig()">×</button>
            <div class="logs-header">
                <div>
                    <h3>Config delivery</h3>
                </div>
            </div>

            <form asp-controller="AgentDashboard" asp-action="UpdateDeliveryConfig" method="post" class="dc-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProjectId" value="@Model.Id" />

                <label>Generation Mode</label>
                <div class="radio-group" role="radiogroup" aria-label="Generation Mode">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="generation-mode-bosch" name="IsUseBoschTemplate" value="true" checked="@(Model.IsUseBoschTemplate == true)" />
                        <label class="form-check-label" for="generation-mode-bosch">Use Bosch Template</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="generation-mode-techlead" name="IsUseBoschTemplate" value="false" checked="@(Model.IsUseBoschTemplate == false)" />
                        <label class="form-check-label" for="generation-mode-techlead">Let TechLead Define</label>
                    </div>
                </div>

                <label>Backend Git</label>
                <input name="BackendGitUrl" value="@Model.BackendGitUrl" placeholder="https://your-org.com/backend-repo.git" />

                <label>Frontend Git</label>
                <input name="FrontendGitUrl" value="@Model.FrontendGitUrl" placeholder="https://your-org.com/frontend-repo.git" />

                <label>Target branch (Pull Request)</label>
                <input name="GitBaseBranch" value="@Model.GitBaseBranch" placeholder="main" />

                <label>Git user name</label>
                <input name="GitUsername" value="@Model.GitUsername" placeholder="Leave empty = use the server's credentials" autocomplete="off" />

                @* Ô CHỈ-GHI: không bao giờ đổ token đã lưu vào value. Trống khi lưu = giữ nguyên token cũ. *@
                <label>Git token (Password / Token Key)</label>
                <input type="password" name="GitAccessToken" value=""
                       placeholder="@(string.IsNullOrWhiteSpace(Model.GitAccessToken) ? "No token" : "Saved — leave empty to keep")"
                       autocomplete="new-password" />
                @if (!string.IsNullOrWhiteSpace(Model.GitAccessToken))
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="dc-clear-git-token" name="ClearGitAccessToken" value="true" />
                        <label class="form-check-label" for="dc-clear-git-token">Clear saved token</label>
                    </div>
                }

                <div class="dg-actions">
                    <button class="btn primary" type="submit">Save configuration</button>
                </div>
            </form>
        </div>
    </div>

    @* Popup "Yêu cầu chỉnh sửa" tại cổng duyệt: người duyệt gõ nhận xét → agent sửa lại đúng bước
       đang chờ duyệt (không hủy workflow, không chạy lại các bước đã xong). *@
    <div class="modal-backdrop" id="revise-modal">
        <div class="modal-card revise-card">
            <button class="modal-x" type="button" aria-label="Close" onclick="closeReviseModal()">×</button>
            <div class="logs-header">
                <div>
                    <h3>Request revision</h3>
                </div>
            </div>

            <form asp-controller="AgentDashboard" asp-action="RequestRevision" method="post" class="dc-form"
                  onsubmit="var b=this.querySelector('button[type=submit]'); b.disabled=true; b.textContent='Sending…';">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <input type="hidden" name="runId" id="dg-revise-runid" value="" />

                <label for="revise-feedback">Feedback for the agent — the step awaiting approval will be revised based on this feedback</label>
                <textarea name="feedback" id="revise-feedback" rows="6"
                          placeholder="E.g. the Dashboard screen is missing the monthly filter from the spec; the inventory table needs paging; rename the 'Save' button to 'Submit'…"></textarea>

                @* Chỉ hiện ở cổng POC (JS bật/tắt theo currentStage): gom các ghi chú người xem đã GHIM
                   trực tiếp trên POC (trang Projects/PocReview) vào nhận xét gửi agent. Có ghi chú được
                   gom thì phần nhận xét gõ tay được phép trống — required của textarea do JS quản. *@
                <div id="revise-poc-comments" class="revise-poc-comments" style="display:none;">
                    <label class="revise-poc-toggle">
                        <input type="checkbox" name="includePocComments" id="revise-include-poc" value="true" checked />
                        <span id="revise-poc-summary">Include notes pinned on the POC</span>
                    </label>
                    <ul id="revise-poc-list" class="revise-poc-list"></ul>
                    <a asp-controller="Projects" asp-action="PocReview" asp-route-projectId="@Model.Id"
                       target="_blank" class="revise-poc-link">Open POC Review to view/pin more ↗</a>
                </div>

                <p class="muted revise-hint" id="revise-remaining"></p>

                <div class="dg-actions">
                    <button class="btn primary" type="submit">Send revision request</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        window.AGENT_DASHBOARD = {
            docs: @Html.Raw(docsJson),
            firstDocId: '@(firstDoc?.Id.ToString() ?? "")',
            projectId: '@Model.Id',
            canAdvance: @(canAdvance ? "true" : "false")
        };
    </script>
    <script src="~/js/agent-dashboard.js" asp-append-version="true"></script>
    <script src="~/js/doc-history.js" asp-append-version="true"></script>
}
