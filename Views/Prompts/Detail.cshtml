@using ICOGenerator.Application.Prompts
@model PromptDetailVm

@{
    ViewData["Title"] = "Prompt Studio";
    var canManage = await Permissions.HasPermissionAsync(User, AppPermission.AgentsManage);
    var latestNumber = Model.Versions.Count > 0 ? Model.Versions.Max(v => v.VersionNumber) : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/prompts.css" asp-append-version="true" />
}

@section Breadcrumb {
    <text><a asp-controller="Agents" asp-action="Index">Agents</a> <span class="sep">&rsaquo;</span> @Model.PromptKey</text>
}

<div class="page-head">
    <div>
        <h1><code class="prompt-key lg">@Model.PromptKey</code></h1>
        <p class="muted prompt-sub">
            Active:
            @if (Model.ActiveVersionNumber is int active)
            {
                <span class="badge green">DB v@(active)</span>
                @if (canManage)
                {
                    <form asp-action="RevertToFile" method="post" class="inline-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="key" value="@Model.PromptKey" />
                        <button class="btn outline small" type="submit"
                                onclick="return confirm('Revert to the FILE content in the repo? Version history is kept.');">
                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Revert to file
                        </button>
                    </form>
                }
            }
            else if (Model.FileExists)
            {
                <span class="badge gray">File content from the repo</span>
            }
            else
            {
                <span class="badge orange">File deleted — no active DB version</span>
            }
        </p>
    </div>
</div>

@if (TempData["Saved"] != null)
{
    <div class="server-toast" data-toast-type="success" hidden>Updated — every subsequent AI call uses the new content immediately.</div>
}

<div class="card prompt-editor-card">
    <div class="prompt-card-head">
        <h3>@(canManage ? "Active content (edit, then Save to create a new version)" : "Active content")</h3>
    </div>
    @if (canManage)
    {
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="key" value="@Model.PromptKey" />
            <textarea class="prompt-editor" name="content" rows="22" spellcheck="false">@Model.ActiveContent</textarea>
            <div class="prompt-editor-foot">
                @* Import: nạp một file .md (đã export từ môi trường khác / bản chỉnh ngoài) vào editor
                   để soát lại rồi Lưu — client-side thuần, không endpoint riêng. Xem prompts.js. *@
                <label class="btn outline small prompt-import-label" title="Load the content of an .md file into the editor (not saved — click Save to create a version)">
                    <i class="bi bi-upload" aria-hidden="true"></i> Load from file
                    <input type="file" id="promptImportInput" accept=".md,.txt,text/markdown,text/plain" hidden />
                </label>
                <input class="prompt-note-input" type="text" name="changeNote" maxlength="500"
                       placeholder="Change note (e.g. tighten the condition for inviting Write Requirement)" />
                <button class="btn primary" type="submit">
                    <i class="bi bi-save" aria-hidden="true"></i> Save &amp; activate
                </button>
            </div>
        </form>
    }
    else
    {
        <pre class="prompt-content-pre">@Model.ActiveContent</pre>
    }
</div>

@if (Model.EvalStats.Any())
{
    <div class="card table-card prompt-eval-card">
        <div class="prompt-card-head">
            <h3>Eval scores by version</h3>
            <a class="btn outline small" asp-controller="Evals" asp-action="Index" title="Run a new eval / view run details on the Prompt Evals page">
                <i class="bi bi-play-fill" aria-hidden="true"></i> Prompt Evals
            </a>
        </div>
        <div class="table-wrap">
            <table class="data-table" data-paginate data-page-size="10">
                <thead>
                    <tr>
                        <th>Measured version</th>
                        <th>Avg judge score (1–5)</th>
                        <th>Results</th>
                        <th>Last run</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.EvalStats)
                    {
                        <tr>
                            <td>
                                @if (s.VersionNumber is int measured)
                                {
                                    <span class="badge green">DB v@(measured)</span>
                                }
                                else
                                {
                                    <span class="badge gray">File</span>
                                }
                            </td>
                            <td><b>@s.AverageScore.ToString("0.00")</b></td>
                            <td>@s.ResultCount</td>
                            <td><span class="prompt-time" data-utc="@s.LastRunAt.ToString("o")"></span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card table-card">
    <div class="prompt-card-head">
        <h3>Version history</h3>
        @if (Model.FileExists && latestNumber > 0)
        {
            <a class="btn outline small" asp-action="Diff" asp-route-key="@Model.PromptKey" asp-route-from="0" asp-route-to="@latestNumber"
               title="Compare the repo file content with the latest version">
                <i class="bi bi-file-earmark-diff" aria-hidden="true"></i> File ↔ v@(latestNumber)
            </a>
        }
    </div>
    <div class="table-wrap">
        <table class="data-table" data-paginate data-page-size="10">
            <thead>
                <tr>
                    <th>Version</th>
                    <th>Note</th>
                    <th>Edited by</th>
                    <th>Time</th>
                    <th>Diff</th>
                    @if (canManage)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Versions.Any())
                {
                    <tr><td colspan="6" class="prompt-empty">No versions yet — the template still uses the file content from the repo. Edit and Save to start a history.</td></tr>
                }
                @foreach (var v in Model.Versions)
                {
                    <tr>
                        <td>
                            <b>v@(v.VersionNumber)</b>
                            @if (v.IsActive)
                            {
                                <span class="badge green">Active</span>
                            }
                        </td>
                        <td class="prompt-note">@(v.ChangeNote ?? "—")</td>
                        <td>@(v.CreatedByDisplayName ?? "—")</td>
                        <td><span class="prompt-time" data-utc="@v.CreatedAt.ToString("o")"></span></td>
                        <td>
                            @* v1 so với file gốc (mốc 0); các bản sau so với bản liền trước. *@
                            <a class="prompt-diff-link" asp-action="Diff" asp-route-key="@Model.PromptKey"
                               asp-route-from="@(v.VersionNumber == 1 ? 0 : v.VersionNumber - 1)" asp-route-to="@v.VersionNumber">
                                @(v.VersionNumber == 1 ? "file ↔ v1" : $"v{v.VersionNumber - 1} ↔ v{v.VersionNumber}")
                            </a>
                            <a class="icon-btn prompt-download" asp-action="Download" asp-route-key="@Model.PromptKey" asp-route-version="@v.VersionNumber"
                               title="Download this version as an .md file (sync back to the repo / move to another environment)">
                                <i class="bi bi-download" aria-hidden="true"></i>
                            </a>
                        </td>
                        @if (canManage)
                        {
                            <td class="actions">
                                @if (!v.IsActive)
                                {
                                    <form asp-action="Activate" method="post" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@v.Id" />
                                        <button class="btn outline small" type="submit"
                                                title="Use this version again (rollback)"
                                                onclick="return confirm('Activate v@(v.VersionNumber)? Every subsequent AI call will use this version.');">
                                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Activate
                                        </button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/prompts.js" asp-append-version="true"></script>
}
