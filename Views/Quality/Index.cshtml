@using System.Globalization
@using ICOGenerator.Application.Quality
@model DeliveryQualityVm

@functions {
    private static string Money(decimal v) =>
        v <= 0 ? "$0.00"
        : v < 0.01m ? "$" + v.ToString("0.####", CultureInfo.InvariantCulture)
        : "$" + v.ToString("N2", CultureInfo.InvariantCulture);

    private static string Pct(double v) => v.ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private static string Duration(double? minutes)
    {
        if (minutes is not double m) return "–";
        if (m < 1) return "< 1 min";
        if (m < 60) return m.ToString("0.#", CultureInfo.InvariantCulture) + " min";
        var h = (int)(m / 60);
        var rem = (int)Math.Round(m - h * 60);
        return rem > 0 ? $"{h}h {rem}m" : $"{h}h";
    }

    // Ngưỡng đơn giản để tô màu tỷ lệ: hoàn tất cao = tốt; thất bại/rework cao = xấu.
    private static string GoodHighClass(double pct) => pct >= 80 ? "good" : pct >= 50 ? "warn" : "bad";
    private static string GoodLowClass(double pct) => pct <= 10 ? "good" : pct <= 30 ? "warn" : "bad";

    // Tỷ lệ CHƯA ĐO ĐƯỢC khác hẳn tỷ lệ 0%: "chưa có run nào đi qua cổng" mà hiện "0%" là nói dối về
    // chất lượng. Cùng luật với cột "Cached prompt" ở trang Usage — không biết thì hiện gạch.
    private static string PctOrDash(double? v) => v is double d ? Pct(d) : "–";

    private static string GoodHighClassOrNeutral(double? v) => v is double d ? GoodHighClass(d) : "";

    // % chiều rộng một segment trong thanh outcome (đã format cho thuộc tính style).
    private static string ShareStyle(int n, int total) =>
        (total <= 0 ? 0 : n * 100d / total).ToString("0.##", CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet" href="~/css/quality.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <h1>Delivery Quality</h1>
    </div>
</div>

@* Command bar chuẩn: chọn năm để lọc dashboard (form GET, tự submit khi đổi). *@
@{
    var qualityBar = new CommandBarModel
    {
        FormUrl = Url.Action("Index"),
        Filters = @<div class="cbar-field">
            <label for="q-filter-year">Year</label>
            <select id="q-filter-year" name="year" data-caption="Year" onchange="this.form.submit()" aria-label="Select year">
                @foreach (var yr in Model.AvailableYears)
                {
                    <option value="@yr" selected="@(Model.SelectedYear == yr)">@yr</option>
                }
            </select>
        </div>
    };
}
@await Html.PartialAsync("_CommandBar", qualityBar)

@if (!Model.HasAnyPricing)
{
    <div class="pricing-hint">
        No model has a price set yet, so costs show $0. Go to
        <a asp-controller="Models" asp-action="Index">AI Models</a>
        to enter the <b>Input/Output price ($/1M tokens)</b> for each model.
    </div>
}

@if (Model.TotalRuns == 0)
{
    <div class="card">
        <div class="q-empty">No workflow runs in @Model.SelectedYear yet. Approve a requirement to start the delivery pipeline.</div>
    </div>
}
else
{
    <div class="q-section-title">Delivery results</div>
    <div class="q-tiles">
        <div class="q-tile accent">
            <div class="q-label">Total runs</div>
            <div class="q-value">@Model.TotalRuns.ToString("N0")</div>
            <div class="q-sub">@Model.InProgressRuns running</div>
        </div>
        <div class="q-tile @GoodHighClass(Model.CompletionRate)">
            <div class="q-label">Completion rate</div>
            <div class="q-value">@Pct(Model.CompletionRate)</div>
            <div class="q-sub">@Model.CompletedRuns completed / @(Model.CompletedRuns + Model.FailedRuns + Model.CanceledRuns) finished</div>
        </div>
        <div class="q-tile @GoodLowClass(Model.FailureRate)">
            <div class="q-label">Failure rate</div>
            <div class="q-value">@Pct(Model.FailureRate)</div>
            <div class="q-sub">@Model.FailedRuns failed · @Model.CanceledRuns canceled</div>
        </div>
        <div class="q-tile">
            <div class="q-label">Avg delivery time</div>
            <div class="q-value">@Duration(Model.AvgDurationMinutes)</div>
            <div class="q-sub">across completed runs</div>
        </div>
        <div class="q-tile">
            <div class="q-label">Total cost</div>
            <div class="q-value">@Money(Model.TotalCost)</div>
            <div class="q-sub">only calls belonging to delivery runs</div>
        </div>
        <div class="q-tile">
            <div class="q-label">Cost / run</div>
            <div class="q-value">@Money(Model.AvgCostPerRun)</div>
            <div class="q-sub">average per run</div>
        </div>
    </div>

    <div class="card" style="padding:18px 20px; margin-top:16px;">
        <div class="q-outcome">
            @if (Model.CompletedRuns > 0)
            {
                <span class="seg-completed" style="width:@ShareStyle(Model.CompletedRuns, Model.TotalRuns)%" title="Completed: @Model.CompletedRuns"></span>
            }
            @if (Model.FailedRuns > 0)
            {
                <span class="seg-failed" style="width:@ShareStyle(Model.FailedRuns, Model.TotalRuns)%" title="Failed: @Model.FailedRuns"></span>
            }
            @if (Model.CanceledRuns > 0)
            {
                <span class="seg-canceled" style="width:@ShareStyle(Model.CanceledRuns, Model.TotalRuns)%" title="Canceled: @Model.CanceledRuns"></span>
            }
            @if (Model.InProgressRuns > 0)
            {
                <span class="seg-progress" style="width:@ShareStyle(Model.InProgressRuns, Model.TotalRuns)%" title="Running: @Model.InProgressRuns"></span>
            }
        </div>
        <div class="q-outcome-legend">
            <span><i class="k-completed"></i>Completed <b>@Model.CompletedRuns</b></span>
            <span><i class="k-failed"></i>Failed <b>@Model.FailedRuns</b></span>
            <span><i class="k-canceled"></i>Canceled <b>@Model.CanceledRuns</b></span>
            <span><i class="k-progress"></i>Running <b>@Model.InProgressRuns</b></span>
        </div>
    </div>

    @if (Model.FailedByStage.Count > 0)
    {
        <div class="q-section-title">Where failed runs stopped</div>
        <div class="q-stage-list">
            @foreach (var s in Model.FailedByStage)
            {
                <span class="q-stage-chip">@s.StageLabel <b>@s.Count</b></span>
            }
        </div>
    }

    <div class="q-section-title">Rework</div>
    <div class="q-tiles">
        <div class="q-tile @GoodLowClass(Model.ReworkRate)">
            <div class="q-label">Runs needing rework</div>
            <div class="q-value">@Pct(Model.ReworkRate)</div>
            <div class="q-sub">with at least one revision/bugfix round</div>
        </div>
        <div class="q-tile">
            <div class="q-label">Revision requests</div>
            <div class="q-value">@Model.TotalRevisionRequests.ToString("N0")</div>
            <div class="q-sub">@Model.RunsNeedingRevision run(s) needing revision</div>
        </div>
        <div class="q-tile">
            <div class="q-label">Auto bug-fix rounds</div>
            <div class="q-value">@Model.TotalBugFixRounds.ToString("N0")</div>
            <div class="q-sub">@Model.RunsNeedingBugFix run(s) needing bugfix</div>
        </div>
    </div>

    <div class="q-section-title">Generated code quality</div>
    <div class="q-tiles">
        <div class="q-tile @GoodHighClassOrNeutral(Model.CodeQuality.FirstPassBuildRate)">
            <div class="q-label">Compiled on first try</div>
            <div class="q-value">@PctOrDash(Model.CodeQuality.FirstPassBuildRate)</div>
            <div class="q-sub">@Model.CodeQuality.RunsCompiledFirstTry/@Model.CodeQuality.RunsMeasured runs scored by the build gate</div>
        </div>
        <div class="q-tile">
            <div class="q-label">Build-fix rounds</div>
            <div class="q-value">@(Model.CodeQuality.AvgBuildFixRounds?.ToString("0.##", CultureInfo.InvariantCulture) ?? "–")</div>
            <div class="q-sub">average per run@(Model.CodeQuality.RunsStillRed > 0 ? $"; {Model.CodeQuality.RunsStillRed} run(s) still red" : "")</div>
        </div>
        <div class="q-tile @GoodHighClassOrNeutral(Model.CodeQuality.TestPassRate)">
            <div class="q-label">Tests PASS</div>
            <div class="q-value">@PctOrDash(Model.CodeQuality.TestPassRate)</div>
            <div class="q-sub">@Model.CodeQuality.RunsTestPassed/@Model.CodeQuality.RunsReachingTesting runs reaching testing</div>
        </div>
        <div class="q-tile @GoodHighClassOrNeutral(Model.CodeQuality.PullRequestRate)">
            <div class="q-label">Reached Pull Request</div>
            <div class="q-value">@PctOrDash(Model.CodeQuality.PullRequestRate)</div>
            <div class="q-sub">@Model.CodeQuality.RunsReachingPullRequest/@Model.CodeQuality.RunsWithImplementation runs that generated code</div>
        </div>
    </div>
    @if (Model.CodeQuality.RunsWithImplementation > Model.CodeQuality.RunsMeasured)
    {
        <div class="q-note">
            @(Model.CodeQuality.RunsWithImplementation - Model.CodeQuality.RunsMeasured) run(s) are not in the build rate:
            they ran before the build gate existed, or the gate skipped itself (no buildable project found, or dependency installation failed).
            They count as neither passed nor failed.
        </div>
    }

    <div class="q-section-title">Project-based quality</div>
    <div class="card table-card">
        @if (Model.Projects.Count == 0)
        {
            <div class="empty-state">No project data yet.</div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table" data-paginate data-page-size="10">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th class="num-col">Runs</th>
                            <th class="num-col">Completed</th>
                            <th class="num-col">Failed</th>
                            <th class="num-col">Revisions</th>
                            <th class="num-col">Bugfix</th>
                            <th class="num-col">Avg time</th>
                            <th class="num-col">Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Projects)
                        {
                            <tr>
                                <td><b>@p.ProjectName</b></td>
                                <td class="num-col">@p.Runs</td>
                                <td class="num-col">@p.Completed</td>
                                <td class="num-col">@(p.Failed > 0 ? p.Failed.ToString() : "–")</td>
                                <td class="num-col">@(p.RevisionRequests > 0 ? p.RevisionRequests.ToString() : "–")</td>
                                <td class="num-col">@(p.BugFixRounds > 0 ? p.BugFixRounds.ToString() : "–")</td>
                                <td class="num-col">@Duration(p.AvgDurationMinutes)</td>
                                <td class="num-col">@Money(p.Cost)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="q-section-title">Model reliability</div>
    <div class="card table-card">
        @if (Model.Models.Count == 0)
        {
            <div class="empty-state">No model calls in @Model.SelectedYear yet.</div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table" data-paginate data-page-size="10">
                    <thead>
                        <tr>
                            <th>Model</th>
                            <th class="num-col">Calls</th>
                            <th class="num-col">Success rate</th>
                            <th class="num-col">Avg latency</th>
                            <th class="num-col">Tokens</th>
                            <th class="num-col">Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Models)
                        {
                            <tr>
                                <td><b>@m.ModelId</b></td>
                                <td class="num-col">@m.Calls.ToString("N0")</td>
                                <td class="num-col"><span class="q-rate-pill @GoodHighClass(m.SuccessRate)">@Pct(m.SuccessRate)</span></td>
                                <td class="num-col">@(m.AvgLatencyMs >= 1000 ? (m.AvgLatencyMs / 1000d).ToString("0.#", CultureInfo.InvariantCulture) + "s" : m.AvgLatencyMs.ToString("0") + "ms")</td>
                                <td class="num-col">@m.TotalTokens.ToString("N0")</td>
                                <td class="num-col">@(m.HasPrice ? Money(m.Cost) : "–")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@* Phễu khai thác yêu cầu: cũng NGOÀI khối TotalRuns>0 — cuộc phỏng vấn/Brief/POC đo được cả khi chưa có run nào
   kết thúc. Ba con số là baseline để biết mỗi thay đổi prompt/flow có thật sự làm phỏng vấn gọn hơn, Brief ít
   phải viết lại hơn, POC ít bị ghim lỗi hơn. *@
@if (Model.RequirementFunnel.Count > 0)
{
    <div class="q-section-title">Requirements elicitation funnel (projects created in @Model.SelectedYear)</div>
    <div class="q-tiles">
        <div class="q-tile">
            <div class="q-label">User replies / interview</div>
            <div class="q-value">@(Model.AvgFunnelUserTurns?.ToString("0.#", CultureInfo.InvariantCulture) ?? "–")</div>
            <div class="q-sub">average per project</div>
        </div>
        <div class="q-tile">
            <div class="q-label">Product Brief rewrites</div>
            <div class="q-value">@(Model.AvgFunnelBriefRewrites?.ToString("0.#", CultureInfo.InvariantCulture) ?? "–")</div>
            <div class="q-sub">after the first version, average per project</div>
        </div>
        <div class="q-tile">
            <div class="q-label">Notes pinned on POC</div>
            <div class="q-value">@(Model.AvgFunnelPocComments?.ToString("0.#", CultureInfo.InvariantCulture) ?? "–")</div>
            <div class="q-sub">average per project</div>
        </div>
    </div>
    <div class="card table-card">
        <div class="table-wrap">
            <table class="data-table" data-paginate data-page-size="10">
                <thead>
                    <tr>
                        <th>Project</th>
                        <th class="num-col">Replies</th>
                        <th class="num-col">Brief rewrites</th>
                        <th class="num-col">POC notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.RequirementFunnel)
                    {
                        <tr>
                            <td><b>@f.ProjectName</b></td>
                            <td class="num-col">@f.UserTurns</td>
                            <td class="num-col">@(f.BriefRewrites > 0 ? f.BriefRewrites.ToString() : "–")</td>
                            <td class="num-col">@(f.PocComments > 0 ? f.PocComments.ToString() : "–")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Prompt eval: hiển thị NGOÀI khối TotalRuns>0 — chất lượng prompt đo được cả khi năm nay chưa có run giao hàng. *@
@if (Model.RecentEvalRuns.Count > 0)
{
    var canEvals = await Permissions.HasPermissionAsync(User, AppPermission.EvalView);

    <div class="q-section-title">Latest prompt evals</div>
    <div class="card table-card">
        <div class="table-wrap">
            <table class="data-table" data-paginate data-page-size="10">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Note</th>
                        <th>Model</th>
                        <th>Prompt</th>
                        <th class="num-col">Avg score (1–5)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.RecentEvalRuns)
                    {
                        <tr>
                            <td>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(r.Note) ? "–" : r.Note)</td>
                            <td>@r.TargetModelName</td>
                            <td>@(string.IsNullOrWhiteSpace(r.PromptKey) ? "all" : r.PromptKey)</td>
                            <td class="num-col">
                                @if (r.AverageScore is double score)
                                {
                                    <span class="q-rate-pill @(score >= 4 ? "good" : score >= 3 ? "warn" : "bad")">@score.ToString("0.00", CultureInfo.InvariantCulture)</span>
                                }
                                else
                                {
                                    <text>–</text>
                                }
                            </td>
                            <td>@r.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (canEvals)
        {
            <div class="q-eval-foot">
                <a asp-controller="Evals" asp-action="Index">View details & run evals on the Prompt Evals page →</a>
            </div>
        }
    </div>
}
